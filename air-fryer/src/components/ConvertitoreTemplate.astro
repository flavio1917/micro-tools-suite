---
import MainLayout from '../layouts/MainLayout.astro';
import AirFryer from '../components/tools/AirFryer/AirFryer.astro';

export interface Props { lang: string; }
const { lang } = Astro.props;

// DIZIONARIO SEO DEDICATO AL TOOL
const seoTitles = {
  it: "Convertitore Tempi e Gradi Forno → Friggitrice ad Aria | Crispissimo",
  en: "Oven to Air Fryer Time & Temp Converter | Crispissimo",
  es: "Convertidor de Tiempos y Grados Horno → Freidora de Aire | Crispissimo",
  fr: "Convertisseur Temps et Température Four → Friteuse à Air | Crispissimo"
};

const seoDescriptions = {
  it: "Adatta istantaneamente i tempi e i gradi del forno tradizionale per la tua friggitrice ad aria. Calcolatore automatico, tabella temperature e consigli pratici.",
  en: "Instantly adapt traditional oven times and temperatures for your air fryer. Automatic calculator, temperature chart, and practical tips.",
  es: "Adapta instantáneamente los tiempos y grados del horno tradicional para tu freidora de aire. Calculadora automática, tabla de temperaturas y consejos.",
  fr: "Adaptez instantanément les temps et les températures du four traditionnel pour votre friteuse à air. Calculateur automatique et tableau des températures."
};

const content = {
  it: {
    pageTitle: seoTitles.it,
    h2: "Guida alla Conversione: Forno vs Friggitrice ad Aria",
    p1: "Hai trovato una ricetta perfetta per il forno ma vuoi cucinarla nella tua friggitrice ad aria per risparmiare tempo ed energia? Il nostro <strong>convertitore per friggitrice ad aria</strong> applica l'algoritmo standard per adattare qualsiasi pietanza: riducendo la temperatura di circa <strong>20°C</strong> e il tempo di cottura del <strong>20%</strong>.",
    tableTitle: "Tabella Rapida Temperature (Forno Statico → Air Fryer)",
    th1: "Forno Tradizionale", th2: "Friggitrice ad Aria", th3: "Note",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Ideale per dolci e torte",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Perfetto per pollo e patatine",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Per gratinature croccanti",
    art1Title: "⚡ Forno Ventilato o Statico?",
    art1Desc: "La friggitrice ad aria funziona come un <strong>forno super-ventilato</strong> molto compatto. Se la tua ricetta originale prevede il forno <em>statico</em>, devi abbassare la temperatura di 20°C. Se la ricetta è già per forno <em>ventilato</em>, spesso basta ridurre solo il tempo, ma abbassare leggermente i gradi aiuta a non seccare il cibo.",
    art2Title: "🍟 Patatine e Surgelati",
    art2Desc: "Per i cibi surgelati (patatine fritte, crocchette, bastoncini), la regola cambia leggermente: spesso puoi mantenere la <strong>stessa temperatura</strong> indicata sulla confezione per il forno ventilato, ma riducendo il tempo del 20-30%. Ricordati di scuotere il cestello a metà cottura!",
    faqTitle: "Domande Frequenti",
    q1: "Devo preriscaldare la friggitrice ad aria?",
    a1: "A differenza del forno tradizionale, la maggior parte delle air fryer moderne raggiunge la temperatura in 2-3 minuti. Preriscaldare è consigliato solo per carne (come bistecche) o dolci lievitati.",
    q2: "Posso usare la carta forno o alluminio?",
    a2: "Sì, ma con attenzione. La carta forno deve essere forata per far circolare l'aria. Non metterla MAI durante il preriscaldamento senza cibo sopra: volerebbe contro la resistenza."
  },
  en: {
    pageTitle: seoTitles.en,
    h2: "Conversion Guide: Oven vs Air Fryer",
    p1: "Found a perfect oven recipe but want to cook it in your air fryer to save time and energy? Our <strong>air fryer calculator</strong> applies the standard algorithm: reducing the temperature by about <strong>25°F (20°C)</strong> and cooking time by <strong>20%</strong>.",
    tableTitle: "Quick Temp Table (Conventional Oven → Air Fryer)",
    th1: "Conventional Oven", th2: "Air Fryer", th3: "Notes",
    row1_1: "350°F (180°C)", row1_2: "320°F (160°C)", row1_3: "Ideal for cakes and baking",
    row2_1: "400°F (200°C)", row2_2: "350°F (180°C)", row2_3: "Perfect for chicken and fries",
    row3_1: "430°F (220°C)", row3_2: "400°F (200°C)", row3_3: "For crispy gratins",
    art1Title: "⚡ Fan or Conventional Oven?",
    art1Desc: "An air fryer works like a compact <strong>super-convection oven</strong>. If your recipe is for a <em>conventional</em> oven, drop the temp by 25°F. If it's already for a <em>fan/convection</em> oven, you often just reduce the time.",
    art2Title: "🍟 Fries and Frozen Foods",
    art2Desc: "For frozen foods (fries, nuggets), you can often keep the <strong>same temperature</strong> listed for a fan oven, but reduce the time by 20-30%. Remember to shake the basket halfway!",
    faqTitle: "Frequently Asked Questions",
    q1: "Do I need to preheat my air fryer?",
    a1: "Most modern air fryers reach target temps in 2-3 minutes. Preheating is only recommended for searing meats or baking to ensure an immediate thermal shock.",
    q2: "Can I use parchment paper or foil?",
    a2: "Yes, but carefully. Parchment paper must be perforated for air circulation. NEVER put it in during preheating without food on top to avoid fire hazards."
  },
  es: {
    pageTitle: seoTitles.es,
    h2: "Guía de Conversión: Horno vs Freidora de Aire",
    p1: "¿Has encontrado una receta para el horno pero quieres usar tu freidora de aire? Nuestro <strong>convertidor</strong> aplica el algoritmo estándar: reduciendo la temperatura unos <strong>20°C</strong> y el tiempo un <strong>20%</strong>.",
    tableTitle: "Tabla Rápida (Horno Tradicional → Air Fryer)",
    th1: "Horno Tradicional", th2: "Freidora de Aire", th3: "Notas",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Ideal para postres y tartas",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Perfecto para pollo y patatas",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Para gratinados crujientes",
    art1Title: "⚡ ¿Horno Estático o con Ventilador?",
    art1Desc: "La freidora de aire es un <strong>horno de convección</strong> compacto. Si la receta es para horno <em>estático</em>, baja la temperatura 20°C. Si es para horno <em>con ventilador</em>, a menudo basta con reducir solo el tiempo.",
    art2Title: "🍟 Patatas Fritas y Congelados",
    art2Desc: "Para alimentos congelados, a menudo puedes mantener la <strong>misma temperatura</strong> del envase para horno con ventilador, pero reduciendo el tiempo en un 20-30%.",
    faqTitle: "Preguntas Frecuentes",
    q1: "¿Debo precalentar la freidora de aire?",
    a1: "La mayoría alcanza la temperatura en 2-3 minutos. Solo se recomienda precalentar para carnes o repostería para asegurar el choque térmico inmediato.",
    q2: "¿Puedo usar papel de horno o aluminio?",
    a2: "Sí, pero con cuidado. NUNCA pongas papel de horno durante el precalentamiento sin comida encima: el flujo de aire podría empujarlo contra la resistencia."
  },
  fr: {
    pageTitle: seoTitles.fr,
    h2: "Guide de Conversion : Four vs Friteuse à Air",
    p1: "Vous avez trouvé une recette pour le four mais voulez utiliser votre Air Fryer ? Notre <strong>calculateur</strong> applique l'algorithme standard : réduire la température d'environ <strong>20°C</strong> et le temps de <strong>20%</strong>.",
    tableTitle: "Tableau Rapide (Four Traditionnel → Air Fryer)",
    th1: "Four Traditionnel", th2: "Friteuse à Air", th3: "Notes",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Idéal pour les gâteaux",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Parfait pour le poulet et les frites",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Pour des gratins croustillants",
    art1Title: "⚡ Four à Chaleur Tournante ou Traditionnel ?",
    art1Desc: "L'Air Fryer est un <strong>four à super-convection</strong>. Si la recette est pour un four <em>traditionnel</em>, baissez la température de 20°C. Si c'est pour un four <em>à chaleur tournante</em>, réduisez souvent juste le temps.",
    art2Title: "🍟 Frites et Surgelés",
    art2Desc: "Pour les surgelés, conservez souvent la <strong>même température</strong> indiquée pour un four à chaleur tournante, mais réduisez le temps de 20 à 30 %.",
    faqTitle: "Foire Aux Questions",
    q1: "Dois-je préchauffer la friteuse à air ?",
    a1: "La plupart atteignent la température en 2-3 minutes. Le préchauffage n'est recommandé que pour la viande ou les pâtisseries.",
    q2: "Puis-je utiliser du papier sulfurisé ?",
    a2: "Oui, mais avec prudence. Ne mettez JAMAIS de papier sulfurisé pendant le préchauffage sans aliments dessus : le flux d'air pourrait le brûler."
  }
};

const t = content[lang as keyof typeof content] || content.it;
const currentDesc = seoDescriptions[lang as keyof typeof seoDescriptions] || seoDescriptions.it;

// URL di questa specifica pagina nelle varie lingue
const alternateUrls = {
  it: "https://www.crispissimo.com/convertitore",
  en: "https://www.crispissimo.com/en/converter",
  es: "https://www.crispissimo.com/es/convertidor",
  fr: "https://www.crispissimo.com/fr/convertisseur"
};

const currentUrl = alternateUrls[lang as keyof typeof alternateUrls] || alternateUrls.it;

// JSON-LD Array: WebApplication + Unica FAQPage consentita
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convertitore Forno in Friggitrice ad Aria | Crispissimo",
    "url": currentUrl,
    "applicationCategory": "Utility",
    "browserRequirements": "Requires JavaScript",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": t.q1, "acceptedAnswer": { "@type": "Answer", "text": t.a1 } },
      { "@type": "Question", "name": t.q2, "acceptedAnswer": { "@type": "Answer", "text": t.a2 } }
    ]
  }
];
---

<MainLayout title={t.pageTitle} lang={lang} description={currentDesc} alternateUrls={alternateUrls}>
  
    <div class="pt-8 pb-4 text-slate-900 dark:text-white">
      <div class="max-w-6xl mx-auto px-4">
        <AirFryer lang={lang} />
      </div>
    </div>

  <section class="max-w-3xl mx-auto px-4 pb-16 text-slate-900 dark:text-slate-300 space-y-12 relative z-10">
    <article class="space-y-6 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">{t.h2}</h2>
      <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-400" set:html={t.p1}></p>
    </article>

    <article class="space-y-4">
      <h3 class="text-xl font-bold text-orange-600 dark:text-orange-400">{t.tableTitle}</h3>
      <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
            <tr>
              <th class="p-4">{t.th1}</th><th class="p-4">{t.th2}</th><th class="p-4 hidden sm:table-cell">{t.th3}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900/50">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row1_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row1_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row1_3}</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row2_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row2_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row2_3}</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row3_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row3_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row3_3}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>

    <div class="grid md:grid-cols-2 gap-8">
      <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">{t.art1Title}</h3>
        <p class="text-sm text-slate-700 dark:text-slate-400 leading-relaxed" set:html={t.art1Desc}></p>
      </article>

      <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">{t.art2Title}</h3>
        <p class="text-sm text-slate-700 dark:text-slate-400 leading-relaxed" set:html={t.art2Desc}></p>
      </article>
    </div>

    <article class="space-y-6 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2"><span class="text-3xl">❓</span> {t.faqTitle}</h3>
      <div class="space-y-4">
        
        <details class="group border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden transition-all bg-white dark:bg-slate-900 shadow-sm hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-4 md:p-5 text-slate-800 dark:text-slate-200 hover:text-orange-600 dark:hover:text-orange-400 transition-colors focus:outline-none group-open:bg-slate-50 dark:group-open:bg-slate-800/80">
                <span class="pr-4">{t.q1}</span>
                <span class="transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <div class="p-4 md:p-5 pt-1 md:pt-2 text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed bg-slate-50 dark:bg-slate-800/80 transition-colors">
                {t.a1}
            </div>
        </details>

        <details class="group border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden transition-all bg-white dark:bg-slate-900 shadow-sm hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-4 md:p-5 text-slate-800 dark:text-slate-200 hover:text-orange-600 dark:hover:text-orange-400 transition-colors focus:outline-none group-open:bg-slate-50 dark:group-open:bg-slate-800/80">
                <span class="pr-4">{t.q2}</span>
                <span class="transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <div class="p-4 md:p-5 pt-1 md:pt-2 text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed bg-slate-50 dark:bg-slate-800/80 transition-colors">
                {t.a2}
            </div>
        </details>

      </div>
    </article>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</MainLayout>