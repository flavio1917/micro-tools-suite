---
import MainLayout from '../layouts/MainLayout.astro';
import AirFryer from '../components/tools/AirFryer/AirFryer.astro';

export interface Props { lang: string; }
const { lang } = Astro.props;

import { seoTitles, seoDescriptions, content, alternateUrls } from '../i18n/pages/convertitore';

const t = content[lang as keyof typeof content] || content.it;
const currentDesc = seoDescriptions[lang as keyof typeof seoDescriptions] || seoDescriptions.it;


const currentUrl = alternateUrls[lang as keyof typeof alternateUrls] || alternateUrls.it;

// JSON-LD Array: WebApplication + Unica FAQPage consentita
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Convertitore Forno in Friggitrice ad Aria | Crispissimo",
    "url": currentUrl,
    "applicationCategory": "Utility",
    "browserRequirements": "Requires JavaScript",
    "operatingSystem": "All"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": t.q1, "acceptedAnswer": { "@type": "Answer", "text": t.a1 } },
      { "@type": "Question", "name": t.q2, "acceptedAnswer": { "@type": "Answer", "text": t.a2 } }
    ]
  }
];
---

<MainLayout title={t.pageTitle} lang={lang} description={currentDesc} alternateUrls={alternateUrls}>
  
    <div class="pt-8 pb-4 text-slate-900 dark:text-white">
      <div class="max-w-6xl mx-auto px-4">
        {t.h1 && (
          <h1 class="text-3xl font-black text-slate-900 dark:text-white mb-6 text-center">
            {t.h1}
          </h1>
        )}
        <AirFryer lang={lang} />
      </div>
    </div>

  <section class="max-w-3xl mx-auto px-4 pb-16 text-slate-900 dark:text-slate-300 space-y-12 relative z-10">
    <article class="space-y-6 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h2 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight">{t.h2}</h2>
      <p class="text-lg leading-relaxed text-slate-700 dark:text-slate-400" set:html={t.p1}></p>
    </article>

    <article class="space-y-4">
      <h3 class="text-xl font-bold text-orange-600 dark:text-orange-400">{t.tableTitle}</h3>
      <div class="overflow-hidden rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800 text-slate-900 dark:text-white font-semibold">
            <tr>
              <th class="p-4">{t.th1}</th><th class="p-4">{t.th2}</th><th class="p-4 hidden sm:table-cell">{t.th3}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-700 bg-white dark:bg-slate-900/50">
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row1_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row1_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row1_3}</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row2_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row2_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row2_3}</td>
            </tr>
            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-slate-600 dark:text-slate-400">{t.row3_1}</td>
              <td class="p-4 font-mono text-orange-600 dark:text-orange-400 font-bold">{t.row3_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row3_3}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>

    <div class="grid md:grid-cols-2 gap-8">
      <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">{t.art1Title}</h3>
        <p class="text-sm text-slate-700 dark:text-slate-400 leading-relaxed" set:html={t.art1Desc}></p>
      </article>

      <article class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/50 p-6 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
        <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 flex items-center gap-2">{t.art2Title}</h3>
        <p class="text-sm text-slate-700 dark:text-slate-400 leading-relaxed" set:html={t.art2Desc}></p>
      </article>
    </div>

    <article class="space-y-6 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-2xl font-black text-slate-900 dark:text-white flex items-center gap-2"><span class="text-3xl">❓</span> {t.faqTitle}</h3>
      <div class="space-y-4">
        
        <details class="group border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden transition-all bg-white dark:bg-slate-900 shadow-sm hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-4 md:p-5 text-slate-800 dark:text-slate-200 hover:text-orange-600 dark:hover:text-orange-400 transition-colors focus:outline-none group-open:bg-slate-50 dark:group-open:bg-slate-800/80">
                <span class="pr-4">{t.q1}</span>
                <span class="transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <div class="p-4 md:p-5 pt-1 md:pt-2 text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed bg-slate-50 dark:bg-slate-800/80 transition-colors">
                {t.a1}
            </div>
        </details>

        <details class="group border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden transition-all bg-white dark:bg-slate-900 shadow-sm hover:shadow-md">
            <summary class="flex justify-between items-center font-bold cursor-pointer list-none p-4 md:p-5 text-slate-800 dark:text-slate-200 hover:text-orange-600 dark:hover:text-orange-400 transition-colors focus:outline-none group-open:bg-slate-50 dark:group-open:bg-slate-800/80">
                <span class="pr-4">{t.q2}</span>
                <span class="transition-transform duration-300 group-open:rotate-180 text-slate-400 group-hover:text-orange-500">
                    <svg fill="none" height="24" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
            </summary>
            <div class="p-4 md:p-5 pt-1 md:pt-2 text-slate-600 dark:text-slate-400 text-sm md:text-base leading-relaxed bg-slate-50 dark:bg-slate-800/80 transition-colors">
                {t.a2}
            </div>
        </details>

      </div>
    </article>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</MainLayout>