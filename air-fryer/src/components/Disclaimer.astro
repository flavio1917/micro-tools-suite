---
export interface Props {
  type: 'elettrico' | 'nutrizionale' | 'generale';
  lang: string;
}

const { type, lang = 'it' } = Astro.props;

import { content } from '../i18n/components/disclaimer';

const t = content[type][lang as keyof typeof content[typeof type]] || content[type].it;
---

<div class="bg-slate-900/80 border border-slate-700/80 rounded-xl p-6 md:p-8 text-sm text-slate-400 shadow-inner mb-8">
  <h4 class="text-slate-300 font-bold mb-3 uppercase tracking-wider text-xs flex items-center gap-2">
    {t.title}
  </h4>
  <p class="leading-relaxed">
    {t.text}
  </p>
</div>