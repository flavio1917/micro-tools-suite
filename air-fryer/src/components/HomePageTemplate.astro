---
import MainLayout from '../layouts/MainLayout.astro';
import RecipeSearch from '../components/recipes/RecipeSearch.astro';

export interface Props { lang: string; }
const { lang } = Astro.props;

// DIZIONARIO SEO
const seoTitles = {
  it: "Crispissimo | Ricette in Friggitrice ad Aria Facili e Croccanti",
  en: "Crispissimo | Easy & Crispy Air Fryer Recipes",
  es: "Crispissimo | Recetas en Freidora de Aire Fáciles y Crujientes",
  fr: "Crispissimo | Recettes à la Friteuse à Air Faciles et Croustillantes"
};

const seoDescriptions = {
  it: "Scopri le migliori ricette per friggitrice ad aria su Crispissimo. Piatti facili, veloci e dalla croccantezza imbattibile per la tua cucina quotidiana.",
  en: "Discover the best air fryer recipes on Crispissimo. Easy, fast, and unbeatably crispy dishes for your everyday cooking.",
  es: "Descubre las mejores recetas para freidora de aire en Crispissimo. Platos fáciles, rápidos y con un crujido inmejorable para tu cocina diaria.",
  fr: "Découvrez les meilleures recettes pour friteuse à air sur Crispissimo. Des plats faciles, rapides et incroyablement croustillants pour tous les jours."
};

// CONTENUTI HERO
const heroContent = {
  it: {
    h1: "La Croccantezza <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-rose-500'>Perfetta.</span>",
    sub: "Centinaia di ricette testate per la tua friggitrice ad aria. Zero grassi pesanti, 100% gusto.",
    cta: "Esplora le Ricette"
  },
  en: {
    h1: "The Perfect <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-rose-500'>Crunch.</span>",
    sub: "Hundreds of tested recipes for your air fryer. Zero heavy fats, 100% flavor.",
    cta: "Explore Recipes"
  },
  es: {
    h1: "El Crujido <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-rose-500'>Perfecto.</span>",
    sub: "Cientos de recetas probadas para tu freidora de aire. Cero grasas pesadas, 100% sabor.",
    cta: "Explora las Recetas"
  },
  fr: {
    h1: "Le Croustillant <span class='text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-rose-500'>Parfait.</span>",
    sub: "Des centaines de recettes testées pour votre friteuse à air. Zéro graisse lourde, 100% goût.",
    cta: "Explorer les Recettes"
  }
};

// TEASER CONVERTITORE E STRUMENTI IN HOME
const toolsContent = {
  it: { 
    convTitle: "Convertitore Automatico", convDesc: "Adatta i tempi del forno in un clic.", convCta: "Apri Convertitore", convLink: "/convertitore",
    toolsTitle: "Strumenti per Air Fryer", toolsDesc: "Guide materiali, pulizia, consumi e utilità.", toolsCta: "Tutti gli Strumenti", toolsLink: "/strumenti"
  },
  en: { 
    convTitle: "Automatic Converter", convDesc: "Adapt oven times in one click.", convCta: "Open Converter", convLink: "/en/converter",
    toolsTitle: "Air Fryer Tools", toolsDesc: "Materials guides, cleaning, and calculators.", toolsCta: "All Tools", toolsLink: "/en/tools" 
  },
  es: { 
    convTitle: "Convertidor Automático", convDesc: "Adapta los tiempos del horno en un clic.", convCta: "Abrir Convertidor", convLink: "/es/convertidor",
    toolsTitle: "Herramientas de Air Fryer", toolsDesc: "Guías de materiales, limpieza y consumos.", toolsCta: "Todas las Herramientas", toolsLink: "/es/herramientas"
  },
  fr: { 
    convTitle: "Convertisseur Auto", convDesc: "Adaptez les temps du four en un clic.", convCta: "Ouvrir Convertisseur", convLink: "/fr/convertisseur",
    toolsTitle: "Outils pour Air Fryer", toolsDesc: "Guides des matériaux, nettoyage et calculs.", toolsCta: "Tous les Outils", toolsLink: "/fr/outils"
  }
};

const currentTitle = seoTitles[lang as keyof typeof seoTitles] || seoTitles.it;
const currentDesc = seoDescriptions[lang as keyof typeof seoDescriptions] || seoDescriptions.it;
const hero = heroContent[lang as keyof typeof heroContent] || heroContent.it;
const teaser = toolsContent[lang as keyof typeof toolsContent] || toolsContent.it;

const alternateUrls = {
  it: "https://www.crispissimo.com/",
  en: "https://www.crispissimo.com/en/",
  es: "https://www.crispissimo.com/es/",
  fr: "https://www.crispissimo.com/fr/"
};

const siteUrl = alternateUrls[lang as keyof typeof alternateUrls] || alternateUrls.it;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Crispissimo",
  "url": siteUrl
};
---

<MainLayout title={currentTitle} lang={lang} description={currentDesc} alternateUrls={alternateUrls}>
  
  <header class="relative pt-16 pb-20 md:pt-24 md:pb-28 px-4 text-center overflow-hidden border-b border-slate-200 dark:border-slate-800">
    <div class="absolute inset-0 z-0 bg-gradient-to-b from-orange-50/80 to-transparent dark:from-[#0B1120] dark:to-transparent pointer-events-none"></div>
    
    <div class="relative z-10 max-w-4xl mx-auto space-y-6">
      <h1 class="text-5xl md:text-7xl font-black text-slate-900 dark:text-white tracking-tight leading-tight" set:html={hero.h1}></h1>
      <p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed">
        {hero.sub}
      </p>
      <div class="pt-6">
        <a href="#ricettario-container" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white transition-all bg-orange-600 hover:bg-orange-700 rounded-full shadow-lg hover:shadow-orange-600/30 hover:-translate-y-1">
          {hero.cta}
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
        </a>
      </div>
    </div>
  </header>

  <section class="max-w-5xl mx-auto px-4 py-10 mt-2 z-20 relative">
    <div class="grid md:grid-cols-2 gap-6">
      <a href={teaser.convLink} class="group block bg-gradient-to-br from-orange-50 to-orange-100/50 dark:from-slate-800/60 dark:to-slate-900/60 border border-orange-200/50 dark:border-slate-700/50 p-6 md:p-8 rounded-3xl text-left shadow-sm transition-all hover:shadow-md hover:border-orange-400 dark:hover:border-orange-500 overflow-hidden relative">
        <div class="absolute -right-8 -top-8 text-8xl opacity-10 group-hover:rotate-12 transition-transform duration-500">🔄</div>
        <div class="relative z-10">
          <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white mb-2 tracking-tight group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">{teaser.convTitle}</h2>
          <p class="text-slate-600 dark:text-slate-400 mb-6 text-sm md:text-base">{teaser.convDesc}</p>
          <span class="inline-flex items-center text-sm font-bold text-orange-600 dark:text-orange-400">
            {teaser.convCta} <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7-7m7 7H3"></path></svg>
          </span>
        </div>
      </a>

      <a href={teaser.toolsLink} class="group block bg-gradient-to-br from-blue-50 to-blue-100/50 dark:from-slate-800/60 dark:to-slate-900/60 border border-blue-200/50 dark:border-slate-700/50 p-6 md:p-8 rounded-3xl text-left shadow-sm transition-all hover:shadow-md hover:border-blue-400 dark:hover:border-blue-500 overflow-hidden relative">
        <div class="absolute -right-8 -top-8 text-8xl opacity-10 group-hover:scale-110 transition-transform duration-500">🧰</div>
        <div class="relative z-10">
          <h2 class="text-xl md:text-2xl font-black text-slate-900 dark:text-white mb-2 tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">{teaser.toolsTitle}</h2>
          <p class="text-slate-600 dark:text-slate-400 mb-6 text-sm md:text-base">{teaser.toolsDesc}</p>
          <span class="inline-flex items-center text-sm font-bold text-blue-600 dark:text-blue-400">
            {teaser.toolsCta} <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7-7m7 7H3"></path></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <section class="w-full py-8">
    <div id="ricettario" class="w-full">
      <RecipeSearch lang={lang} />
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</MainLayout>