---
import MainLayout from '../layouts/MainLayout.astro';
import AirFryer from '../components/tools/AirFryer/AirFryer.astro';
import RecipeSearch from '../components/recipes/RecipeSearch.astro';

export interface Props { lang: string; }
const { lang } = Astro.props;

// DIZIONARIO SEO PER TITOLI E DESCRIZIONI UNICHE (Anti-Boilerplate)
const seoTitles = {
  it: "Convertitore Friggitrice ad Aria: Calcolo Tempi e Gradi Online",
  en: "Air Fryer Calculator: Convert Oven Time and Temperature",
  es: "Calculadora Freidora de Aire: Convierte Tiempos y Grados de Horno",
  fr: "Calculateur Friteuse à Air : Convertir Temps et Température Four"
};

const seoDescriptions = {
  it: "Il miglior convertitore friggitrice ad aria online. Trasforma tempi e temperature da forno a Air Fryer in un click. Oltre 220 ricette testate e guide ai consumi.",
  en: "The best air fryer converter online. Easily transform oven times and temperatures for your Air Fryer. Explore 220+ tested recipes and energy-saving tips.",
  es: "El mejor conversor para freidora de aire. Transforma tiempos y grados de horno a Air Fryer con un clic. Más de 220 recetas y guías de ahorro energético.",
  fr: "Le meilleur convertisseur pour friteuse à air. Transformez les temps et températures du four pour l'Air Fryer. Plus de 220 recettes testées et conseils d'économie."
};

const content = {
  it: {
    pageTitle: seoTitles.it,
    explore: "Esplora il Ricettario",
    h2: "Guida alla Conversione: Forno vs Friggitrice ad Aria",
    p1: "Hai trovato una ricetta perfetta per il forno ma vuoi cucinarla nella tua friggitrice ad aria per risparmiare tempo ed energia? Il nostro <strong>convertitore per friggitrice ad aria</strong> applica l'algoritmo standard per adattare qualsiasi pietanza: riducendo la temperatura di circa <strong>20°C</strong> e il tempo di cottura del <strong>20%</strong>.",
    tableTitle: "Tabella Rapida Temperature (Forno Statico → Air Fryer)",
    th1: "Forno Tradizionale", th2: "Friggitrice ad Aria", th3: "Note",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Ideale per dolci e torte",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Perfetto per pollo e patatine",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Per gratinature croccanti",
    art1Title: "⚡ Forno Ventilato o Statico?",
    art1Desc: "La friggitrice ad aria funziona come un <strong>forno super-ventilato</strong> molto compatto. Se la tua ricetta originale prevede il forno <em>statico</em>, devi abbassare la temperatura di 20°C. Se la ricetta è già per forno <em>ventilato</em>, spesso basta ridurre solo il tempo, ma abbassare leggermente i gradi aiuta a non seccare il cibo.",
    art2Title: "🍟 Patatine e Surgelati",
    art2Desc: "Per i cibi surgelati (patatine fritte, crocchette, bastoncini), la regola cambia leggermente: spesso puoi mantenere la <strong>stessa temperatura</strong> indicata sulla confezione per il forno ventilato, ma riducendo il tempo del 20-30%. Ricordati di scuotere il cestello a metà cottura!",
    faqTitle: "Domande Frequenti",
    q1: "Devo preriscaldare la friggitrice ad aria?",
    a1: "A differenza del forno tradizionale, la maggior parte delle air fryer moderne raggiunge la temperatura in 2-3 minuti. Preriscaldare è consigliato solo per carne (come bistecche) o dolci lievitati.",
    q2: "Posso usare la carta forno o alluminio?",
    a2: "Sì, ma con attenzione. La carta forno deve essere forata per far circolare l'aria. Non metterla MAI durante il preriscaldamento senza cibo sopra: volerebbe contro la resistenza."
  },
  en: {
    pageTitle: seoTitles.en,
    explore: "Explore the Cookbook",
    h2: "Conversion Guide: Oven vs Air Fryer",
    p1: "Found a perfect oven recipe but want to cook it in your air fryer to save time and energy? Our <strong>air fryer calculator</strong> applies the standard algorithm: reducing the temperature by about <strong>25°F (20°C)</strong> and cooking time by <strong>20%</strong>.",
    tableTitle: "Quick Temp Table (Conventional Oven → Air Fryer)",
    th1: "Conventional Oven", th2: "Air Fryer", th3: "Notes",
    row1_1: "350°F (180°C)", row1_2: "320°F (160°C)", row1_3: "Ideal for cakes and baking",
    row2_1: "400°F (200°C)", row2_2: "350°F (180°C)", row2_3: "Perfect for chicken and fries",
    row3_1: "430°F (220°C)", row3_2: "400°F (200°C)", row3_3: "For crispy gratins",
    art1Title: "⚡ Fan or Conventional Oven?",
    art1Desc: "An air fryer works like a compact <strong>super-convection oven</strong>. If your recipe is for a <em>conventional</em> oven, drop the temp by 25°F. If it's already for a <em>fan/convection</em> oven, you often just reduce the time.",
    art2Title: "🍟 Fries and Frozen Foods",
    art2Desc: "For frozen foods (fries, nuggets), you can often keep the <strong>same temperature</strong> listed for a fan oven, but reduce the time by 20-30%. Remember to shake the basket halfway!",
    faqTitle: "Frequently Asked Questions",
    q1: "Do I need to preheat my air fryer?",
    a1: "Most modern air fryers reach target temps in 2-3 minutes. Preheating is only recommended for searing meats or baking to ensure an immediate thermal shock.",
    q2: "Can I use parchment paper or foil?",
    a2: "Yes, but carefully. Parchment paper must be perforated for air circulation. NEVER put it in during preheating without food on top to avoid fire hazards."
  },
  es: {
    pageTitle: seoTitles.es,
    explore: "Explora el Recetario",
    h2: "Guía de Conversión: Horno vs Freidora de Aire",
    p1: "¿Has encontrado una receta para el horno pero quieres usar tu freidora de aire? Nuestro <strong>convertidor</strong> aplica el algoritmo estándar: reduciendo la temperatura unos <strong>20°C</strong> y el tiempo un <strong>20%</strong>.",
    tableTitle: "Tabla Rápida (Horno Tradicional → Air Fryer)",
    th1: "Horno Tradicional", th2: "Freidora de Aire", th3: "Notas",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Ideal para postres y tartas",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Perfecto para pollo y patatas",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Para gratinados crujientes",
    art1Title: "⚡ ¿Horno Estático o con Ventilador?",
    art1Desc: "La freidora de aire es un <strong>horno de convección</strong> compacto. Si la receta es para horno <em>estático</em>, baja la temperatura 20°C. Si es para horno <em>con ventilador</em>, a menudo basta con reducir solo el tiempo.",
    art2Title: "🍟 Patatas Fritas y Congelados",
    art2Desc: "Para alimentos congelados, a menudo puedes mantener la <strong>misma temperatura</strong> del envase para horno con ventilador, pero reduciendo el tiempo en un 20-30%.",
    faqTitle: "Preguntas Frecuentes",
    q1: "¿Debo precalentar la freidora de aire?",
    a1: "La mayoría alcanza la temperatura en 2-3 minuti. Solo se recomienda precalentar para carnes o repostería para asegurar el choque térmico inmediato.",
    q2: "¿Puedo usar papel de horno o aluminio?",
    a2: "Sí, ma con cuidado. NUNCA pongas papel de horno durante el precalentamiento sin comida encima: el flujo de aire podría empujarlo contra la resistencia."
  },
  fr: {
    pageTitle: seoTitles.fr,
    explore: "Explorer le Livre de Recettes",
    h2: "Guide de Conversion : Four vs Friteuse à Air",
    p1: "Vous avez trouvé une recette pour le four mais voulez utiliser votre Air Fryer ? Notre <strong>calculateur</strong> applique l'algorithme standard : réduire la température d'environ <strong>20°C</strong> et le temps de <strong>20%</strong>.",
    tableTitle: "Tableau Rapide (Four Traditionnel → Air Fryer)",
    th1: "Four Traditionnel", th2: "Friteuse à Air", th3: "Notes",
    row1_1: "180°C", row1_2: "160°C", row1_3: "Idéal pour les gâteaux",
    row2_1: "200°C", row2_2: "180°C", row2_3: "Parfait pour le poulet et les frites",
    row3_1: "220°C", row3_2: "200°C", row3_3: "Pour des gratins croustillants",
    art1Title: "⚡ Four à Chaleur Tournante ou Traditionnel ?",
    art1Desc: "L'Air Fryer est un <strong>four à super-convection</strong>. Si la recette est pour un four <em>traditionnel</em>, baissez la température de 20°C. Si c'est pour un four <em>à chaleur tournante</em>, réduisez souvent juste le temps.",
    art2Title: "🍟 Frites et Surgelés",
    art2Desc: "Pour les surgelés, conservez souvent la <strong>même température</strong> indiquée pour un four à chaleur tournante, mais réduisez le temps de 20 à 30 %.",
    faqTitle: "Foire Aux Questions",
    q1: "Dois-je préchauffer la friteuse à air ?",
    a1: "La plupart atteignent la température en 2-3 minutes. Le préchauffage n'est recommandé que pour la viande o le pâtisseries.",
    q2: "Puis-je utiliser du papier sulfurisé ?",
    a2: "Oui, mais con prudence. Ne mettez JAMAIS de papier sulfurisé pendant le préchauffage sans aliments dessus : le flux d'air pourrait le brûler."
  }
};

const t = content[lang as keyof typeof content] || content.it;

// DIZIONARIO STRUMENTI EXTRA
const toolsData = {
  it: {
    title: "Gli Strumenti Extra",
    subtitle: "Guide e utility per padroneggiare la tua friggitrice ad aria.",
    cards: [
      { link: "materiali", emoji: "🛑", title: "Guida Materiali", desc: "Cosa puoi (e NON puoi) mettere nel cestello." },
      { link: "riscaldare", emoji: "🍕", title: "Riscalda Avanzi", desc: "Fai tornare croccante la pizza e i fritti di ieri." },
      { link: "errori", emoji: "⚠️", title: "Codici Errore", desc: "Significato degli errori E1, E2, E3 e come resettare." },
      { link: "calorie", emoji: "⚖️", title: "Calcolo Calorie", desc: "Scopri quanti grassi risparmi rispetto alla frittura." },
      { link: "pulizia", emoji: "🧽", title: "Pulizia Resistenza", desc: "Sgrassa la serpentina superiore in sicurezza." },
      { link: "problemi", emoji: "💨", title: "Fumo & Puzza", desc: "Risolvi la puzza di plastica e il fumo bianco." },
      { link: "consumi", emoji: "⚡", title: "Costi in Bolletta", desc: "Calcola quanto spendi rispetto al forno elettrico." },
      { link: "surgelati", emoji: "❄️", title: "Cottura Surgelati", desc: "Calcola i tempi a 2 Fasi per i cibi congelati." }
    ]
  },
  en: {
    title: "Extra Tools",
    subtitle: "Guides and utilities to master your air fryer.",
    cards: [
      { link: "materiali", emoji: "🛑", title: "Materials Guide", desc: "What you can (and CANNOT) put in the basket." },
      { link: "riscaldare", emoji: "🍕", title: "Reheating Guide", desc: "Bring back the crispiness to yesterday's pizza." },
      { link: "errori", emoji: "⚠️", title: "Error Codes", desc: "Meaning of E1, E2, E3 errors and how to reset." },
      { link: "calorie", emoji: "⚖️", title: "Calorie Calculator", desc: "Discover how much fat you save vs deep frying." },
      { link: "pulizia", emoji: "🧽", title: "Heating Element", desc: "Safely degrease the top heating coil." },
      { link: "problemi", emoji: "💨", title: "Smoke & Smells", desc: "Solve plastic smells and white smoke issues." },
      { link: "consumi", emoji: "⚡", title: "Energy Bill", desc: "Calculate how much you spend vs the electric oven." },
      { link: "surgelati", emoji: "❄️", title: "Frozen Foods", desc: "Calculate 2-Phase cooking times for frozen items." }
    ]
  },
  es: {
    title: "Herramientas Extra",
    subtitle: "Guías y utilidades para dominar tu freidora de aire.",
    cards: [
      { link: "materiali", emoji: "🛑", title: "Guía de Materiales", desc: "Qué puedes (y NO puedes) meter en la cesta." },
      { link: "riscaldare", emoji: "🍕", title: "Recalentar Sobras", desc: "Devuélvele el crujiente a la pizza de ayer." },
      { link: "errori", emoji: "⚠️", title: "Códigos de Error", desc: "Significado de los errores E1, E2, E3 y cómo resetear." },
      { link: "calorie", emoji: "⚖️", title: "Cálculo Calorías", desc: "Descubre cuánta grasa ahorras frente a la fritura." },
      { link: "pulizia", emoji: "🧽", title: "Limpieza Resistencia", desc: "Desengrasa la bobina superior de forma segura." },
      { link: "problemi", emoji: "💨", title: "Humo y Olores", desc: "Resuelve el olor a plástico y el humo blanco." },
      { link: "consumi", emoji: "⚡", title: "Gasto Eléctrico", desc: "Calcula cuánto gastas frente al horno eléctrico." },
      { link: "surgelati", emoji: "❄️", title: "Comida Congelada", desc: "Calcula los tiempos en 2 Fases para congelados." }
    ]
  },
  fr: {
    title: "Outils Supplémentaires",
    subtitle: "Guides et utilitaires pour maîtriser votre friteuse à air.",
    cards: [
      { link: "materiali", emoji: "🛑", title: "Guide des Matériaux", desc: "Ce que vous pouvez (et NE pouvez PAS) mettre." },
      { link: "riscaldare", emoji: "🍕", title: "Réchauffer", desc: "Redonnez du croustillant à la pizza d'hier." },
      { link: "errori", emoji: "⚠️", title: "Codes d'Erreur", desc: "Signification des erreurs E1, E2, E3 et comment réinitialiser." },
      { link: "calorie", emoji: "⚖️", title: "Calcul Calories", desc: "Découvrez combien de graisses vous économisez." },
      { link: "pulizia", emoji: "🧽", title: "Nettoyage Résistance", desc: "Dégraissez le serpentin supérieur en toute sécurité." },
      { link: "problemi", emoji: "💨", title: "Fumée & Odeurs", desc: "Résolvez les odeurs de plastique et la fumée blanche." },
      { link: "consumi", emoji: "⚡", title: "Coût Électrique", desc: "Calculez vos dépenses par rapport au four électrique." },
      { link: "surgelati", emoji: "❄️", title: "Aliments Surgelés", desc: "Calculez les temps en 2 phases pour les surgelés." }
    ]
  }
};

const toolsLang = toolsData[lang as keyof typeof toolsData] || toolsData.it;

const alternateUrls = {
  it: "https://www.convertitorefriggitrice.it/",
  en: "https://www.convertitorefriggitrice.it/en/",
  es: "https://www.convertitorefriggitrice.it/es/",
  fr: "https://www.convertitorefriggitrice.it/fr/"
};

const currentDesc = seoDescriptions[lang as keyof typeof seoDescriptions] || seoDescriptions.it;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": t.q1, "acceptedAnswer": { "@type": "Answer", "text": t.a1 } },
    { "@type": "Question", "name": t.q2, "acceptedAnswer": { "@type": "Answer", "text": t.a2 } }
  ]
};
---

<MainLayout title={t.pageTitle} lang={lang} description={currentDesc} alternateUrls={alternateUrls}>
  
  <AirFryer lang={lang} />

  <div class="max-w-4xl mx-auto my-12 relative flex items-center justify-center px-4">
    <div class="absolute inset-x-0 h-px bg-gradient-to-r from-transparent via-slate-700 to-transparent opacity-50"></div>
    <div class="absolute inset-x-1/4 h-px bg-gradient-to-r from-transparent via-blue-500 to-transparent shadow-[0_0_12px_rgba(59,130,246,0.8)]"></div>
    <div class="relative bg-[#0B1120] px-6 py-2 rounded-full border border-slate-700/80 text-xs font-semibold text-blue-300 uppercase tracking-widest shadow-xl flex items-center gap-2">
      <span>🍽️</span> {t.explore}
    </div>
  </div>

  <div class="mb-8">
    <RecipeSearch lang={lang} />
  </div>

  <section class="max-w-5xl mx-auto px-4 py-16 border-t border-slate-800 mt-8 relative z-10">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-black text-white mb-3 tracking-tight">{toolsLang.title}</h2>
      <p class="text-slate-400 text-sm md:text-lg">{toolsLang.subtitle}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-6">
      {toolsLang.cards.map((card) => (
        <a href={`/${lang}/${card.link}`} class="group bg-slate-800/40 border border-slate-700/60 p-5 md:p-6 rounded-2xl hover:bg-slate-800 transition-all shadow-lg hover:shadow-2xl flex items-start gap-4 overflow-hidden relative">
          <div class="absolute -left-10 top-0 bottom-0 w-2 bg-gradient-to-b from-blue-400 to-orange-500 blur-xl group-hover:left-0 transition-all duration-300 opacity-0 group-hover:opacity-100"></div>
          <div class="text-4xl flex-shrink-0 group-hover:scale-110 group-hover:rotate-3 transition-transform duration-300 drop-shadow-md">
            {card.emoji}
          </div>
          <div class="flex-1 relative z-10">
            <h3 class="text-white font-bold text-lg mb-1 group-hover:text-blue-400 transition-colors">{card.title}</h3>
            <p class="text-xs md:text-sm text-slate-400 leading-relaxed">{card.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 pb-12 text-slate-300 space-y-12">
    <article class="space-y-6 pt-12 border-t border-slate-800">
      <h2 class="text-3xl font-bold text-white tracking-tight">{t.h2}</h2>
      <p class="text-lg leading-relaxed text-slate-400" set:html={t.p1}></p>
    </article>

    <article class="space-y-4">
      <h3 class="text-xl font-semibold text-blue-200">{t.tableTitle}</h3>
      <div class="overflow-hidden rounded-xl border border-slate-700 shadow-2xl">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-800 text-white font-semibold">
            <tr>
              <th class="p-4">{t.th1}</th><th class="p-4">{t.th2}</th><th class="p-4 hidden sm:table-cell">{t.th3}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700 bg-slate-900/50">
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-orange-300">{t.row1_1}</td>
              <td class="p-4 font-mono text-blue-300 font-bold">{t.row1_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row1_3}</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-orange-300">{t.row2_1}</td>
              <td class="p-4 font-mono text-blue-300 font-bold">{t.row2_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row2_3}</td>
            </tr>
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="p-4 font-mono text-orange-300">{t.row3_1}</td>
              <td class="p-4 font-mono text-blue-300 font-bold">{t.row3_2}</td>
              <td class="p-4 text-slate-500 hidden sm:table-cell">{t.row3_3}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </article>

    <div class="grid md:grid-cols-2 gap-8">
      <article class="bg-slate-800/30 p-6 rounded-2xl border border-slate-700/50">
        <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">{t.art1Title}</h3>
        <p class="text-sm text-slate-400 leading-relaxed" set:html={t.art1Desc}></p>
      </article>

      <article class="bg-slate-800/30 p-6 rounded-2xl border border-slate-700/50">
        <h3 class="text-lg font-bold text-white mb-3 flex items-center gap-2">{t.art2Title}</h3>
        <p class="text-sm text-slate-400 leading-relaxed" set:html={t.art2Desc}></p>
      </article>
    </div>

    <article class="space-y-6 pt-8 border-t border-slate-800">
      <h3 class="text-2xl font-bold text-white">{t.faqTitle}</h3>
      <div class="space-y-4">
        <details class="group bg-slate-900 rounded-lg p-4 cursor-pointer [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-medium text-slate-200 group-hover:text-blue-300 transition-colors">
            {t.q1}
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-400 mt-3 text-sm leading-relaxed">{t.a1}</p>
        </details>

        <details class="group bg-slate-900 rounded-lg p-4 cursor-pointer [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex justify-between items-center font-medium text-slate-200 group-hover:text-blue-300 transition-colors">
            {t.q2}
            <span class="transition group-open:rotate-180">
              <svg fill="none" height="24" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
            </span>
          </summary>
          <p class="text-slate-400 mt-3 text-sm leading-relaxed">{t.a2}</p>
        </details>
      </div>
    </article>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

</MainLayout>