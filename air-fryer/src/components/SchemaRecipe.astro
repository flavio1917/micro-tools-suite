---
export interface Props {
  recipe: any;
  lang?: string;
}

const { recipe, lang = "it" } = Astro.props;

// Helper: Estrae i minuti dal formato e converte in ISO 8601
function toISODuration(timeStr: string | undefined) {
  if (!timeStr) return "PT0M";
  const matches = timeStr.toString().match(/\d+/g);
  if (matches && matches.length > 0) {
    const maxTime = matches[matches.length - 1];
    return `PT${maxTime}M`;
  }
  return "PT0M";
}

const prepTimeISO = toISODuration(recipe.prep_time);
const cookTimeISO = toISODuration(recipe.time); 

// L'URL dinamico dell'immagine
const baseImageName = recipe.image || recipe.slug;
const imageUrl = `https://www.convertitorefriggitrice.it/images/recipes/${baseImageName}.webp`;

// Gestione URL dinamico per la pagina Info
const infoUrlPath = lang === 'it' ? '/info' : `/${lang}/info`;

// Integrazione Nutrizionale Avanzata
let nutritionSchema = undefined;
if (recipe.nutrition) {
  nutritionSchema = {
    "@type": "NutritionInformation",
    "servingSize": "1 porzione",
    "calories": `${recipe.nutrition.kcal} calories`,
    "proteinContent": `${recipe.nutrition.proteins_g} grams`,
    "fatContent": `${recipe.nutrition.fats_g} grams`,
    "saturatedFatContent": `${recipe.nutrition.saturated_fats_g} grams`,
    "carbohydrateContent": `${recipe.nutrition.carbs_g} grams`,
    "sugarContent": `${recipe.nutrition.sugars_g} grams`,
    "sodiumContent": `${recipe.nutrition.salt_g * 400} milligrams`
  };
}

const schema = {
  "@context": "https://schema.org/",
  "@type": "Recipe",
  "name": recipe.title,
  "image": [ imageUrl ],
  "author": {
    "@type": "Person",
    "name": "Flavio Refrigeri",
    "jobTitle": "Ingegnere Informatico & Creatore di Ricette", 
    "url": `https://www.convertitorefriggitrice.it${infoUrlPath}` 
  },
  "description": recipe.description,
  "prepTime": prepTimeISO,
  "cookTime": cookTimeISO,
  "recipeYield": recipe.portions ? `${recipe.portions} servings` : "2 servings",
  "cookMethod": "Air Frying",
  "recipeCategory": recipe.keywords && recipe.keywords.length > 0 ? recipe.keywords[0] : "Main Course",
  "recipeIngredient": recipe.ingredients,
  "recipeInstructions": recipe.instructions ? recipe.instructions.map((step: string) => ({
    "@type": "HowToStep",
    "text": step
  })) : [],
  "nutrition": nutritionSchema
};

// Rimuove eventuali chiavi undefined
Object.keys(schema).forEach(key => schema[key as keyof typeof schema] === undefined && delete schema[key as keyof typeof schema]);
---

<script type="application/ld+json" id="recipe-schema" set:html={JSON.stringify(schema)} />