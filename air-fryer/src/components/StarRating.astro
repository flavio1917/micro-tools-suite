---
const { slug, title } = Astro.props;
---

<div id="rating-widget" data-state="closed" class="relative flex items-center justify-center h-full bg-slate-800/90 backdrop-blur-md rounded-full border border-slate-600/50 shadow-xl transition-all duration-300 overflow-hidden cursor-pointer">

  <div id="rating-closed" class="flex items-center justify-between w-full px-2.5 md:px-3 transition-opacity duration-300">
    <div class="flex items-center gap-1">
      <svg class="w-3.5 h-3.5 md:w-4 md:h-4 text-orange-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      <span id="avg-display" class="font-bold text-xs md:text-sm text-white leading-none">--</span>
    </div>
    <div id="btn-text-vota" class="text-orange-400 font-bold text-[9px] md:text-[10px] uppercase tracking-wider ml-1.5">
      Vota
    </div>
  </div>

  <div id="rating-expanded" class="absolute inset-0 bg-slate-700 flex items-center justify-center gap-0.5 md:gap-1 opacity-0 pointer-events-none transition-opacity duration-300">
    {[1, 2, 3, 4, 5].map((num) => (
      <svg data-value={num} class="star-icon w-5 h-5 md:w-6 md:h-6 text-slate-400 hover:text-orange-400 hover:scale-110 cursor-pointer transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>
    ))}
  </div>

</div>

<style>
  #rating-widget[data-state="closed"] { width: 95px; }
  #rating-widget[data-state="expanded"] { width: 150px; }
  @media (min-width: 768px) {
    #rating-widget[data-state="closed"] { width: 110px; }
    #rating-widget[data-state="expanded"] { width: 170px; }
  }
</style>

<script is:inline define:vars={{ slug }}>
  document.addEventListener('DOMContentLoaded', () => {
    const widget = document.getElementById('rating-widget');
    const closedState = document.getElementById('rating-closed');
    const expandedState = document.getElementById('rating-expanded');
    const avgDisplay = document.getElementById('avg-display');
    const votaText = document.getElementById('btn-text-vota');
    const stars = document.querySelectorAll('.star-icon');
    let hasVoted = false;

    // Caricamento Voti
    fetch(`/api/vote?slug=${slug}`)
      .then(res => res.json())
      .then(data => {
        if (data.count > 0) {
          avgDisplay.innerText = data.average;
        } else {
          avgDisplay.innerText = "0";
        }
      }).catch(() => avgDisplay.innerText = "0");

    // Espandi Pillola
    widget.addEventListener('click', (e) => {
      if(hasVoted) return;
      e.stopPropagation();
      widget.setAttribute('data-state', 'expanded');
      closedState.classList.add('opacity-0', 'pointer-events-none');
      expandedState.classList.remove('opacity-0', 'pointer-events-none');
      widget.classList.add('ring-1', 'ring-orange-400');
    });

    // Chiudi Pillola
    document.addEventListener('click', (e) => {
      if(!widget.contains(e.target) && widget.getAttribute('data-state') === 'expanded') {
        closeWidget();
      }
    });

    function closeWidget() {
      widget.setAttribute('data-state', 'closed');
      expandedState.classList.add('opacity-0', 'pointer-events-none');
      closedState.classList.remove('opacity-0', 'pointer-events-none');
      widget.classList.remove('ring-1', 'ring-orange-400');
    }

    // Logica Stelle
    stars.forEach(star => {
      star.addEventListener('mouseenter', () => {
        const val = star.getAttribute('data-value');
        stars.forEach(s => {
          if(s.getAttribute('data-value') <= val) {
            s.setAttribute('fill', 'currentColor');
            s.classList.replace('text-slate-400', 'text-orange-400');
          } else {
            s.setAttribute('fill', 'none');
            s.classList.replace('text-orange-400', 'text-slate-400');
          }
        });
      });

      star.addEventListener('mouseleave', () => {
        stars.forEach(s => {
          s.setAttribute('fill', 'none');
          s.classList.replace('text-orange-400', 'text-slate-400');
        });
      });

      // Vota
      star.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (hasVoted) return;
        
        const rating = star.getAttribute('data-value');
        hasVoted = true;
        
        stars.forEach(s => {
          if(s.getAttribute('data-value') <= rating) {
            s.setAttribute('fill', 'currentColor');
            s.classList.replace('text-slate-400', 'text-orange-400');
          }
        });
        
        avgDisplay.innerText = "...";
        setTimeout(() => closeWidget(), 400);

        try {
          const response = await fetch('/api/vote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, rating: parseInt(rating) })
          });
          const data = await response.json();
          if (data.success) {
            avgDisplay.innerText = data.average;
            votaText.innerText = "✓";
            votaText.classList.replace('text-orange-400', 'text-green-400');
          }
        } catch (err) {
           avgDisplay.innerText = "Err";
        }
      });
    });
  });
</script>