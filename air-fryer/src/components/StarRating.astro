---
const { slug, title } = Astro.props;
---

<div class="flex flex-col items-center gap-2 my-6 p-4 bg-slate-900/40 rounded-2xl border border-slate-800" id="rating-container">
  <p class="text-xs text-slate-400 uppercase tracking-widest font-semibold">Valuta questa ricetta</p>
  
  <div class="flex gap-1" id="star-wrapper">
    {[1, 2, 3, 4, 5].map((num) => (
      <button 
  class="star-btn text-3xl transition-all duration-200 hover:scale-125 focus:outline-none text-slate-500" 
  data-value={num}
  aria-label={`Vota ${num} stelle`}
>
  ★
</button>
    ))}
  </div>

  <div class="text-sm text-slate-500">
    <span id="avg-display">Nessun voto</span> 
    <span id="count-display" class="ml-1"></span>
  </div>
</div>

<script is:inline define:vars={{ slug, title }}>
  const stars = document.querySelectorAll('.star-btn');
  const avgDisplay = document.getElementById('avg-display');
  const countDisplay = document.getElementById('count-display');
  let hasVoted = false;

  // 1. CARICAMENTO VOTI ALL'AVVIO
  fetch(`/api/vote?slug=${slug}`)
    .then(res => res.json())
    .then(data => {
      if (data.count > 0) {
        // Aggiorna l'interfaccia
        avgDisplay.innerText = data.average;
        countDisplay.innerText = `(${data.count} voti)`;
        highlightStars(Math.round(data.average));

        // Inserisce i dati SEO per Google (Rich Snippet)
        const schema = {
          "@context": "https://schema.org/",
          "@type": "Recipe",
          "name": title,
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": data.average,
            "reviewCount": data.count,
            "bestRating": "5",
            "worstRating": "1"
          }
        };
        const script = document.createElement('script');
        script.type = 'application/ld+json';
        script.text = JSON.stringify(schema);
        document.head.appendChild(script);
      }
    })
    .catch(err => console.error("Errore caricamento voti", err));

  // 2. GESTIONE DEL CLIC PER VOTARE
  stars.forEach(star => {
    star.addEventListener('click', async () => {
      if (hasVoted) return;
      
      const rating = star.getAttribute('data-value');
      highlightStars(rating);
      hasVoted = true;

      try {
        const response = await fetch('/api/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, rating: parseInt(rating) })
        });

        const data = await response.json();
        if (data.success) {
          avgDisplay.innerText = data.average;
          countDisplay.innerText = `(${data.count} voti)`;
        }
      } catch (err) {}
    });

    star.addEventListener('mouseenter', () => {
      if (!hasVoted) highlightStars(star.getAttribute('data-value'));
    });
  });

  function highlightStars(val) {
  stars.forEach(s => {
    const sVal = s.getAttribute('data-value');
    // Se la stella è minore o uguale al valore, diventa gialla
    s.classList.toggle('text-yellow-400', sVal <= val);
    // Se è maggiore, torna al grigio chiaro (invece del 700 che non vedi)
    s.classList.toggle('text-slate-500', sVal > val); 
  });
}
</script>