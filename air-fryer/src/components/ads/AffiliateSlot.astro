---
import { affiliateTranslations } from '../../data/i18n/affiliate-data';

export interface Props {
  lang?: 'it' | 'en' | 'es' | 'fr';
  context: string;
}

const { lang = 'it', context } = Astro.props;

const dict = affiliateTranslations[lang] || affiliateTranslations['it'];
const data = dict[context];

if (!data || !data.products || data.products.length === 0) {
  // Se non ci sono prodotti per il contesto o la lingua, non mostriamo l'area sponsorizzata
  return;
}
---

<aside aria-label={data.uiTitle} class="my-12 bg-gradient-to-br from-indigo-50 to-blue-50 dark:from-gray-800 dark:to-gray-800 border-2 border-indigo-100 dark:border-gray-700 rounded-2xl overflow-hidden shadow-sm">
  
  <div class="px-5 py-3 border-b border-indigo-100/50 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white/60 dark:bg-gray-900/40">
    <h3 class="text-lg sm:text-xl font-extrabold text-gray-900 dark:text-white flex items-center gap-2">
      <svg class="w-5 h-5 text-amber-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
      {data.uiTitle}
    </h3>
    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-gray-200/80 dark:bg-gray-700 text-gray-600 dark:text-gray-300 uppercase tracking-widest">
      {data.uiSponsoredText}
    </span>
  </div>

  <div class="p-5 sm:p-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      {data.products.map((product) => (
        <a 
          href={product.link} 
          target="_blank" 
          rel="sponsored nofollow noopener" 
          class="group flex flex-col items-center text-center p-5 bg-white dark:bg-gray-750 rounded-xl hover:shadow-md hover:-translate-y-1 transition-all duration-300 border border-transparent hover:border-indigo-200 dark:hover:border-indigo-800"
        >
          {product.svgIcon && (
            <div 
              class="w-14 h-14 rounded-full bg-indigo-100 dark:bg-indigo-900/40 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white dark:group-hover:bg-indigo-500 transition-all duration-300" 
              set:html={product.svgIcon} 
            />
          )}
          <h4 class="text-base font-bold text-gray-900 dark:text-white mb-2 leading-tight group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">
            {product.title}
          </h4>
          <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-3">
            {product.copy}
          </p>
          <div class="mt-4 pt-3 w-full border-t border-gray-100 dark:border-gray-700/50 flex justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
             <span class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 uppercase tracking-wider">Scopri l'offerta &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
  
</aside>
