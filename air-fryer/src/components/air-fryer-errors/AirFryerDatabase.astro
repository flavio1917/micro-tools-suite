---
import type { AirFryerModel } from '../../types/air-fryer';
import { getBrands } from '../../lib/air-fryer-db';
import DiagnosticSearch from './DiagnosticSearch.astro';
import DiagnosticDisclaimer from './DiagnosticDisclaimer.astro';
import AirFryerModelCard from './AirFryerModelCard.astro';
import BrandErrorOverview from './BrandErrorOverview.astro';
import GenericAirFryerGuidance from './GenericAirFryerGuidance.astro';
import MissingModelForm from './MissingModelForm.astro';

import { errorsUiTranslations } from '../../data/i18n/errors-ui';
import { getSearchIndex } from '../../lib/air-fryer-search-index';

export interface Props {
  models: AirFryerModel[];
  lang: 'it' | 'en' | 'es' | 'fr';
}

const { models, lang } = Astro.props;
const brands = getBrands();
const t = errorsUiTranslations[lang] || errorsUiTranslations.it;
const searchIndex = getSearchIndex(lang);

---
<div class="af-database-container" aria-live="polite" 
  data-search-index={JSON.stringify(searchIndex)}
  data-msg-ambiguous={t.statusMessages?.ambiguous}
  data-msg-model-not-found={t.statusMessages?.modelNotFound}
  data-msg-brand-selected={t.statusMessages?.brandSelected}
  data-msg-brand-not-found={t.statusMessages?.brandNotFound}
  data-msg-generic-guidance={t.statusMessages?.genericGuidance}
  data-msg-empty-search={t.statusMessages?.emptySearch}
>
  <DiagnosticDisclaimer lang={lang} />
  <DiagnosticSearch lang={lang} />

  {/* Dynamic Status Message */}
  <div id="af-status-message" class="mb-8 text-center p-6 sm:p-8 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm transition-all duration-300">
    <p class="text-lg font-medium text-slate-700 dark:text-slate-300" id="af-status-text">
      {t.statusMessages?.initial}
    </p>
  </div>

  <div id="af-results-container" class="hidden space-y-6">
    
    {/* State A: Specific Models */}
    <div id="state-a" class="hidden">
      {models.map(model => (
        <div class="af-model-view hidden" data-model-id={model.id}>
          <AirFryerModelCard model={model} />
        </div>
      ))}
    </div>

    {/* State B: Brand Overview (Marca selected, No model) */}
    <div id="state-b" class="hidden">
      {brands.map(brand => {
        const brandModels = models.filter(m => m.brand === brand);
        return (
          <div class="af-brand-view hidden" data-brand={brand}>
            <BrandErrorOverview brand={brand} brandModels={brandModels} isUnlisted={false} />
          </div>
        );
      })}
    </div>

    {/* State C: Brand Overview Unlisted (Marca selected, Model unlisted) */}
    <div id="state-c" class="hidden">
      {brands.map(brand => {
        const brandModels = models.filter(m => m.brand === brand);
        return (
          <div class="af-brand-unlisted-view hidden" data-brand={brand}>
            <BrandErrorOverview brand={brand} brandModels={brandModels} isUnlisted={true} />
          </div>
        );
      })}
    </div>

    {/* State D: Generic Guidance */}
    <div id="state-d" class="hidden">
      <GenericAirFryerGuidance />
    </div>

    {/* State E: Ambiguous Variant View */}
    <div id="state-e" class="hidden">
      <div id="af-ambiguous-variant-view" class="bg-white dark:bg-slate-900 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-800 p-6 sm:p-8 mb-6">
        <div class="flex flex-col sm:flex-row gap-6 items-start">
           <div id="af-ambiguous-img-container" class="w-24 h-24 sm:w-32 sm:h-32 shrink-0 bg-slate-50 dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 flex items-center justify-center p-4">
              <!-- img -->
           </div>
           <div class="flex-1 space-y-4">
              <div class="text-sm font-bold text-blue-600 dark:text-blue-400 tracking-wider uppercase" id="af-ambiguous-brand"></div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white" id="af-ambiguous-title"></h2>
              <p class="text-slate-500 dark:text-slate-400 font-medium font-mono text-sm" id="af-ambiguous-spec"></p>
              
              <div class="bg-orange-50 dark:bg-orange-900/20 text-orange-800 dark:text-orange-200 p-4 rounded-xl text-sm leading-relaxed border border-orange-200 dark:border-orange-800/50 mt-4">
                 Informazioni disponibili per una o più varianti di questo modello. Verifica il codice completo sull'etichetta del prodotto o nel manuale prima di seguire le istruzioni.
              </div>
           </div>
        </div>
      </div>
    </div>

  </div>
  
  <MissingModelForm lang={lang} />
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const statusMessageContainer = document.getElementById('af-status-message');
    const statusText = document.getElementById('af-status-text');
    const resultsContainer = document.getElementById('af-results-container');
    
    const stateA = document.getElementById('state-a');
    const stateB = document.getElementById('state-b');
    const stateC = document.getElementById('state-c');
    const stateD = document.getElementById('state-d');

    // Helper: Hide all views
    function hideAllViews() {
      const allViews = document.querySelectorAll('.af-model-view, .af-brand-view, .af-brand-unlisted-view');
      allViews.forEach(v => v.classList.add('hidden'));
      [stateA, stateB, stateC, stateD].forEach(s => s?.classList.add('hidden'));
    }

    // Apply the active state based on URL
    async function applyState() {
      const params = new URLSearchParams(window.location.search);
      const dataEl = document.querySelector('.af-database-container');
      const searchIndex = dataEl?.getAttribute('data-search-index') ? JSON.parse(dataEl.getAttribute('data-search-index')!) : [];
      
      const { validateDiagnosticParams } = await import('../../lib/air-fryer-query-validation');
      const { toSafeAnchorId } = await import('../../lib/air-fryer-anchor');
      const { serializeMissingModelContext, parseMissingModelContext } = await import('../../lib/missing-model-context');
      const { trackEvent } = await import('../../lib/analytics');
      
      const state = validateDiagnosticParams(params, searchIndex);
      const { brand, model, code, symptom, reviewModel } = state;
        
      hideAllViews();
      resultsContainer?.classList.remove('hidden');

      const msgAmbiguous = dataEl?.getAttribute('data-msg-ambiguous') || '';
      const msgModelNotFound = dataEl?.getAttribute('data-msg-model-not-found') || '';
      const msgBrandSelected = dataEl?.getAttribute('data-msg-brand-selected') || '';
      const msgBrandNotFound = dataEl?.getAttribute('data-msg-brand-not-found') || '';
      const msgGenericGuidance = dataEl?.getAttribute('data-msg-generic-guidance') || '';
      const msgEmptySearch = dataEl?.getAttribute('data-msg-empty-search') || '';

        if (reviewModel) {
          // STATE Ambiguous
          statusMessageContainer?.classList.remove('hidden');
          if (statusText) statusText.textContent = msgAmbiguous;
          if (statusText) statusText.classList.add('text-orange-600', 'dark:text-orange-400');
          else if (statusText) statusText.classList.remove('text-orange-600', 'dark:text-orange-400');

          const variantSlug = params.get('variant');
          const stateE = document.getElementById('state-e');
          if (stateE && searchIndex.length > 0) {
            const item = searchIndex.find((i: any) => i.canonical_slug === reviewModel && (!variantSlug || i.variant_slug === variantSlug));
            if (item) {
              stateE.classList.remove('hidden');
              const title = stateE.querySelector('#af-ambiguous-title');
              const spec = stateE.querySelector('#af-ambiguous-spec');
              const brandEl = stateE.querySelector('#af-ambiguous-brand');
              const imgContainer = stateE.querySelector('#af-ambiguous-img-container');
              
              if (title) title.textContent = item.primary_display_name;
              if (spec) spec.textContent = `Codice Tecnico: ${item.model_spec}`;
              if (brandEl) brandEl.textContent = item.brand_display_name;
              
              if (imgContainer) {
                imgContainer.innerHTML = '';
                if (item.image_path) {
                  const img = document.createElement('img');
                  img.src = item.image_path;
                  img.className = "w-full h-full object-contain mix-blend-multiply dark:mix-blend-normal";
                  imgContainer.appendChild(img);
                } else {
                  imgContainer.innerHTML = `<svg class="w-12 h-12 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>`;
                }
              }
            }
          }

          if (code || symptom) {
            stateD?.classList.remove('hidden');
          } else if (brand) {
            stateB?.classList.remove('hidden');
            const view = document.querySelector(`.af-brand-view[data-brand="${brand}"]`);
            if (view) view.classList.remove('hidden');
          }
        } else if (model) {
          if (statusText) statusText.classList.remove('text-orange-600', 'dark:text-orange-400');
          // STATE A: Specific Model
          statusMessageContainer?.classList.add('hidden');
          stateA?.classList.remove('hidden');
          const view = document.querySelector(`.af-model-view[data-model-id="${model}"]`);
          if (view) {
             view.classList.remove('hidden');
             
             // Open details and Scroll to fragment
             const details = view.querySelector('details');
             if (details) details.open = true;
             
             // Fire analytics for visible cards (with dedup guard in listener)
             setTimeout(() => {
               window.dispatchEvent(new CustomEvent('diagnostic-analytics-update', { detail: { container: view } }));
             }, 150);
             
             if (code || symptom) {
               setTimeout(() => {
                 const targetId = code ? toSafeAnchorId('error', code) : (symptom ? toSafeAnchorId('symptom', symptom) : null);
                 if (targetId) {
                   const targetEl = document.getElementById(targetId);
                   if (targetEl) {
                     targetEl.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
                     targetEl.classList.add('ring-4', 'ring-blue-500', 'ring-opacity-50');
                     setTimeout(() => targetEl.classList.remove('ring-4', 'ring-blue-500', 'ring-opacity-50'), 2000);
                   }
                 }
               }, 100);
             }
          } else {
             statusMessageContainer?.classList.remove('hidden');
             if (statusText) statusText.textContent = msgModelNotFound;
             stateD?.classList.remove('hidden');
          }

          
        } else if (brand) {
          if (statusText) statusText.classList.remove('text-orange-600', 'dark:text-orange-400');
          
          if (brand === 'other') {
            statusMessageContainer?.classList.add('hidden');
            stateD?.classList.remove('hidden');
          } else {
            // STATE B: Brand Overview
            if (statusText) statusText.textContent = msgBrandSelected.replace('{brand}', brand.toUpperCase());
            statusMessageContainer?.classList.remove('hidden');
            stateB?.classList.remove('hidden');
            const view = document.querySelector(`.af-brand-view[data-brand="${brand}"]`);
            if (view) {
               view.classList.remove('hidden');
            } else {
               if (statusText) statusText.textContent = msgBrandNotFound;
               stateD?.classList.remove('hidden');
            }
          }
          
        } else if (code || symptom) {
          if (statusText) statusText.classList.remove('text-orange-600', 'dark:text-orange-400');
          // STATE D: Code/Symptom without model (Generic Guidance)
          if (statusText) statusText.textContent = msgGenericGuidance;
          statusMessageContainer?.classList.remove('hidden');
          stateD?.classList.remove('hidden');
          
        } else {
          if (statusText) statusText.classList.remove('text-orange-600', 'dark:text-orange-400');
          // Default / Empty State
          if (statusText) statusText.textContent = msgEmptySearch;
          statusMessageContainer?.classList.remove('hidden');
          resultsContainer?.classList.add('hidden');
        }
        
        // Prefill Form logic
        const formContainer = document.getElementById('missing-model-form-container');
        if (formContainer) {
          const rawParams = new URLSearchParams(window.location.search);
          const rawBrand = rawParams.get('brand');
          const rawModel = rawParams.get('model');
          const rawCode = rawParams.get('code');
          const rawSymptom = rawParams.get('symptom');
          const rawReviewModel = rawParams.get('review-model');
          const originalQuery = rawParams.get('q');
          
          let showForm = false;
          let reason = '';
          
          if (rawReviewModel && reviewModel) {
             showForm = true;
             reason = 'ambiguous_variant';
          } else if (rawModel && !model) {
             showForm = true;
             reason = 'missing_model';
          } else if (rawBrand === 'other') {
             showForm = true;
             reason = 'other_brand';
          } else if (rawCode && !code) {
             showForm = true;
             reason = 'missing_code';
          } else if (rawSymptom && !symptom) {
             showForm = true;
             reason = 'missing_symptom';
          }
          
          if (showForm) {
            const wasHidden = formContainer.classList.contains('hidden');
            formContainer.classList.remove('hidden');
            
            // Track form opened only when newly shown
            if (wasHidden) {
              trackEvent('air_fryer_missing_model_form_opened', {
                lang: window.location.pathname.split('/')[1] || 'it',
                reason,
                brand_present: !!(rawParams.get('brand') || brand),
                model_present: !!rawModel,
                code_present: !!rawCode,
                symptom_present: !!rawSymptom
              });
            }
            
            const context = {
              lang: window.location.pathname.split('/')[1] || 'it',
              reason: reason,
              original_query: originalQuery?.substring(0, 100) || '',
              brand: (rawParams.get('brand') || brand)?.substring(0, 50) || '',
              model: (rawModel || rawReviewModel || model || '')?.substring(0, 100),
              error_code: (rawCode || code || '')?.substring(0, 10),
              symptom_key: (rawSymptom || symptom)?.substring(0, 50) || ''
            };
            
            const serialized = serializeMissingModelContext(context);
            const parsed = parseMissingModelContext(new URLSearchParams(serialized));
            
            const reasonInput = document.getElementById('mmf-reason') as HTMLInputElement;
            const originalQueryInput = document.getElementById('mmf-original-query') as HTMLInputElement;
            const symptomKeyInput = document.getElementById('mmf-symptom-key') as HTMLInputElement;
            const brandInput = document.getElementById('mmf-brand') as HTMLInputElement;
            const modelInput = document.getElementById('mmf-model') as HTMLInputElement;
            const codeInput = document.getElementById('mmf-code') as HTMLInputElement;
            
            if (reasonInput && parsed.reason) reasonInput.value = parsed.reason;
            if (originalQueryInput && parsed.original_query) originalQueryInput.value = parsed.original_query;
            if (symptomKeyInput && parsed.symptom_key) symptomKeyInput.value = parsed.symptom_key;
            if (brandInput && parsed.brand) brandInput.value = parsed.brand;
            if (modelInput && parsed.model) modelInput.value = parsed.model;
            if (codeInput && parsed.error_code) codeInput.value = parsed.error_code;
            
          } else {
            formContainer.classList.add('hidden');
          }
        }
    }

    // Event Listeners for state changes
    window.addEventListener('popstate', () => {
      applyState();
    });

    window.addEventListener('diagnostic-search-update', () => {
      applyState();
    });

    // Initial load
    applyState();
    
    // Checklist Logic
    import('../../lib/air-fryer-local-storage').then(({ getChecklistKey, saveChecklistState, loadChecklistState }) => {
      const checklists = document.querySelectorAll('.af-checklist');
      checklists.forEach(list => {
        const lang = list.getAttribute('data-lang') || 'it';
        const scope = list.getAttribute('data-scope') || 'univ';
        const record = list.getAttribute('data-record') || 'unknown';
        const key = getChecklistKey(lang, scope, record);
        
        const checkboxes = list.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
        if (checkboxes.length === 0) return;
        
        // Load state
        const saved = loadChecklistState(key);
        if (saved && saved.length === checkboxes.length) {
          checkboxes.forEach((cb, i) => {
            cb.checked = saved[i];
          });
        }
        
        // Save state on change
        list.addEventListener('change', () => {
          const states = Array.from(checkboxes).map(cb => cb.checked);
          saveChecklistState(key, states);
        });
      });
    });
    
    // Form submit analytics
    import('../../lib/analytics').then(({ trackEvent }) => {
      const form = document.getElementById('missing-model-form') as HTMLFormElement | null;
      if (form) {
        form.addEventListener('submit', () => {
          const reasonEl = document.getElementById('mmf-reason') as HTMLInputElement | null;
          const pathLang = window.location.pathname.split('/')[1] || 'it';
          trackEvent('air_fryer_missing_model_form_submitted', {
            lang: pathLang,
            reason: reasonEl?.value || 'unknown',
            brand_present: !!(document.getElementById('mmf-brand') as HTMLInputElement)?.value,
            model_present: !!(document.getElementById('mmf-model') as HTMLInputElement)?.value,
            code_present: !!(document.getElementById('mmf-code') as HTMLInputElement)?.value
          });
        });
      }
    });

    // M-1 Analytics: error_code_opened, symptom_opened, manual_opened
    // Guard: track each code/symptom only once per page session to prevent duplicates
    import('../../lib/analytics').then(({ trackEvent }) => {
      const firedCodes = new Set<string>();
      const firedSymptoms = new Set<string>();
      const pathLang = window.location.pathname.split('/')[1] || 'it';

      // Called by applyState after a model view is made visible
      function trackVisibleCards(container: Element) {
        // Error codes
        container.querySelectorAll<HTMLElement>('[data-analytics-code]').forEach(el => {
          const code = el.dataset.analyticsCode;
          if (!code || firedCodes.has(code)) return;
          firedCodes.add(code);
          trackEvent('air_fryer_error_code_opened', {
            lang: pathLang,
            error_code: code,
            severity: (el.dataset.analyticsSeverity as any) || undefined,
            evidence_level: (el.dataset.analyticsEvidence as any) || undefined,
            brand: el.dataset.analyticsBrand || undefined
          });
        });

        // Symptoms
        container.querySelectorAll<HTMLElement>('[data-analytics-symptom]').forEach(el => {
          const sym = el.dataset.analyticsSymptom;
          if (!sym || firedSymptoms.has(sym)) return;
          firedSymptoms.add(sym);
          trackEvent('air_fryer_symptom_opened', {
            lang: pathLang,
            symptom_key: sym,
            severity: (el.dataset.analyticsSeverity as any) || undefined,
            evidence_level: (el.dataset.analyticsEvidence as any) || undefined,
            brand: el.dataset.analyticsBrand || undefined
          });
        });
      }

      // Listen for state updates to track visible cards
      window.addEventListener('diagnostic-analytics-update', (e: Event) => {
        const container = (e as CustomEvent).detail?.container;
        if (container) trackVisibleCards(container);
      });

      // Manual click delegation — fires only on explicit click, no URL sent
      document.addEventListener('click', (e: MouseEvent) => {
        const link = (e.target as Element).closest('[data-analytics-manual]') as HTMLElement | null;
        if (!link) return;
        trackEvent('air_fryer_manual_opened', {
          lang: pathLang,
          source_type: (link.dataset.analyticsSourceType as any) || 'manual'
        });
      });

      // Expose hook for applyState to call
      (window as any).__afTrackVisibleCards = trackVisibleCards;
    });
  });
</script>
