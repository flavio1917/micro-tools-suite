---
import type { AirFryerModel } from '../../../types/air-fryer';
import { getBrands } from '../../../lib/air-fryer-db';
import AirFryerFilters from './AirFryerFilters.astro';
import AirFryerModelCard from './AirFryerModelCard.astro';
import BrandErrorOverview from './BrandErrorOverview.astro';
import GenericAirFryerGuidance from './GenericAirFryerGuidance.astro';

export interface Props {
  models: AirFryerModel[];
}

const { models } = Astro.props;
const brands = getBrands();

---
<div class="af-database-container" aria-live="polite">
  <AirFryerFilters brands={brands} models={models} />

  {/* Dynamic Status Message */}
  <div id="af-status-message" class="mb-8 text-center p-6 sm:p-8 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm transition-all duration-300">
    <p class="text-lg font-medium text-slate-700 dark:text-slate-300" id="af-status-text">
      Scegli una marca per vedere i modelli disponibili oppure seleziona 'Altro' per la guida generica.
    </p>
  </div>

  <div id="af-results-container" class="hidden space-y-6">
    
    {/* State A: Specific Models */}
    <div id="state-a" class="hidden">
      {models.map(model => (
        <div class="af-model-view hidden" data-model-id={model.id}>
          <AirFryerModelCard model={model} />
        </div>
      ))}
    </div>

    {/* State B: Brand Overview (Marca selected, No model) */}
    <div id="state-b" class="hidden">
      {brands.map(brand => {
        const brandModels = models.filter(m => m.brand === brand);
        return (
          <div class="af-brand-view hidden" data-brand={brand}>
            <BrandErrorOverview brand={brand} brandModels={brandModels} isUnlisted={false} />
          </div>
        );
      })}
    </div>

    {/* State C: Brand Overview Unlisted (Marca selected, Model unlisted) */}
    <div id="state-c" class="hidden">
      {brands.map(brand => {
        const brandModels = models.filter(m => m.brand === brand);
        return (
          <div class="af-brand-unlisted-view hidden" data-brand={brand}>
            <BrandErrorOverview brand={brand} brandModels={brandModels} isUnlisted={true} />
          </div>
        );
      })}
    </div>

    {/* State D: Generic Guidance */}
    <div id="state-d" class="hidden">
      <GenericAirFryerGuidance />
    </div>

  </div>
</div>

<script>
  import { normalizeString, parseFiltersFromUrl, writeFiltersToUrl } from '../../../lib/air-fryer-filters';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('af-filters-form') as HTMLFormElement;
    const brandSelect = document.getElementById('af-brand') as HTMLSelectElement;
    const modelSelect = document.getElementById('af-model') as HTMLSelectElement;
    const searchInput = document.getElementById('af-search') as HTMLInputElement;
    const unlistedOpt = document.getElementById('af-unlisted-opt') as HTMLOptionElement;
    
    const statusMessageContainer = document.getElementById('af-status-message');
    const statusText = document.getElementById('af-status-text');
    const resultsContainer = document.getElementById('af-results-container');
    
    const stateA = document.getElementById('state-a');
    const stateB = document.getElementById('state-b');
    const stateC = document.getElementById('state-c');
    const stateD = document.getElementById('state-d');

    if (!form || !brandSelect || !modelSelect) return;

    // Helper: Hide all views
    function hideAllViews() {
      const allViews = document.querySelectorAll('.af-model-view, .af-brand-view, .af-brand-unlisted-view');
      allViews.forEach(v => v.classList.add('hidden'));
      [stateA, stateB, stateC, stateD].forEach(s => s?.classList.add('hidden'));
    }

    // Handle Brand Change: Update Model Select options
    function updateModelSelectOptions() {
      const selectedBrand = brandSelect.value;
      const optgroups = modelSelect.querySelectorAll('optgroup');
      
      // Hide all optgroups
      optgroups.forEach(group => group.classList.add('hidden'));
      
      if (!selectedBrand || selectedBrand === 'altro') {
        modelSelect.disabled = true;
        modelSelect.value = "";
        unlistedOpt.classList.add('hidden');
      } else {
        modelSelect.disabled = false;
        unlistedOpt.classList.remove('hidden');
        
        // Show relevant optgroup
        const targetGroup = modelSelect.querySelector(`optgroup[data-brand="${selectedBrand}"]`);
        if (targetGroup) {
          targetGroup.classList.remove('hidden');
        }
        
        // If current selected model doesn't belong to this brand, reset it
        const currentModelOpt = modelSelect.options[modelSelect.selectedIndex];
        if (currentModelOpt.value !== "" && currentModelOpt.value !== "unlisted" && currentModelOpt.parentElement?.getAttribute('data-brand') !== selectedBrand) {
          modelSelect.value = "";
        }
      }
    }

    // Apply the active state and filter
    function applyState(fromSubmit = false) {
      const brand = brandSelect.value;
      const model = modelSelect.value;
      const query = normalizeString(searchInput.value);

      hideAllViews();
      resultsContainer?.classList.remove('hidden');

      if (!brand) {
        // No selection
        if (statusText) statusText.textContent = "Scegli una marca per vedere i modelli disponibili oppure seleziona 'Altro' per la guida generica.";
        statusMessageContainer?.classList.remove('hidden');
        resultsContainer?.classList.add('hidden');
        
      } else if (brand === 'altro') {
        // STATE D
        if (statusText) statusText.textContent = "Usa questa guida per controlli iniziali sicuri. I codici non hanno significato universale tra marche diverse.";
        statusMessageContainer?.classList.remove('hidden');
        stateD?.classList.remove('hidden');
        
      } else if (brand && !model) {
        // STATE B
        if (statusText) statusText.textContent = `Hai selezionato ${brand}. Puoi scegliere un modello oppure consultare i messaggi documentati per gli altri modelli del brand.`;
        statusMessageContainer?.classList.remove('hidden');
        stateB?.classList.remove('hidden');
        const view = document.querySelector(`.af-brand-view[data-brand="${brand}"]`);
        if (view) view.classList.remove('hidden');
        
      } else if (brand && model === 'unlisted') {
        // STATE C
        if (statusText) statusText.textContent = `Il modello non è ancora censito: consulta i messaggi documentati per altri modelli ${brand}, verificando sempre il manuale della tua variante.`;
        statusMessageContainer?.classList.remove('hidden');
        stateC?.classList.remove('hidden');
        const view = document.querySelector(`.af-brand-unlisted-view[data-brand="${brand}"]`);
        if (view) view.classList.remove('hidden');
        
      } else if (brand && model && model !== 'unlisted') {
        // STATE A
        statusMessageContainer?.classList.add('hidden'); // Hide instructional message when model is selected
        stateA?.classList.remove('hidden');
        const view = document.querySelector(`.af-model-view[data-model-id="${model}"]`);
        if (view) view.classList.remove('hidden');
      }

      // Handle query filtering on the active view
      if (query && resultsContainer && !resultsContainer.classList.contains('hidden')) {
        // Find visible code cards in the current active state and filter them
        const activeContainer = stateA?.classList.contains('hidden') === false ? stateA :
                                stateB?.classList.contains('hidden') === false ? stateB :
                                stateC?.classList.contains('hidden') === false ? stateC : null;
                                
        if (activeContainer) {
           // We only filter ErrorCodeCards. We use CSS to hide/show them.
           // To avoid complex JS, we can just hide cards that don't match the query.
           // But since ErrorCodeCard doesn't have a data-search-text by default, let's just search its textContent.
           const codeCards = activeContainer.querySelectorAll('[id^="code-"], .mb-6.rounded-lg.border');
           codeCards.forEach(card => {
             // Basic text search on the card's content
             const text = normalizeString((card.textContent || ''));
             if (text.includes(query)) {
               card.classList.remove('hidden');
             } else {
               card.classList.add('hidden');
             }
           });
        }
      } else {
        // Reset all hidden cards if query is empty
        const codeCards = document.querySelectorAll('#af-results-container .mb-6.rounded-lg.border');
        codeCards.forEach(card => card.classList.remove('hidden'));
      }
      
      // Update URL only if it was a submit or we have a valid state
      if (fromSubmit) {
         const url = new URL(window.location.href);
         if (brand) url.searchParams.set('brand', brand); else url.searchParams.delete('brand');
         if (model) url.searchParams.set('model', model); else url.searchParams.delete('model');
         if (searchInput.value) url.searchParams.set('q', searchInput.value); else url.searchParams.delete('q');
         window.history.replaceState({}, '', url.toString());
      }
    }

    // Event Listeners
    brandSelect.addEventListener('change', () => {
      updateModelSelectOptions();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      applyState(true);
    });

    // Initialize from URL
    const params = new URLSearchParams(window.location.search);
    if (params.has('brand')) {
      brandSelect.value = params.get('brand') || '';
      updateModelSelectOptions();
    }
    if (params.has('model')) {
      modelSelect.value = params.get('model') || '';
    }
    if (params.has('q')) {
      searchInput.value = params.get('q') || '';
    }
    
    // Apply initial state based on URL, if parameters exist. Otherwise show initial message.
    if (params.has('brand') || params.has('model') || params.has('q')) {
      applyState(false);
    }
  });
</script>
