---
import type { AirFryerModel } from '../../../types/air-fryer';

export interface Props {
  brands: string[];
  models: AirFryerModel[];
}

const { brands, models } = Astro.props;
---
<form id="af-filters-form" class="bg-white dark:bg-[#151b2b] p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm mb-8">
  
  <div class="grid grid-cols-1 md:grid-cols-12 gap-5 mb-6">
    
    {/* Brand Select */}
    <div class="md:col-span-4">
      <label for="af-brand" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Marca</label>
      <div class="relative">
        <select 
          id="af-brand" 
          name="brand"
          class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-shadow font-medium appearance-none cursor-pointer pr-10"
        >
          <option value="" disabled selected>Seleziona la marca</option>
          {brands.map(b => (
            <option value={b}>{b}</option>
          ))}
          <option value="altro">Altro / marca non in elenco</option>
        </select>
        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

    {/* Model Select */}
    <div class="md:col-span-4">
      <label for="af-model" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Modello</label>
      <div class="relative">
        <select 
          id="af-model" 
          name="model"
          disabled
          class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-shadow font-medium appearance-none cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed pr-10"
        >
          <option value="" disabled selected>Seleziona il modello (facoltativo)</option>
          {brands.map(brand => {
            const brandModels = models.filter(m => m.brand === brand);
            return (
              <optgroup label={brand} data-brand={brand} class="hidden">
                {brandModels.map(m => (
                  <option value={m.id}>{m.actual_model} {m.user_label && m.user_label !== m.actual_model ? `(${m.user_label})` : ''}</option>
                ))}
              </optgroup>
            );
          })}
          <option value="unlisted" id="af-unlisted-opt" class="hidden font-bold">Il mio modello non è in elenco</option>
        </select>
        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-slate-500">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
        </div>
      </div>
    </div>

    {/* Code/Message Input */}
    <div class="md:col-span-4">
      <label for="af-search" class="block text-sm font-bold text-slate-700 dark:text-slate-300 mb-2">Codice o messaggio sul display</label>
      <div class="relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
           <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        </div>
        <input 
          type="text" 
          id="af-search" 
          name="q"
          placeholder="Es. E1, E3, Pot, Cool, SHAKE" 
          class="w-full pl-10 pr-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 text-slate-900 dark:text-white focus:ring-2 focus:ring-blue-500 outline-none transition-shadow font-medium"
        />
      </div>
    </div>

  </div>

  {/* Submit Button */}
  <div class="flex justify-end">
    <button 
      type="submit" 
      id="af-submit-btn"
      class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-bold transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 w-full sm:w-auto"
    >
      Mostra diagnosi
      <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
    </button>
  </div>
</form>
