---
import { errorsUiTranslations } from '../../data/i18n/errors-ui';

export interface Props {
  lang: 'it' | 'en' | 'es' | 'fr';
}

const { lang } = Astro.props;
const t = errorsUiTranslations[lang]?.disclaimer;

if (!t) {
  if (import.meta.env.DEV) {
    throw new Error(`Traduzione disclaimer mancante per la lingua: ${lang}`);
  }
  throw new Error(`Traduzione disclaimer mancante per la lingua: ${lang}`);
}
---

<div class="diagnostic-disclaimer bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-2.5 sm:p-3 mb-5">
  <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-3">
    <div class="flex items-center gap-1.5 shrink-0">
      <div class="text-amber-600 dark:text-amber-500">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <h4 class="text-xs font-bold text-amber-800 dark:text-amber-500 uppercase tracking-wider">{t.title}</h4>
    </div>
    <div class="text-[11px] sm:text-xs text-amber-800 dark:text-amber-400/90 leading-tight flex-1">
      <strong class="font-bold">{t.text2}</strong> {t.text1}
      <span class="opacity-75 italic inline sm:ml-1">{t.text3}</span>
    </div>
  </div>
</div>
