---
import { errorsUiTranslations } from '../../data/i18n/errors-ui';

export interface Props {
  lang: 'it' | 'en' | 'es' | 'fr';
}

const { lang } = Astro.props;
const t = errorsUiTranslations[lang]?.disclaimer || errorsUiTranslations.it.disclaimer;
---

<div class="diagnostic-disclaimer bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl p-4 sm:p-5 mb-8">
  <div class="flex items-start gap-3">
    <div class="shrink-0 text-amber-600 dark:text-amber-500 mt-1">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    <div class="space-y-2">
      <h4 class="text-sm sm:text-base font-bold text-amber-800 dark:text-amber-500">{t.title}</h4>
      <p class="text-xs sm:text-sm text-amber-700 dark:text-amber-400/90 leading-relaxed">
        {t.text1}
      </p>
      <p class="text-xs sm:text-sm text-amber-700 dark:text-amber-400/90 leading-relaxed font-medium">
        {t.text2}
      </p>
      <p class="text-xs sm:text-sm text-amber-700/80 dark:text-amber-400/70 leading-relaxed italic mt-3 pt-3 border-t border-amber-200/50 dark:border-amber-800/50">
        {t.text3}
      </p>
    </div>
  </div>
</div>
