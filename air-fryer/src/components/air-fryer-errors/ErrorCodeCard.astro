---
import { getLocalizedErrorContent, getUiTranslation } from '../../lib/air-fryer-error-i18n';
import SeverityBadge from './SeverityBadge.astro';
import { toSafeAnchorId } from '../../lib/air-fryer-anchor';

export interface Props {
  error: any;
  model?: any;
  lang: string;
  sourceModelName?: string;
  sourceModelSpec?: string;
  modelCanonicalSlug?: string;
  brandDisplayName?: string;
}

const { error, model, lang, brandDisplayName, sourceModelName: overrideModelName, sourceModelSpec: overrideModelSpec, modelCanonicalSlug: overrideSlug } = Astro.props;

const modelCanonicalSlug = overrideSlug || model?.canonical_slug || model?.id || '';
const loc = getLocalizedErrorContent(lang, modelCanonicalSlug, error);

const finalAnchorId = toSafeAnchorId('error', loc.code);

const sourceModelName = overrideModelName || model?.primary_display_name || model?.user_label;
const sourceModelSpec = overrideModelSpec || model?.model_spec;

const hasModelInfo = sourceModelName || sourceModelSpec;

const manualUrl = error.source?.manual_url || error.manual_url;
---

<div class="mb-6 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm overflow-hidden flex flex-col md:flex-row" id={finalAnchorId}
     data-analytics-code={loc.code}
     data-analytics-severity={loc.severity}
     data-analytics-brand={brandDisplayName || model?.brand || ''}>
     
  <!-- LEFT COLUMN -->
  <div class="w-full md:w-1/3 bg-slate-50 dark:bg-slate-800/50 p-5 border-b md:border-b-0 md:border-r border-slate-100 dark:border-slate-800 flex flex-col gap-4">
    <div class="flex items-center gap-3 flex-wrap">
      <h3 class="text-3xl font-black text-slate-900 dark:text-white tracking-tight m-0 font-mono">
        {loc.displayCode}
      </h3>
    </div>
    
    {/* Classification badge */}
    {loc.classification && (
      <div>
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-300 border-slate-200 dark:border-slate-700">
          {loc.classification}
        </span>
      </div>
    )}
    
    {/* Severity/Semaphore badge */}
    <div>
      <SeverityBadge severityLevel={loc.severity} color={loc.color} severityLabel={loc.severityLabel} lang={lang} />
    </div>

    {hasModelInfo ? (
      <div class="flex flex-col gap-1 mt-2">
        {sourceModelName && (
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider bg-white dark:bg-slate-800 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 w-max">
            {getUiTranslation(lang, 'Modello')}: {sourceModelName}
          </span>
        )}
        {sourceModelSpec && (
          <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider bg-white dark:bg-slate-800 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 w-max">
            {getUiTranslation(lang, 'Model Spec')}: {sourceModelSpec}
          </span>
        )}
      </div>
    ) : brandDisplayName ? (
      <div class="flex flex-col gap-1 mt-2">
        <span class="text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider bg-white dark:bg-slate-800 px-2 py-1 rounded border border-slate-200 dark:border-slate-700 w-max">
          {brandDisplayName}
        </span>
      </div>
    ) : null}
  </div>

  <!-- RIGHT COLUMN -->
  <div class="w-full md:w-2/3 p-5 space-y-5 flex flex-col justify-center">
    
    {/* Diagnosis — from Errori column */}
    {loc.diagnosis && (
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5 flex items-center gap-2">
          {getUiTranslation(lang, 'Diagnosi')}
          {loc.isFallbackSource && (
            <span class="inline-flex items-center text-[10px] bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300 px-2 py-0.5 rounded-full border border-amber-200 dark:border-amber-800 font-medium normal-case tracking-normal">
              {loc.originalManualBadge}
            </span>
          )}
        </h4>
        <p class="text-slate-800 dark:text-slate-200 font-medium text-sm sm:text-base whitespace-pre-line leading-relaxed">
          {loc.diagnosis}
        </p>
      </div>
    )}

    {/* User Symptom */}
    {loc.userSymptom && !(model?.brand_slug === 'philips' || model?.brand?.toLowerCase() === 'philips') && (
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">
          {getUiTranslation(lang, 'Sintomo utente')}
        </h4>
        <p class="text-slate-700 dark:text-slate-300 text-sm sm:text-base whitespace-pre-line leading-relaxed bg-blue-50/50 dark:bg-blue-900/10 p-4 rounded-lg border border-blue-100 dark:border-blue-900/30">
          {loc.userSymptom}
        </p>
      </div>
    )}

    {/* Manual link */}
    {manualUrl && (
      <div class="pt-2">
        <a
          href={manualUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-bold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300 hover:underline transition-colors"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          {getUiTranslation(lang, 'Consulta il manuale ufficiale')}
          <svg class="h-3.5 w-3.5 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    )}
  </div>
</div>
