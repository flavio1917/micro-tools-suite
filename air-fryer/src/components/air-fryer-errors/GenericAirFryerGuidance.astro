---
import { genericAirFryerGuidance } from '../../data/generic-air-fryer-guidance';
import ErrorCodeCard from './ErrorCodeCard.astro';
import { getUiTranslation } from '../../lib/air-fryer-error-i18n';

export interface Props {
  lang?: string;
}

const { lang = 'it' } = Astro.props as { lang: 'it' | 'en' | 'fr' | 'es' };
const activeGuidance = genericAirFryerGuidance[lang] || genericAirFryerGuidance['it'];

// Translations for UI headings
const uiHeadings: Record<'it'|'en'|'fr'|'es', Record<string, string>> = {
  it: {
    title: "Friggitrice ad aria non in elenco: guida ai codici e problemi comuni",
    initialChecks: "Controlli iniziali sicuri",
    codeMeanings: "Significato dei codici (E1, E2, ecc.)",
    commonProblems: "Problemi comuni",
    stopUsage: "Quando interrompere l'uso e chiamare l'assistenza"
  },
  en: {
    title: "Air fryer not listed: code guide and common problems",
    initialChecks: "Initial safe checks",
    codeMeanings: "Meaning of codes (E1, E2, etc.)",
    commonProblems: "Common problems",
    stopUsage: "When to stop using and call support"
  },
  fr: {
    title: "Friteuse à air non répertoriée : guide des codes et problèmes",
    initialChecks: "Contrôles initiaux de sécurité",
    codeMeanings: "Signification des codes (E1, E2, etc.)",
    commonProblems: "Problèmes courants",
    stopUsage: "Quand arrêter l'utilisation et appeler l'assistance"
  },
  es: {
    title: "Freidora de aire no listada: guía de códigos y problemas comunes",
    initialChecks: "Controles iniciales seguros",
    codeMeanings: "Significado de los códigos (E1, E2, etc.)",
    commonProblems: "Problemas comunes",
    stopUsage: "Cuándo interrumpir el uso y llamar al servicio técnico"
  }
};
const headings = uiHeadings[lang] || uiHeadings['it'];

// Generic codes with explicit severity from the generic guidance.
// These use the new localized format so ErrorCodeCard can render them.
const genericCodes = [
  { 
    code: 'E1', display_code: 'E1', aliases: [],
    localized: {
      it: { diagnosis: activeGuidance.genericCodeGuidance[0].meaning, classification: 'Errore Termico / Sensore' },
      en: { diagnosis: activeGuidance.genericCodeGuidance[0].meaning, classification: 'Thermal / Sensor Error' },
      fr: { diagnosis: activeGuidance.genericCodeGuidance[0].meaning, classification: 'Erreur Thermique / Capteur' },
      es: { diagnosis: activeGuidance.genericCodeGuidance[0].meaning, classification: 'Error Térmico / Sensor' }
    },
    severity_level: 'unknown', color: 'yellow', source_language: 'it',
    source: {}
  },
  { 
    code: 'E2', display_code: 'E2', aliases: [],
    localized: {
      it: { diagnosis: activeGuidance.genericCodeGuidance[1].meaning, classification: 'Cortocircuito Sensore' },
      en: { diagnosis: activeGuidance.genericCodeGuidance[1].meaning, classification: 'Sensor Short Circuit' },
      fr: { diagnosis: activeGuidance.genericCodeGuidance[1].meaning, classification: 'Court-circuit Capteur' },
      es: { diagnosis: activeGuidance.genericCodeGuidance[1].meaning, classification: 'Cortocircuito Sensor' }
    },
    severity_level: 'unknown', color: 'yellow', source_language: 'it',
    source: {}
  },
  { 
    code: 'E3', display_code: 'E3', aliases: [],
    localized: {
      it: { diagnosis: activeGuidance.genericCodeGuidance[2].meaning, classification: 'Protezione Surriscaldamento' },
      en: { diagnosis: activeGuidance.genericCodeGuidance[2].meaning, classification: 'Overheating Protection' },
      fr: { diagnosis: activeGuidance.genericCodeGuidance[2].meaning, classification: 'Protection Surchauffe' },
      es: { diagnosis: activeGuidance.genericCodeGuidance[2].meaning, classification: 'Protección Sobrecalentamiento' }
    },
    severity_level: 'unknown', color: 'yellow', source_language: 'it',
    source: {}
  },
  { 
    code: 'E4', display_code: 'E4', aliases: [],
    localized: {
      it: { diagnosis: activeGuidance.genericCodeGuidance[3].meaning, classification: 'Alimentazione o Malfunzionamento' },
      en: { diagnosis: activeGuidance.genericCodeGuidance[3].meaning, classification: 'Power or Malfunction' },
      fr: { diagnosis: activeGuidance.genericCodeGuidance[3].meaning, classification: 'Alimentation ou Dysfonctionnement' },
      es: { diagnosis: activeGuidance.genericCodeGuidance[3].meaning, classification: 'Alimentación o Mal Funcionamiento' }
    },
    severity_level: 'unknown', color: 'yellow', source_language: 'it',
    source: {}
  },
  { 
    code: 'Display Spento', display_code: 'Display Spento', aliases: [],
    localized: {
      it: { diagnosis: activeGuidance.genericCodeGuidance[4].meaning, classification: 'Nessuna Alimentazione' },
      en: { diagnosis: activeGuidance.genericCodeGuidance[4].meaning, classification: 'No Power' },
      fr: { diagnosis: activeGuidance.genericCodeGuidance[4].meaning, classification: 'Pas d\'Alimentation' },
      es: { diagnosis: activeGuidance.genericCodeGuidance[4].meaning, classification: 'Sin Alimentación' }
    },
    severity_level: 'unknown', color: 'yellow', source_language: 'it',
    source: {}
  }
];
---
<div class="af-generic-guidance bg-white dark:bg-[#151b2b] rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm p-6 sm:p-8 mb-6">
  
  <header class="mb-10 border-b border-slate-100 dark:border-slate-800 pb-6">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mb-4">
      {headings.title}
    </h2>
    <div class="bg-amber-50 dark:bg-amber-900/20 border-l-4 border-amber-400 p-4 rounded-r-lg">
      <p class="text-amber-800 dark:text-amber-300 font-medium">
        {activeGuidance.disclaimer}
      </p>
    </div>
  </header>

  <div class="space-y-12">
    
    {/* Controlli Iniziali Sicuri */}
    <section>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
        <svg class="w-6 h-6 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        {headings.initialChecks}
      </h3>
      <div class="bg-emerald-50 dark:bg-emerald-900/10 rounded-xl p-6 border border-emerald-100 dark:border-emerald-800/30">
        <ol class="space-y-3 text-slate-700 dark:text-slate-300 list-decimal list-inside">
          {activeGuidance.generalSafetySteps.map(step => (
            <li class="pl-2 marker:text-emerald-600 marker:font-bold">{step}</li>
          ))}
        </ol>
      </div>
    </section>

    {/* Significato Codici Generici */}
    <section>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
        <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        {headings.codeMeanings}
      </h3>
      <div class="space-y-4">
        {genericCodes.map(err => (
          <ErrorCodeCard error={err} lang={lang} brandDisplayName={getUiTranslation(lang, 'Guida Generica')} />
        ))}
      </div>
    </section>

    {/* Problemi Comuni */}
    <section>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-5 flex items-center gap-2">
        <svg class="w-6 h-6 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {headings.commonProblems}
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {activeGuidance.commonSymptoms.map(item => (
          <article class="bg-white dark:bg-slate-800 p-5 rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md transition-shadow">
            <h4 class="font-bold text-slate-900 dark:text-white mb-2 text-lg">{item.symptom}</h4>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">{item.advice}</p>
          </article>
        ))}
      </div>
    </section>

    {/* Quando Interrompere l'Uso */}
    <section>
      <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 p-6 rounded-r-xl">
        <h3 class="text-lg font-bold text-red-800 dark:text-red-400 mb-3 flex items-center gap-2">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          {headings.stopUsage}
        </h3>
        <ul class="space-y-2 text-red-700 dark:text-red-300 font-medium">
          {activeGuidance.commonSymptoms[3]?.advice && (
             <li class="flex items-start gap-2"><span class="mt-1 text-red-500">•</span> {activeGuidance.commonSymptoms[3].advice}</li>
          )}
        </ul>
      </div>
    </section>

  </div>
</div>
