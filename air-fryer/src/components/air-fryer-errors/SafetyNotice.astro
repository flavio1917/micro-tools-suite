---
export interface Props {
  severity: 'safe_check' | 'caution' | 'stop_and_support';
  lang: 'it' | 'fr' | 'es' | 'en';
}

const { severity, lang } = Astro.props;

const safetyMessages = {
  it: 'Scollega la spina. Non aprire la scocca. Contatta l’assistenza autorizzata.',
  fr: 'Débranchez l’appareil. N’ouvrez pas le boîtier. Contactez un service agréé.',
  es: 'Desenchufa el aparato. No abras la carcasa. Contacta con el servicio técnico autorizado.',
  en: 'Unplug the appliance. Do not open the housing. Contact authorised support.'
};

const message = safetyMessages[lang] || safetyMessages.it;
---
{severity === 'stop_and_support' && (
  <div class="mt-4 p-4 bg-red-50 dark:bg-red-900/20 border-l-4 border-red-500 rounded-r-md text-sm text-red-800 dark:text-red-300 flex items-start gap-3" role="alert" aria-live="assertive">
    <svg class="w-5 h-5 text-red-600 dark:text-red-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
    <span class="font-semibold">{message}</span>
  </div>
)}
