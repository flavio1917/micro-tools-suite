---
import { getUiTranslation } from '../../lib/air-fryer-error-i18n';

export interface Props {
  severityLevel: string;  // "low" | "medium" | "high" | "unknown"
  color: string;          // "green" | "yellow" | "red" | "unknown"
  severityLabel?: string; // Localized label like "Media", "High", etc.
  lang: string;
  // Legacy props (for GenericAirFryerGuidance compatibility)
  severity?: string;
  actionLevel?: string;
  fixable?: boolean;
}

const { severityLevel, color, severityLabel, lang, severity, actionLevel, fixable } = Astro.props;

// Determine badge type from the database color field
// Priority: use color from database. Fallback: legacy severity mapping.
let badgeColor = color || 'unknown';

// Legacy fallback (for generic guidance cards that don't have the new format)
if (badgeColor === 'unknown' && severity) {
  if (severity === 'hardware' || actionLevel === 'assistenza' || severity === 'stop_and_support' || severity === 'high') {
    badgeColor = 'red';
  } else if (severity === 'software_reset' || fixable || severity === 'low') {
    badgeColor = 'green';
  } else {
    badgeColor = 'yellow';
  }
}

// Use severityLabel from the database as the display text
// Fallback to generic labels for legacy/generic guidance usage
let label = severityLabel || '';
if (!label) {
  const defaultLabels: Record<string, string> = {
    green: getUiTranslation(lang, 'Gravità') + ': ' + 'Low',
    yellow: getUiTranslation(lang, 'Gravità') + ': ' + 'Medium',
    red: getUiTranslation(lang, 'Gravità') + ': ' + 'High',
  };
  label = defaultLabels[badgeColor] || '';
}

const styles: Record<string, string> = {
  green: 'bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300 border-green-200 dark:border-green-800',
  yellow: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/30 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800',
  red: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300 border-red-200 dark:border-red-800',
  unknown: 'bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-400 border-slate-200 dark:border-slate-700',
};

const dotStyles: Record<string, string> = {
  green: 'bg-green-500',
  yellow: 'bg-yellow-500',
  red: 'bg-red-500',
  unknown: 'bg-slate-400',
};

const styleClass = styles[badgeColor] || styles.unknown;
const dotClass = dotStyles[badgeColor] || dotStyles.unknown;
---
{label && (
  <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold border ${styleClass}`}>
    <span class={`w-2.5 h-2.5 rounded-full mr-1.5 ${dotClass}`}></span>
    <span>{getUiTranslation(lang, 'Gravità')}: {label}</span>
  </span>
)}
