---
import SeverityBadge from './SeverityBadge.astro';
import EvidenceLabel from './EvidenceLabel.astro';
import SafetyNotice from './SafetyNotice.astro';
import type { Severity, EvidenceLevel, SourceReference, SupportedLanguage } from '../../types/air-fryer-v2';
import { toSafeAnchorId } from '../../lib/air-fryer-anchor';
import { errorsUiTranslations } from '../../data/i18n/errors-ui';

export interface Props {
  symptomKey: string;
  severity: Severity;
  evidenceLevel: EvidenceLevel;
  content: {
    label: string;
    cause?: string;
    solution?: string;
    steps?: string[];
  };
  source?: SourceReference;
  lang: SupportedLanguage;
  brandDisplayName?: string;
}

const { symptomKey, severity, evidenceLevel, content, source, lang, brandDisplayName } = Astro.props;

const validSeverities = new Set(['safe_check', 'caution', 'stop_and_support']);
const validEvidenceLevels = new Set(['model_specific', 'brand_generic', 'universal_guidance']);

const isRenderable = Boolean(
  symptomKey &&
  content?.label &&
  lang &&
  validSeverities.has(severity ?? '') &&
  validEvidenceLevels.has(evidenceLevel ?? '')
);

const currentLang = (lang && errorsUiTranslations[lang]) ? lang : 'it';
const translations = errorsUiTranslations[currentLang];
const labels = translations.cardLabels;

const symptomAnchorId = toSafeAnchorId('symptom', symptomKey);
---
<Fragment>
{isRenderable && (
<article class="mb-6 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 overflow-hidden shadow-sm" id={symptomAnchorId}
         data-analytics-symptom={symptomKey}
         data-analytics-severity={severity}
         data-analytics-evidence={evidenceLevel}
         data-analytics-brand={brandDisplayName || ''}>
  <div class="px-5 py-4 border-b border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-start justify-between gap-3 bg-slate-50 dark:bg-slate-800/50">
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-3 flex-wrap">
        <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight m-0">{content.label}</h3>
        <SeverityBadge severity={severity} lang={lang} />
      </div>
      <EvidenceLabel level={evidenceLevel} lang={lang} brandDisplayName={brandDisplayName} />
    </div>
  </div>

  <div class="p-5 space-y-5">
    {content.cause && (
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">{labels.possibleCause}</h4>
        <p class="text-slate-800 dark:text-slate-200 font-medium text-sm sm:text-base">
          {content.cause}
        </p>
      </div>
    )}

    {content.solution && (
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-1.5">{labels.solution}</h4>
        <p class="text-slate-800 dark:text-slate-200 font-medium text-sm sm:text-base">
          {content.solution}
        </p>
      </div>
    )}

    {content.steps && content.steps.length > 0 && severity !== 'stop_and_support' && (
      <div class="bg-slate-50 dark:bg-slate-800/30 rounded p-4">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2.5 flex items-center gap-2">
          <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
          {labels.checklist}
        </h4>
        <ul class="space-y-3 text-sm sm:text-base text-slate-700 dark:text-slate-300 af-checklist" data-lang={lang} data-scope={'symptom-' + (brandDisplayName || 'univ')} data-record={symptomKey}>
          {content.steps.map((step, idx) => {
            return (
              <li class="flex items-start gap-3">
                <input type="checkbox" id={'chk-sym-' + symptomKey + '-' + idx} data-idx={idx} class="mt-1 w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600 cursor-pointer" />
                <label for={'chk-sym-' + symptomKey + '-' + idx} class="select-none cursor-pointer">{step}</label>
              </li>
            );
          })}
        </ul>
      </div>
    )}
    
    <SafetyNotice severity={severity} lang={lang} />
    
    {source?.manual_url && (
  <div class="mt-4 border-t border-slate-100 pt-4 text-xs dark:border-slate-800">
    <a
      href={source.manual_url}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-manual="true"
      data-analytics-source-type={source.type || 'manual'}
      class="inline-flex items-center gap-1 text-blue-600 hover:underline dark:text-blue-400"
    >
      <span>
        {labels.officialManual}
        {source.source_page ? ` (${labels.page} ${source.source_page})` : ''}
      </span>
      <svg
        class="h-3 w-3"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
        />
      </svg>
      <span class="sr-only">({labels.opensInNewTab})</span>
    </a>
  </div>
)}
  </div>
</article>
)}
</Fragment>
