---
// src/components/recipes/RecipeCard.astro
const { recipe } = Astro.props;

const imagePath = `/images/recipes/${recipe.slug}.webp`;

// Preparazione sicura stringa ingredienti per la ricerca
const ingredientsString = recipe.ingredients && Array.isArray(recipe.ingredients) 
  ? recipe.ingredients.join(' ').toLowerCase() 
  : '';
---

<a 
  href={`/ricette/${recipe.slug}`} 
  class="recipe-card group relative block overflow-hidden rounded-2xl bg-slate-900 border border-slate-700 hover:border-blue-500 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-900/20"
  data-title={recipe.title.toLowerCase()} 
  data-ingredients={ingredientsString}
>
  
  <div class="aspect-w-16 aspect-h-10 w-full overflow-hidden bg-slate-800 relative h-56">
    
    <img 
      src={imagePath} 
      alt={recipe.title}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90"
      onerror="this.style.display='none';" 
    />
    
    <div class="absolute inset-0 bg-black/40 bg-gradient-to-t from-black via-black/80 to-transparent transition-opacity"></div>
  </div>

  <div class="absolute inset-0 flex flex-col justify-end p-5">
    
    <div class="mb-3 relative z-10">
      <h3 class="text-xl font-bold text-white leading-tight group-hover:text-blue-300 transition-colors line-clamp-2 drop-shadow-[0_3px_3px_rgba(0,0,0,0.9)]">
        {recipe.title}
      </h3>
    </div>

    <div class="flex items-center gap-2 text-sm text-slate-200 mt-1 relative z-10">
      <span class="flex items-center gap-1.5 bg-black/70 px-2.5 py-1.5 rounded-lg backdrop-blur-md border border-white/10 shadow-lg font-medium">
        🔥 <span class="text-orange-300 font-bold">{recipe.temp}°C</span>
      </span>
      <span class="flex items-center gap-1.5 bg-black/70 px-2.5 py-1.5 rounded-lg backdrop-blur-md border border-white/10 shadow-lg font-medium">
        ⏱️ <span class="text-blue-300 font-bold">{recipe.time}'</span>
      </span>
    </div>
  </div>
</a>