---
import recipesEn from '../../data/recipes-en.json';

export interface Props {
  recipe: any;
  lang?: string;
}

const { recipe, lang = "it" } = Astro.props;

const baseImageName = recipe.image || recipe.slug;
const imagePath = `/images/recipes/${baseImageName}.webp`;

const ingredientsString = recipe.ingredients && Array.isArray(recipe.ingredients) 
  ? recipe.ingredients.join(' ').toLowerCase() 
  : '';

const recipeUrl = `/${lang}/recipes/${recipe.slug}`;
const tempSymbol = lang === "en" ? "°F" : "°C";
const timeSymbol = lang === "en" ? " min" : "'";

let isAuth = recipe.isItalian === true || recipe.isItalian === "true";
if (recipe.isItalian === undefined) {
  const enRecipe = recipesEn.find((r: any) => (r.image || r.slug) === baseImageName);
  if (enRecipe) {
    isAuth = enRecipe.isItalian === true || enRecipe.isItalian === "true";
  }
}

const authLabels = {
  it: "Autentica",
  en: "Authentic",
  es: "Auténtica",
  fr: "Authentique"
};
const authLabel = authLabels[lang as keyof typeof authLabels] || authLabels.it;

// LOGICA CTR HACKING (Badge Nutrizionali Visivi)
const hasNutrition = recipe.nutrition && recipe.nutrition.kcal;
const kcalValue = hasNutrition ? recipe.nutrition.kcal : 9999;
const proValue = hasNutrition ? recipe.nutrition.proteins_g : 0;

const isHighProtein = proValue >= 15;
const isLowCal = kcalValue > 0 && kcalValue <= 350;

const badgeLabels = {
  it: { pro: "Pro", light: "Solo", kcal: "Kcal" },
  en: { pro: "Pro", light: "Only", kcal: "Kcal" },
  es: { pro: "Pro", light: "Solo", kcal: "Kcal" },
  fr: { pro: "Pro", light: "Max", kcal: "Kcal" }
};
const bl = badgeLabels[lang as keyof typeof badgeLabels] || badgeLabels.it;
---

<a 
  href={recipeUrl} 
  class="recipe-card group relative block overflow-hidden rounded-2xl bg-slate-900 border border-slate-700 hover:border-blue-500 transition-all duration-300 hover:shadow-2xl hover:shadow-blue-900/20"
  data-title={recipe?.title?.toLowerCase() || ''}
  data-ingredients={ingredientsString}
  data-kcal={kcalValue} 
>
  
  <div class="aspect-w-16 aspect-h-10 w-full overflow-hidden bg-slate-800 relative h-56">
    <img 
      src={imagePath} 
      alt={recipe.title}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
      onerror="this.style.opacity='0';" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/70 via-40% to-transparent to-60% transition-opacity duration-300"></div>
  </div>

  {hasNutrition && (isHighProtein || isLowCal) && (
    <div class="absolute top-3 left-3 z-30 flex flex-col gap-1.5">
      {isHighProtein ? (
        <span class="flex items-center gap-1.5 px-2.5 py-1.5 bg-emerald-500/95 backdrop-blur-md border border-emerald-400 text-white text-[10px] font-black uppercase tracking-widest rounded-lg shadow-lg">
          💪 {proValue}g {bl.pro}
        </span>
      ) : (
        <span class="flex items-center gap-1.5 px-2.5 py-1.5 bg-amber-500/95 backdrop-blur-md border border-amber-400 text-black text-[10px] font-black uppercase tracking-widest rounded-lg shadow-lg">
          🥗 {bl.light} {kcalValue} {bl.kcal}
        </span>
      )}
    </div>
  )}

  {isAuth && (
    <div class="absolute top-3 right-3 z-30">
      <div class="flex items-center gap-1.5 px-2.5 py-1 bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-600 border border-yellow-300/80 text-black text-[10px] font-black uppercase tracking-widest rounded-full shadow-[0_4px_15px_rgba(0,0,0,0.6)]">
        <img src="https://flagcdn.com/it.svg" alt="Italia" class="w-4 h-auto rounded-[2px] shadow-sm border border-black/20" />
        <span class="drop-shadow-sm">{authLabel}</span>
      </div>
    </div>
  )}

  <div class="absolute inset-0 flex flex-col justify-end p-5 z-20 pointer-events-none">
    
    <div class="mb-3">
      <h3 class="text-xl font-bold text-white leading-tight group-hover:text-blue-300 transition-colors line-clamp-2 drop-shadow-[0_4px_4px_rgba(0,0,0,0.9)]">
        {recipe.title}
      </h3>
    </div>

    <div class="flex flex-wrap items-center gap-2 text-sm text-slate-200 mt-1">
      <span class="flex items-center gap-1.5 bg-black/70 px-2.5 py-1.5 rounded-lg backdrop-blur-md border border-white/10 shadow-lg font-medium pointer-events-auto">
        🔥 <span class="text-orange-300 font-bold">{recipe.temp}{tempSymbol}</span>
      </span>
      <span class="flex items-center gap-1.5 bg-black/70 px-2.5 py-1.5 rounded-lg backdrop-blur-md border border-white/10 shadow-lg font-medium pointer-events-auto">
        ⏱️ <span class="text-blue-300 font-bold">{recipe.time}{timeSymbol}</span>
      </span>
    </div>
  </div>
</a>