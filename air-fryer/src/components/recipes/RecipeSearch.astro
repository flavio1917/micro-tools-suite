---
import recipesIt from '../../data/recipes-it.json';
import recipesEn from '../../data/recipes-en.json';
import recipesEs from '../../data/recipes-es.json';
import recipesFr from '../../data/recipes-fr.json';
import RecipeCard from './RecipeCard.astro';

export interface Props { lang?: string; }
const { lang = "it" } = Astro.props;

// Selezionatore dinamico del database
const allRecipes = {
  it: recipesIt,
  en: recipesEn,
  es: recipesEs,
  fr: recipesFr
};

const recipes = allRecipes[lang as keyof typeof allRecipes] || recipesIt;

const translations = {
  it: {
    title: "Cosa vuoi cucinare oggi?",
    subtitlePre: "Cerca tra ",
    subtitlePost: " ricette ottimizzate per la tua friggitrice ad aria.",
    placeholder: "🔍 Cerca per titolo o categoria (es. 'italiana', 'pollo')...",
    noResultsTitle: "Nessuna ricetta trovata",
    noResultsDesc: "Prova a cercare un titolo diverso o usa parole più semplici.",
    resetBtn: "Mostra tutte le ricette"
  },
  en: {
    title: "What do you want to cook today?",
    subtitlePre: "Search through ",
    subtitlePost: " optimized recipes for your air fryer.",
    placeholder: "🔍 Search by title or category (e.g. 'authentic', 'chicken')...",
    noResultsTitle: "No recipes found",
    noResultsDesc: "Try searching for a different title or use simpler words.",
    resetBtn: "Show all recipes"
  },
  es: {
    title: "¿Qué quieres cocinar hoy?",
    subtitlePre: "Busca entre ",
    subtitlePost: " recetas optimizadas para tu freidora de aire.",
    placeholder: "🔍 Buscar por título o categoría (ej. 'auténtica', 'pollo')...",
    noResultsTitle: "No se encontraron recetas",
    noResultsDesc: "Prueba a buscar un título diferente o usa palabras más sencillas.",
    resetBtn: "Mostrar todas las recetas"
  },
  fr: {
    title: "Que voulez-vous cuisiner aujourd'hui ?",
    subtitlePre: "Recherchez parmi ",
    subtitlePost: " recettes optimisées pour votre friteuse à air.",
    placeholder: "🔍 Rechercher par titre ou catégorie (ex. 'authentique', 'poulet')...",
    noResultsTitle: "Aucune recette trouvée",
    noResultsDesc: "Essayez de rechercher un titre différent ou utilisez des mots plus simples.",
    resetBtn: "Afficher toutes les recettes"
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;
---

<section id="ricettario" class="py-12 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
        {t.title}
      </h2>
      <p class="text-slate-400">
        {t.subtitlePre}<span class="text-blue-400 font-bold">{recipes.length}</span>{t.subtitlePost}
      </p>

      <div class="relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/20 to-transparent transition-all duration-300"></div>      
        <div class="relative">
          <input 
            type="text" 
            id="recipe-search-input" 
            placeholder={t.placeholder}
            class="block w-full p-4 pl-6 text-lg bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:ring-2 focus:ring-[#F59E0B] focus:border-transparent outline-none shadow-xl transition-all"
          >
        </div>
      </div>
    </div>

    <div id="recipes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {recipes.map((recipe) => {
        // CROSS REFERENCE PER LA RICERCA
        const baseImageName = recipe.image || recipe.slug;
        let isAuth = recipe.isItalian === true || recipe.isItalian === "true";
        
        if (recipe.isItalian === undefined) {
          const enRecipe = recipesEn.find((r: any) => (r.image || r.slug) === baseImageName);
          if (enRecipe) {
            isAuth = enRecipe.isItalian === true || enRecipe.isItalian === "true";
          }
        }

        const authKeyword = isAuth ? "italia italiana autentica authentic italian authentique auténtica" : "";
        const combinedKeywords = `${recipe.keywords || ''} ${authKeyword}`.trim();

        return (
          <div class="recipe-wrapper" data-title={recipe.title} data-slug={recipe.slug} data-keywords={combinedKeywords}>
            <RecipeCard recipe={recipe} lang={lang} />
          </div>
        );
      })}
    </div>

    <div id="no-results" class="hidden text-center py-12">
      <span class="text-6xl block mb-4">😕</span>
      <h3 class="text-xl font-bold text-white">{t.noResultsTitle}</h3>
      <p class="text-slate-400 mt-2">{t.noResultsDesc}</p>
      <button id="reset-search" class="mt-6 text-[#F59E0B] hover:text-white underline underline-offset-4 cursor-pointer transition-colors">
        {t.resetBtn}
      </button>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('recipe-search-input');
    const grid = document.getElementById('recipes-grid');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-search');
    
    const wrappers = Array.from(document.querySelectorAll('.recipe-wrapper'));
    wrappers.forEach((w, index) => w.setAttribute('data-original-index', index));

    function filterRecipes(query) {
      const rawQuery = query.toLowerCase().trim();
      const searchTerms = rawQuery.split(/\s+/).filter(t => t.length >= 2);
      let visibleCount = 0;

      if (rawQuery === "") {
        wrappers.sort((a, b) => parseInt(a.getAttribute('data-original-index')) - parseInt(b.getAttribute('data-original-index')));
        wrappers.forEach(wrapper => {
          grid.appendChild(wrapper);
          wrapper.style.display = '';
          visibleCount++;
        });
      } else {
        let results = [];

        wrappers.forEach(wrapper => {
          const title = (wrapper.getAttribute('data-title') || '').toLowerCase();
          const slug = (wrapper.getAttribute('data-slug') || '').toLowerCase();
          const keywords = (wrapper.getAttribute('data-keywords') || '').toLowerCase();
          
          const isVisible = searchTerms.every(term => {
            const root = term.length > 4 ? term.substring(0, term.length - 1) : term;
            return title.includes(root) || slug.includes(root) || keywords.includes(root);
          });

          if (isVisible) {
            let score = 0;
            try {
              const exactWordRegex = new RegExp('\\b' + rawQuery + '\\b', 'i');
              if (exactWordRegex.test(title)) score += 100;
            } catch(e) {}

            if (title.includes(rawQuery)) score += 50;

            searchTerms.forEach(term => {
              const root = term.length > 4 ? term.substring(0, term.length - 1) : term;
              if (title.includes(root)) score += 10;
              if (keywords.includes(root)) score += 1;
            });

            results.push({ wrapper: wrapper, score: score, originalIndex: parseInt(wrapper.getAttribute('data-original-index')) });
          } else {
            wrapper.style.display = 'none';
          }
        });

        results.sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          return a.originalIndex - b.originalIndex;
        });

        results.forEach(item => {
          grid.appendChild(item.wrapper);
          item.wrapper.style.display = '';
          visibleCount++;
        });
      }

      if (visibleCount === 0) {
        if(grid) grid.classList.add('hidden');
        if(noResults) noResults.classList.remove('hidden');
      } else {
        if(grid) grid.classList.remove('hidden');
        if(noResults) noResults.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => filterRecipes(e.target.value));
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); searchInput.blur(); }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) { searchInput.value = ''; filterRecipes(''); searchInput.focus(); }
      });
    }
  });
</script>