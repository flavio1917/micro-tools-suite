---
import recipesIt from '../../data/recipes-it.json';
import recipesEn from '../../data/recipes-en.json';
import recipesEs from '../../data/recipes-es.json';
import recipesFr from '../../data/recipes-fr.json';
import RecipeCard from './RecipeCard.astro';

export interface Props { lang?: string; }
const { lang = "it" } = Astro.props;

// Selezionatore dinamico del database
const allRecipes = {
  it: recipesIt,
  en: recipesEn,
  es: recipesEs,
  fr: recipesFr
};

const recipes = allRecipes[lang as keyof typeof allRecipes] || recipesIt;

const translations = {
  it: {
    title: "Cosa vuoi cucinare oggi?",
    subtitlePre: "Cerca tra ",
    subtitlePost: " ricette ottimizzate per la tua friggitrice ad aria.",
    placeholder: "🔍 Cerca (es. 'pesce', 'pollo', 'vegetariana')...",
    noResultsTitle: "Nessuna ricetta trovata",
    noResultsDesc: "Prova a cercare un titolo diverso o rimuovi i filtri applicati.",
    resetBtn: "Mostra tutte le ricette",
    all: "🍽️ Tutte", meat: "🥩 Carne", fish: "🐟 Pesce", veg: "🥦 Veg", sweet: "🥧 Dolci", fast: "⏱️ Veloci (≤15m)", light: "🥗 Leggeri (≤300)"
  },
  en: {
    title: "What do you want to cook today?",
    subtitlePre: "Search through ",
    subtitlePost: " optimized recipes for your air fryer.",
    placeholder: "🔍 Search (e.g. 'fish', 'chicken', 'vegetarian')...",
    noResultsTitle: "No recipes found",
    noResultsDesc: "Try searching for a different title or clear the filters.",
    resetBtn: "Show all recipes",
    all: "🍽️ All", meat: "🥩 Meat", fish: "🐟 Fish", veg: "🥦 Veg", sweet: "🥧 Sweets", fast: "⏱️ Fast (≤15m)", light: "🥗 Light (≤300)"
  },
  es: {
    title: "¿Qué quieres cocinar hoy?",
    subtitlePre: "Busca entre ",
    subtitlePost: " recetas optimizadas para tu freidora de aire.",
    placeholder: "🔍 Buscar (ej. 'pescado', 'pollo', 'vegetariana')...",
    noResultsTitle: "No se encontraron recetas",
    noResultsDesc: "Prueba a buscar un título diferente o quita los filtros.",
    resetBtn: "Mostrar todas las recetas",
    all: "🍽️ Todas", meat: "🥩 Carne", fish: "🐟 Pescado", veg: "🥦 Veg", sweet: "🥧 Dulces", fast: "⏱️ Rápidas (≤15m)", light: "🥗 Ligeras (≤300)"
  },
  fr: {
    title: "Que voulez-vous cuisiner aujourd'hui ?",
    subtitlePre: "Recherchez parmi ",
    subtitlePost: " recettes optimisées pour votre friteuse à air.",
    placeholder: "🔍 Rechercher (ex. 'poisson', 'poulet', 'végétarien')...",
    noResultsTitle: "Aucune recette trouvée",
    noResultsDesc: "Essayez un autre mot-clé ou désactivez les filtres.",
    resetBtn: "Afficher toutes les recettes",
    all: "🍽️ Toutes", meat: "🥩 Viande", fish: "🐟 Poisson", veg: "🥦 Végé", sweet: "🥧 Desserts", fast: "⏱️ Rapides (≤15m)", light: "🥗 Légères (≤300)"
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;

const getCategory = (recipe: any) => {
  const kw = Array.isArray(recipe.keywords) ? recipe.keywords.map((k: string) => k.toLowerCase()) : [];
  if (kw.some((k: string) => k.includes('carne') || k.includes('pollo') || k.includes('meat') || k.includes('viande'))) return 'meat';
  if (kw.some((k: string) => k.includes('pesce') || k.includes('fish') || k.includes('poisson'))) return 'fish';
  if (kw.some((k: string) => k.includes('veg') || k.includes('verdure') || k.includes('vegetariano') || k.includes('vegan'))) return 'veg';
  if (kw.some((k: string) => k.includes('dolc') || k.includes('sweet') || k.includes('dessert'))) return 'sweet';
  return 'other';
};

const isFast = (recipe: any) => {
  const timeStr = recipe.time ? recipe.time.toString() : "0";
  const numMatch = timeStr.match(/\d+/);
  return (numMatch && parseInt(numMatch[0]) <= 15) ? 'true' : 'false';
};
---

<section id="ricettario-container" class="scroll-mt-20 overflow-hidden w-full">
  <div class="w-full">
    
    <div class="text-center w-full max-w-5xl mx-auto mb-10 space-y-4 md:space-y-6">
      <h2 class="text-3xl md:text-4xl font-black text-slate-900 dark:text-white tracking-tight">
        {t.title}
      </h2>
      <p class="text-slate-600 dark:text-slate-400">
        {t.subtitlePre}<span class="text-orange-600 dark:text-orange-400 font-black">{recipes.length}</span>{t.subtitlePost}
      </p>

      <div class="bg-white/80 dark:bg-slate-800/60 backdrop-blur-xl border border-slate-200 dark:border-slate-700/60 rounded-3xl p-4 md:p-8 shadow-xl dark:shadow-2xl relative z-30">
        
        <div class="relative mb-6">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          </div>
          <input 
            type="text" 
            id="recipe-search-input" 
            placeholder={t.placeholder}
            class="block w-full p-4 pl-12 text-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-600 rounded-xl text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-orange-500 focus:border-orange-500 outline-none shadow-inner transition-all font-medium"
          >
        </div>

        <div class="flex overflow-x-auto snap-x hide-scrollbar items-center justify-start md:justify-center gap-2 md:gap-3 pb-2 -mx-2 px-2 md:mx-0 md:px-0 md:overflow-x-visible md:flex-wrap" id="filter-pills">
          <button data-filter="all" class="filter-btn active whitespace-nowrap flex-shrink-0 snap-start bg-orange-600 text-white border-orange-500 shadow-[0_0_15px_rgba(234,88,12,0.4)] px-4 py-2 rounded-full text-sm font-bold transition-all hover:scale-105">{t.all}</button>
          <button data-filter="meat" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105">{t.meat}</button>
          <button data-filter="fish" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105">{t.fish}</button>
          <button data-filter="veg" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105">{t.veg}</button>
          <button data-filter="sweet" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-slate-300 dark:hover:border-slate-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105">{t.sweet}</button>
          <button data-filter="fast" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-amber-400 dark:hover:border-amber-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105 hover:text-amber-600 dark:hover:text-amber-400">{t.fast}</button>
          <button data-filter="light" class="filter-btn whitespace-nowrap flex-shrink-0 snap-start bg-slate-100 text-slate-700 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700 hover:border-emerald-400 dark:hover:border-emerald-500 px-4 py-2 rounded-full text-sm font-bold transition-all hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105 hover:text-emerald-600 dark:hover:text-emerald-400">{t.light}</button>
        </div>

      </div>
    </div>

    <div id="recipes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 relative z-20">
      {recipes.map((recipe) => {
        const baseImageName = recipe.image || recipe.slug;
        let isAuth = recipe.isItalian === true || recipe.isItalian === "true";
        
        if (recipe.isItalian === undefined) {
          const enRecipe = recipesEn.find((r: any) => (r.image || r.slug) === baseImageName);
          if (enRecipe) {
            isAuth = enRecipe.isItalian === true || enRecipe.isItalian === "true";
          }
        }

        const authKeyword = isAuth ? "italia italiana autentica authentic italian authentique auténtica" : "";
        const keywordsString = Array.isArray(recipe.keywords) ? recipe.keywords.join(' ') : (recipe.keywords || '');
        const combinedKeywords = `${keywordsString} ${authKeyword}`.trim();

        const cat = getCategory(recipe);
        const fast = isFast(recipe);
        const kcalValue = recipe.nutrition ? recipe.nutrition.kcal : 9999;

        return (
          <div class="recipe-wrapper" 
               data-title={recipe.title} 
               data-slug={recipe.slug} 
               data-keywords={combinedKeywords}
               data-category={cat}
               data-fast={fast}
               data-kcal={kcalValue}>
            <RecipeCard recipe={recipe} lang={lang} />
          </div>
        );
      })}
    </div>

    <div id="no-results" class="hidden text-center py-16 bg-slate-50 dark:bg-slate-800/40 border border-slate-200 dark:border-slate-700/60 rounded-3xl mt-6 shadow-sm">
      <span class="text-6xl block mb-4 opacity-50">😕</span>
      <h3 class="text-2xl font-bold text-slate-900 dark:text-white">{t.noResultsTitle}</h3>
      <p class="text-slate-600 dark:text-slate-400 mt-2 mb-6">{t.noResultsDesc}</p>
      <button id="reset-search" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white dark:bg-slate-800 text-slate-900 dark:text-white font-bold hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-orange-600 dark:hover:text-orange-400 transition-all border border-slate-300 dark:border-slate-600 shadow-sm">
        {t.resetBtn}
      </button>
    </div>

  </div>
</section>

<style>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', () => {
    // 1. DOM SCOPING E GUARDIA ANTI-DOPPIA INIZIALIZZAZIONE
    const container = document.getElementById('ricettario-container');
    if (!container || container.dataset.initialized === 'true') return;
    container.dataset.initialized = 'true';

    const searchInput = container.querySelector('#recipe-search-input');
    const filterBtns = container.querySelectorAll('.filter-btn');
    const grid = container.querySelector('#recipes-grid');
    const noResults = container.querySelector('#no-results');
    const resetBtn = container.querySelector('#reset-search');
    
    const wrappers = Array.from(container.querySelectorAll('.recipe-wrapper'));
    wrappers.forEach((w, index) => w.setAttribute('data-original-index', index));

    let currentSearch = "";
    let currentFilter = "all";

    // 2. NORMALIZZAZIONE TESTO (Rimuove accenti e rende minuscolo)
    const normalizeText = (str) => {
      if (!str) return "";
      return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    };

    function updateDisplay() {
      const rawQuery = normalizeText(currentSearch).trim();
      const searchTerms = rawQuery.split(/\s+/).filter(t => t.length >= 2);
      let visibleCount = 0;
      let results = [];

      wrappers.forEach(wrapper => {
        const title = normalizeText(wrapper.getAttribute('data-title'));
        const slug = normalizeText(wrapper.getAttribute('data-slug'));
        const keywords = normalizeText(wrapper.getAttribute('data-keywords'));
        const category = wrapper.getAttribute('data-category');
        const isFast = wrapper.getAttribute('data-fast') === 'true';
        const kcal = parseInt(wrapper.getAttribute('data-kcal') || "9999", 10);

        // MATCH TESTUALE PULITO
        let isTextMatch = true;
        if (searchTerms.length > 0) {
          isTextMatch = searchTerms.every(term => {
            return title.includes(term) || slug.includes(term) || keywords.includes(term);
          });
        }

        // MATCH FILTRO (Regola ≤ 300 allineata con l'etichetta)
        let isFilterMatch = false;
        if (currentFilter === 'all') isFilterMatch = true;
        else if (currentFilter === 'fast') isFilterMatch = isFast;
        else if (currentFilter === 'light') isFilterMatch = kcal <= 300;
        else isFilterMatch = (category === currentFilter);

        if (isTextMatch && isFilterMatch) {
          let score = 0;
          if (rawQuery !== "") {
            if (title.includes(rawQuery)) score += 50;
            if (keywords.includes(rawQuery)) score += 25;
            searchTerms.forEach(term => {
              if (title.includes(term)) score += 10;
            });
          }
          results.push({ wrapper: wrapper, score: score, originalIndex: parseInt(wrapper.getAttribute('data-original-index')) });
        } else {
          wrapper.style.display = 'none';
        }
      });

      // ORDINAMENTO: Solo se c'è una query testuale, altrimenti mantiene l'ordine editoriale
      results.sort((a, b) => {
        if (rawQuery !== "" && b.score !== a.score) return b.score - a.score;
        return a.originalIndex - b.originalIndex;
      });

      results.forEach(item => {
        grid.appendChild(item.wrapper); 
        item.wrapper.style.display = '';
        visibleCount++;
      });

      if (visibleCount === 0) {
        if(grid) grid.style.display = 'none';
        if(noResults) noResults.style.display = 'block';
      } else {
        if(grid) grid.style.display = 'grid'; 
        if(noResults) noResults.style.display = 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value;
        updateDisplay();
      });
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); searchInput.blur(); }
      });
    }

    const inactiveClasses = ['bg-slate-100', 'text-slate-700', 'border-slate-200', 'dark:bg-slate-800', 'dark:text-slate-300', 'dark:border-slate-700'];
    const activeClasses = ['bg-orange-600', 'text-white', 'border-orange-500', 'shadow-[0_0_15px_rgba(234,88,12,0.4)]', 'active'];
    const activeLightClasses = ['bg-emerald-500', 'text-white', 'border-emerald-400', 'shadow-[0_0_15px_rgba(16,185,129,0.4)]', 'active'];

    filterBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        filterBtns.forEach(b => {
          b.classList.remove(...activeClasses, ...activeLightClasses);
          b.classList.add(...inactiveClasses);
        });
        
        const target = e.currentTarget;
        const isLightFilter = target.getAttribute('data-filter') === 'light';
        
        target.classList.remove(...inactiveClasses);
        
        if (isLightFilter) {
          target.classList.add(...activeLightClasses);
        } else {
          target.classList.add(...activeClasses);
        }

        currentFilter = target.getAttribute('data-filter');
        updateDisplay();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearch = "";
        const btnAll = container.querySelector('[data-filter="all"]');
        if(btnAll) btnAll.click();
        else {
          currentFilter = "all";
          updateDisplay();
        }
      });
    }
  });
</script>