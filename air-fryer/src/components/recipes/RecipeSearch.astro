---
import recipes from '../../data/recipes.json';
import RecipeCard from './RecipeCard.astro';
---

<section id="ricettario" class="py-12 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
        Cosa vuoi cucinare oggi?
      </h2>
      <p class="text-slate-400">
        Cerca tra <span class="text-blue-400 font-bold">{recipes.length}</span> ricette ottimizzate per la tua friggitrice ad aria.
      </p>

      <div class="relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/20 to-transparent transition-all duration-300"></div>      
        <div class="relative">
          <input 
            type="text" 
            id="recipe-search-input" 
            placeholder="🔍 Cerca per titolo o categoria (es. 'frittura gamberi')..." 
            class="block w-full p-4 pl-6 text-lg bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:ring-2 focus:ring-[#F59E0B] focus:border-transparent outline-none shadow-xl transition-all"
          >
        </div>
      </div>
    </div>

    <div id="recipes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {recipes.map((recipe) => (
        <div class="recipe-wrapper" data-title={recipe.title} data-slug={recipe.slug} data-keywords={recipe.keywords || ''}>
          <RecipeCard recipe={recipe} />
        </div>
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-12">
      <span class="text-6xl block mb-4">😕</span>
      <h3 class="text-xl font-bold text-white">Nessuna ricetta trovata</h3>
      <p class="text-slate-400 mt-2">Prova a cercare un titolo diverso o usa parole più semplici.</p>
      <button id="reset-search" class="mt-6 text-[#F59E0B] hover:text-white underline underline-offset-4 cursor-pointer transition-colors">
        Mostra tutte le ricette
      </button>
    </div>

  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('recipe-search-input');
    const grid = document.getElementById('recipes-grid');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-search');
    
    // Peschiamo i wrapper convertendoli in Array per poterli ordinare
    const wrappers = Array.from(document.querySelectorAll('.recipe-wrapper'));
    
    // Memorizziamo l'ordine iniziale per poterlo ripristinare
    wrappers.forEach((w, index) => w.setAttribute('data-original-index', index));

    function filterRecipes(query) {
      const rawQuery = query.toLowerCase().trim();
      const searchTerms = rawQuery.split(/\s+/).filter(t => t.length >= 2);
      let visibleCount = 0;

      // Se la ricerca è vuota, ripristina l'ordine originale
      if (rawQuery === "") {
        wrappers.sort((a, b) => parseInt(a.getAttribute('data-original-index')) - parseInt(b.getAttribute('data-original-index')));
        wrappers.forEach(wrapper => {
          grid.appendChild(wrapper);
          wrapper.style.display = '';
          visibleCount++;
        });
      } else {
        let results = [];

        wrappers.forEach(wrapper => {
          const title = (wrapper.getAttribute('data-title') || '').toLowerCase();
          const slug = (wrapper.getAttribute('data-slug') || '').toLowerCase();
          const keywords = (wrapper.getAttribute('data-keywords') || '').toLowerCase();
          
          const isVisible = searchTerms.every(term => {
            const root = term.length > 4 ? term.substring(0, term.length - 1) : term;
            return title.includes(root) || slug.includes(root) || keywords.includes(root);
          });

          if (isVisible) {
            // CALCOLO DEL PUNTEGGIO DI PERTINENZA
            let score = 0;

            // 1. Match Esatto di una parola intera (es. "parmigiana" non viene confuso con "parmigiano")
            try {
              const exactWordRegex = new RegExp('\\b' + rawQuery + '\\b', 'i');
              if (exactWordRegex.test(title)) score += 100;
            } catch(e) {}

            // 2. Il titolo contiene l'esatta frase cercata
            if (title.includes(rawQuery)) score += 50;

            // 3. Punteggi per le singole parole tagliate
            searchTerms.forEach(term => {
              const root = term.length > 4 ? term.substring(0, term.length - 1) : term;
              if (title.includes(root)) score += 10;
              if (keywords.includes(root)) score += 1;
            });

            results.push({ 
              wrapper: wrapper, 
              score: score, 
              originalIndex: parseInt(wrapper.getAttribute('data-original-index')) 
            });
          } else {
            wrapper.style.display = 'none';
          }
        });

        // Ordina i risultati in base al punteggio (decrescente). A parità di punti, usa l'ordine originale.
        results.sort((a, b) => {
          if (b.score !== a.score) return b.score - a.score;
          return a.originalIndex - b.originalIndex;
        });

        // Appendi gli elementi riordinati al DOM
        results.forEach(item => {
          grid.appendChild(item.wrapper);
          item.wrapper.style.display = '';
          visibleCount++;
        });
      }

      if (visibleCount === 0) {
        if(grid) grid.classList.add('hidden');
        if(noResults) noResults.classList.remove('hidden');
      } else {
        if(grid) grid.classList.remove('hidden');
        if(noResults) noResults.classList.add('hidden');
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        filterRecipes(e.target.value);
      });

      // Chiude la tastiera su mobile alla pressione di "Vai" o "Invio"
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault(); 
          searchInput.blur(); 
        }
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterRecipes('');
          searchInput.focus();
        }
      });
    }
  });
</script>