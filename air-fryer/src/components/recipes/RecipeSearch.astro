---
// src/components/recipes/RecipeSearch.astro
import recipes from '../../data/recipes.json';
import RecipeCard from './RecipeCard.astro';
---

<section id="ricettario" class="py-12 scroll-mt-20">
  <div class="max-w-6xl mx-auto px-4">
    
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-6">
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
        Cosa vuoi cucinare oggi?
      </h2>
      <p class="text-slate-400">
        Cerca tra <span class="text-blue-400 font-bold">{recipes.length}</span> ricette ottimizzate per la tua friggitrice ad aria.
      </p>

      <div class="relative group">
        <div class="absolute inset-0 bg-gradient-to-t from-[#0B1120] via-[#0B1120]/60 to-transparent transition-all duration-300"></div>      
        <div class="relative">
          <input 
            type="text" 
            id="recipe-search-input" 
            placeholder="🔍 Cerca 'Pollo', 'Patatine', 'Dolce'..." 
            class="block w-full p-4 pl-6 text-lg bg-slate-900 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none shadow-xl transition-all"
          >
        </div>
      </div>
    </div>

    <div id="recipes-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {recipes.map((recipe) => (
        <RecipeCard recipe={recipe} />
      ))}
    </div>

    <div id="no-results" class="hidden text-center py-12">
      <span class="text-6xl block mb-4">😕</span>
      <h3 class="text-xl font-bold text-white">Nessuna ricetta trovata</h3>
      <p class="text-slate-400 mt-2">Prova a cercare qualcosa di più generico come "carne" o "verdure".</p>
      <button id="reset-search" class="mt-6 text-blue-400 hover:text-blue-300 underline underline-offset-4 cursor-pointer">
        Mostra tutte le ricette
      </button>
    </div>

  </div>
</section>

<script is:inline>
  // Aspettiamo che il DOM sia caricato
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('recipe-search-input');
    const grid = document.getElementById('recipes-grid');
    const noResults = document.getElementById('no-results');
    const resetBtn = document.getElementById('reset-search');
    
    // Selezioniamo tutte le card
    const cards = document.querySelectorAll('.recipe-card');

    function filterRecipes(query) {
      const term = query.toLowerCase().trim();
      let visibleCount = 0;

      cards.forEach(card => {
        // Leggiamo i data-attributes (assicurati che RecipeCard li abbia!)
        const title = card.getAttribute('data-title') || '';
        const ingredients = card.getAttribute('data-ingredients') || '';
        const emoji = card.getAttribute('data-emoji') || '';
        
        // Logica di ricerca
        const isVisible = title.includes(term) || emoji.includes(term) || ingredients.includes(term);
        
        if (isVisible) {
          card.style.display = ''; // Reset display (mostra)
          visibleCount++;
        } else {
          card.style.display = 'none'; // Nascondi
        }
      });

      // Gestione visibilità griglia vs messaggio errore
      if (visibleCount === 0) {
        if(grid) grid.classList.add('hidden');
        if(noResults) noResults.classList.remove('hidden');
      } else {
        if(grid) grid.classList.remove('hidden');
        if(noResults) noResults.classList.add('hidden');
      }
    }

    // Event Listener Input
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        filterRecipes(e.target.value);
      });
    }

    // Event Listener Reset
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) {
          searchInput.value = '';
          filterRecipes('');
          searchInput.focus();
        }
      });
    }
  });
</script>