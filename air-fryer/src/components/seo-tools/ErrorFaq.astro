---
import { faqErrorsTranslations } from '../../data/i18n/faq-errors';

export interface Props {
  lang?: 'it' | 'en' | 'es' | 'fr';
}

const { lang = 'it' } = Astro.props;
const data = faqErrorsTranslations[lang] || faqErrorsTranslations['it'];

if (!data || !data.faqs || data.faqs.length === 0) {
  return;
}
---

<section aria-labelledby="faq-errors-title" class="my-16 max-w-4xl mx-auto px-4 sm:px-0">
  <div class="text-center mb-10">
    <h2 id="faq-errors-title" class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white">
      {data.sectionTitle}
    </h2>
  </div>

  <dl class="space-y-6">
    {data.faqs.map((faq) => (
      <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl border border-gray-200 dark:border-gray-700 shadow-sm hover:shadow-md transition-shadow">
        <dt class="text-lg font-bold text-gray-900 dark:text-white mb-3 flex items-start gap-3">
          <svg class="w-6 h-6 text-blue-600 dark:text-blue-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>{faq.question}</span>
        </dt>
        <dd class="text-base text-gray-700 dark:text-gray-300 sm:ml-9 leading-relaxed">
          {faq.answer}
        </dd>
      </div>
    ))}
  </dl>
</section>
