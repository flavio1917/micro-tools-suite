---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../Disclaimer.astro';
import { problemGuidesI18n } from '../../data/i18n/problem-guides';

export interface Props {
  id: string;
  lang: string;
}

const { id, lang } = Astro.props;

// Fallback to Italian if translation is missing
const t = problemGuidesI18n[lang]?.[id] || problemGuidesI18n['it'][id];

const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;

const backBtnLabel = {
  it: "Vai all'hub strumenti",
  en: "Go to tools hub",
  es: "Ir al hub de herramientas",
  fr: "Aller au hub des outils"
}[lang] || "Vai all'hub strumenti";

const hubBaseUrls = {
  it: '/strumenti',
  en: '/en/tools',
  es: '/es/herramientas',
  fr: '/fr/outils'
};
const hubUrl = hubBaseUrls[lang] || hubBaseUrls['it'];

const faqsTitle = {
  it: "Domande Frequenti",
  en: "Frequently Asked Questions",
  es: "Preguntas Frecuentes",
  fr: "Foire Aux Questions"
}[lang] || "Domande Frequenti";

// Generate hreflang paths
const routeMap = {
  'reset': { it: '/strumenti/reset-friggitrice-ad-aria/', en: '/en/tools/air-fryer-reset/', es: '/es/herramientas/reset-freidora-aire/', fr: '/fr/outils/reset-friteuse-air/' },
  'smoke-smell': { it: '/strumenti/fumo-puzza-friggitrice-ad-aria/', en: '/en/tools/air-fryer-smell-smoke/', es: '/es/herramientas/freidora-aire-humo-olor/', fr: '/fr/outils/friteuse-air-odeur-fumee/' },
  'wont-turn-on': { it: '/strumenti/friggitrice-ad-aria-non-si-accende/', en: '/en/tools/air-fryer-wont-turn-on/', es: '/es/herramientas/freidora-aire-no-enciende/', fr: '/fr/outils/friteuse-air-ne-sallume-pas/' },
  'not-heating': { it: '/strumenti/friggitrice-ad-aria-non-scalda/', en: '/en/tools/air-fryer-not-heating/', es: '/es/herramientas/freidora-aire-no-calienta/', fr: '/fr/outils/friteuse-air-ne-chauffe-pas/' },
  'fan-not-working': { it: '/strumenti/ventola-friggitrice-ad-aria-non-gira/', en: '/en/tools/air-fryer-fan-not-working/', es: '/es/herramientas/freidora-aire-ventilador-no-funciona/', fr: '/fr/outils/friteuse-air-ventilateur-ne-marche-pas/' }
};

const routes = routeMap[id];
const canonicalUrl = `https://www.crispissimo.com${routes[lang]}`;
const languages = ['it', 'en', 'es', 'fr'];
---

<MainLayout 
  title={t.title} 
  description={t.meta} 
  lang={lang} 
  canonicalUrl={canonicalUrl}
  currentPath={routes[lang]}
>
  <Fragment slot="head">
    {languages.map((l) => (
      <link rel="alternate" hreflang={l} href={`https://www.crispissimo.com${routes[l]}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://www.crispissimo.com${routes['en']}`} />
  </Fragment>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="flex text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
          <a href={homeUrl} class="inline-flex items-center hover:text-orange-600 transition-colors">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
            </svg>
            Home
          </a>
        </li>
        <li>
          <div class="flex items-center">
            <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
            </svg>
            <a href={hubUrl} class="ml-1 hover:text-orange-600 transition-colors">Hub</a>
          </div>
        </li>
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
        {t.h1}
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
        {t.intro}
      </p>
      
      <div class="mt-6 flex flex-wrap gap-4">
        <a 
          href={`${hubUrl}/codici-errore-friggitrice-ad-aria`}
          class="inline-flex items-center justify-center px-5 py-3 border border-transparent text-base font-medium rounded-full text-white bg-blue-600 hover:bg-blue-700 dark:bg-blue-500 dark:hover:bg-blue-600 transition-colors shadow-sm"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
          {backBtnLabel}
        </a>
      </div>
    </header>

    <Disclaimer type="elettrico" lang={lang} />

    <div class="space-y-12 mt-12">
      
      <!-- Diagnostic Steps -->
      <section class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
            <svg class="w-6 h-6 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            {t.stepsTitle}
          </h2>
          
          <ul class="space-y-4">
            {t.steps.map((step) => {
              const [title, ...rest] = step.split(':');
              return (
                <li class="flex items-start">
                  <span class="flex-shrink-0 h-6 w-6 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center mt-0.5 mr-3">
                    <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                  </span>
                  <p class="text-gray-700 dark:text-gray-300">
                    <strong class="text-gray-900 dark:text-white">{title}:</strong> {rest.join(':')}
                  </p>
                </li>
              );
            })}
          </ul>
        </div>
      </section>

      <!-- When to Contact Support -->
      <section class="bg-orange-50 dark:bg-gray-800 rounded-2xl shadow-sm border border-orange-100 dark:border-orange-900/30 overflow-hidden">
        <div class="p-6 sm:p-8">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
            <svg class="w-6 h-6 mr-3 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            {t.supportTitle}
          </h2>
          
          <ul class="space-y-3">
            {t.supportItems.map((item) => (
              <li class="flex items-start text-gray-700 dark:text-gray-300">
                <span class="mr-2 mt-1 text-orange-500">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- FAQs (if any) -->
      {t.faqs && t.faqs.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{faqsTitle}</h2>
          <div class="space-y-4">
            {t.faqs.map((faq) => (
              <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{faq.q}</h3>
                <p class="text-gray-600 dark:text-gray-300">{faq.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

    </div>

    <!-- Related Brands Section -->
    <section class="mt-12 bg-white dark:bg-gray-800 p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
        {lang === 'it' ? 'Esplora le guide specifiche per marca' : lang === 'en' ? 'Explore brand-specific guides' : lang === 'es' ? 'Explora guías específicas por marca' : 'Explorez les guides spécifiques par marque'}
      </h2>
      <p class="text-gray-600 dark:text-gray-300 mb-6 text-sm">
        {lang === 'it' ? 'Se il tuo dispositivo mostra un codice di errore, consulta il nostro database specifico per marca:' : lang === 'en' ? 'If your device shows an error code, check our brand-specific database:' : lang === 'es' ? 'Si tu dispositivo muestra un código de error, consulta nuestra base de datos por marca:' : 'Si votre appareil affiche un code d\'erreur, consultez notre base de données par marque :'}
      </p>
      <div class="flex flex-wrap gap-3">
        {['cosori', 'philips', 'xiaomi', 'ninja'].map(b => (
          <a href={`${hubUrl}/codici-errore-friggitrice-ad-aria/${b}/`} class="inline-flex items-center px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors capitalize">
            {b}
          </a>
        ))}
      </div>
    </section>
  </main>
</MainLayout>
