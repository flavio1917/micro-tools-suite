---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../Disclaimer.astro';
import { problemGuidesI18n } from '../../data/i18n/problem-guides';

export interface Props {
  id: string;
  lang: string;
}

const { id, lang } = Astro.props;

// Fallback to Italian if translation is missing
const t = problemGuidesI18n[lang]?.[id] || problemGuidesI18n['it'][id];



const hubBaseUrls = {
  it: '/strumenti',
  en: '/en/tools',
  es: '/es/herramientas',
  fr: '/fr/outils'
};
const hubUrl = hubBaseUrls[lang] || hubBaseUrls['it'];

const faqsTitle = {
  it: "Domande Frequenti",
  en: "Frequently Asked Questions",
  es: "Preguntas Frecuentes",
  fr: "Foire Aux Questions"
}[lang] || "Domande Frequenti";

// Generate hreflang paths
const routeMap = {
  'reset': { it: '/strumenti/reset-friggitrice-ad-aria/', en: '/en/tools/air-fryer-reset/', es: '/es/herramientas/reset-freidora-aire/', fr: '/fr/outils/reset-friteuse-air/' },
  'smoke-smell': { it: '/strumenti/fumo-puzza-friggitrice-ad-aria/', en: '/en/tools/air-fryer-smoke-smell/', es: '/es/herramientas/humo-olor-freidora-aire/', fr: '/fr/outils/fumee-odeur-friteuse-air/' },
  'wont-turn-on': { it: '/strumenti/friggitrice-ad-aria-non-si-accende/', en: '/en/tools/air-fryer-wont-turn-on/', es: '/es/herramientas/freidora-aire-no-enciende/', fr: '/fr/outils/friteuse-air-ne-sallume-pas/' },
  'not-heating': { it: '/strumenti/friggitrice-ad-aria-non-scalda/', en: '/en/tools/air-fryer-not-heating/', es: '/es/herramientas/freidora-aire-no-calienta/', fr: '/fr/outils/friteuse-air-ne-chauffe-pas/' },
  'fan-not-working': { it: '/strumenti/ventola-friggitrice-ad-aria-non-gira/', en: '/en/tools/air-fryer-fan-not-working/', es: '/es/herramientas/freidora-aire-ventilador-no-funciona/', fr: '/fr/outils/friteuse-air-ventilateur-ne-marche-pas/' }
};

const breadcrumbNames = {
  'it': { 'reset': 'Reset', 'smoke-smell': 'Fumo e Puzza', 'wont-turn-on': 'Non si accende', 'not-heating': 'Non scalda', 'fan-not-working': 'Ventola non gira' },
  'en': { 'reset': 'Reset', 'smoke-smell': 'Smoke and Smell', 'wont-turn-on': 'Won\'t Turn On', 'not-heating': 'Not Heating', 'fan-not-working': 'Fan Not Working' },
  'es': { 'reset': 'Reset', 'smoke-smell': 'Humo y Olor', 'wont-turn-on': 'No enciende', 'not-heating': 'No calienta', 'fan-not-working': 'Ventilador no funciona' },
  'fr': { 'reset': 'Reset', 'smoke-smell': 'Fumée et Odeur', 'wont-turn-on': 'Ne s\'allume pas', 'not-heating': 'Ne chauffe pas', 'fan-not-working': 'Ventilateur ne marche pas' }
};

const currentGuideName = breadcrumbNames[lang as keyof typeof breadcrumbNames]?.[id as keyof typeof breadcrumbNames['it']] || breadcrumbNames['it'][id as keyof typeof breadcrumbNames['it']] || id;
const toolsNames = { it: 'Strumenti', en: 'Tools', es: 'Herramientas', fr: 'Outils' };

const routes = routeMap[id as keyof typeof routeMap];
const canonicalUrl = `https://www.crispissimo.com${routes[lang as keyof typeof routes]}`;
const languages = ['it', 'en', 'es', 'fr'];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `https://www.crispissimo.com${lang === 'it' ? '/' : '/' + lang + '/'}` },
    { "@type": "ListItem", "position": 2, "name": toolsNames[lang as keyof typeof toolsNames], "item": `https://www.crispissimo.com${hubUrl}/` },
    { "@type": "ListItem", "position": 3, "name": currentGuideName, "item": canonicalUrl }
  ]
};

const faqSchema = t.faqs && t.faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map((faq: any) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
} : null;
---

<MainLayout
  title={t.title}
  description={t.meta}
  lang={lang}
  canonicalUrl={canonicalUrl}
  currentPath={routes[lang]}
>
  <Fragment slot="head">
    {languages.map((l) => (
      <link rel="alternate" hreflang={l} href={`https://www.crispissimo.com${routes[l]}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://www.crispissimo.com${routes['en']}`} />
  </Fragment>

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={lang === 'it' ? '/strumenti/' : lang === 'en' ? '/en/tools/' : lang === 'es' ? '/es/herramientas/' : '/fr/outils/'} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{toolsNames[lang as keyof typeof toolsNames] || toolsNames.it}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-[200px] sm:max-w-none">{currentGuideName}</li>
      </ol>
    </nav>

    <!-- Header Section -->
    <header class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4">
        {t.h1}
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl">
        {t.intro}
      </p>
    </header>

    <Disclaimer type="elettrico" lang={lang} />

    {t.items ? (
      <div class="mt-12">
        <div class="tool-card-inner bg-blue-50 dark:bg-blue-900/10 border-blue-200 dark:border-blue-500/30 mb-12 max-w-3xl mx-auto shadow-sm dark:shadow-inner p-6 rounded-2xl border">
          <h3 class="font-bold text-blue-700 dark:text-blue-400 mb-4 text-lg">{t.fsTitle}</h3>
          <ol class="space-y-3 list-decimal list-inside text-gray-700 dark:text-gray-300 font-medium">
            {t.fsList.map(rule => (
              <li class="leading-relaxed pl-2">{rule}</li>
            ))}
          </ol>
        </div>

        <aside class="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-500/30 mb-12 max-w-3xl mx-auto p-6 rounded-2xl" role="alert">
          <h2 class="text-lg font-bold text-red-600 dark:text-red-400 mb-2 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            {t.emergencyTitle}
          </h2>
          <p class="text-sm md:text-base font-medium text-red-800 dark:text-red-300">{t.emergency}</p>
        </aside>

        <nav aria-label={t.quickNav} class="flex flex-wrap justify-center gap-2 md:gap-3 mb-12">
          <span class="w-full text-center mb-2 font-semibold text-gray-500 uppercase tracking-wider text-xs">{t.quickNav}</span>
          {t.items.map((item) => (
            <a href={`#${item.id}`} class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-full text-xs md:text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 hover:text-orange-600 transition-all shadow-sm">
              <span aria-hidden="true">{item.emoji}</span> {item.name}
            </a>
          ))}
        </nav>

        <div class="space-y-6">
          {t.items.map((item) => (
            <article id={item.id} class="bg-white dark:bg-gray-800 flex flex-col md:flex-row gap-6 p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">
              <div class="flex-shrink-0 w-16 h-16 rounded-full flex items-center justify-center text-4xl bg-slate-50 dark:bg-slate-900/50 shadow-inner border border-slate-200 dark:border-white/5" aria-hidden="true">
                {item.emoji}
              </div>

              <div class="flex-1 space-y-4">
                <h2 class="text-xl font-bold text-gray-900 dark:text-white">{item.name}</h2>

                <div class="bg-gray-50 dark:bg-gray-900/50 rounded-xl p-4 border border-gray-100 dark:border-gray-700">
                  <span class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-1.5 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {t.causeLabel}
                  </span>
                  <p class="text-gray-700 dark:text-gray-300 text-sm md:text-base">{item.cause}</p>
                </div>

                <div class="bg-blue-50 dark:bg-blue-950/20 border-blue-200 dark:border-blue-500/20 p-4 rounded-xl shadow-sm border">
                  <span class="text-xs font-bold uppercase tracking-wider text-blue-700 dark:text-blue-400 mb-1.5 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {t.solutionLabel}
                  </span>
                  <p class="text-blue-900 dark:text-blue-100 text-sm md:text-base font-medium leading-relaxed">{item.solution}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <div class="space-y-12 mt-12">

        <!-- Diagnostic Steps -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
          <div class="p-6 sm:p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
              <svg class="w-6 h-6 mr-3 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              {t.stepsTitle}
            </h2>

            <ul class="space-y-4">
              {t.steps.map((step) => {
                const [title, ...rest] = step.split(':');
                return (
                  <li class="flex items-start">
                    <span class="flex-shrink-0 h-6 w-6 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center mt-0.5 mr-3">
                      <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                    </span>
                    <p class="text-gray-700 dark:text-gray-300">
                      <strong class="text-gray-900 dark:text-white">{title}:</strong> {rest.join(':')}
                    </p>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>

        <!-- When to Contact Support -->
        <section class="bg-orange-50 dark:bg-gray-800 rounded-2xl shadow-sm border border-orange-100 dark:border-orange-900/30 overflow-hidden">
          <div class="p-6 sm:p-8">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center">
              <svg class="w-6 h-6 mr-3 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              {t.supportTitle}
            </h2>

            <ul class="space-y-3">
              {t.supportItems.map((item) => (
                <li class="flex items-start text-gray-700 dark:text-gray-300">
                  <span class="mr-2 mt-1 text-orange-500">•</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>

        <!-- FAQs (if any) -->
        {t.faqs && t.faqs.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">{faqsTitle}</h2>
            <div class="space-y-4">
              {t.faqs.map((faq) => (
                <div class="bg-white dark:bg-gray-800 p-6 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{faq.q}</h3>
                  <p class="text-gray-600 dark:text-gray-300">{faq.a}</p>
                </div>
              ))}
            </div>
          </section>
        )}

      </div>
    )}

    <!-- Related Brands Section -->
    <section class="mt-12 bg-white dark:bg-gray-800 p-6 sm:p-8 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700">
      <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">
        {lang === 'it' ? 'Esplora le guide specifiche per marca' : lang === 'en' ? 'Explore brand-specific guides' : lang === 'es' ? 'Explora guías específicas por marca' : 'Explorez les guides spécifiques par marque'}
      </h2>
      <p class="text-gray-600 dark:text-gray-300 mb-6 text-sm">
        {lang === 'it' ? 'Se il tuo dispositivo mostra un codice di errore, consulta il nostro database specifico per marca:' : lang === 'en' ? 'If your device shows an error code, check our brand-specific database:' : lang === 'es' ? 'Si tu dispositivo muestra un código de error, consulta nuestra base de datos por marca:' : 'Si votre appareil affiche un code d\'erreur, consultez notre base de données par marque :'}
      </p>
      <div class="flex flex-wrap gap-3">
        {['cosori', 'philips', 'xiaomi', 'ninja'].map(b => (
          <a href={`${hubUrl}/codici-errore-friggitrice-ad-aria/${b}/`} class="inline-flex items-center px-4 py-2 border border-gray-200 dark:border-gray-600 rounded-full text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-50 dark:bg-gray-700 hover:bg-gray-100 dark:hover:bg-gray-600 transition-colors capitalize">
            {b}
          </a>
        ))}
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</MainLayout>
