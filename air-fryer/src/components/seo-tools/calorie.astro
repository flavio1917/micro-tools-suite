---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;


import { content } from '../../i18n/pages/tools/calorie';

const t = content[lang as keyof typeof content] || content.it;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.h1,
  "operatingSystem": "All",
  "applicationCategory": "HealthApplication",
  "description": t.desc,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};

// GENERAZIONE DINAMICA DELLO SCHEMA FAQPage


// === INJECTED SEO DATA ===
const alternateUrls = {
  it: `https://www.crispissimo.com/strumenti/calcolo-calorie-friggitrice-ad-aria/`,
  en: `https://www.crispissimo.com/en/tools/air-fryer-calorie-calculator/`,
  es: `https://www.crispissimo.com/es/herramientas/calculo-calorias-freidora-aire/`,
  fr: `https://www.crispissimo.com/fr/outils/calcul-calories-friteuse-air/`,
  "x-default": `https://www.crispissimo.com/strumenti/calcolo-calorie-friggitrice-ad-aria/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.crispissimo.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti",
      "item": `https://www.crispissimo.com${{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {"it": "Calcolo Calorie", "en": "Calorie Calculator", "es": "Calculadora de Calor\u00edas", "fr": "Calcul Calories"}[lang] || "",
      "item": alternateUrls[lang] || alternateUrls.it
    }
  ]
};

const currentFaqs = t.faqs || [];
const faqSchema = currentFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": currentFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q || faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a || faq.answer
    }
  }))
} : null;
---

<MainLayout alternateUrls={alternateUrls} title={t.title} lang={lang} description={t.desc}>
  <section class="max-w-4xl mx-auto py-8 md:py-16 px-4">

    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{{"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti"}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate">{{"it": "Calcolo Calorie", "en": "Calorie Calculator", "es": "Calculadora de Calor\u00edas", "fr": "Calcul Calories"}[lang] || ""}</li>
      </ol>
    </nav>

    <header class="text-center mb-10">
      <div class="inline-flex items-center justify-center mb-6">
         <span class="px-4 py-1.5 bg-emerald-950/50 backdrop-blur-sm border border-emerald-500/30 rounded-full text-xs text-emerald-400 font-bold shadow-lg">
           {t.eeatBadge}
         </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 mb-4 tracking-tight">{t.h1}</h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto font-medium mb-6 text-slate-600 dark:text-slate-300">{t.intro}</p>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto">{t.desc}</p>
    </header>

    <div class="tool-card md:p-10 mb-12 backdrop-blur-sm max-w-2xl mx-auto relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="space-y-6 relative z-10">
        <div>
          <label class="tool-label">{t.foodLabel}</label>
          <select id="food-select" class="tool-input focus:ring-emerald-500 focus:border-emerald-500 appearance-none cursor-pointer">
            {t.foods.map((food) => (
              <option value={food.id} data-absorb={food.absorb} data-airoil={food.airOil}>{food.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="tool-label">{t.weightLabel}</label>

          <div class="flex items-center justify-center bg-slate-50 dark:bg-slate-900 border border-slate-300 dark:border-slate-600 rounded-xl overflow-hidden shadow-sm dark:shadow-inner h-14 transition-colors">
            <button id="btn-minus-weight" class="w-16 h-full hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-white font-black text-2xl transition-colors select-none active:bg-slate-700">-</button>
            <div class="flex-1 flex items-center justify-center border-x border-slate-700/50 h-full">
              <input type="number" id="weight-input" value="250" class="w-16 bg-transparent text-right text-slate-900 dark:text-white font-mono font-bold text-3xl outline-none appearance-none p-0 m-0" style="-moz-appearance: textfield;" />
              <span class="text-slate-600 dark:text-slate-400 font-bold text-xl ml-1 mb-0.5 select-none">g</span>
            </div>
            <button id="btn-plus-weight" class="w-16 h-full hover:bg-slate-200 dark:hover:bg-slate-800 text-slate-700 dark:text-white font-black text-2xl transition-colors select-none active:bg-slate-700">+</button>
          </div>
        </div>

        <button id="calc-btn" class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-900 font-black text-lg py-4 rounded-xl shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all active:scale-95 uppercase tracking-wide mt-4">
          {t.btnCalc}
        </button>
      </div>

      <div id="results-dash" class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700 hidden opacity-0 transition-opacity duration-500">
        <div class="grid grid-cols-2 gap-4">
          <div class="tool-card-inner border-amber-200 dark:border-amber-500/30 p-4 text-center">
            <span class="block text-[10px] md:text-xs uppercase font-bold text-amber-500 dark:text-amber-400 tracking-wider mb-1">{t.resFat}</span>
            <div class="flex items-baseline justify-center gap-1">
              <span id="res-fat" class="text-3xl md:text-4xl font-black font-mono text-slate-900 dark:text-white">0</span>
              <span class="text-amber-600 dark:text-amber-500 font-bold">g</span>
            </div>
          </div>
          <div class="tool-card-inner border-emerald-200 dark:border-emerald-500/30 p-4 text-center">
            <span class="block text-[10px] md:text-xs uppercase font-bold text-emerald-600 dark:text-emerald-400 tracking-wider mb-1">{t.resKcal}</span>
            <div class="flex items-baseline justify-center gap-1">
              <span id="res-kcal" class="text-3xl md:text-4xl font-black font-mono text-slate-900 dark:text-white">0</span>
              <span class="text-emerald-600 dark:text-emerald-500 font-bold">kcal</span>
            </div>
          </div>
        </div>

        <div class="mt-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-500/20 rounded-xl p-4 flex items-center justify-center gap-3 transition-colors">
          <span class="text-2xl animate-bounce">🏃‍♂️</span>
          <p class="text-blue-800 dark:text-blue-200 text-sm md:text-base font-medium">
            {t.resRun} <strong id="res-run" class="text-slate-900 dark:text-white text-lg font-black mx-1">0</strong> <span class="text-blue-600 dark:text-blue-300">{t.resRunUnit}</span>
          </p>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto mt-16 text-slate-300">
      <article class="tool-card mb-12">
        <h2 class="tool-subtitle mb-4">{t.editorialH2}</h2>
        <p class="tool-text text-lg" set:html={t.editorialText}></p>
      </article>

      <div class="space-y-6 mb-12">
        <h2 class="tool-subtitle mb-6 border-b border-slate-200 dark:border-slate-700 pb-4">{t.faqTitle}</h2>
        <div class="space-y-4">
          {t.faqs.map((faq) => (
            <details class="group tool-faq-item [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-bold text-slate-800 dark:text-slate-200 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors text-lg">
                {faq.q}
                <span class="transition group-open:rotate-180 bg-slate-100 dark:bg-slate-800 p-2 rounded-full text-slate-500 dark:text-slate-400 transition-colors">
                  <svg fill="none" height="20" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="tool-text mt-4 text-base border-t border-slate-200 dark:border-slate-800 pt-4">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>


    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-xl font-bold mb-4 text-slate-800 dark:text-white">Strumenti Correlati</h3>
      <ul class="space-y-2 text-slate-600 dark:text-slate-400">
        <li><a href={lang === 'it' ? '/strumenti/codici-errore-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-error-codes/' : lang === 'es' ? '/es/herramientas/codigos-error-freidora-aire/' : '/fr/outils/codes-erreur-friteuse-air/'} class="hover:text-orange-500 underline">Codici Errore Friggitrice ad Aria</a></li>
        <li><a href={lang === 'it' ? '/strumenti/fumo-puzza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-smell-smoke/' : lang === 'es' ? '/es/herramientas/freidora-aire-humo-olor/' : '/fr/outils/friteuse-air-fumee-odeur/'} class="hover:text-orange-500 underline">Fumo e Puzza</a></li>
        <li><a href={lang === 'it' ? '/strumenti/pulire-resistenza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/clean-air-fryer-heating-element/' : lang === 'es' ? '/es/herramientas/limpiar-resistencia-freidora-aire/' : '/fr/outils/nettoyer-resistance-friteuse-air/'} class="hover:text-orange-500 underline">Pulizia Resistenza</a></li>
      </ul>
    </div>

    <Disclaimer type="nutrizionale" lang={lang} />



  </section>

  <style>
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  </style>

<script is:inline data-astro-rerun>
    document.addEventListener('astro:page-load', () => {
      const btnMinus = document.getElementById('btn-minus-weight');
      const btnPlus = document.getElementById('btn-plus-weight');
      const wInput = document.getElementById('weight-input');

      if (!btnMinus || !btnPlus || !wInput) return; // Salvaguardia per cambi pagina

      btnMinus.addEventListener('click', () => {
        let val = parseInt(wInput.value) || 0;
        if (val > 50) wInput.value = val - 50;
      });

      btnPlus.addEventListener('click', () => {
        let val = parseInt(wInput.value) || 0;
        if (val < 2000) wInput.value = val + 50;
      });

      const btn = document.getElementById('calc-btn');
      const select = document.getElementById('food-select');
      const dash = document.getElementById('results-dash');
      const elFat = document.getElementById('res-fat');
      const elKcal = document.getElementById('res-kcal');
      const elRun = document.getElementById('res-run');

      let animRefs = { fat: null, kcal: null, run: null };

      function animateValue(obj, start, end, duration, animKey) {
        if (animRefs[animKey]) cancelAnimationFrame(animRefs[animKey]);
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          obj.innerHTML = Math.floor(progress * (end - start) + start);
          if (progress < 1) animRefs[animKey] = window.requestAnimationFrame(step);
        };
        animRefs[animKey] = window.requestAnimationFrame(step);
      }

      btn.addEventListener('click', () => {
        const option = select.options[select.selectedIndex];
        const absorbRate = parseFloat(option.getAttribute('data-absorb'));
        const baseAirOil = parseFloat(option.getAttribute('data-airoil'));
        const weight = parseFloat(wInput.value);

        if (isNaN(weight) || weight <= 0) return;

        const airFryOilGram = (weight / 250) * baseAirOil;

        const deepFryFat = weight * absorbRate;
        let savedFat = Math.max(0, deepFryFat - airFryOilGram);
        const savedKcal = savedFat * 9;
        const runMinutes = savedKcal / 10;

        dash.classList.remove('hidden');
        requestAnimationFrame(() => dash.classList.remove('opacity-0'));

        animateValue(elFat, 0, Math.round(savedFat), 1000, 'fat');
        animateValue(elKcal, 0, Math.round(savedKcal), 1000, 'kcal');
        animateValue(elRun, 0, Math.round(runMinutes), 1000, 'run');
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />


    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</MainLayout>