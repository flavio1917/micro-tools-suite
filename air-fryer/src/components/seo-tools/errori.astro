---
import MainLayout from '../../layouts/MainLayout.astro';
import AirFryerDatabase from '../air-fryer-errors/AirFryerDatabase.astro';
import { airFryerModels } from '../../lib/air-fryer-db';
import AffiliateSlot from '../ads/AffiliateSlot.astro';
import ErrorFaq from './ErrorFaq.astro';
import { pageErrorsSeoTranslations } from '../../data/i18n/page-errors-seo';
import { getAirFryerErrorHubUrl } from '../../lib/air-fryer-error-routes';

import { errorsUiTranslations } from '../../data/i18n/errors-ui';

// Trova marchi disponibili nel db per SEO pages
const availableBrands = [...new Set(airFryerModels.map(m => m.brand_slug))].filter(b => b === 'philips' || b === 'cosori' || b === 'xiaomi');
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

export interface Props {
  lang?: 'it' | 'en' | 'es' | 'fr';
}

const { lang = 'it' } = Astro.props;


const seoData = pageErrorsSeoTranslations[lang as string] || pageErrorsSeoTranslations['it'];
const t = errorsUiTranslations[lang] || errorsUiTranslations['it'];
const hubUrl = getAirFryerErrorHubUrl(lang);

// JSON-LD
const alternateUrls = {
  it: "https://www.crispissimo.com/strumenti/codici-errore-friggitrice-ad-aria/",
  en: "https://www.crispissimo.com/en/tools/air-fryer-error-codes/",
  es: "https://www.crispissimo.com/es/herramientas/codigos-error-freidora-aire/",
  fr: "https://www.crispissimo.com/fr/outils/codes-erreur-friteuse-air/",
  "x-default": "https://www.crispissimo.com/strumenti/codici-errore-friggitrice-ad-aria/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": seoData.breadcrumbHome, "item": `https://crispissimo.com/${lang === 'it' ? '' : lang}` },
    { "@type": "ListItem", "position": 2, "name": seoData.breadcrumbTools, "item": `https://crispissimo.com/${lang === 'it' ? 'strumenti' : lang + '/tools'}` },
    { "@type": "ListItem", "position": 3, "name": seoData.breadcrumbCurrent, "item": alternateUrls[lang as keyof typeof alternateUrls] || alternateUrls.it }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": seoData.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};
---

<MainLayout title={seoData.metaTitle} description={seoData.metaDescription} lang={lang} alternateUrls={alternateUrls}>
  
  <section class="max-w-4xl mx-auto py-12 md:py-16 px-4">
    
    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={lang === 'it' ? '/strumenti/' : lang === 'en' ? '/en/tools/' : lang === 'es' ? '/es/herramientas/' : '/fr/outils/'} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{seoData.breadcrumbTools}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate max-w-[200px] sm:max-w-none">{seoData.breadcrumbCurrent}</li>
      </ol>
    </nav>

    <header class="text-center mb-12">
      <h1 class="tool-title text-4xl md:text-6xl font-black mb-4 text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-500 pb-1 tracking-tight">
        {seoData.h1}
      </h1>
      <p class="tool-text text-lg md:text-xl max-w-3xl mx-auto text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
        {seoData.introParagraph}
      </p>
    </header>

    <!-- H2 Eyebrow per Mantenere il branding precedente se utile -->
    <h2 class="sr-only">{t.heroTitle}</h2>

    <!-- NUOVO MOTORE DIAGNOSTICA (DiagnosticSearch via AirFryerDatabase) -->
    <div class="w-full max-w-4xl mx-auto mb-16">
      <AirFryerDatabase models={airFryerModels} lang={lang as 'it'|'en'|'es'|'fr'} />
    </div>

    <AffiliateSlot lang={lang as 'it' | 'en' | 'es' | 'fr'} context="error-codes" />
    <ErrorFaq lang={lang as 'it' | 'en' | 'es' | 'fr'} />

    <section aria-labelledby="documented-brands" class="mt-20 pt-10 border-t border-slate-200 dark:border-slate-800 transition-colors">
      <h2 id="documented-brands" class="text-2xl font-bold text-slate-900 dark:text-white mb-8">
        {seoData.brandsTitle}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {availableBrands.map(b => (
          <a href={`${hubUrl}${b}/`} class="group block p-6 bg-slate-50 dark:bg-slate-900/50 rounded-2xl hover:bg-white dark:hover:bg-slate-800 transition-all duration-300 border border-slate-200 dark:border-slate-700/50 shadow-sm hover:shadow-md">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-lg font-semibold text-orange-600 dark:text-orange-400 group-hover:text-orange-700 dark:group-hover:text-orange-300 transition-colors">{capitalize(b)}</h3>
              <svg class="w-5 h-5 text-slate-400 group-hover:text-orange-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section aria-labelledby="useful-resources" class="mt-20 pt-10 border-t border-slate-200 dark:border-slate-800 transition-colors">
      <h2 id="useful-resources" class="text-2xl font-bold text-slate-900 dark:text-white mb-8">
        {seoData.usefulResourcesTitle}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <a href={seoData.linkCleaningUrl} class="group block p-6 bg-slate-50 dark:bg-slate-900/50 rounded-2xl hover:bg-white dark:hover:bg-slate-800 transition-all duration-300 border border-slate-200 dark:border-slate-700/50 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{seoData.linkCleaning}</h3>
            <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </a>
        <a href={seoData.linkConverterUrl} class="group block p-6 bg-slate-50 dark:bg-slate-900/50 rounded-2xl hover:bg-white dark:hover:bg-slate-800 transition-all duration-300 border border-slate-200 dark:border-slate-700/50 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{seoData.linkConverter}</h3>
            <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </a>
        <a href={seoData.linkRecipesUrl} class="group block p-6 bg-slate-50 dark:bg-slate-900/50 rounded-2xl hover:bg-white dark:hover:bg-slate-800 transition-all duration-300 border border-slate-200 dark:border-slate-700/50 shadow-sm hover:shadow-md">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-blue-600 dark:text-blue-400 group-hover:text-blue-700 dark:group-hover:text-blue-300 transition-colors">{seoData.linkRecipes}</h3>
            <svg class="w-5 h-5 text-slate-400 group-hover:text-blue-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </a>
      </div>
    </section>



  </section>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</MainLayout>