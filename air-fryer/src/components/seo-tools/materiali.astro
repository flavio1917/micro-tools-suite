---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;


const content = {
  it: {
    title: "Cosa Mettere (e Non) in Friggitrice ad Aria | Guida Materiali",
    h1: "Contenitori e Materiali per Friggitrice ad Aria: Cosa Si Può Mettere?",
    desc: "Carta forno, alluminio, silicone o vetro? Scopri quali contenitori usare in friggitrice ad aria e quali materiali evitare per non rovinare l'apparecchio.",
    intro: "Scopri quali materiali e contenitori puoi usare in sicurezza nella tua friggitrice ad aria. Questa guida ti mostra cosa mettere e cosa evitare per non rovinare l'apparecchio e cucinare in totale sicurezza.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Posso mettere la carta forno nella friggitrice ad aria?", a: "Sì, ma solo se fissata con il cibo sopra. Altrimenti vola verso la resistenza e può bruciarsi." },
      { q: "Il silicone è sicuro per la friggitrice ad aria?", a: "Sì, gli stampi in silicone alimentare resistono alle temperature della friggitrice e sono sicuri." },
      { q: "Posso usare contenitori in vetro?", a: "Solo se resistenti al calore (vetro temperato). Evita vetro sottile che può rompersi con gli sbalzi termici." },
      { q: "L'alluminio si può mettere?", a: "Sì, ma con cautela. Usa fogli di alluminio solo se ben fissati e non a contatto diretto con la resistenza." }
    ],
    eeatBadge: "✓ Standard di Sicurezza Verificati",
    fsTitle: "La Regola d'Oro: Cosa usare?",
    fsText: "In generale, <strong>qualsiasi contenitore adatto al forno tradizionale può essere utilizzato nella friggitrice ad aria</strong> (vetro temperato, ceramica, silicone, metallo). Tuttavia, a causa del violento flusso d'aria ciclonico, non inserire mai materiali leggeri sprovvisti di peso (come la carta forno da sola) o materiali a basso punto di fusione come la plastica.",
    safe: "🟢 SICURO (Vai tranquillo)",
    caution: "🟡 ATTENZIONE (Con riserva)",
    danger: "🔴 PERICOLO (Mai inserire)",
    items: [
      { status: "safe", name: "Carta Forno", desc: "Sì, ma usala solo se forata e SEMPRE con il cibo pesante sopra. Mai metterla durante il preriscaldamento o volerà sulla resistenza bruciandosi." },
      { status: "safe", name: "Alluminio (Carta Stagnola)", desc: "Sì, ma non metterlo a contatto con cibi molto acidi (come pomodoro o limone). Assicurati che sia ben fissato e che non ostruisca completamente il flusso d'aria sul fondo." },
      { status: "safe", name: "Stampi in Silicone", desc: "Sì, resistono fino a 230°C. Ottimi per muffin o torte, non si sciolgono e sono antiaderenti." },
      { status: "safe", name: "Pirofile in Vetro/Ceramica", desc: "Sì, purché abbiano il marchio 'Oven Safe' (resistenti al calore da forno). Ideali per sformati o lasagne." },
      { status: "safe", name: "Teglie e Griglie in Metallo", desc: "Sì. Acciaio, alluminio e ghisa sono perfetti e garantiscono una croccantezza uniforme." },
      { status: "caution", name: "Carta Assorbente (Scottex)", desc: "Mai per cuocere. Usala solo per asciugare il cibo PRIMA di inserirlo nel cestello. Nel cestello prende fuoco." },
      { status: "danger", name: "Plastica e Tupperware", desc: "Assolutamente no. Si scioglieranno in pochi secondi rovinando il cibo e la macchina." },
      { status: "danger", name: "Pellicola Trasparente", desc: "Assolutamente no. Si fonde immediatamente al contatto col calore." }
    ]
  },
  en: {
    title: "What to Put in an Air Fryer (and What Not To) | Materials Guide",
    h1: "Air Fryer Materials Guide: What Can You Put Inside?",
    desc: "Parchment paper, foil, silicone, or glass? Discover which containers are safe to use in your air fryer and which materials to avoid completely.",
    intro: "Discover which materials and containers you can safely use in your air fryer. This guide shows you what to put inside and what to avoid to protect your appliance and cook safely.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Can I put parchment paper in the air fryer?", a: "Yes, but only if weighed down by food. Otherwise, it will fly into the heating element and burn." },
      { q: "Is silicone safe for the air fryer?", a: "Yes, food-grade silicone molds can withstand air fryer temperatures and are perfectly safe." },
      { q: "Can I use glass containers?", a: "Only if they are heat-resistant (tempered glass or oven-safe). Avoid thin glass that might shatter." },
      { q: "Can I use aluminum foil?", a: "Yes, but use caution. Make sure it is securely tucked and not touching the heating element." }
    ],
    eeatBadge: "✓ Verified Safety Standards",
    fsTitle: "The Golden Rule: What to use?",
    fsText: "Generally, <strong>any oven-safe container can be used in an air fryer</strong> (tempered glass, ceramic, silicone, metal). However, due to the violent cyclonic airflow, never insert lightweight materials without weight on them (like parchment paper alone) or low-melting point materials like plastic.",
    safe: "🟢 SAFE (Good to go)",
    caution: "🟡 CAUTION (With reservations)",
    danger: "🔴 DANGER (Never insert)",
    items: [
      { status: "safe", name: "Parchment Paper", desc: "Yes, but only use it perforated and ALWAYS with heavy food on top. Never put it in during preheating or it will fly into the heating element and burn." },
      { status: "safe", name: "Aluminum Foil", desc: "Yes, but do not put it in contact with highly acidic foods (like tomato or lemon). Make sure it's secured and doesn't completely block the bottom airflow." },
      { status: "safe", name: "Silicone Molds", desc: "Yes, they resist up to 450°F. Great for muffins or cakes, they don't melt and are non-stick." },
      { status: "safe", name: "Glass/Ceramic Dishes", desc: "Yes, as long as they have the 'Oven Safe' mark. Ideal for casseroles." },
      { status: "safe", name: "Metal Pans and Racks", desc: "Yes. Steel, aluminum, and cast iron are perfect and guarantee uniform crispiness." },
      { status: "caution", name: "Paper Towels", desc: "Never for cooking. Only use them to dry food BEFORE putting it in the basket. In the basket, it will catch fire." },
      { status: "danger", name: "Plastic and Tupperware", desc: "Absolutely not. They will melt in seconds, ruining the food and the machine." },
      { status: "danger", name: "Cling Film / Saran Wrap", desc: "Absolutely not. It melts instantly on contact with heat." }
    ]
  },
  es: {
    title: "Qué Meter (y Qué No) en la Freidora de Aire | Guía de Materiales",
    h1: "Materiales y Recipientes para Freidora de Aire: ¿Qué se puede meter?",
    desc: "¿Papel de horno, papel de aluminio, silicona o cristal? Descubre qué recipientes son seguros para usar en la freidora de aire y cuáles debes evitar siempre.",
    intro: "Descubre qué materiales y recipientes puedes usar de forma segura en tu freidora de aire. Esta guía te muestra qué introducir y qué evitar para no dañar el aparato.",
    faqTitle: "FAQ",
    faqs: [
      { q: "¿Puedo poner papel de horno en la freidora de aire?", a: "Sí, pero solo si está sujeto con comida encima. De lo contrario, volará hacia la resistencia y se quemará." },
      { q: "¿Es segura la silicona para la freidora de aire?", a: "Sí, los moldes de silicona alimentaria resisten las altas temperaturas y son muy seguros." },
      { q: "¿Puedo usar recipientes de cristal?", a: "Solo si son resistentes al calor (vidrio templado). Evita el cristal fino que puede romperse por choque térmico." },
      { q: "¿Se puede meter papel de aluminio?", a: "Sí, pero con precaución. Asegúrate de que esté bien fijado y no toque directamente la resistencia." }
    ],
    eeatBadge: "✓ Estándares de Seguridad Verificados",
    fsTitle: "La Regla de Oro: ¿Qué usar?",
    fsText: "En general, <strong>cualquier recipiente apto para horno tradicional se puede utilizar en la freidora de aire</strong> (vidrio templado, cerámica, silicona, metal). Sin embargo, debido al violento flujo de aire ciclónico, nunca introduzcas materiales ligeros sin peso (como papel de horno solo) ni materiales de bajo punto de fusión como el plástico.",
    safe: "🟢 SEGURO (Adelante)",
    caution: "🟡 PRECAUCIÓN (Con cuidado)",
    danger: "🔴 PELIGRO (Nunca introducir)",
    items: [
      { status: "safe", name: "Papel de Horno", desc: "Sí, pero úsalo solo perforado y SIEMPRE con comida pesada encima. Nunca lo pongas durante el precalentamiento o volará hacia la resistencia y se quemará." },
      { status: "safe", name: "Papel de Aluminio", desc: "Sí, pero no lo pongas en contacto con alimentos muy ácidos (como tomate o limón). Asegúrate de que esté bien fijado y no obstruya el flujo de aire." },
      { status: "safe", name: "Moldes de Silicona", desc: "Sí, resisten hasta 230°C. Geniales para magdalenas o tartas, no se derriten y son antiadherentes." },
      { status: "safe", name: "Pirex de Vidrio/Cerámica", desc: "Sí, siempre que tengan la marca 'Apto para Horno'. Ideales para pasteles de carne." },
      { status: "safe", name: "Bandejas de Metal", desc: "Sí. Acero, aluminio y hierro fundido son perfectos y garantizan un crujido uniforme." },
      { status: "caution", name: "Papel Absorbente (Rollo de cocina)", desc: "Nunca para cocinar. Úsalo solo para secar la comida ANTES de meterla. Dentro se incendiará." },
      { status: "danger", name: "Plástico y Tupperware", desc: "Absolutamente no. Se derretirán en segundos arruinando la comida y la máquina." },
      { status: "danger", name: "Film Transparente", desc: "Absolutamente no. Se funde inmediatamente al contacto con el calor." }
    ]
  },
  fr: {
    title: "Que Mettre (et Ne Pas Mettre) dans une Friteuse à Air | Matériaux",
    h1: "Récipients et Matériaux pour Friteuse à Air : Que peut-on mettre ?",
    desc: "Papier cuisson, papier d'aluminium, silicone ou verre ? Découvrez quels récipients utiliser sans aucun danger dans votre friteuse à air et ceux à éviter.",
    intro: "Découvrez quels matériaux et récipients vous pouvez utiliser en toute sécurité dans votre friteuse à air. Ce guide vous montre quoi mettre et quoi éviter pour protéger votre appareil.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Puis-je mettre du papier cuisson dans la friteuse à air ?", a: "Oui, mais uniquement s'il est maintenu par des aliments. Sinon, il volera vers la résistance et brûlera." },
      { q: "Le silicone est-il sûr pour la friteuse à air ?", a: "Oui, les moules en silicone alimentaire résistent aux températures de la friteuse et sont sûrs." },
      { q: "Puis-je utiliser des récipients en verre ?", a: "Seulement s'ils résistent à la chaleur (verre trempé). Évitez le verre fin qui peut se briser sous l'effet de la chaleur." },
      { q: "Peut-on mettre du papier d'aluminium ?", a: "Oui, mais avec prudence. Assurez-vous qu'il est bien fixé et qu'il ne touche pas la résistance." }
    ],
    eeatBadge: "✓ Normes de Sécurité Vérifiées",
    fsTitle: "La Règle d'Or : Que peut-on utiliser ?",
    fsText: "En général, <strong>tout récipient allant au four traditionnel peut être utilisé dans la friteuse à air</strong> (verre trempé, céramique, silicone, métal). Cependant, en raison du flux d'air cyclonique, n'insérez jamais de matériaux légers non lestés (comme le papier sulfurisé seul) ou des matériaux à bas point de fusion comme le plastique.",
    safe: "🟢 SÛR (Allez-y)",
    caution: "🟡 ATTENTION (Sous réserve)",
    danger: "🔴 DANGER (Ne jamais insérer)",
    items: [
      { status: "safe", name: "Papier Cuisson", desc: "Oui, mais utilisez-le perforé et TOUJOURS avec des aliments lourds dessus. Ne le mettez jamais pendant le préchauffage, il s'envolerait sur la résistance." },
      { status: "safe", name: "Papier d'Aluminium", desc: "Oui, mais évitez le contact avec des aliments très acides (tomate, citron). Fixez-le bien pour ne pas bloquer l'air au fond." },
      { status: "safe", name: "Moules en Silicone", desc: "Oui, résiste jusqu'à 230°C. Parfait pour muffins ou gâteaux, antiadhésif et ne fond pas." },
      { status: "safe", name: "Plats en Verre/Céramique", desc: "Oui, à condition d'avoir le logo 'Passe au four'. Idéal pour les gratins." },
      { status: "safe", name: "Grilles et Plaques en Métal", desc: "Oui. L'acier, l'aluminium et la fonte sont parfaits pour une cuisson uniforme." },
      { status: "caution", name: "Essuie-tout", desc: "Jamais pour cuire. Utilisez-le uniquement pour sécher les aliments AVANT cuisson. Dans le panier, il prendra feu." },
      { status: "danger", name: "Plastique et Tupperware", desc: "Absolument pas. Ils fondront en quelques secondes, ruinant l'aliment et l'appareil." },
      { status: "danger", name: "Film Alimentaire", desc: "Absolument pas. Il fond instantanément au contact de la chaleur." }
    ]
  }
};

const t = content[lang as keyof typeof content] || content.it;

// === INJECTED SEO DATA ===
const alternateUrls = {
  it: `https://www.crispissimo.com/strumenti/materiali-friggitrice-ad-aria/`,
  en: `https://www.crispissimo.com/en/tools/air-fryer-materials-guide/`,
  es: `https://www.crispissimo.com/es/herramientas/materiales-freidora-aire/`,
  fr: `https://www.crispissimo.com/fr/outils/materiaux-friteuse-air/`,
  "x-default": `https://www.crispissimo.com/strumenti/materiali-friggitrice-ad-aria/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.crispissimo.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti",
      "item": `https://www.crispissimo.com${{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {"it": "Materiali Friggitrice ad Aria", "en": "Air Fryer Materials", "es": "Materiales Freidora de Aire", "fr": "Mat\u00e9riaux Friteuse \u00e0 Air"}[lang] || "",
      "item": alternateUrls[lang] || alternateUrls.it
    }
  ]
};

const currentFaqs = t.faqs || [];
const faqSchema = currentFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": currentFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q || faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a || faq.answer
    }
  }))
} : null;
---

<MainLayout alternateUrls={alternateUrls} title={t.title} lang={lang} description={t.desc}>
  <section class="max-w-4xl mx-auto py-12 md:py-16 px-4">

    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{{"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti"}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate">{{"it": "Materiali Friggitrice ad Aria", "en": "Air Fryer Materials", "es": "Materiales Freidora de Aire", "fr": "Mat\u00e9riaux Friteuse \u00e0 Air"}[lang] || ""}</li>
      </ol>
    </nav>

    <header class="text-center mb-12">
      <div class="inline-flex items-center justify-center mb-6">
         <span class="px-4 py-1.5 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-500/30 rounded-full text-xs text-emerald-700 dark:text-emerald-400 font-bold shadow-sm transition-colors">
           {t.eeatBadge}
         </span>
      </div>

      <h1 class="tool-title text-3xl md:text-5xl mb-4 text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 pb-1">{t.h1}</h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto font-medium mb-6 text-slate-600 dark:text-slate-300">{t.intro}</p>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto">{t.desc}</p>
    </header>

    <div class="space-y-8 max-w-3xl mx-auto relative z-10">

      <div class="tool-card relative overflow-hidden">
        <div class="absolute top-0 left-0 w-1.5 h-full bg-blue-500"></div>
        <h2 class="tool-subtitle mb-3">{t.fsTitle}</h2>
        <p class="tool-text text-sm md:text-base" set:html={t.fsText}></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 p-4 rounded-xl text-center shadow-sm transition-colors">
          <span class="font-bold text-green-800 dark:text-green-400 text-sm">{t.safe}</span>
        </div>
        <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 p-4 rounded-xl text-center shadow-sm transition-colors">
          <span class="font-bold text-amber-800 dark:text-amber-400 text-sm">{t.caution}</span>
        </div>
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4 rounded-xl text-center shadow-sm transition-colors">
          <span class="font-bold text-red-800 dark:text-red-400 text-sm">{t.danger}</span>
        </div>
      </div>

      <div class="space-y-6">
        {t.items.map((item) => (
          <div class="tool-card flex flex-col md:flex-row gap-6 items-start relative overflow-hidden group hover:border-slate-400 dark:hover:border-slate-500 hover:-translate-y-1 transition-all duration-300 !p-6">

            <div class={`absolute left-0 top-0 bottom-0 w-1.5 transition-all duration-300 ${
              item.status === 'safe' ? 'bg-green-500' :
              item.status === 'caution' ? 'bg-amber-500' : 'bg-red-500'
            }`}></div>

            <div class="flex-shrink-0 w-14 h-14 rounded-full flex items-center justify-center text-3xl bg-slate-50 dark:bg-slate-900/80 shadow-inner border border-slate-200 dark:border-white/5 drop-shadow-md transition-colors">
              {item.status === 'safe' ? '✅' : item.status === 'caution' ? '⚠️' : '❌'}
            </div>

            <div class="flex-1">
              <h3 class={`text-xl font-bold mb-2 transition-colors ${
                item.status === 'safe' ? 'text-green-700 dark:text-green-400' :
                item.status === 'caution' ? 'text-amber-700 dark:text-amber-400' : 'text-red-700 dark:text-red-400'
              }`}>{item.name}</h3>
              <p class="tool-text text-base">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800 transition-colors">

    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-xl font-bold mb-4 text-slate-800 dark:text-white">Strumenti Correlati</h3>
      <ul class="space-y-2 text-slate-600 dark:text-slate-400">
        <li><a href={lang === 'it' ? '/strumenti/codici-errore-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-error-codes/' : lang === 'es' ? '/es/herramientas/codigos-error-freidora-aire/' : '/fr/outils/codes-erreur-friteuse-air/'} class="hover:text-orange-500 underline">Codici Errore Friggitrice ad Aria</a></li>
        <li><a href={lang === 'it' ? '/strumenti/fumo-puzza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-smell-smoke/' : lang === 'es' ? '/es/herramientas/freidora-aire-humo-olor/' : '/fr/outils/friteuse-air-fumee-odeur/'} class="hover:text-orange-500 underline">Fumo e Puzza</a></li>
        <li><a href={lang === 'it' ? '/strumenti/pulire-resistenza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/clean-air-fryer-heating-element/' : lang === 'es' ? '/es/herramientas/limpiar-resistencia-freidora-aire/' : '/fr/outils/nettoyer-resistance-friteuse-air/'} class="hover:text-orange-500 underline">Pulizia Resistenza</a></li>
      </ul>
    </div>


    {t.faqs && t.faqs.length > 0 && (
      <div class="mt-12 max-w-3xl mx-auto">
        <h2 class="tool-subtitle mb-6 border-b border-slate-200 dark:border-slate-700 pb-4">{t.faqTitle || "FAQ"}</h2>
        <div class="space-y-4">
          {t.faqs.map((faq) => (
            <details class="group tool-faq-item [&_summary::-webkit-details-marker]:hidden bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl p-4 sm:p-5 shadow-sm">
              <summary class="flex justify-between items-center font-bold cursor-pointer list-none text-slate-800 dark:text-slate-100 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
                {faq.q || faq.question}
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="tool-text mt-4 text-base border-t border-slate-200 dark:border-slate-800 pt-4">{faq.a || faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    <Disclaimer type="generale" lang={lang} />
    </div>



  </section>

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</MainLayout>