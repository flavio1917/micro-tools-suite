---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { problemiContent, problemiBackBtnLabel } from '../../i18n/pages/tools/problemi';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;
const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;

const backBtnLabel = problemiBackBtnLabel[lang as keyof typeof problemiBackBtnLabel] || problemiBackBtnLabel.it;
const t = problemiContent[lang as keyof typeof problemiContent] || problemiContent.it;

// Dati Strutturati FAQ Aggiornati per E-E-A-T
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.items.map(item => ({
    "@type": "Question",
    "name": `Perché la friggitrice ad aria fa ${item.name.toLowerCase()}?`, 
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `Questo problema si verifica perché: ${item.cause} Per risolvere rapidamente il problema: ${item.solution}`
    }
  }))
};

// Dati Strutturati Breadcrumb
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": `https://www.convertitorefriggitrice.it/${lang === 'it' ? '' : lang}`
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "Risoluzione Problemi",
    "item": `https://www.convertitorefriggitrice.it/${lang}/problemi`
  }]
};
---

<MainLayout title={t.title} lang={lang} description={t.desc}>
  <section class="max-w-4xl mx-auto py-8 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-white dark:bg-slate-800/90 backdrop-blur-md text-slate-700 dark:text-white border border-slate-200 dark:border-slate-600/50 shadow-xl rounded-full hover:bg-slate-50 dark:hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>
    
    <header class="text-center mb-8">
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-yellow-500 dark:from-orange-400 dark:to-yellow-300 pb-1">{t.h1}</h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto">{t.desc}</p>
    </header>

    <div class="tool-card-inner bg-blue-50 dark:bg-blue-900/10 border-blue-200 dark:border-blue-500/30 mb-12 max-w-3xl mx-auto shadow-sm dark:shadow-inner">
      <h3 class="tool-subtitle !text-blue-700 dark:!text-blue-400 mb-4">{t.fsTitle}</h3>
      <ol class="space-y-3 tool-text list-decimal list-inside marker:text-blue-600 dark:marker:text-blue-500 font-medium">
        {t.fsList.map(rule => (
          <li class="leading-relaxed pl-2" set:html={rule}></li>
        ))}
      </ol>
    </div>

    <aside class="tool-card-alert mb-12 max-w-3xl mx-auto animate-fade-in" role="alert">
      <h2 class="text-lg font-bold text-red-600 dark:text-red-400 mb-2 flex items-center gap-2 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        {t.emergencyTitle}
      </h2>
      <p class="tool-text text-sm md:text-base font-medium">{t.emergency}</p>
    </aside>

    <nav aria-label={t.quickNav} class="flex flex-wrap justify-center gap-2 md:gap-3 mb-12">
      <span class="tool-label w-full text-center !mb-2">{t.quickNav}</span>
      {t.items.map((item) => (
        <a href={`#${item.id}`} class="inline-flex items-center gap-1.5 px-4 py-2 bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-full text-xs md:text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 hover:text-orange-600 dark:hover:text-white transition-all shadow-sm focus:ring-2 focus:ring-orange-500 outline-none">
          <span aria-hidden="true">{item.emoji}</span> {item.name}
        </a>
      ))}
    </nav>

    <div class="space-y-6 mb-16">
      {t.items.map((item) => (
        <article id={item.id} class="tool-card group flex flex-col md:flex-row gap-6 scroll-mt-24 hover:border-slate-400 dark:hover:border-slate-500/50">
          <div class="flex-shrink-0 w-16 h-16 rounded-full flex items-center justify-center text-4xl bg-slate-50 dark:bg-slate-900/50 shadow-inner border border-slate-200 dark:border-white/5 group-hover:scale-110 group-hover:rotate-6 transition-all duration-300" aria-hidden="true">
            {item.emoji}
          </div>
          
          <div class="flex-1 space-y-4">
            <h2 class="tool-subtitle mb-1">{item.name}</h2>
            
            <div class="tool-card-inner p-4">
              <span class="tool-label !mb-1.5 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {t.causeLabel}
              </span>
              <p class="tool-text text-sm md:text-base">{item.cause}</p>
            </div>
            
            <div class="tool-card-inner bg-blue-50 dark:bg-blue-950/20 border-blue-200 dark:border-blue-500/20 p-4 shadow-sm">
              <span class="tool-label !text-blue-700 dark:!text-blue-400 !mb-1.5 flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                {t.solutionLabel}
              </span>
              <p class="text-blue-900 dark:text-blue-100 text-sm md:text-base font-medium leading-relaxed transition-colors">{item.solution}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <Disclaimer type="elettrico" lang={lang} />

    <div class="mt-12 text-center pt-8 border-t border-slate-200 dark:border-slate-800 transition-colors">
      <a href={homeUrl} class="inline-flex items-center justify-center px-6 py-3 bg-white dark:bg-slate-800/90 backdrop-blur-md text-slate-700 dark:text-white border border-slate-200 dark:border-slate-600/50 shadow-xl rounded-full hover:bg-slate-50 dark:hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

</MainLayout>