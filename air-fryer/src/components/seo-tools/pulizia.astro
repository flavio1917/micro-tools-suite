---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;

// DIZIONARIO SEO SPECIFICO (Anti-Boilerplate)
const seoData = {
  it: {
    title: "Come Pulire la Resistenza della Friggitrice ad Aria",
    description: "Scopri come pulire e sgrassare la serpentina della tua friggitrice ad aria senza graffiare il rivestimento. Metodo sicuro ed ecologico in 5 step."
  },
  en: {
    title: "How to Clean Air Fryer Heating Element Safely",
    description: "Discover how to clean and degrease the heating coil of your air fryer without scratching the non-stick coating. Safe 5-step eco-friendly method."
  },
  es: {
    title: "Cómo Limpiar la Resistencia de la Freidora de Aire",
    description: "Descubre cómo limpiar y desengrasar la resistencia de tu freidora de aire sin rayar el revestimiento de teflón. Método ecológico y seguro en 5 pasos."
  },
  fr: {
    title: "Comment Nettoyer la Résistance de la Friteuse à Air",
    description: "Découvrez comment nettoyer et dégraisser la résistance de votre friteuse à air sans rayer le revêtement. Méthode écologique sûre en 5 étapes."
  }
};

const currentSeo = seoData[lang as keyof typeof seoData] || seoData.it;


const content = {
  it: {
    h1: "Come Pulire la Resistenza della Friggitrice ad Aria in Sicurezza",
    intro: "La resistenza della friggitrice ad aria si sporca e fa fumo? Scopri come pulire e sgrassare la serpentina in sicurezza, senza graffiare il rivestimento antiaderente e senza prodotti aggressivi.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Posso usare lo sgrassatore per il forno?", a: "Assolutamente no. I residui chimici verrebbero vaporizzati sul cibo alla prima accensione. Usa solo prodotti naturali come il bicarbonato." },
      { q: "Come evito che la resistenza si sporchi?", a: "Non riempire mai troppo il cestello e usa un paraschizzi se disponibile. Cuoci cibi molto grassi (come la pancetta) a temperature leggermente inferiori." },
      { q: "Ogni quanto devo pulire la serpentina?", a: "Controllala visivamente una volta al mese. Puliscila solo se noti accumuli evidenti di grasso o se l'apparecchio fa fumo." }
    ],
    desc: currentSeo.description,
    eeatBadge: "✓ Metodo Sicuro Verificato",
    dangerTitle: "🚫 Assolutamente Vietato",
    dangerText: "Mai usare sgrassatori industriali da forno (es. schiume attive), spugne in metallo o lame. I residui chimici brucerebbero alla prima accensione intossicando il cibo.",
    reqTitle: "Cosa ti serve:",
    toolLabel: "🛠️ Strumenti",
    supplyLabel: "🧪 Materiali (Naturali)",
    tools: ["Spazzolino a setole morbide", "Panno in microfibra", "Carta assorbente"],
    supplies: ["Bicarbonato di sodio", "Acqua tiepida", "Mezzo limone (opzionale)"],
    steps: [
      { title: "Scollega e Proteggi il Display", desc: "Stacca la spina e assicurati che la macchina sia fredda. Stendi un asciugamano spesso sul tavolo e capovolgi DELICATAMENTE il corpo motore." },
      { title: "Crea la Pasta Naturale", desc: "Mescola 3 cucchiai di bicarbonato con 1 d'acqua. Ottieni una pasta densa, simile al dentifricio. Il bicarbonato sgrassa senza graffiare il metallo." },
      { title: "Applica con Precisione", desc: "Usa uno spazzolino a setole MORBIDE. Massaggia la pasta sulla serpentina metallica, evitando di spingerla dentro le fessure della ventola." },
      { title: "Lascia Agire la Chimica", desc: "Il grasso ha bisogno di tempo per sciogliersi. Lascia agire per 15-20 minuti. Non accendere MAI la macchina in questa fase." },
      { title: "Risciacquo a Umido e Asciugatura", desc: "Usa un panno in microfibra umido e ben strizzato per rimuovere la pasta. Asciuga perfettamente con carta assorbente. Lascia asciugare all'aria per 30 minuti." }
    ]
  },
  en: {
    h1: "How to Clean the Air Fryer Heating Element Safely",
    intro: "Is your air fryer heating element dirty and smoking? Discover how to clean and degrease the coil safely without scratching the non-stick coating and without harsh chemicals.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Can I use oven cleaner?", a: "Absolutely not. Chemical residues will vaporize into your food the next time you cook. Only use natural products like baking soda." },
      { q: "How do I prevent the element from getting dirty?", a: "Never overfill the basket and use a splatter shield if available. Cook very fatty foods (like bacon) at slightly lower temperatures." },
      { q: "How often should I clean the heating element?", a: "Check it visually once a month. Only clean it if you see obvious grease buildup or if the appliance is smoking." }
    ],
    desc: currentSeo.description,
    eeatBadge: "✓ Verified Safe Method",
    dangerTitle: "🚫 Strictly Prohibited",
    dangerText: "Never use heavy-duty oven cleaners, steel wool, or blades. Chemical residues will vaporize into your food.",
    reqTitle: "What you need:",
    toolLabel: "🛠️ Tools",
    supplyLabel: "🧪 Supplies (Natural)",
    tools: ["Soft-bristle toothbrush", "Microfiber cloth", "Paper towels"],
    supplies: ["Baking soda", "Warm water", "Half a lemon (optional)"],
    steps: [
      { title: "Unplug and Protect the Display", desc: "Unplug the unit. Place a thick towel on your counter and GENTLY turn the main unit upside down." },
      { title: "Mix the Natural Paste", desc: "Mix 3 tablespoons of baking soda with 1 tablespoon of water. You want a thick paste, like toothpaste." },
      { title: "Apply with Precision", desc: "Use a SOFT-bristled toothbrush. Gently scrub the metal coil. Do not push paste into the fan slots." },
      { title: "Let Chemistry Work", desc: "Let the paste sit for 15-20 minutes to break down grease. NEVER plug in the machine during this phase." },
      { title: "Damp Rinse and Dry", desc: "Use a damp microfiber cloth (wrung out tightly) to wipe away the paste. Dry perfectly with paper towels." }
    ]
  },
  es: {
    h1: "Cómo Limpiar la Resistencia de la Freidora de Aire de Forma Segura",
    intro: "¿La resistencia de la freidora de aire se ensucia y hace humo? Descubre cómo limpiar y desengrasar la resistencia de forma segura, sin rayar el teflón y sin productos agresivos.",
    faqTitle: "FAQ",
    faqs: [
      { q: "¿Puedo usar desengrasante para hornos?", a: "Absolutamente no. Los residuos químicos se vaporizarán en tu comida. Usa solo productos naturales como el bicarbonato." },
      { q: "¿Cómo evito que la resistencia se ensucie?", a: "Nunca llenes demasiado la cesta y usa una tapa antisalpicaduras si la tienes. Cocina alimentos muy grasos a temperaturas más bajas." },
      { q: "¿Con qué frecuencia debo limpiar la resistencia?", a: "Revísala visualmente una vez al mes. Límpiala solo si notas acumulaciones de grasa evidentes o si el aparato hace humo." }
    ],
    desc: currentSeo.description,
    eeatBadge: "✓ Método Seguro Verificado",
    dangerTitle: "🚫 Totalmente Prohibido",
    dangerText: "Nunca uses desengrasantes para hornos, estropajos metálicos o cuchillas. Los químicos intoxicarán tu comida.",
    reqTitle: "Qué necesitas:",
    toolLabel: "🛠️ Herramientas",
    supplyLabel: "🧪 Materiales (Naturales)",
    tools: ["Cepillo de cerdas suaves", "Paño de microfibra", "Papel absorbente"],
    supplies: ["Bicarbonato de sodio", "Agua tibia", "Medio limón (opcional)"],
    steps: [
      { title: "Desenchufa y Protege la Pantalla", desc: "Desenchufa. Pon una toalla gruesa en la mesa y voltea la máquina DELICADAMENTE sobre ella." },
      { title: "Crea la Pasta Natural", desc: "Mezcla 3 cucharadas de bicarbonato con 1 de agua. Debe ser una pasta espesa, similar a la pasta de dientes." },
      { title: "Aplica con Precision", desc: "Usa un cepillo de cerdas SUAVES. Frota suavemente la resistencia. No empujes la pasta hacia el ventilador." },
      { title: "Deja Actuar", desc: "Deja actuar la pasta 15-20 minutos. NUNCA enciendas la máquina en esta fase." },
      { title: "Enjuague Húmedo", desc: "Usa un paño de microfibra húmedo muy escurrido para retirar la pasta. Seca perfectamente con papel absorbente." }
    ]
  },
  fr: {
    h1: "Guide de Nettoyage de la Résistance",
    intro: "La résistance de la friteuse à air se salit et fume ? Découvrez comment nettoyer et dégraisser la résistance en toute sécurité, sans rayer le revêtement antiadhésif.",
    faqTitle: "FAQ",
    faqs: [
      { q: "Puis-je utiliser un dégraissant pour four ?", a: "Absolument pas. Les résidus chimiques se vaporiseraient sur vos aliments. Utilisez uniquement des produits naturels comme le bicarbonate." },
      { q: "Comment éviter que la résistance ne se salisse ?", a: "Ne remplissez jamais trop le panier et utilisez un couvercle anti-éclaboussures si possible. Cuisez les aliments très gras à des températures plus basses." },
      { q: "À quelle fréquence dois-je nettoyer la résistance ?", a: "Vérifiez-la visuellement une fois par mois. Nettoyez-la uniquement si vous remarquez des accumulations évidentes de graisse ou si l'appareil fume." }
    ],
    desc: currentSeo.description,
    eeatBadge: "✓ Méthode Sûre Vérifiée",
    dangerTitle: "🚫 Strictement Interdit",
    dangerText: "N'utilisez jamais de dégraissants pour four, d'éponges métalliques ou de lames. Les résidus intoxiqueront vos aliments.",
    reqTitle: "Ce dont vous avez besoin :",
    toolLabel: "🛠️ Outils",
    supplyLabel: "🧪 Fournitures (Naturelles)",
    tools: ["Brosse à poils souples", "Chiffon en microfibre", "Essuie-tout"],
    supplies: ["Bicarbonate de soude", "Eau tiède", "Un demi-citron (facultatif)"],
    steps: [
      { title: "Débranchez et Protégez l'Écran", desc: "Débranchez. Placez une serviette épaisse sur la table et retournez DÉLICATEMENT l'appareil." },
      { title: "Créez la Pâte Naturelle", desc: "Mélangez 3 cuillères à soupe de bicarbonate avec 1 d'eau. Obtenez une pâte épaisse, semblable à du dentifrice." },
      { title: "Appliquez avec Précision", desc: "Utilisez une brosse à poils SOUPLES. Massez la pâte sur la résistance sans en pousser dans le ventilateur." },
      { title: "Laissez Agir", desc: "Laissez la pâte agir 15-20 minutes. Ne branchez JAMAIS l'appareil pendant cette phase." },
      { title: "Rinçage Humide", desc: "Utilisez un chiffon humide très essoré pour retirer la pâte. Séchez parfaitement avec de l'essuie-tout." }
    ]
  }
};

const t = content[lang as keyof typeof content] || content.it;

// SCHEMA.ORG: How-To Perfetto e Sincronizzato con la UI (Immagini incluse!)
const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": currentSeo.title,
  "description": currentSeo.description,
  "totalTime": "PT30M",
  "tool": t.tools.map(tool => ({ "@type": "HowToTool", "name": tool })),
  "supply": t.supplies.map(supply => ({ "@type": "HowToSupply", "name": supply })),
  "step": t.steps.map((step, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "name": step.title,
    "text": step.desc,
    "image": `https://www.convertitorefriggitrice.it/images/pulizia/step_${index + 1}.jpg`
  }))
};

// === INJECTED SEO DATA ===
const alternateUrls = {
  it: `https://www.crispissimo.com/strumenti/pulire-resistenza-friggitrice-ad-aria/`,
  en: `https://www.crispissimo.com/en/tools/clean-air-fryer-heating-element/`,
  es: `https://www.crispissimo.com/es/herramientas/limpiar-resistencia-freidora-aire/`,
  fr: `https://www.crispissimo.com/fr/outils/nettoyer-resistance-friteuse-air/`,
  "x-default": `https://www.crispissimo.com/strumenti/pulire-resistenza-friggitrice-ad-aria/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.crispissimo.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti",
      "item": `https://www.crispissimo.com${{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {"it": "Pulizia Resistenza", "en": "Cleaning Heating Element", "es": "Limpiar Resistencia", "fr": "Nettoyer R\u00e9sistance"}[lang] || "",
      "item": alternateUrls[lang] || alternateUrls.it
    }
  ]
};

const currentFaqs = t.faqs || [];
const faqSchema = currentFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": currentFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q || faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a || faq.answer
    }
  }))
} : null;
---

<MainLayout alternateUrls={alternateUrls} title={currentSeo.title} lang={lang} description={currentSeo.description}>
  <section class="max-w-4xl mx-auto py-12 md:py-16 px-4">

    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{{"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti"}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate">{{"it": "Pulizia Resistenza", "en": "Cleaning Heating Element", "es": "Limpiar Resistencia", "fr": "Nettoyer R\u00e9sistance"}[lang] || ""}</li>
      </ol>
    </nav>

    <header class="text-center mb-10">
       <div class="inline-flex items-center justify-center mb-6">
         <span class="px-4 py-1.5 bg-blue-50 dark:bg-blue-950/50 backdrop-blur-sm border border-blue-200 dark:border-blue-500/30 rounded-full text-xs text-blue-600 dark:text-blue-400 font-bold shadow-sm dark:shadow-lg transition-colors">
           {t.eeatBadge}
         </span>
      </div>

      <h1 class="tool-title text-3xl md:text-5xl mb-4 text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 pb-1">{t.h1}</h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto font-medium mb-6 text-slate-600 dark:text-slate-300">{t.intro}</p>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto">{t.desc}</p>
    </header>

    <div class="tool-card-alert mb-10 max-w-3xl mx-auto">
      <h2 class="text-lg font-black text-red-600 dark:text-red-400 mb-2 flex items-center gap-2 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        {t.dangerTitle}
      </h2>
      <p class="tool-text text-sm md:text-base font-medium">
        {t.dangerText}
      </p>
    </div>

    <div class="max-w-3xl mx-auto mb-12">
      <h3 class="tool-subtitle mb-4 pl-2">{t.reqTitle}</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="tool-card-inner">
          <h4 class="tool-label !text-blue-600 dark:!text-blue-400 mb-3">{t.toolLabel}</h4>
          <ul class="space-y-2 tool-text text-sm md:text-base">
            {t.tools.map(tool => (
              <li class="flex items-center gap-2"><span class="text-blue-500">✔</span> {tool}</li>
            ))}
          </ul>
        </div>
        <div class="tool-card-inner">
          <h4 class="tool-label !text-emerald-600 dark:!text-emerald-400 mb-3">{t.supplyLabel}</h4>
          <ul class="space-y-2 tool-text text-sm md:text-base">
            {t.supplies.map(supply => (
              <li class="flex items-center gap-2"><span class="text-emerald-500">✔</span> {supply}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="max-w-3xl mx-auto space-y-8 mb-16 relative before:absolute before:inset-0 before:ml-[1.1rem] md:before:ml-6 before:-z-10 before:h-full before:w-0.5 before:bg-slate-200 dark:before:bg-slate-700 transition-colors">
      {t.steps.map((step, index) => (
        <article class="flex gap-4 md:gap-6 relative group">
          <div class="flex-shrink-0 w-10 h-10 md:w-12 md:h-12 rounded-full bg-blue-600 flex items-center justify-center font-black text-white shadow-md dark:shadow-[0_0_15px_rgba(37,99,235,0.5)] ring-4 ring-orange-50 dark:ring-[#0B1120] z-10 text-lg md:text-xl group-hover:scale-110 transition-all">
            {index + 1}
          </div>
          <div class="pt-1.5 md:pt-2 w-full tool-card !p-5 md:!p-6 hover:border-blue-300 dark:hover:border-blue-500/30">
            <h3 class="tool-subtitle !text-lg md:!text-xl mb-3">{step.title}</h3>
            <p class="tool-text text-sm md:text-base mb-5">{step.desc}</p>

            {/* IMMAGINE DELLO STEP - Dinamica */}
            <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-slate-600/50 shadow-sm dark:shadow-lg bg-slate-100 dark:bg-slate-900/50 transition-colors">
              <img
                src={`/images/pulizia/step_${index + 1}.jpg`}
                alt={step.title}
                class="w-full h-auto object-cover max-h-80"
                loading="lazy"
                onerror="this.parentElement.style.display='none';"
              />
            </div>

          </div>
        </article>
      ))}
    </div>

    <div class="mt-8 border-t border-slate-200 dark:border-slate-800 pt-8 transition-colors">

    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-xl font-bold mb-4 text-slate-800 dark:text-white">Strumenti Correlati</h3>
      <ul class="space-y-2 text-slate-600 dark:text-slate-400">
        <li><a href={lang === 'it' ? '/strumenti/codici-errore-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-error-codes/' : lang === 'es' ? '/es/herramientas/codigos-error-freidora-aire/' : '/fr/outils/codes-erreur-friteuse-air/'} class="hover:text-orange-500 underline">Codici Errore Friggitrice ad Aria</a></li>
        <li><a href={lang === 'it' ? '/strumenti/fumo-puzza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-smell-smoke/' : lang === 'es' ? '/es/herramientas/freidora-aire-humo-olor/' : '/fr/outils/friteuse-air-fumee-odeur/'} class="hover:text-orange-500 underline">Fumo e Puzza</a></li>
        <li><a href={lang === 'it' ? '/strumenti/pulire-resistenza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/clean-air-fryer-heating-element/' : lang === 'es' ? '/es/herramientas/limpiar-resistencia-freidora-aire/' : '/fr/outils/nettoyer-resistance-friteuse-air/'} class="hover:text-orange-500 underline">Pulizia Resistenza</a></li>
      </ul>
    </div>


    {t.faqs && t.faqs.length > 0 && (
      <div class="mt-12 max-w-3xl mx-auto">
        <h2 class="tool-subtitle mb-6 border-b border-slate-200 dark:border-slate-700 pb-4">{t.faqTitle || "FAQ"}</h2>
        <div class="space-y-4">
          {t.faqs.map((faq) => (
            <details class="group tool-faq-item [&_summary::-webkit-details-marker]:hidden bg-white dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 rounded-xl p-4 sm:p-5 shadow-sm">
              <summary class="flex justify-between items-center font-bold cursor-pointer list-none text-slate-800 dark:text-slate-100 hover:text-orange-600 dark:hover:text-orange-400 transition-colors">
                {faq.q || faq.question}
                <span class="transition group-open:rotate-180">
                  <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="tool-text mt-4 text-base border-t border-slate-200 dark:border-slate-800 pt-4">{faq.a || faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    )}

    <Disclaimer type="elettrico" lang={lang} />
    </div>



  </section>

  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</MainLayout>