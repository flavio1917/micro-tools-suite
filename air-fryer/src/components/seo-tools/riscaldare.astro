        ]
      },
      {
        id: "contorni", icon: "🍟", title: "Accompagnements",
        items: [
          { emoji: "🍟", name: "Frites", temp: "180°C", time: "4-5 min", tip: "Secouez le panier à mi-cuisson et ajoutez un pschitt d'huile." },
          { emoji: "🥦", name: "Légumes Rôtis", temp: "160°C", time: "4-5 min", tip: "Ajoutez une cuillère à café d'eau au fond du panier pour créer de la vapeur." }
        ]
      }
    ]
  }
};

const t = content[lang as keyof typeof content] || content.it;

// Appiattisco tutte le categorie per generare lo Schema.org FAQ unico
const allItems = t.categories.flatMap(cat => cat.items);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": allItems.map(item => ({
    "@type": "Question",
    "name": `Come riscaldare ${item.name.toLowerCase()} nella friggitrice ad aria?`, 
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `Imposta a ${item.temp} per ${item.time}. Consiglio: ${item.tip}`
    }
  }))
};
---

<MainLayout title={currentSeo.title} lang={lang} description={currentSeo.description}>
  <section class="max-w-5xl mx-auto py-12 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-white dark:bg-slate-800/90 backdrop-blur-md text-slate-700 dark:text-white border border-slate-200 dark:border-slate-600/50 shadow-xl rounded-full hover:bg-slate-50 dark:hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

    <header class="text-center mb-10">
      <h1 class="tool-title text-3xl md:text-5xl mb-4 text-transparent bg-clip-text bg-gradient-to-r from-orange-600 to-amber-600 dark:from-orange-400 dark:to-amber-400 pb-1">{t.h1}</h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto">{t.desc}</p>
    </header>

    <div class="max-w-4xl mx-auto mb-16 space-y-6">
      <article class="tool-card relative overflow-hidden">
        <div class="absolute top-0 right-0 w-2 h-full bg-gradient-to-b from-orange-400 to-amber-600"></div>
        <h2 class="tool-subtitle mb-4 flex items-center gap-2">
          <span>🔬</span> {t.editorialH2}
        </h2>
        <p class="tool-text text-base" set:html={t.editorialText}></p>
      </article>

      <div class="tool-card-inner bg-amber-50 dark:bg-amber-500/10 border-amber-200 dark:border-amber-500/30 shadow-sm dark:shadow-inner">
        <h3 class="tool-subtitle !text-amber-600 dark:!text-amber-400 mb-4">{t.fsTitle}</h3>
        <ul class="space-y-3 tool-text">
          {t.fsList.map(rule => (
            <li class="flex items-start gap-3">
              <span class="text-amber-500 font-bold mt-1">✔</span>
              <span class="leading-relaxed" set:html={rule}></span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <nav class="flex flex-wrap justify-center gap-2 md:gap-3 mb-16 bg-slate-50 dark:bg-slate-900/50 p-4 rounded-2xl border border-slate-200 dark:border-slate-800/50 max-w-4xl mx-auto shadow-sm dark:shadow-inner transition-colors">
      <span class="tool-label !mb-2 w-full text-center">{t.quickNav}</span>
      {t.categories.map(cat => (
        <a href={`#${cat.id}`} class="inline-flex items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-full text-xs md:text-sm font-bold text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 hover:text-orange-600 dark:hover:text-white transition-colors shadow-sm focus:ring-2 focus:ring-orange-500 outline-none">
          <span class="text-base">{cat.icon}</span> {cat.title}
        </a>
      ))}
    </nav>

    <div class="space-y-16 mb-12">
      {t.categories.map((cat) => (
        <div id={cat.id} class="scroll-mt-24">
          <h2 class="tool-subtitle !text-2xl md:!text-3xl mb-6 flex items-center gap-3 border-b border-slate-200 dark:border-slate-800 pb-3">
            <span class="text-3xl md:text-4xl drop-shadow-md">{cat.icon}</span> {cat.title}
          </h2>
          
          <div class="grid md:grid-cols-2 gap-6">
            {cat.items.map((item) => (
              <article class="tool-card hover:border-orange-400 dark:hover:border-orange-500/50 hover:-translate-y-1 transition-all duration-300 !p-6">
                <h3 class="tool-subtitle !text-xl mb-4 border-b border-slate-200 dark:border-slate-700/60 pb-3 flex items-center gap-3">
                  <span class="text-2xl bg-slate-50 dark:bg-slate-900/80 p-2 rounded-xl shadow-sm dark:shadow-inner border border-slate-200 dark:border-white/5 transition-colors">{item.emoji}</span> 
                  {item.name}
                </h3>
                
                <div class="flex gap-4 mb-4">
                  <div class="tool-card-inner !px-4 !py-2 text-center flex-1">
                    <span class="tool-label !mb-1 !text-[10px]">Temp</span>
                    <span class="text-lg md:text-xl font-mono font-bold text-orange-600 dark:text-orange-400">{item.temp}</span>
                  </div>
                  <div class="tool-card-inner !px-4 !py-2 text-center flex-1">
                    <span class="tool-label !mb-1 !text-[10px]">Time</span>
                    <span class="text-lg md:text-xl font-mono font-bold text-blue-600 dark:text-blue-400">{item.time}</span>
                  </div>
                </div>
                
                <p class="tool-text text-sm bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 p-3 rounded-xl leading-relaxed">
                  <span class="text-amber-600 dark:text-amber-400 font-bold block mb-1">💡 Tip:</span> 
                  {item.tip}
                </p>
              </article>
            ))}
          </div>
        </div>
      ))}
    </div>

    <Disclaimer type="generale" lang={lang} />

    <div class="mt-12 text-center pt-8 border-t border-slate-200 dark:border-slate-800 transition-colors">
      <a href={homeUrl} class="inline-flex items-center justify-center px-6 py-3 bg-white dark:bg-slate-800/90 backdrop-blur-md text-slate-700 dark:text-white border border-slate-200 dark:border-slate-600/50 shadow-xl rounded-full hover:bg-slate-50 dark:hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</MainLayout>