---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;
const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;

// DIZIONARIO SEO SPECIFICO (Anti-Boilerplate)
const seoData = {
  it: {
    title: "Come Riscaldare Avanzi in Friggitrice ad Aria | Tempi e Gradi",
    description: "Addio cibo molliccio al microonde! Scopri i tempi e gradi esatti per far tornare croccanti i tuoi avanzi: pizza, patatine, pollo e fritti come appena fatti."
  },
  en: {
    title: "How to Reheat Leftovers in Air Fryer | Time and Temp Guide",
    description: "Say goodbye to soggy microwave food! Discover the exact times and temperatures to bring back the crunch to your leftovers: pizza, fries, chicken, and more."
  },
  es: {
    title: "Cómo Recalentar Sobras en Freidora de Aire | Tiempos y Grados",
    description: "¡Adiós comida blanda del microondas! Descubre los tiempos y grados exactos para devolver el crujiente a tus sobras: pizza, patatas, pollo y fritos."
