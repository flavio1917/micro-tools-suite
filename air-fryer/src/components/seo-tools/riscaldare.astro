import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;
const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;

// DIZIONARIO SEO SPECIFICO (Anti-Boilerplate)
const seoData = {
  it: {
    title: "Come Riscaldare Cibo in Friggitrice ad Aria: Tempi e Gradi",
    description: "Tempi e temperature per riscaldare pizza, pasta, pollo, fritti e altri avanzi in friggitrice ad aria e recuperarne la croccantezza."
  },
  en: {
    title: "How to Reheat Food in an Air Fryer: Time and Temperature",
    description: "Reheat pizza, pasta, chicken, fried food and more in an air fryer with recommended times and temperatures for crispy leftovers."
