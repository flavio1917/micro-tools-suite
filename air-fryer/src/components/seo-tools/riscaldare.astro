};

const currentSeo = seoData[lang as keyof typeof seoData] || seoData.it;

const backBtnLabel = {
  it: "Vai alle ricette",
  en: "Go to Recipes",
  es: "Ir a las recetas",
  fr: "Voir les recettes"
}[lang] || "Vai alle ricette";

const content = {
  it: {
    h1: "Rianimatore di Avanzi",
