---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import { surgelatiContent } from '../../../i18n/pages/tools/surgelati';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;

const t = surgelatiContent[lang as keyof typeof surgelatiContent] || surgelatiContent.it;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.h1,
  "operatingSystem": "All",
  "applicationCategory": "UtilitiesApplication",
  "description": t.desc,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};

// GENERAZIONE DINAMICA DELLO SCHEMA FAQPage


// === INJECTED SEO DATA ===
const alternateUrls = {
  it: `https://www.crispissimo.com/strumenti/cottura-surgelati-friggitrice-ad-aria/`,
  en: `https://www.crispissimo.com/en/tools/cook-frozen-food-air-fryer/`,
  es: `https://www.crispissimo.com/es/herramientas/cocinar-congelados-freidora-aire/`,
  fr: `https://www.crispissimo.com/fr/outils/cuisson-surgeles-friteuse-air/`,
  "x-default": `https://www.crispissimo.com/strumenti/cottura-surgelati-friggitrice-ad-aria/`
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://www.crispissimo.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti",
      "item": `https://www.crispissimo.com${{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {"it": "Cottura Surgelati", "en": "Cook Frozen Food", "es": "Cocinar Congelados", "fr": "Cuisson Surgel\u00e9s"}[lang] || "",
      "item": alternateUrls[lang] || alternateUrls.it
    }
  ]
};

const currentFaqs = t.faqs || [];
const faqSchema = currentFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": currentFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q || faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a || faq.answer
    }
  }))
} : null;
---

<MainLayout alternateUrls={alternateUrls} title={t.title} lang={lang} description={t.desc}>
  <section class="max-w-5xl mx-auto py-8 md:py-16 px-4">

    <nav aria-label="Breadcrumb" class="mb-8 flex justify-start w-full overflow-x-auto pb-2">
      <ol class="flex items-center space-x-2 text-xs md:text-sm text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <li><a href={lang === 'it' ? '/' : `/${lang}/`} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Home</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li><a href={{"it": "/strumenti/", "en": "/en/tools/", "es": "/es/herramientas/", "fr": "/fr/outils/"}[lang] || "/strumenti/"} class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">{{"it": "Strumenti", "en": "Tools", "es": "Herramientas", "fr": "Outils"}[lang] || "Strumenti"}</a></li>
        <li><span class="mx-1.5 md:mx-2 text-slate-300 dark:text-slate-600">/</span></li>
        <li aria-current="page" class="text-slate-800 dark:text-slate-200 font-medium truncate">{{"it": "Cottura Surgelati", "en": "Cook Frozen Food", "es": "Cocinar Congelados", "fr": "Cuisson Surgel\u00e9s"}[lang] || ""}</li>
      </ol>
    </nav>

    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-black mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600 dark:from-cyan-400 dark:to-blue-500 pb-1">
        <span class="text-4xl md:text-5xl text-slate-900 dark:text-white">❄️</span> {t.h1}
      </h1>
      <p class="tool-text text-base md:text-xl max-w-2xl mx-auto leading-relaxed">{t.desc}</p>
    </header>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 max-w-4xl mx-auto">

      <div class="flex-1 tool-card relative overflow-hidden h-fit">
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-8 relative z-10">

          <div>
            <label class="tool-label">{t.sourceLabel}</label>
            <div class="flex p-1 bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm dark:shadow-inner gap-1 transition-colors" role="tablist">
              <button id="src-oven" role="tab" aria-selected="true" class="flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50">{t.srcOven}</button>
              <button id="src-af" role="tab" aria-selected="false" class="flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all border border-transparent">{t.srcAF}</button>
            </div>
          </div>

          <div>
            <label class="tool-label">{t.catLabel}</label>
            <select id="cat-select" class="tool-input focus:ring-cyan-500 appearance-none cursor-pointer">
              {t.cats.map((cat) => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
          </div>

          <div class="tool-card-inner !p-5">
            <div class="flex justify-between items-end mb-4">
              <label class="tool-label !mb-0">{t.tLabel}</label>
              <div class="text-2xl font-black font-mono text-orange-600 dark:text-orange-400"><span id="val-temp">{lang === 'en' ? '400' : '200'}</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <input type="range" id="slider-temp" min={lang === 'en' ? '300' : '150'} max={lang === 'en' ? '450' : '230'} step="5" value={lang === 'en' ? '400' : '200'} class="w-full h-2 bg-slate-300 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-orange-500 transition-colors" />
            <div class="flex justify-between text-[10px] text-slate-500 dark:text-slate-400 mt-2 font-mono font-bold transition-colors">
              <span>{lang === 'en' ? '300°F' : '150°C'}</span>
              <span>{lang === 'en' ? '450°F' : '230°C'}</span>
            </div>
          </div>

          <div class="tool-card-inner !p-5">
            <div class="flex justify-between items-end mb-4">
              <label class="tool-label !mb-0">{t.mLabel}</label>
              <div class="text-2xl font-black font-mono text-blue-600 dark:text-blue-400"><span id="val-mins">20</span> <span class="text-sm">min</span></div>
            </div>
            <input type="range" id="slider-mins" min="5" max="60" step="1" value="20" class="w-full h-2 bg-slate-300 dark:bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500 transition-colors" />
            <div class="flex justify-between text-[10px] text-slate-500 dark:text-slate-400 mt-2 font-mono font-bold transition-colors">
              <span>5 min</span>
              <span>60 min</span>
            </div>
          </div>

        </div>
      </div>

      <div class="flex-1 space-y-0 flex flex-col justify-center relative">

        <div id="af-target-badge" class="mb-5 ml-0 md:ml-4 flex justify-center md:justify-start transition-opacity duration-300 ease-in-out opacity-100">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-50 dark:bg-gradient-to-r dark:from-blue-900/40 dark:to-cyan-900/40 border border-cyan-200 dark:border-cyan-500/40 rounded-xl shadow-sm dark:shadow-lg backdrop-blur-sm transition-colors">
            <span class="text-cyan-700 dark:text-cyan-300 font-bold text-xs md:text-sm uppercase tracking-wide transition-colors">{t.targetAFLabel}</span>
          </div>
        </div>

        <div class="relative bg-white dark:bg-gradient-to-r dark:from-cyan-900/30 dark:to-slate-900/50 border border-slate-200 dark:border-cyan-500/30 p-6 rounded-2xl mb-6 ml-0 md:ml-4 shadow-sm dark:shadow-lg hover:border-cyan-300 dark:hover:border-cyan-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-cyan-500 rounded-full flex items-center justify-center font-black text-white dark:text-slate-900 shadow-md text-lg ring-4 ring-white dark:ring-[#0B1120] transition-colors">1</div>

          <h3 class="text-cyan-600 dark:text-cyan-400 font-bold uppercase tracking-wider text-xs mb-4 transition-colors">{t.phase1}</h3>

          <div class="flex gap-4">
            <div class="tool-card-inner !p-3 text-center flex-1">
              <span class="tool-label !text-[10px] !mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-600 dark:text-orange-400 transition-colors"><span id="res-t1">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="tool-card-inner !p-3 text-center flex-1">
              <span class="tool-label !text-[10px] !mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-cyan-600 dark:text-cyan-300 transition-colors"><span id="res-m1">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

        <div class="relative bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/20 rounded-xl p-4 flex items-center gap-3 ml-0 md:ml-8 mb-6 z-10 backdrop-blur-md transition-colors">
          <span class="text-2xl animate-bounce">🔀</span>
          <p class="text-amber-700 dark:text-amber-200 text-xs md:text-sm font-bold tracking-wide uppercase transition-colors">{t.shakeTip}</p>
        </div>

        <div class="relative bg-white dark:bg-gradient-to-r dark:from-orange-900/30 dark:to-slate-900/50 border border-slate-200 dark:border-orange-500/30 p-6 rounded-2xl ml-0 md:ml-4 shadow-sm dark:shadow-lg hover:border-orange-300 dark:hover:border-orange-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center font-black text-white dark:text-slate-900 shadow-md text-lg ring-4 ring-white dark:ring-[#0B1120] transition-colors">2</div>

          <h3 class="text-orange-600 dark:text-orange-400 font-bold uppercase tracking-wider text-xs mb-4 transition-colors">{t.phase2}</h3>

          <div class="flex gap-4">
            <div class="tool-card-inner !p-3 text-center flex-1">
              <span class="tool-label !text-[10px] !mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-600 dark:text-orange-500 transition-colors"><span id="res-t2">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="tool-card-inner !p-3 text-center flex-1">
              <span class="tool-label !text-[10px] !mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-blue-600 dark:text-blue-400 transition-colors"><span id="res-m2">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="max-w-3xl mx-auto mt-20 text-slate-300">

      <article class="tool-card mb-16">
        <h2 class="tool-subtitle mb-4">{t.editorialH2}</h2>
        <p class="tool-text text-lg" set:html={t.editorialText}></p>
      </article>

      <div class="space-y-6">
        <h2 class="tool-subtitle mb-6 border-b border-slate-200 dark:border-slate-700 pb-4">{t.faqTitle}</h2>

        <div class="space-y-4">
          {t.faqs.map((faq) => (
            <details class="group tool-faq-item [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-bold text-slate-800 dark:text-slate-200 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors text-lg">
                {faq.q}
                <span class="transition group-open:rotate-180 bg-slate-100 dark:bg-slate-800 p-2 rounded-full text-slate-500 dark:text-slate-400 transition-colors">
                  <svg fill="none" height="20" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="tool-text mt-4 text-base border-t border-slate-200 dark:border-slate-800 pt-4">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

    </div>

    <div class="mt-20 text-center pt-8 border-t border-slate-200 dark:border-slate-800 transition-colors">

    <div class="mt-16 pt-8 border-t border-slate-200 dark:border-slate-800">
      <h3 class="text-xl font-bold mb-4 text-slate-800 dark:text-white">Strumenti Correlati</h3>
      <ul class="space-y-2 text-slate-600 dark:text-slate-400">
        <li><a href={lang === 'it' ? '/strumenti/codici-errore-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-error-codes/' : lang === 'es' ? '/es/herramientas/codigos-error-freidora-aire/' : '/fr/outils/codes-erreur-friteuse-air/'} class="hover:text-orange-500 underline">Codici Errore Friggitrice ad Aria</a></li>
        <li><a href={lang === 'it' ? '/strumenti/fumo-puzza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/air-fryer-smell-smoke/' : lang === 'es' ? '/es/herramientas/freidora-aire-humo-olor/' : '/fr/outils/friteuse-air-fumee-odeur/'} class="hover:text-orange-500 underline">Fumo e Puzza</a></li>
        <li><a href={lang === 'it' ? '/strumenti/pulire-resistenza-friggitrice-ad-aria/' : lang === 'en' ? '/en/tools/clean-air-fryer-heating-element/' : lang === 'es' ? '/es/herramientas/limpiar-resistencia-freidora-aire/' : '/fr/outils/nettoyer-resistance-friteuse-air/'} class="hover:text-orange-500 underline">Pulizia Resistenza</a></li>
      </ul>
    </div>

    <Disclaimer type="generale" lang={lang} />
    </div>



  </section>

  <script is:inline define:vars={{ isEn: lang === 'en' }}>
    document.addEventListener('astro:page-load', () => {
      const selectCat = document.getElementById('cat-select');
      const sliderTemp = document.getElementById('slider-temp');
      const sliderMins = document.getElementById('slider-mins');
      const btnOven = document.getElementById('src-oven');
      const btnAF = document.getElementById('src-af');
      const afTargetBadge = document.getElementById('af-target-badge');

      if (!selectCat || !btnOven || !btnAF) return;

      const valTemp = document.getElementById('val-temp');
      const valMins = document.getElementById('val-mins');
      const resT1 = document.getElementById('res-t1');
      const resM1 = document.getElementById('res-m1');
      const resT2 = document.getElementById('res-t2');
      const resM2 = document.getElementById('res-m2');

      let currentSource = 'oven';
      let animRefs = {};

      function animateValue(obj, start, end, duration, key) {
        if (animRefs[key]) cancelAnimationFrame(animRefs[key]);
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          obj.innerHTML = Math.floor(progress * (end - start) + start);
          if (progress < 1) animRefs[key] = window.requestAnimationFrame(step);
        };
        animRefs[key] = window.requestAnimationFrame(step);
      }

      function round5(val) { return Math.round(val / 5) * 5; }

      function calculateLive() {
        const cat = selectCat.value;
        const boxTemp = parseFloat(sliderTemp.value);
        const boxMins = parseFloat(sliderMins.value);

        valTemp.textContent = boxTemp;
        valMins.textContent = boxMins;

        let dropT1, dropT2, percM1, percM2;

        if (currentSource === 'oven') {
          if (cat === 'patate') { dropT1 = 40; dropT2 = 0; percM1 = 0.45; percM2 = 0.35; }
          else if (cat === 'carne') { dropT1 = 30; dropT2 = 10; percM1 = 0.50; percM2 = 0.30; }
          else if (cat === 'pesce') { dropT1 = 40; dropT2 = 15; percM1 = 0.50; percM2 = 0.25; }
          else if (cat === 'lievitati') { dropT1 = 50; dropT2 = 20; percM1 = 0.60; percM2 = 0.20; }
        } else {
          if (cat === 'patate') { dropT1 = 20; dropT2 = -10; percM1 = 0.60; percM2 = 0.40; }
          else if (cat === 'carne') { dropT1 = 15; dropT2 = 0; percM1 = 0.60; percM2 = 0.40; }
          else if (cat === 'pesce') { dropT1 = 20; dropT2 = 0; percM1 = 0.65; percM2 = 0.35; }
          else if (cat === 'lievitati') { dropT1 = 30; dropT2 = 0; percM1 = 0.70; percM2 = 0.30; }
        }

        if (isEn) {
          dropT1 = Math.round(dropT1 * 1.8);
          dropT2 = Math.round(dropT2 * 1.8);
        }

        const finalT1 = round5(boxTemp - dropT1);
        const finalT2 = round5(boxTemp - dropT2);
        const finalM1 = Math.max(1, Math.round(boxMins * percM1));
        const finalM2 = Math.max(1, Math.round(boxMins * percM2));

        const currT1 = parseInt(resT1.textContent) || finalT1;
        const currM1 = parseInt(resM1.textContent) || finalM1;
        const currT2 = parseInt(resT2.textContent) || finalT2;
        const currM2 = parseInt(resM2.textContent) || finalM2;

        animateValue(resT1, currT1, finalT1, 400, 't1');
        animateValue(resM1, currM1, finalM1, 400, 'm1');
        animateValue(resT2, currT2, finalT2, 400, 't2');
        animateValue(resM2, currM2, finalM2, 400, 'm2');
      }

      btnOven.addEventListener('click', () => {
        currentSource = 'oven';
        btnOven.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50";
        btnOven.setAttribute('aria-selected', 'true');
        btnAF.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all border border-transparent";
        btnAF.setAttribute('aria-selected', 'false');
        if(afTargetBadge) {
            afTargetBadge.classList.remove('hidden', 'opacity-0');
            afTargetBadge.classList.add('opacity-100');
        }
        calculateLive();
      });

      btnAF.addEventListener('click', () => {
        currentSource = 'af';
        btnAF.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50";
        btnAF.setAttribute('aria-selected', 'true');
        btnOven.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all border border-transparent";
        btnOven.setAttribute('aria-selected', 'false');
        if(afTargetBadge) {
            afTargetBadge.classList.add('hidden', 'opacity-0');
            afTargetBadge.classList.remove('opacity-100');
        }
        calculateLive();
      });

      selectCat.addEventListener('change', calculateLive);
      sliderTemp.addEventListener('input', calculateLive);
      sliderMins.addEventListener('input', calculateLive);

      calculateLive();
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />



    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />


{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</MainLayout>