---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang = 'it' } = Astro.props;
const homeUrl = `/#ricettario`;

const backBtnLabel = {
  it: "Vai alle ricette",
  en: "Go to Recipes",
  es: "Ir a las recetas",
  fr: "Voir les recettes"
}[lang] || "Vai alle ricette";

const content = {
  it: {
    title: "Convertitore Friggitrice ad Aria per Surgelati: Tempi a 2 Fasi",
    h1: "Cottura Surgelati",
    desc: "Basta cibi surgelati che vengono bruciati fuori e ghiacciati dentro. Inserisci i dati della scatola e ottieni la cottura termodinamica perfetta in 2 Fasi.",
    sourceLabel: "Cosa c'è scritto sulla confezione?",
    srcOven: "🌡️ Forno",
    srcAF: "🌪️ Friggitrice ad Aria",
    catLabel: "Categoria Prodotto",
    tLabel: "Gradi sulla Confezione",
    mLabel: "Minuti sulla Confezione",
    targetAFLabel: "🎯 Le tue impostazioni per Friggitrice ad Aria:",
    phase1: "Fase 1: Scongelamento & Asciugatura",
    phase2: "Fase 2: Crisping ad Alta Temp.",
    cats: [
      { id: "patate", name: "🍟 Patatine & Snack Fritti" },
      { id: "carne", name: "🍗 Carne Panata (Cordon Bleu, Nuggets)" },
      { id: "pesce", name: "🐟 Pesce (Bastoncini, Anelli)" },
      { id: "lievitati", name: "🥐 Lievitati (Cornetti, Rustici)" }
    ],
    shakeTip: "🔔 Ricorda di scuotere il cestello a metà cottura!",
    
    // NUOVI CONTENUTI EDITORIALI E FAQ
    editorialH2: "Perché il Metodo a 2 Fasi è Fondamentale?",
    editorialText: "La cottura dei cibi surgelati in friggitrice ad aria presenta una sfida termodinamica precisa: l'esterno scongela e brucia molto prima che il calore raggiunga il cuore del prodotto. Il nostro algoritmo a due fasi risolve questo problema. La <strong>Fase 1</strong> utilizza una temperatura moderata per scongelare delicatamente ed evaporare l'umidità superficiale senza attivare la reazione di Maillard. La <strong>Fase 2</strong> applica uno shock termico ad alta temperatura (Crisping) solo quando il cibo è già caldo all'interno, garantendo una crosticina perfetta e un cuore tenero, replicando i risultati di una vera frittura ad immersione ma senza olio.",
    faqTitle: "Domande Frequenti sui Surgelati",
    faqs: [
      { q: "Devo preriscaldare la friggitrice per i surgelati?", a: "No. Iniziare a freddo è parte della 'Fase 1'. Il tempo che la friggitrice impiega per scaldarsi aiuta lo scongelamento graduale del cibo, evitando che l'esterno bruci." },
      { q: "Posso sovrapporre le patatine surgelate nel cestello?", a: "Sì, ma solo per i cibi di piccole dimensioni (come le patatine). Tuttavia, se le sovrapponi, è obbligatorio scuotere il cestello energicamente ogni 5-7 minuti per garantire che l'aria ciclonica raggiunga tutti i lati." },
      { q: "Devo aggiungere olio ai cibi surgelati pre-fritti?", a: "Assolutamente no. I prodotti come patatine da forno, cordon bleu o bastoncini di pesce contengono già olio dalla pre-frittura industriale. L'aria calda lo farà emergere in superficie, friggendoli perfettamente." },
      { q: "Perché i tempi del forno non vanno bene per la friggitrice?", a: "Il forno statico scalda l'ambiente lentamente. La friggitrice ad aria spinge aria rovente ad alta velocità direttamente sul cibo. Usare i tempi del forno causerebbe una bruciatura superficiale immediata lasciando l'interno congelato." }
    ]
  },
  en: {
    title: "Air Fryer Frozen Food Converter: 2-Phase Cooking",
    h1: "Frozen Food Calibrator",
    desc: "Stop burning the frozen food outside while the inside is frozen. Enter the box instructions to get the perfect 2-Phase thermodynamic cooking method.",
    sourceLabel: "Box instructions are for:",
    srcOven: "🌡️ Oven",
    srcAF: "🌪️ Air Fryer",
    catLabel: "Product Category",
    tLabel: "Degrees on Box",
    mLabel: "Minutes on Box",
    targetAFLabel: "🎯 Your Air Fryer Settings:",
    phase1: "Phase 1: Defrost & Dry",
    phase2: "Phase 2: High-Heat Crisping",
    cats: [
      { id: "patate", name: "🍟 French Fries & Snacks" },
      { id: "carne", name: "🍗 Breaded Meat (Nuggets, Schnitzel)" },
      { id: "pesce", name: "🐟 Fish (Fishsticks, Calamari)" },
      { id: "lievitati", name: "🥐 Pastries & Doughs" }
    ],
    shakeTip: "🔔 Remember to shake the basket halfway through!",
    
    editorialH2: "Why is the 2-Phase Method Essential?",
    editorialText: "Cooking frozen foods in an air fryer presents a specific thermodynamic challenge: the exterior thaws and burns long before heat reaches the core. Our two-phase algorithm solves this. <strong>Phase 1</strong> uses moderate temperature to gently thaw and evaporate surface moisture without triggering the Maillard reaction. <strong>Phase 2</strong> applies a high-heat thermal shock (Crisping) only when the food is already warm inside, guaranteeing a perfect crust and tender core, replicating deep-frying results without the oil.",
    faqTitle: "Frequently Asked Questions",
    faqs: [
      { q: "Should I preheat the air fryer for frozen foods?", a: "No. Starting cold is part of 'Phase 1'. The time it takes for the fryer to heat up helps gradually thaw the food, preventing the exterior from burning." },
      { q: "Can I stack frozen fries in the basket?", a: "Yes, but only for small items like fries. However, if you stack them, it is mandatory to shake the basket vigorously every 5-7 minutes to ensure the cyclonic air reaches all sides." },
      { q: "Do I need to add oil to pre-fried frozen foods?", a: "Absolutely not. Products like oven fries, nuggets, or fish sticks already contain oil from industrial pre-frying. The hot air will force it to the surface, frying them perfectly." },
      { q: "Why don't oven instructions work for the air fryer?", a: "A conventional oven heats the environment slowly. An air fryer forces blazing hot air at high speed directly onto the food. Using oven times would cause immediate surface burning while leaving the inside frozen." }
    ]
  },
  es: {
    title: "Calculadora Freidora de Aire para Congelados: 2 Fases",
    h1: "Calibrador de Congelados",
    desc: "Evita que la comida congelada se queme por fuera y sea congelada por dentro. Introduce los datos del envase y obtén la cocción termodinámica en 2 Fases.",
    sourceLabel: "¿Las instrucciones del envase son para?",
    srcOven: "🌡️ Horno",
    srcAF: "🌪️ Freidora de Aire",
    catLabel: "Categoría del Producto",
    tLabel: "Grados en el Envase",
    mLabel: "Minutos en el Envase",
    targetAFLabel: "🎯 Tus ajustes para Freidora de Aire:",
    phase1: "Fase 1: Descongelación y Secado",
    phase2: "Fase 2: Crujiente a Alta Temp.",
    cats: [
      { id: "patate", name: "🍟 Patatas Fritas y Snacks" },
      { id: "carne", name: "🍗 Carne Empanada (Nuggets, San Jacobos)" },
      { id: "pesce", name: "🐟 Pescado (Varitas, Anillas)" },
      { id: "lievitati", name: "🥐 Masas y Bollería" }
    ],
    shakeTip: "🔔 ¡Recuerda agitar la cesta a la mitad del tiempo!",

    editorialH2: "¿Por qué es fundamental el método de 2 Fases?",
    editorialText: "Cocinar alimentos congelados en una freidora de aire presenta un desafío termodinámico: el exterior se descongela y se quema mucho antes de que el calor llegue al corazón. Nuestro algoritmo resuelve esto. La <strong>Fase 1</strong> utiliza una temperatura moderada para descongelar suavemente y evaporar la humedad sin activar la reacción de Maillard. La <strong>Fase 2</strong> aplica un choque térmico de alta temperatura (Crisping) solo cuando la comida ya está caliente por dentro, garantizando una corteza perfecta y un corazón tierno.",
    faqTitle: "Preguntas Frecuentes",
    faqs: [
      { q: "¿Debo precalentar la freidora para los congelados?", a: "No. Empezar en frío es parte de la 'Fase 1'. El tiempo que tarda la freidora en calentarse ayuda a descongelar gradualmente la comida." },
      { q: "¿Puedo apilar las patatas fritas congeladas en la cesta?", a: "Sí, pero solo para alimentos pequeños. Sin embargo, si los apilas, es obligatorio agitar la cesta enérgicamente cada 5-7 minutos para que el aire llegue a todos lados." },
      { q: "¿Debo añadir aceite a los alimentos congelados prefritos?", a: "Absolutamente no. Productos como patatas para horno o nuggets ya contienen aceite de la prefritura industrial. El aire caliente lo sacará a la superficie." },
      { q: "¿Por qué los tiempos del horno no sirven para la freidora?", a: "El horno estático calienta el ambiente lentamente. La freidora empuja aire muy caliente a alta velocidad. Usar tiempos de horno quemaría la superficie inmediatamente." }
    ]
  },
  fr: {
    title: "Convertisseur Friteuse à Air pour Surgelés : Cuisson en 2 Phases",
    h1: "Calculateur pour Surgelés",
    desc: "Évitez les aliments brûlés dehors et congelés dedans. Entrez les données de la boîte pour obtenir la cuisson thermodynamique parfaite.",
    sourceLabel: "Les instructions sur la boîte sont pour :",
    srcOven: "🌡️ Four",
    srcAF: "🌪️ Friteuse à Air",
    catLabel: "Catégorie de Produit",
    tLabel: "Temp. sur la Boîte",
    mLabel: "Minutes sur la Boîte",
    targetAFLabel: "🎯 Vos paramètres pour Friteuse à Air :",
    phase1: "Phase 1 : Décongélation",
    phase2: "Phase 2 : Croustillant Haute Temp.",
    cats: [
      { id: "patate", name: "🍟 Frites et Snacks" },
      { id: "carne", name: "🍗 Viande Panée (Nuggets, Cordon Bleu)" },
      { id: "pesce", name: "🐟 Poisson (Bâtonnets, Calamars)" },
      { id: "lievitati", name: "🥐 Pâtisseries et Pâtes" }
    ],
    shakeTip: "🔔 N'oubliez pas de secouer le panier à mi-cuisson !",
    
    editorialH2: "Pourquoi la méthode à 2 phases est-elle essentielle ?",
    editorialText: "La cuisson des surgelés dans une Air Fryer présente un défi thermodynamique : l'extérieur décongèle et brûle bien avant que la chaleur n'atteigne le cœur. L'algorithme résout ce problème. La <strong>Phase 1</strong> utilise une température modérée pour décongeler en douceur et évaporer l'humidité sans activer la réaction de Maillard. La <strong>Phase 2</strong> applique un choc thermique à haute température uniquement lorsque l'aliment est déjà chaud à l'intérieur, garantissant une croûte parfaite.",
    faqTitle: "Foire Aux Questions",
    faqs: [
      { q: "Dois-je préchauffer la friteuse pour les surgelés ?", a: "Non. Commencer à froid fait partie de la 'Phase 1'. Le temps que la friteuse chauffe aide à décongeler progressivement les aliments." },
      { q: "Puis-je empiler les frites surgelées dans le panier ?", a: "Oui, mais uniquement pour les petits aliments. Si vous les empilez, il est obligatoire de secouer vigoureusement le panier toutes les 5-7 minutes." },
      { q: "Dois-je ajouter de l'huile aux surgelés préfrits ?", a: "Absolument pas. Les produits comme les frites au four ou les nuggets contiennent déjà de l'huile. L'air chaud la fera remonter à la surface." },
      { q: "Pourquoi les temps du four ne conviennent-ils pas ?", a: "Le four chauffe lentement. L'Air Fryer propulse de l'air très chaud à grande vitesse. Utiliser les temps du four brûlerait immédiatement la surface." }
    ]
  }
};

const t = content[lang as keyof typeof content] || content.it;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.h1,
  "operatingSystem": "All",
  "applicationCategory": "UtilitiesApplication",
  "description": t.desc,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};

// GENERAZIONE DINAMICA DELLO SCHEMA FAQPage
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<MainLayout title={t.title} lang={lang}>
  <section class="max-w-5xl mx-auto py-12 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
        <span class="text-4xl md:text-5xl">❄️</span> {t.h1}
      </h1>
      <p class="text-slate-400 text-base md:text-xl max-w-2xl mx-auto leading-relaxed">{t.desc}</p>
    </header>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 max-w-4xl mx-auto">
      
      <div class="flex-1 bg-slate-800/60 border border-slate-700 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden h-fit">
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-8 relative z-10">
          
          <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">{t.sourceLabel}</label>
            <div class="flex p-1 bg-slate-900 border border-slate-700 rounded-xl shadow-inner gap-1" role="tablist">
              <button id="src-oven" role="tab" aria-selected="true" class="flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50">{t.srcOven}</button>
              <button id="src-af" role="tab" aria-selected="false" class="flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-400 hover:text-white transition-all border border-transparent">{t.srcAF}</button>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">{t.catLabel}</label>
            <select id="cat-select" class="w-full bg-slate-900 border border-slate-600 text-white rounded-xl px-4 py-3.5 focus:ring-2 focus:ring-cyan-500 outline-none transition-all shadow-inner font-medium text-base appearance-none cursor-pointer">
              {t.cats.map((cat) => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
          </div>

          <div class="bg-slate-900/50 p-5 rounded-2xl border border-slate-700/50">
            <div class="flex justify-between items-end mb-4">
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">{t.tLabel}</label>
              <div class="text-2xl font-black font-mono text-orange-400"><span id="val-temp">{lang === 'en' ? '400' : '200'}</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <input type="range" id="slider-temp" min={lang === 'en' ? '300' : '150'} max={lang === 'en' ? '450' : '230'} step="5" value={lang === 'en' ? '400' : '200'} class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-orange-500" />
            <div class="flex justify-between text-[10px] text-slate-500 mt-2 font-mono font-bold">
              <span>{lang === 'en' ? '300°F' : '150°C'}</span>
              <span>{lang === 'en' ? '450°F' : '230°C'}</span>
            </div>
          </div>

          <div class="bg-slate-900/50 p-5 rounded-2xl border border-slate-700/50">
            <div class="flex justify-between items-end mb-4">
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">{t.mLabel}</label>
              <div class="text-2xl font-black font-mono text-blue-400"><span id="val-mins">20</span> <span class="text-sm">min</span></div>
            </div>
            <input type="range" id="slider-mins" min="5" max="60" step="1" value="20" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500" />
            <div class="flex justify-between text-[10px] text-slate-500 mt-2 font-mono font-bold">
              <span>5 min</span>
              <span>60 min</span>
            </div>
          </div>

        </div>
      </div>

      <div class="flex-1 space-y-0 flex flex-col justify-center relative">
        
        <div id="af-target-badge" class="mb-5 ml-0 md:ml-4 flex justify-center md:justify-start transition-opacity duration-300 ease-in-out opacity-100">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-blue-900/40 to-cyan-900/40 border border-cyan-500/40 rounded-xl shadow-lg backdrop-blur-sm">
            <span class="text-cyan-300 font-bold text-xs md:text-sm uppercase tracking-wide">{t.targetAFLabel}</span>
          </div>
        </div>

        <div class="relative bg-gradient-to-r from-cyan-900/30 to-slate-900/50 border border-cyan-500/30 p-6 rounded-2xl mb-6 ml-0 md:ml-4 shadow-lg hover:border-cyan-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-cyan-500 rounded-full flex items-center justify-center font-black text-slate-900 shadow-[0_0_15px_rgba(6,182,212,0.5)] text-lg ring-4 ring-[#0B1120]">1</div>
          
          <h3 class="text-cyan-400 font-bold uppercase tracking-wider text-xs mb-4">{t.phase1}</h3>
          
          <div class="flex gap-4">
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-300"><span id="res-t1">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-cyan-300"><span id="res-m1">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

        <div class="relative bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 flex items-center gap-3 ml-0 md:ml-8 mb-6 z-10 backdrop-blur-md">
          <span class="text-2xl animate-bounce">🔀</span>
          <p class="text-amber-200 text-xs md:text-sm font-bold tracking-wide uppercase">{t.shakeTip}</p>
        </div>

        <div class="relative bg-gradient-to-r from-orange-900/30 to-slate-900/50 border border-orange-500/30 p-6 rounded-2xl ml-0 md:ml-4 shadow-lg hover:border-orange-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center font-black text-slate-900 shadow-[0_0_15px_rgba(249,115,22,0.5)] text-lg ring-4 ring-[#0B1120]">2</div>
          
          <h3 class="text-orange-400 font-bold uppercase tracking-wider text-xs mb-4">{t.phase2}</h3>
          
          <div class="flex gap-4">
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-500"><span id="res-t2">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-blue-400"><span id="res-m2">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="max-w-3xl mx-auto mt-20 text-slate-300">
      
      <article class="mb-16 bg-slate-800/30 p-8 rounded-3xl border border-slate-700/50">
        <h2 class="text-2xl font-bold text-white mb-4 tracking-tight">{t.editorialH2}</h2>
        <p class="text-lg leading-relaxed text-slate-400" set:html={t.editorialText}></p>
      </article>

      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-white mb-6 border-b border-slate-700 pb-4">{t.faqTitle}</h2>
        
        <div class="space-y-4">
          {t.faqs.map((faq) => (
            <details class="group bg-slate-900 rounded-2xl p-5 border border-slate-800 cursor-pointer [&_summary::-webkit-details-marker]:hidden shadow-sm hover:shadow-md transition-shadow">
              <summary class="flex justify-between items-center font-bold text-slate-200 group-hover:text-cyan-400 transition-colors text-lg">
                {faq.q}
                <span class="transition group-open:rotate-180 bg-slate-800 p-2 rounded-full text-slate-400">
                  <svg fill="none" height="20" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" width="20"><path d="M6 9l6 6 6-6"></path></svg>
                </span>
              </summary>
              <p class="text-slate-400 mt-4 leading-relaxed text-base border-t border-slate-800 pt-4">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
      
    </div>

    <div class="mt-20 text-center pt-8 border-t border-slate-800">
      <Disclaimer type="generale" lang={lang} />
    </div>

  </section>

  <script is:inline define:vars={{ isEn: lang === 'en' }}>
    document.addEventListener('astro:page-load', () => {
      const selectCat = document.getElementById('cat-select');
      const sliderTemp = document.getElementById('slider-temp');
      const sliderMins = document.getElementById('slider-mins');
      const btnOven = document.getElementById('src-oven');
      const btnAF = document.getElementById('src-af');
      const afTargetBadge = document.getElementById('af-target-badge');
      
      if (!selectCat || !btnOven || !btnAF) return;

      const valTemp = document.getElementById('val-temp');
      const valMins = document.getElementById('val-mins');
      const resT1 = document.getElementById('res-t1');
      const resM1 = document.getElementById('res-m1');
      const resT2 = document.getElementById('res-t2');
      const resM2 = document.getElementById('res-m2');

      let currentSource = 'oven';
      let animRefs = {};

      function animateValue(obj, start, end, duration, key) {
        if (animRefs[key]) cancelAnimationFrame(animRefs[key]);
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          obj.innerHTML = Math.floor(progress * (end - start) + start);
          if (progress < 1) animRefs[key] = window.requestAnimationFrame(step);
        };
        animRefs[key] = window.requestAnimationFrame(step);
      }

      function round5(val) { return Math.round(val / 5) * 5; }

      function calculateLive() {
        const cat = selectCat.value;
        const boxTemp = parseFloat(sliderTemp.value);
        const boxMins = parseFloat(sliderMins.value);

        valTemp.textContent = boxTemp;
        valMins.textContent = boxMins;

        let dropT1, dropT2, percM1, percM2;

        if (currentSource === 'oven') {
          if (cat === 'patate') { dropT1 = 40; dropT2 = 0; percM1 = 0.45; percM2 = 0.35; } 
          else if (cat === 'carne') { dropT1 = 30; dropT2 = 10; percM1 = 0.50; percM2 = 0.30; } 
          else if (cat === 'pesce') { dropT1 = 40; dropT2 = 15; percM1 = 0.50; percM2 = 0.25; } 
          else if (cat === 'lievitati') { dropT1 = 50; dropT2 = 20; percM1 = 0.60; percM2 = 0.20; }
        } else {
          if (cat === 'patate') { dropT1 = 20; dropT2 = -10; percM1 = 0.60; percM2 = 0.40; } 
          else if (cat === 'carne') { dropT1 = 15; dropT2 = 0; percM1 = 0.60; percM2 = 0.40; } 
          else if (cat === 'pesce') { dropT1 = 20; dropT2 = 0; percM1 = 0.65; percM2 = 0.35; } 
          else if (cat === 'lievitati') { dropT1 = 30; dropT2 = 0; percM1 = 0.70; percM2 = 0.30; }
        }

        if (isEn) {
          dropT1 = Math.round(dropT1 * 1.8);
          dropT2 = Math.round(dropT2 * 1.8);
        }

        const finalT1 = round5(boxTemp - dropT1);
        const finalT2 = round5(boxTemp - dropT2);
        const finalM1 = Math.max(1, Math.round(boxMins * percM1));
        const finalM2 = Math.max(1, Math.round(boxMins * percM2));

        const currT1 = parseInt(resT1.textContent) || finalT1;
        const currM1 = parseInt(resM1.textContent) || finalM1;
        const currT2 = parseInt(resT2.textContent) || finalT2;
        const currM2 = parseInt(resM2.textContent) || finalM2;

        animateValue(resT1, currT1, finalT1, 400, 't1');
        animateValue(resM1, currM1, finalM1, 400, 'm1');
        animateValue(resT2, currT2, finalT2, 400, 't2');
        animateValue(resM2, currM2, finalM2, 400, 'm2');
      }

      btnOven.addEventListener('click', () => {
        currentSource = 'oven';
        btnOven.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50";
        btnOven.setAttribute('aria-selected', 'true');
        btnAF.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-400 hover:text-white transition-all border border-transparent";
        btnAF.setAttribute('aria-selected', 'false');
        if(afTargetBadge) {
            afTargetBadge.classList.remove('hidden', 'opacity-0');
            afTargetBadge.classList.add('opacity-100');
        }
        calculateLive();
      });

      btnAF.addEventListener('click', () => {
        currentSource = 'af';
        btnAF.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold bg-gradient-to-b from-cyan-500 to-blue-600 text-white shadow-md transition-all border border-cyan-400/50";
        btnAF.setAttribute('aria-selected', 'true');
        btnOven.className = "flex-1 py-2.5 rounded-lg text-xs md:text-sm font-bold text-slate-400 hover:text-white transition-all border border-transparent";
        btnOven.setAttribute('aria-selected', 'false');
        if(afTargetBadge) {
            afTargetBadge.classList.add('hidden', 'opacity-0');
            afTargetBadge.classList.remove('opacity-100');
        }
        calculateLive();
      });

      selectCat.addEventListener('change', calculateLive);
      sliderTemp.addEventListener('input', calculateLive);
      sliderMins.addEventListener('input', calculateLive);

      calculateLive();
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

</MainLayout>