        <button id="btn-convert" class="w-full py-3 bg-[#F59E0B] hover:bg-[#D97706] text-black rounded-xl font-bold text-base transition-all active:scale-95">{t.btn_action}</button>
    </div>

    <div class="mt-4 pt-3 border-t border-white/10">
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-black/20 p-3 rounded-xl border border-white/5 text-center"><span class="block text-[9px] text-slate-400 uppercase font-bold">{t.label_temp}</span><span id="res-temp" class="text-2xl font-black">--</span><span class="text-sm font-bold text-[#F59E0B]">{tempSymbol}</span></div>
        <div class="bg-black/20 p-3 rounded-xl border border-white/5 text-center"><span class="block text-[9px] text-slate-400 uppercase font-bold">{t.label_time}</span><span id="res-time" class="text-2xl font-black">--</span><span class="text-sm font-bold text-[#F59E0B]">m</span></div>
      </div>
      <div id="eco-container" class="hidden flex justify-center mt-2 mb-2">
