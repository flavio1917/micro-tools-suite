                {t.btn_grid}
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>

  <div class="mx-auto text-center space-y-4 px-4 pb-8 mt-4">
    <p class="text-[11px] text-slate-500 leading-relaxed font-medium">{t.legal_privacy}</p>
    <div class="border-t border-white/5 w-1/2 mx-auto"></div>
    <p class="text-[10px] text-slate-500 leading-relaxed italic opacity-80">{t.legal_disclaimer}</p>
