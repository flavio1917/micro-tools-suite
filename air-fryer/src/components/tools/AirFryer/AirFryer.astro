          <div class="w-8 h-8 rounded-full bg-orange-500 flex items-center justify-center animate-pulse">🎁</div>
          <p class="text-[11px] font-semibold text-white truncate">Kit Accessori Universale: miglior prezzo oggi</p>
        </div>
        <a href="https://www.amazon.it/s?k=kit+accessori+friggitrice+ad+aria&tag=convfriggit-21" class="bg-orange-500 text-black text-[11px] font-bold py-2 px-4 rounded-full">Prezzo</a>
      </div>
    </div>
  )}
</div>

      {lang === 'it' && (
        <>
          <div class="mt-3 md:mt-4 flex justify-between items-center mb-1.5 px-1">
            <h4 class="text-[#F59E0B] font-bold text-[9px] md:text-[10px] uppercase tracking-wider">{t.ad_title}</h4>
