---
// src/components/tools/AirFryer/AirFryer.astro
import recipes from '../../../data/recipes-it.json';

export interface Props { lang?: string; }
const { lang = "it" } = Astro.props;

const totalRecipes = recipes?.length || 200;
const roundedCount = Math.floor(totalRecipes / 10) * 10;

// COPY PREMIUM E INGEGNERISTICO (Con il nuovo Tooltip E-E-A-T)
const translations = {
  it: {
    title: "Convertitore", subtitle: "Pro", tab_conv: "Incolla Ricetta", tab_food: "Inserimento Rapido", tab_recipes: "Ricettario",
    placeholder: "Incolla qui la ricetta (es: 'Cuocere a 200°C per 40 minuti')...",
    btn_action: "Calcola", label_temp: "Temp. Ottimizzata", label_time: "Tempo Calcolato", eco_label: "Risparmio stimato: ~",
    manual_temp: "TEMP. FORNO", manual_time: "MINUTI FORNO", error_msg: "⚠️ Dati insufficienti. Inserisci Temperatura e Tempo.", 
    legal_privacy: "⚙️ Motore di Convezione Termica attivo. Calcolo 100% locale.",
    alert_cap: "⚠️ Sicurezza: Temp limitata a 200°C", 
    tooltip_cap: "Perché 200°C? Superare questa soglia degrada l'antiaderente e favorisce l'Acrilammide, nociva sugli amidi ad alte temperature. Cuoci in sicurezza!",
    cta_recipes_top: "Senza idee per cena?", cta_recipes_bottom: `Esplora ${roundedCount}+ Ricette Testate`,
  },
  en: {
    title: "Air Fryer", subtitle: "Engine", tab_conv: "Smart Paste", tab_food: "Quick Input", tab_recipes: "Recipes",
    placeholder: "Paste oven recipe here (e.g. 'Bake at 400°F for 40 minutes')...",
    btn_action: "Calculate", label_temp: "Optimized Temp", label_time: "Calculated Time", eco_label: "Est. Savings: ~",
    manual_temp: "OVEN TEMP.", manual_time: "OVEN MINUTES", error_msg: "⚠️ Missing data! Please provide Temp and Time.", 
    legal_privacy: "⚙️ Thermal Convection Engine active. 100% local processing.",
    alert_cap: "⚠️ Safety: Capped at 400°F", 
    tooltip_cap: "Why 400°F? Exceeding this degrades the non-stick coating and promotes Acrylamide, a harmful byproduct on starches at extreme heat. Cook safely!",
    cta_recipes_top: "Don't know what to cook?", cta_recipes_bottom: `Explore ${roundedCount}+ Tested Recipes`,
  },
  es: {
    title: "Convertidor", subtitle: "Pro", tab_conv: "Pegar Receta", tab_food: "Datos Rápidos", tab_recipes: "Recetas",
    placeholder: "Pega el texto de la receta aquí (ej: 'Hornear a 200°C por 40 min')...",
    btn_action: "Calcular", label_temp: "Temp. Optimizada", label_time: "Tiempo Calculado", eco_label: "Ahorro estimado: ~",
    manual_temp: "TEMP. HORNO", manual_time: "MINUTOS HORNO", error_msg: "⚠️ ¡Faltan datos! Introduce Temperatura y Tiempo.", 
    legal_privacy: "⚙️ Motor de Convección Térmica activo. Cálculos 100% locales.",
    alert_cap: "⚠️ Seguridad: Temp limitada a 200°C", 
    tooltip_cap: "¿Por qué 200°C? Superar este límite degrada el antiadherente y favorece la Acrilamida, nociva en almidones a calor extremo. ¡Cocina seguro!",
    cta_recipes_top: "¿Sin ideas para cenar?", cta_recipes_bottom: `Explora ${roundedCount}+ Recetas`,
  },
  fr: {
    title: "Convertisseur", subtitle: "Pro", tab_conv: "Coller Recette", tab_food: "Saisie Rapide", tab_recipes: "Recettes",
    placeholder: "Collez le texte de la recette ici (ex: 'Cuire à 200°C pendant 40 min')...",
    btn_action: "Calculer", label_temp: "Temp. Optimisée", label_time: "Temps Calculé", eco_label: "Économie est. : ~",
    manual_temp: "TEMP. FOUR", manual_time: "MINUTES FOUR", error_msg: "⚠️ Données manquantes ! Entrez Température et Temps.", 
    legal_privacy: "⚙️ Moteur de Convection Thermique actif. Calculs 100% locaux.",
    alert_cap: "⚠️ Sécurité : Temp. limitée à 200°C", 
    tooltip_cap: "Pourquoi 200°C ? Dépasser ce seuil dégrade le revêtement et favorise l'Acrylamide, nocive sur les amidons à haute température. Cuisinez en sécurité !",
    cta_recipes_top: "En panne d'inspiration ?", cta_recipes_bottom: `Explorez ${roundedCount}+ Recettes`,
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;

const isEn = lang === 'en';
const tempSymbol = isEn ? '°F' : '°C';
const currSymbol = isEn ? '$' : '€';
const initialEco = isEn ? '$0.00' : '0.00€';

// SCHEMA.ORG: SOFTWARE APPLICATION
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": `${t.title} ${t.subtitle}`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": isEn ? "USD" : "EUR"
  },
  "description": "Algoritmo avanzato di ottimizzazione termica per convertire tempi e temperature dal forno tradizionale alla friggitrice ad aria in tempo reale.",
  "featureList": [
    "Analisi testuale istantanea delle ricette",
    "Calcolo differenziale del tempo e della temperatura",
    "Stima del risparmio energetico"
  ]
};
---

<div id="airfryer-wrapper" data-lang={lang} class="max-w-[480px] mx-auto space-y-3 md:space-y-4">
  <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-[32px] shadow-2xl overflow-hidden font-sans text-white p-4 relative">
    
    <div class="text-center mb-3 md:mb-4 flex flex-col items-center justify-center">
      <h2 class="text-xl md:text-2xl font-black text-slate-100 uppercase tracking-tight">
        {t.title} <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-yellow-300">{t.subtitle}</span>
      </h2>
      <div class="flex items-center gap-1.5 mt-1">
        <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse" aria-hidden="true"></span>
        <span class="text-[9px] uppercase tracking-widest text-green-400 font-bold opacity-80">System Online</span>
      </div>
    </div>

    <div class="flex p-1 bg-black/30 border border-white/5 rounded-xl mb-3 md:mb-4 gap-1 shadow-inner" role="tablist">
      <button id="tab-conv" role="tab" aria-selected="true" class="flex-1 py-2 rounded-lg text-xs sm:text-sm font-bold bg-gradient-to-b from-orange-400 to-orange-500 text-black shadow-md transition-all">{t.tab_conv}</button>
      <button id="tab-food" role="tab" aria-selected="false" class="flex-1 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-white transition-all">{t.tab_food}</button>
    </div>

    <div id="view-converter" class="space-y-3 md:space-y-4 animate-fade-in" role="tabpanel">
      <textarea id="recipe-input" aria-label={t.tab_conv} class="w-full h-16 md:h-20 p-3 bg-black/40 border border-slate-700 rounded-2xl focus:border-orange-400 focus:ring-1 focus:ring-orange-400/50 outline-none transition-all resize-none text-slate-200 text-sm leading-relaxed placeholder:text-slate-500 shadow-inner" placeholder={t.placeholder}></textarea>
      
      <div id="error-box" class="hidden bg-red-500/10 border border-red-500/30 text-red-400 px-4 py-2 rounded-xl text-xs font-bold text-center animate-pulse" role="alert">{t.error_msg}</div>
      
      <div id="cap-alert" tabindex="0" class="hidden mt-3 bg-yellow-950/20 border border-yellow-500/30 rounded-xl p-3 items-start gap-3 group relative cursor-help outline-none">
        <span class="text-lg flex-shrink-0">🛡️</span>
        <div class="flex-1 text-left">
          <p class="text-yellow-200 text-[10px] md:text-xs font-bold mt-0.5 border-b border-yellow-500/30 border-dashed inline-block pb-0.5">
            {t.alert_cap}
          </p>
          <div class="absolute z-50 bottom-full left-0 mb-2 w-full md:w-80 p-3 bg-slate-900 border border-yellow-500/50 rounded-xl shadow-2xl opacity-0 pointer-events-none group-hover:opacity-100 transition-all text-xs text-slate-300 leading-relaxed">
            {t.tooltip_cap}
          </div>
        </div>
      </div>

      <button id="btn-convert" aria-label={t.btn_action} class="hidden w-full py-3 bg-gradient-to-r from-orange-500 to-orange-400 hover:from-orange-400 hover:to-orange-500 text-black rounded-xl font-black text-base shadow-[0_4px_20px_0_rgba(245,158,11,0.3)] transition-transform active:scale-95 flex items-center justify-center gap-2 cursor-pointer border border-orange-300/50">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        {t.btn_action}
      </button>
    </div>
    
    <div id="view-presets" class="hidden space-y-3 animate-fade-in py-2" role="tabpanel">
      <div class="flex gap-3 md:gap-4">
        <div class="flex-1">
          <label for="manual-temp" class="text-[9px] md:text-[10px] uppercase font-bold text-slate-400 tracking-wider block mb-1.5">{t.manual_temp}</label>
          <div class="relative">
            <input type="number" id="manual-temp" min="1" max="600" aria-label={t.manual_temp} class="w-full p-2.5 pl-8 bg-black/40 border border-slate-700 rounded-xl font-bold text-lg text-white outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-400/50 transition-all placeholder:text-slate-600 shadow-inner" placeholder="0">
            <span class="absolute left-2.5 top-3 text-slate-500" aria-hidden="true">🌡️</span>
            <span class="absolute right-2.5 top-3.5 text-[9px] md:text-[10px] text-slate-500 font-bold" aria-hidden="true">{tempSymbol}</span>
          </div>
        </div>
        <div class="flex-1">
          <label for="manual-time" class="text-[9px] md:text-[10px] uppercase font-bold text-slate-400 tracking-wider block mb-1.5">{t.manual_time}</label>
          <div class="relative">
            <input type="number" id="manual-time" min="1" max="300" aria-label={t.manual_time} class="w-full p-2.5 pl-8 bg-black/40 border border-slate-700 rounded-xl font-bold text-lg text-white outline-none focus:border-orange-400 focus:ring-1 focus:ring-orange-400/50 transition-all placeholder:text-slate-600 shadow-inner" placeholder="0">
            <span class="absolute left-2.5 top-3 text-slate-500" aria-hidden="true">⏱️</span>
            <span class="absolute right-2.5 top-3.5 text-[9px] md:text-[10px] text-slate-500 font-bold tracking-wider" aria-hidden="true">MIN</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4 pt-3 border-t border-slate-700/50 relative">
      <div class="grid grid-cols-2 gap-3 md:gap-4">
        <div class="bg-black/30 p-3 rounded-xl md:rounded-2xl flex flex-col items-center justify-center relative min-h-[70px] md:min-h-[80px] border border-slate-700/50 shadow-inner">
          <span class="text-[9px] md:text-[10px] text-orange-300 uppercase font-black tracking-wider mb-1 opacity-90">{t.label_temp}</span>
          <div class="flex items-baseline gap-1">
            <span id="res-temp" class="text-3xl font-black text-white drop-shadow-md">--</span>
            <span class="text-lg md:text-xl font-bold text-orange-400" aria-hidden="true">{tempSymbol}</span>
          </div>
        </div>
        <div class="bg-black/30 p-3 rounded-xl md:rounded-2xl flex flex-col items-center justify-center relative min-h-[70px] md:min-h-[80px] border border-slate-700/50 shadow-inner">
          <span class="text-[9px] md:text-[10px] text-orange-300 uppercase font-black tracking-wider mb-1 opacity-90">{t.label_time}</span>
          <div class="flex items-baseline gap-1">
            <span id="res-time" class="text-3xl font-black text-white drop-shadow-md">--</span>
            <span class="text-lg md:text-xl font-bold text-orange-400" aria-hidden="true">m</span>
          </div>
        </div>
      </div>

      <div id="eco-container" class="hidden flex justify-center mt-3 mb-1">
        <div class="bg-emerald-950/50 border border-emerald-500/30 px-3 md:px-4 py-1.5 rounded-full flex items-center gap-2 shadow-[0_0_10px_rgba(16,185,129,0.1)] backdrop-blur-sm">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
          <span class="text-[10px] md:text-xs font-bold text-emerald-400 uppercase tracking-wide">
            {t.eco_label} <span id="res-eco">{initialEco}</span>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="py-2">
    <button id="cta-recipes-unified" class="w-full py-3.5 md:py-4 border-2 border-[#F59E0B]/80 bg-gradient-to-br from-[#F59E0B]/20 to-black/40 backdrop-blur-sm rounded-xl font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all flex flex-col items-center justify-center group cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-[#F59E0B]/10 animate-pulse pointer-events-none"></div>
      <span class="text-[#F59E0B] text-[10px] md:text-xs uppercase tracking-wider mb-0.5 md:mb-1 relative z-10 drop-shadow-md">{t.cta_recipes_top}</span>
      <span class="text-white text-base md:text-xl flex items-center gap-2 group-hover:text-[#F59E0B] transition-colors relative z-10 drop-shadow-lg">
        {t.cta_recipes_bottom}
        <svg class="w-4 h-4 md:w-5 md:h-5 text-[#F59E0B] animate-bounce transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
      </span>
    </button>
  </div>

  <div class="mx-auto text-center space-y-4 px-4 pb-4 md:mt-4">
    <p class="text-[10px] text-slate-500/80 uppercase tracking-wider font-bold">{t.legal_privacy}</p>
    <div class="border-t border-white/5 w-1/3 mx-auto"></div>
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />

<script>
  function initAirFryer() {
    const wrapper = document.getElementById('airfryer-wrapper');
    if (!wrapper) return;

    const sysLang = wrapper.getAttribute('data-lang') || 'it';
    const isEn = sysLang === 'en';
    const currUnit = isEn ? '$' : '€';

    const convert = (temp: number, time: number, isInputF: boolean) => {
      let finalTemp, finalTime, isCapped = false;
      
      if (temp > 600) temp = 600; 
      if (time > 300) time = 300;
      
      if (isEn) {
        let tempF = isInputF ? temp : (temp * 9/5) + 32;
        finalTemp = tempF - 25;
        let timeMult = 1;
        
        if (finalTemp > 400) {
          isCapped = true;
          let diff = finalTemp - 400;
          finalTemp = 400;
          timeMult = 1 + (diff * 0.015);
        }
        finalTime = Math.round(time * 0.8 * timeMult);
        finalTemp = Math.round(finalTemp / 5) * 5;
      } else {
        let tempC = isInputF ? (temp - 32) * 5/9 : temp;
        finalTemp = tempC - 20;
        let timeMult = 1;
        
        if (finalTemp > 200) {
          isCapped = true;
          let diff = finalTemp - 200;
          finalTemp = 200;
          timeMult = 1 + (diff * 0.015);
        }
        finalTime = Math.round(time * 0.8 * timeMult);
        finalTemp = Math.round(finalTemp);
      }

      const ovenCost = 2.0 * (time / 60);
      const fryerCost = 1.4 * (finalTime / 60);
      const saved = ((ovenCost - fryerCost) * 0.30).toFixed(2);
      
      return { temp: finalTemp, time: finalTime, saved: saved, isCapped: isCapped };
    };

    const updateUI = (res: { temp: number | string, time: number | string, saved: string, isCapped: boolean }) => {
      const elTemp = document.getElementById('res-temp');
      const elTime = document.getElementById('res-time');
      const elEco = document.getElementById('res-eco');
      
      if (elTemp) elTemp.innerText = res.temp.toString();
      if (elTime) elTime.innerText = res.time.toString();
      if (elEco) elEco.innerText = isEn ? (currUnit + res.saved) : (res.saved + currUnit);
      
      document.getElementById('error-box')?.classList.add('hidden');
      document.getElementById('eco-container')?.classList.remove('hidden');
      
      // MOSTRA/NASCONDI ALERT CON LOGICA FLEX (Perché ora usiamo flex-row nel tooltip)
      const capAlert = document.getElementById('cap-alert');
      if (capAlert) {
        if (res.isCapped) {
            capAlert.classList.remove('hidden');
            capAlert.classList.add('flex');
        } else {
            capAlert.classList.add('hidden');
            capAlert.classList.remove('flex');
        }
      }
    };

    const resetUI = () => {
      const elTemp = document.getElementById('res-temp');
      const elTime = document.getElementById('res-time');
      const elEco = document.getElementById('res-eco');
      
      if (elTemp) elTemp.innerText = "--";
      if (elTime) elTime.innerText = "--";
      if (elEco) elEco.innerText = isEn ? "$0.00" : "0.00€";
      
      document.getElementById('error-box')?.classList.add('hidden');
      document.getElementById('eco-container')?.classList.add('hidden');

      const capAlert = document.getElementById('cap-alert');
      if (capAlert) {
        capAlert.classList.add('hidden');
        capAlert.classList.remove('flex');
      }
    };

    const runParser = (showErrors = false) => {
      const inputEl = document.getElementById('recipe-input') as HTMLTextAreaElement | null;
      const btnConvert = document.getElementById('btn-convert');
      if (!inputEl) return;
      const text = inputEl.value;
      
      const tMatch = text.match(/(\d{3})\s*(?:°|º|gradi|degrees)?\s*([CFcf]?)/i);
      const mMatch = text.match(/(\d{1,3})\s*(?:m|min|minutes|minuti|minutos)/i);

      if (tMatch && mMatch) {
        const tempVal = parseInt(tMatch[1], 10);
        const isF = tMatch[2].toUpperCase() === 'F' || (isEn && tMatch[2].toUpperCase() !== 'C');
        const timeVal = parseInt(mMatch[1], 10);
        
        const res = convert(tempVal, timeVal, isF);
        updateUI(res);
        if (btnConvert) btnConvert.classList.add('hidden');
      } else {
        resetUI();
        if (btnConvert && text.length > 5) btnConvert.classList.remove('hidden');
        if (showErrors) document.getElementById('error-box')?.classList.remove('hidden');
      }
    };

    const runManual = () => {
      const tInput = document.getElementById('manual-temp') as HTMLInputElement | null;
      const mInput = document.getElementById('manual-time') as HTMLInputElement | null;
      if (!tInput || !mInput) return;
      const t = parseInt(tInput.value || "0", 10);
      const m = parseInt(mInput.value || "0", 10);
      
      if (t > 0 && m > 0) {
        updateUI(convert(t, m, isEn));
      } else {
        resetUI();
      }
    };

    const scrollToRecipes = (e: Event) => {
      e.preventDefault();
      const recipeSection = document.getElementById('ricettario');
      if (recipeSection) {
        recipeSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        window.location.href = '/#ricettario';
      }
    };

    document.getElementById('btn-convert')?.addEventListener('click', () => runParser(true));
    
    document.getElementById('recipe-input')?.addEventListener('input', (e) => {
      const target = e.target as HTMLTextAreaElement;
      if (target.value.trim() === "") {
          resetUI();
          document.getElementById('btn-convert')?.classList.add('hidden');
      } else {
          document.getElementById('error-box')?.classList.add('hidden');
          runParser(false); 
      }
    });
    
    document.getElementById('manual-temp')?.addEventListener('input', runManual);
    document.getElementById('manual-time')?.addEventListener('input', runManual);
    document.getElementById('cta-recipes-unified')?.addEventListener('click', scrollToRecipes);

    const btnConv = document.getElementById('tab-conv');
    const btnFood = document.getElementById('tab-food');
    const viewConv = document.getElementById('view-converter');
    const viewFood = document.getElementById('view-presets');

    if(btnConv && btnFood && viewConv && viewFood) {
      const switchTo = (mode: 'conv' | 'food') => {
        resetUI();
        if(mode === 'conv') {
          viewConv.classList.remove('hidden');
          viewFood.classList.add('hidden');
          btnConv.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-bold bg-gradient-to-b from-orange-400 to-orange-500 text-black shadow-md transition-all";
          btnConv.setAttribute('aria-selected', 'true');
          btnFood.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-white transition-all";
          btnFood.setAttribute('aria-selected', 'false');
        } else {
          viewConv.classList.add('hidden');
          viewFood.classList.remove('hidden');
          btnFood.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-bold bg-gradient-to-b from-orange-400 to-orange-500 text-black shadow-md transition-all";
          btnFood.setAttribute('aria-selected', 'true');
          btnConv.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-white transition-all";
          btnConv.setAttribute('aria-selected', 'false');
        }
      };
      btnConv.addEventListener('click', () => switchTo('conv'));
      btnFood.addEventListener('click', () => switchTo('food'));
    }
  }

  document.addEventListener('DOMContentLoaded', initAirFryer);
  document.addEventListener('astro:page-load', initAirFryer);
</script>