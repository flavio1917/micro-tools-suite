      </div>
    </div>
  </div>

  {lang === 'it' && (
    <div class="fixed bottom-0 left-0 right-0 z-[100]">
      <div class="w-full bg-[#0B1120] md:border-t md:border-slate-800 border-t border-orange-500/30 p-3 flex items-center justify-between gap-3 shadow-2xl">
