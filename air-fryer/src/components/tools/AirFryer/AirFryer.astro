const t = translations[lang as keyof typeof translations] || translations.it;

const isEn = lang === 'en';
const tempSymbol = isEn ? '°F' : '°C';
const currSymbol = isEn ? '$' : '€';
---
<div id="airfryer-wrapper" data-lang={lang} class="max-w-[480px] mx-auto space-y-3 md:space-y-4">
  <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-3xl shadow-2xl overflow-hidden font-sans text-white p-4 relative">
    
    <div class="text-center mb-4">
      <h2 class="text-xl font-bold text-slate-100">{t.title} <span class="text-[#F59E0B]">{t.subtitle}</span></h2>
    </div>

    <div class="flex p-1 bg-black/20 border border-white/5 rounded-xl mb-4 gap-1">
      <button id="tab-conv" class="flex-1 py-2 rounded-lg text-xs font-bold bg-[#F59E0B] text-black transition-all">{t.tab_conv}</button>
