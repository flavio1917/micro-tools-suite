      <button id="tab-recipes" class="flex-1 py-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white transition-all">{t.tab_recipes}</button>
    </div>

    <div id="view-converter" class="space-y-3 animate-fade-in">
