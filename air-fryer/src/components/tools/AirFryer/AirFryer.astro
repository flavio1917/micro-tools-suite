  <div class="h-24 md:h-12"></div>
</div>

{lang === 'it' && (
  <div class="fixed bottom-0 left-0 right-0 z-[100] pointer-events-none flex justify-center md:pb-6 transition-transform duration-300">
    <div class="w-full md:max-w-2xl bg-gradient-to-t from-[#0B1120] via-slate-900/95 to-slate-900/90 md:bg-gradient-to-r md:from-slate-900 md:via-slate-800 md:to-slate-900 backdrop-blur-xl border-t md:border border-orange-500/30 md:rounded-full shadow-[0_-10px_40px_rgba(245,158,11,0.15)] p-3 md:px-5 flex items-center justify-between gap-4 pointer-events-auto">
      <div class="flex items-center gap-3 flex-1 min-w-0">
         <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 p-[1px] flex-shrink-0 shadow-[0_0_10px_rgba(245,158,11,0.5)] animate-pulse">
            <div class="w-full h-full bg-slate-900 rounded-full flex items-center justify-center text-lg">🎁</div>
         </div>
        <div class="flex-1 min-w-0">
          <span class="block text-[10px] uppercase tracking-widest font-extrabold text-orange-400 mb-0.5 drop-shadow-md">Migliora la tua Friggitrice</span>
          <p class="text-xs md:text-sm text-slate-100 leading-tight font-semibold truncate">Scopri il Kit Accessori Universale definitivo.</p>
        </div>
      </div>
      <a href="https://www.amazon.it/s?k=kit+accessori+friggitrice+ad+aria&tag=convfriggit-21" target="_blank" rel="nofollow noopener" class="flex-shrink-0 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-400 hover:to-amber-400 text-black text-xs md:text-sm font-black py-2.5 px-5 rounded-full flex items-center gap-1.5 shadow-[0_0_15px_rgba(245,158,11,0.4)] hover:shadow-[0_0_25px_rgba(245,158,11,0.6)] transition-all hover:scale-105 active:scale-95">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        <span class="hidden sm:inline">Scopri le</span> Offerte
      </a>
    </div>
  </div>
)}

<script>
  const ads = [
    { k: ['patat', 'fries', 'chips', 'surgelat', 'frozen'], t: "Per patatine croccanti e non unte, questo spray è fondamentale.", l: "https://www.amazon.it/dp/B0GC74RM68?tag=convfriggit-21" },
    { k: ['pollo', 'chicken', 'wings', 'alette', 'carne', 'meat'], t: "Non sporcare il cestello! Usa le teglie in carta forno per Air Fryer.", l: "https://www.amazon.it/dp/B0FP284FKG?tag=convfriggit-21" },
    { k: ['pesce', 'fish', 'salmone'], t: "Cucina il pesce senza odori persistenti con i tappetini in silicone.", l: "https://www.amazon.it/dp/B0FVM478YZ?tag=convfriggit-21" },
    { k: ['dolc', 'cake', 'muffin', 'verdur', 'veggie'], t: "Set di stampi in silicone per cotture delicate e uniformi.", l: "https://www.amazon.it/s?k=stampi+silicone+friggitrice+ad+aria&tag=convfriggit-21" }
  ];
  const defaultAd = { t: "Il kit definitivo per sfruttare al 100% la tua friggitrice.", l: "https://www.amazon.it/s?k=kit+accessori+friggitrice+ad+aria&tag=convfriggit-21" };
  
  const wrapper = document.getElementById('airfryer-wrapper');
  const sysLang = wrapper ? wrapper.getAttribute('data-lang') : 'it';
  const isEn = sysLang === 'en';
  const currUnit = isEn ? '$' : '€';

  const convert = (temp: number, time: number, isInputF: boolean) => {
    let finalTemp, finalTime, isCapped = false;
    
    if (isEn) {
      let tempF = isInputF ? temp : (temp * 9/5) + 32;
      finalTemp = tempF - 25;
      let timeMult = 1;
      
      if (finalTemp > 400) {
        isCapped = true;
        let diff = finalTemp - 400;
        finalTemp = 400;
        timeMult = 1 + (diff * 0.015);
      }
      finalTime = Math.round(time * 0.8 * timeMult);
      finalTemp = Math.round(finalTemp / 5) * 5;
      
    } else {
      let tempC = isInputF ? (temp - 32) * 5/9 : temp;
      finalTemp = tempC - 20;
      let timeMult = 1;
      
      if (finalTemp > 200) {
        isCapped = true;
        let diff = finalTemp - 200;
        finalTemp = 200;
        timeMult = 1 + (diff * 0.015);
      }
      finalTime = Math.round(time * 0.8 * timeMult);
      finalTemp = Math.round(finalTemp);
    }

    const ovenCost = 2.0 * (time / 60);
    const fryerCost = 1.4 * (finalTime / 60);
    const saved = ((ovenCost - fryerCost) * 0.30).toFixed(2);
    
    return { temp: finalTemp, time: finalTime, saved: saved, isCapped: isCapped };
  };

  const updateUI = (res: { temp: number | string, time: number | string, saved: string, isCapped: boolean }, keyword: string = '') => {
    const resTemp = document.getElementById('res-temp');
    const resTime = document.getElementById('res-time');
    const resEco = document.getElementById('res-eco');
    const errorBox = document.getElementById('error-box');
    const capAlert = document.getElementById('cap-alert');
    const adText = document.getElementById('ad-text');
    const adLink = document.getElementById('ad-link') as HTMLAnchorElement | null;

    if (resTemp) resTemp.innerText = res.temp.toString();
    if (resTime) resTime.innerText = res.time.toString();
    if (resEco) resEco.innerText = isEn ? (currUnit + res.saved) : (res.saved + currUnit);
    if (errorBox) errorBox.classList.add('hidden');
    
    if (capAlert) {
      if (res.isCapped) capAlert.classList.remove('hidden');
      else capAlert.classList.add('hidden');
    }

    const textLower = keyword.toLowerCase();
    const ad = ads.find(a => a.k.some(kw => textLower.includes(kw))) || defaultAd;
    
    if (adText) adText.innerText = ad.t;
    if (adLink) adLink.href = ad.l;
  };

  const resetUI = () => {
    const resTemp = document.getElementById('res-temp');
    const resTime = document.getElementById('res-time');
    const resEco = document.getElementById('res-eco');
    const errorBox = document.getElementById('error-box');
    const capAlert = document.getElementById('cap-alert');

    if (resTemp) resTemp.innerText = "--";
    if (resTime) resTime.innerText = "--";
    if (resEco) resEco.innerText = isEn ? "$0.00" : "0.00€";
    if (errorBox) errorBox.classList.add('hidden');
    if (capAlert) capAlert.classList.add('hidden');
  };

  const runParser = () => {
    const inputEl = document.getElementById('recipe-input') as HTMLTextAreaElement | null;
    if (!inputEl) return;
    const text = inputEl.value;
    const tMatch = text.match(/(\d{3})\s?[°º]?\s?([CFcf]?)/);
    const mMatch = text.match(/(\d{1,3})\s?(m|min|minutes|minuti)/i);

    if (tMatch && mMatch) {
      const tempVal = parseInt(tMatch[1]);
      const isF = tMatch[2].toUpperCase() === 'F' || (isEn && tMatch[2].toUpperCase() !== 'C');
      const timeVal = parseInt(mMatch[1]);
      const res = convert(tempVal, timeVal, isF);
      updateUI(res, text);
    } else {
      const errorBox = document.getElementById('error-box');
      if (errorBox) errorBox.classList.remove('hidden');
    }
  };

  const runManual = () => {
    const tInput = document.getElementById('manual-temp') as HTMLInputElement | null;
    const mInput = document.getElementById('manual-time') as HTMLInputElement | null;
    if (!tInput || !mInput) return;
    const t = parseInt(tInput.value || "0");
    const m = parseInt(mInput.value || "0");
    if (t > 0 && m > 0) {
      const res = convert(t, m, isEn);
      updateUI(res, "");
    } else {
      resetUI();
    }
  };

  const scrollToRecipes = (e: Event) => {
    e.preventDefault();
    const recipeSection = document.getElementById('ricettario');
    if (recipeSection) {
      recipeSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    } else {
      window.location.href = '/#ricettario';
    }
  };

  document.getElementById('btn-convert')?.addEventListener('click', runParser);
  
  const recipeInput = document.getElementById('recipe-input') as HTMLTextAreaElement | null;
  recipeInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLTextAreaElement;
    if (target.value.trim() === "") resetUI();
    else document.getElementById('error-box')?.classList.add('hidden');
  });
  
  document.getElementById('manual-temp')?.addEventListener('input', runManual);
  document.getElementById('manual-time')?.addEventListener('input', runManual);

  document.getElementById('tab-recipes')?.addEventListener('click', scrollToRecipes);
  document.getElementById('cta-recipes-unified')?.addEventListener('click', scrollToRecipes);

  const btnConv = document.getElementById('tab-conv');
  const btnFood = document.getElementById('tab-food');
  const viewConv = document.getElementById('view-converter');
  const viewFood = document.getElementById('view-presets');

  if(btnConv && btnFood && viewConv && viewFood) {
    const switchTo = (mode: 'conv' | 'food') => {
      resetUI();
      if(mode === 'conv') {
        viewConv.classList.remove('hidden');
        viewFood.classList.add('hidden');
        btnConv.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-bold bg-[#F59E0B] text-black shadow-md transition-all";
        btnFood.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-white transition-all";
      } else {
        viewConv.classList.add('hidden');
        viewFood.classList.remove('hidden');
        btnFood.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-bold bg-[#F59E0B] text-black shadow-md transition-all";
        btnConv.className = "flex-1 py-2 rounded-lg text-xs sm:text-sm font-medium text-slate-400 hover:text-white transition-all";
      }
    };
    btnConv.addEventListener('click', () => switchTo('conv'));
    btnFood.addEventListener('click', () => switchTo('food'));
  }
</script>