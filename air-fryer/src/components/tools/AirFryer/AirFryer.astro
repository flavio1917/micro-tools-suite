  <div class="py-2">
    <button id="cta-recipes-unified" class="w-full py-4 border-2 border-[#F59E0B]/80 bg-gradient-to-br from-[#F59E0B]/20 to-black/40 backdrop-blur-sm rounded-xl font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)] transition-all flex flex-col items-center justify-center group cursor-pointer relative overflow-hidden">
      <div class="absolute inset-0 bg-[#F59E0B]/10 animate-pulse pointer-events-none"></div>
      <span class="text-[#F59E0B] text-xs uppercase tracking-wider mb-1 relative z-10 drop-shadow-md">{t.cta_recipes_top}</span>
