---
import recipes from '../../../data/recipes-it.json';

export interface Props { lang?: string; }
const { lang = "it" } = Astro.props;

const totalRecipes = recipes.length || 200;
const roundedCount = Math.floor(totalRecipes / 10) * 10;

const translations = {
  it: {
    title: "Friggitrice ad Aria", subtitle: "Smart", tab_conv: "Incolla Ricetta", tab_food: "Inserisci Dati", tab_recipes: "Ricettario",
    placeholder: "Incolla qui il testo della ricetta per Forno (es: 'Cuocere a 200°C per 40 minuti')...",
    btn_action: "Converti Ora", label_temp: "Temperatura", label_time: "Tempo", eco_label: "Risparmio stimato: ~",
    ad_title: "Consiglio dello Chef", ad_label: "Scelta Top", ad_link: "Verifica il Prezzo", manual_temp: "TEMP. FORNO",
    manual_time: "MINUTI FORNO", error_msg: "⚠️ Manca qualcosa! Inserisci Temperatura e Tempo.", legal_privacy: "🔒 Privacy First: Calcoli locali. Nessun dato inviato.",
    legal_disclaimer: "⚠️ DISCLAIMER: In qualità di Affiliato Amazon, ricevo un guadagno dagli acquisti idonei. Risultati stimati su base matematica (-20°C / -20%). Controlla SEMPRE la cottura.",
    shop_items: [
      { name: "Carta Forno", image: "/images/ads/paper-liner-main-page.jpg", link: "https://www.amazon.it/dp/B0FP284FKG?tag=convfriggit-21" },
      { name: "Magneti Cottura", image: "/images/ads/magnets-main-page.jpg", link: "https://www.amazon.it/dp/B0FJRJP94B?tag=convfriggit-21" },
      { name: "Olio Spray", image: "/images/ads/oil-spray-main.jpg", link: "https://www.amazon.it/dp/B0GC74RM68?tag=convfriggit-21" }
    ],
    alert_cap: "⚠️ Temp limitata a 200°C (Max Air Fryer)", cta_recipes_top: "Non sai cosa cucinare?", cta_recipes_bottom: `Esplora le nostre ${roundedCount}+ Ricette`, badge_grid: "TOP", btn_grid: "Prezzo"
  },
  en: {
    title: "Air Fryer Calculator", subtitle: "Pro", tab_conv: "Paste Recipe", tab_food: "Manual Input", tab_recipes: "Recipes",
    placeholder: "Paste oven recipe text here (e.g. 'Bake at 400°F for 40 minutes')...",
    btn_action: "Convert Now", label_temp: "Temperature", label_time: "Time", eco_label: "Est. Savings: ~",
    ad_title: "Chef's Tip", ad_label: "Top Pick", ad_link: "Check Price", manual_temp: "OVEN TEMP.",
    manual_time: "OVEN MINUTES", error_msg: "⚠️ Missing inputs! Please provide Temp and Time.", legal_privacy: "🔒 Privacy First: Local calculations. No data sent.",
    legal_disclaimer: "⚠️ DISCLAIMER: As an Amazon Associate I earn from qualifying purchases. Estimated results (-25°F / -20%). ALWAYS check food.",
    shop_items: [], alert_cap: "⚠️ Capped at 400°F (Max Air Fryer Temp)", cta_recipes_top: "Don't know what to cook?", cta_recipes_bottom: `Explore ${roundedCount}+ Recipes`, badge_grid: "TOP", btn_grid: "Price"
  },
  es: {
    title: "Freidora de Aire", subtitle: "Smart", tab_conv: "Pegar Receta", tab_food: "Datos Manuales", tab_recipes: "Recetas",
    placeholder: "Pega el texto de la receta para el horno aquí (ej: 'Hornear a 200°C por 40 min')...",
    btn_action: "Convertir Ahora", label_temp: "Temperatura", label_time: "Tiempo", eco_label: "Ahorro estimado: ~",
    ad_title: "Consejo del Chef", ad_label: "Elección Top", ad_link: "Ver Precio", manual_temp: "TEMP. HORNO",
    manual_time: "MINUTOS HORNO", error_msg: "⚠️ ¡Falta algo! Introduce Temperatura y Tiempo.", legal_privacy: "🔒 Privacidad: Cálculos locales. Sin envío de datos.",
    legal_disclaimer: "⚠️ AVISO: En calidad de Afiliado de Amazon, obtengo ingresos por las compras adscritas. Resultados estimados (-20°C / -20%). Revisa SIEMPRE la cocción.",
    shop_items: [], alert_cap: "⚠️ Temp limitada a 200°C (Máx Air Fryer)", cta_recipes_top: "¿No sabes qué cocinar?", cta_recipes_bottom: `Explora ${roundedCount}+ Recetas`, badge_grid: "TOP", btn_grid: "Precio"
  },
  fr: {
    title: "Friteuse à Air", subtitle: "Smart", tab_conv: "Coller Recette", tab_food: "Saisie Manuelle", tab_recipes: "Recettes",
    placeholder: "Collez le texte de la recette pour four ici (ex: 'Cuire à 200°C pendant 40 minutes')...",
    btn_action: "Convertir", label_temp: "Température", label_time: "Temps", eco_label: "Économie est. : ~",
    ad_title: "Astuce du Chef", ad_label: "Top Choix", ad_link: "Vérifier le Prix", manual_temp: "TEMP. FOUR",
    manual_time: "MINUTES FOUR", error_msg: "⚠️ Il manque des données ! Entrez la Température et le Temps.", legal_privacy: "🔒 Confidentialité : Calculs locaux. Aucune donnée envoyée.",
    legal_disclaimer: "⚠️ AVIS : En tant que Partenaire Amazon, je réalise un bénéfice sur les achats. Résultats estimés (-20°C / -20%). Vérifiez TOUJOURS la cuisson.",
    shop_items: [], alert_cap: "⚠️ Temp. limitée à 200°C (Max Air Fryer)", cta_recipes_top: "Vous ne savez pas quoi cuisiner ?", cta_recipes_bottom: `Explorez nos ${roundedCount}+ Recettes`, badge_grid: "TOP", btn_grid: "Prix"
  }
