  <div class="block md:hidden space-y-4">
    {lang === 'it' && (
      <div class="grid grid-cols-3 gap-2 w-full mx-auto">
        {t.shop_items.map(item => (
          <a href={item.link} target="_blank" rel="nofollow noopener" class="bg-transparent border border-white/5 rounded-xl p-1.5 text-center hover:border-[#F59E0B]/50 transition-all group block relative">
            <span class="absolute top-1 right-1 bg-emerald-500/20 text-emerald-400 text-[8px] font-bold px-1.5 py-0.5 rounded uppercase tracking-wider z-10 backdrop-blur-sm border border-emerald-500/30">{t.badge_grid}</span>
            <div class="aspect-square w-full mb-2 overflow-hidden bg-white/5 rounded-xl flex items-center justify-center p-2">
              <img src={item.image} alt={item.name} class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300" />
