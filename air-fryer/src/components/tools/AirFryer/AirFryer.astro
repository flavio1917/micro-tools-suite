---
import recipes from '../../../data/recipes.json';

export interface Props { lang: string; }
const { lang } = Astro.props;

// Calcolo dinamico del numero (es. 155 diventa 150)
const totalRecipes = recipes.length;
const roundedCount = Math.floor(totalRecipes / 10) * 10;

const translations = {
  it: {
    title: "Friggitrice ad Aria",
    subtitle: "Smart",
    tab_conv: "Incolla Ricetta",
    tab_food: "Inserisci Dati",
    tab_recipes: "Ricettario",
    placeholder: "Incolla qui il testo della ricetta (es: 'Cuocere a 200°C per 40 minuti')...",
    btn_action: "Converti Ora",
    label_temp: "Temperatura",
    label_time: "Tempo",
    eco_label: "Risparmio stimato: ~",
    ad_title: "Consiglio dello Chef",
    ad_link: "Vedi su Amazon",
    manual_temp: "TEMP. FORNO",
    manual_time: "MINUTI FORNO",
    error_msg: "⚠️ Manca qualcosa! Inserisci Temperatura e Tempo.",
    legal_privacy: "🔒 Privacy First: Calcoli locali. Nessun dato inviato.",
    legal_disclaimer: "⚠️ DISCLAIMER: Risultati stimati su base matematica standard (-20°C / -20%). Controlla SEMPRE la cottura. L'autore declina responsabilità.",
    shop_items: [
      { name: "Carta Forno", image: "/images/ads/paper-liner-main-page.jpg", link: "https://www.amazon.it/dp/B0FP284FKG?tag=convfriggit-21" },
      { name: "Magneti Carta Forno", image: "/images/ads/magnets-main-page.jpg", link: "https://www.amazon.it/dp/B0FJRJP94B?tag=convfriggit-21" },
      { name: "Olio Spray", image: "/images/ads/oil-spray-main.jpg", link: "https://www.amazon.it/dp/B0GC74RM68?tag=convfriggit-21" }
    ],
    alert_cap: "Temp max raggiungibile da friggitrice ad aria a 200°C",
    cta_recipes_top: "Non sai cosa cucinare?",
    cta_recipes_bottom: `Esplora le nostre ${roundedCount}+ Ricette`
  },
  en: {
    title: "Air Fryer",
    subtitle: "Smart",
    tab_conv: "Paste Recipe",
    tab_food: "Manual Input",
    tab_recipes: "Recipes",
    placeholder: "Paste recipe text here...",
    btn_action: "Convert Now",
    label_temp: "Temperature",
    label_time: "Time",
    eco_label: "Est. Savings: ~",
    ad_title: "Chef's Tip",
    ad_link: "View on Amazon",
    manual_temp: "OVEN TEMP.",
    manual_time: "OVEN MINUTES",
    error_msg: "⚠️ Missing inputs.",
    legal_privacy: "🔒 Privacy First: Local calculations.",
    legal_disclaimer: "⚠️ DISCLAIMER: Estimated results. ALWAYS check food. Not responsible for errors.",
    shop_items: [
      { name: "Liners", image: "/images/ads/paper-liner-main-page.png", link: "https://www.amazon.it/dp/B0FP284FKG?tag=convfriggit-21" },
      { name: "Sprayer", image: "/images/ads/oil-spray-main.png", link: "https://www.amazon.it/dp/B0GC74RM68?tag=convfriggit-21" },
      { name: "Cheat Sheet", image: "/images/ads/magnets-main-page.png", link: "https://www.amazon.it/dp/B08J3B1VXZ?tag=convfriggit-21" }
    ],
    alert_cap: "⚠️ Capped at 200°C",
    cta_recipes_top: "Don't know what to cook?",
    cta_recipes_bottom: `Explore ${roundedCount}+ Recipes`
  },
  es: {
    title: "Freidora de Aire",
    subtitle: "Smart",
    tab_conv: "Pegar Receta",
    tab_food: "Datos Manuales",
    tab_recipes: "Recetas",
    placeholder: "Pega el texto de la receta aquí...",
    btn_action: "Convertir Ahora",
    label_temp: "Temperatura",
    label_time: "Tiempo",
    eco_label: "Ahorro estimado: ~",
    ad_title: "Consejo del Chef",
    ad_link: "Ver en Amazon",
    manual_temp: "TEMP. HORNO",
    manual_time: "MINUTOS HORNO",
    error_msg: "⚠️ ¡Falta algo! Introduce Temperatura y Tiempo.",
    legal_privacy: "🔒 Privacidad: Cálculos locales. Sin envío de datos.",
    legal_disclaimer: "⚠️ AVISO: Resultados estimados (-20°C / -20%). Revisa SIEMPRE la cocción. El autor no se hace responsable.",
    shop_items: [
      { name: "Papel Horno", image: "/images/ads/paper-liner-main-page.png", link: "https://www.amazon.it/dp/B0FP284FKG?tag=convfriggit-21" },
      { name: "Aceite Spray", image: "/images/ads/oil-spray-main.png", link: "https://www.amazon.it/dp/B0GC74RM68?tag=convfriggit-21" },
      { name: "Imanes Tiempos", image: "/images/ads/magnets-main-page.png", link: "https://www.amazon.it/dp/B08J3B1VXZ?tag=convfriggit-21" }
    ],
    alert_cap: "⚠️ Temp limitada a 200°C",
