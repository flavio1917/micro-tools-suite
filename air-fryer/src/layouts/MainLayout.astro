---
import "../styles/global.css"; // <--- QUESTA RIGA È FONDAMENTALE PER IL CSS

export interface Props {
  title: string;
  lang?: string;
}

const { title, lang = "it" } = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <link rel="icon" type="image/png" href="/favicon.png" />
    
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content="Converti le ricette da forno tradizionale a friggitrice ad aria in un click. Calcola tempi e gradi corretti per risparmiare energia." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Convertitore Friggitrice ad Aria: Calcola Tempi e Gradi e risparmia bolletta." />
    <meta property="og:image" content="https://www.convertitorefriggitrice.it/og-image.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.convertitorefriggitrice.it" />
  </head>
  <body class="bg-[#0B1120] text-slate-300 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white">
    
    <main class="flex-grow w-full px-4 py-8">
      <slot />
    </main>

    <footer class="bg-[#0F172A] border-t border-slate-800 mt-auto py-10 text-center font-sans">
      <div class="max-w-[480px] mx-auto px-6 space-y-6">
        
        <div class="p-4 bg-slate-900/50 rounded-xl border border-slate-800">
          <p class="text-[10px] text-slate-500 leading-relaxed text-justify">
            <strong>Disclaimer Affiliazione:</strong> In qualità di Affiliato Amazon, questo sito riceve un guadagno dagli acquisti idonei. 
            I prezzi e la disponibilità dei prodotti sono accurati alla data/ora indicata e sono soggetti a modifica. 
            Qualsiasi informazione di prezzo o disponibilità visualizzata su Amazon al momento dell'acquisto si applicherà all'acquisto di tale prodotto.
            Il logo Amazon e il logo Amazon Prime sono marchi di Amazon.com, Inc. o delle sue affiliate.
          </p>
        </div>

        <div class="flex justify-center gap-4 text-[11px] text-slate-400 font-medium tracking-wide">
          <a href="/privacy" class="hover:text-blue-400 transition-colors decoration-dashed underline-offset-4 hover:underline">Privacy Policy</a>
          <span>•</span>
          <a href="/cookies" class="hover:text-blue-400 transition-colors decoration-dashed underline-offset-4 hover:underline">Cookie Policy</a>
        </div>

        <p class="text-[10px] text-slate-600 font-mono">
          © {new Date().getFullYear()} ConvertitoreFriggitrice.it - Tutti i diritti riservati.
        </p>
      </div>
    </footer>

  </body>
</html>