---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  recipeData?: any;
  alternateUrls?: { 
    it?: string; 
    en?: string; 
    es?: string; 
    fr?: string;
  };
}

const { 
  title = "Convertitore Friggitrice ad Aria: Tempi e Gradi Online", 
  lang = "it",
  description = "Il miglior convertitore friggitrice ad aria online. Trasforma tempi e temperature da forno a Air Fryer in un click. Oltre 220 ricette ottimizzate.",
  ogImage = "https://www.convertitorefriggitrice.it/og-image.jpg",
  recipeData,
  alternateUrls
} = Astro.props;

// Genera l'URL canonico corretto per ogni pagina
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://www.convertitorefriggitrice.it").toString();

// Gestione dinamica e pulita delle traduzioni del Footer
const disclaimers = {
  it: "Trasparenza: In qualità di Affiliato Amazon, questo sito riceve un guadagno dagli acquisti idonei. I risultati della conversione sono stime basate su parametri standard (-20°C / -20% tempo). Controlla sempre la cottura. Le immagini sono a scopo illustrativo (IA).",
  en: "Transparency: As an Amazon Associate, this site earns from qualifying purchases. Conversion results are estimates based on standard parameters (-40°F / -20% time). Always check your food. Images are for illustrative purposes (AI).",
  es: "Transparencia: Como Afiliado de Amazon, este sitio recibe una comisión por compras elegibles. Los resultados son estimaciones basadas en parámetros estándar (-20°C / -20% tiempo). Comprueba siempre la cocción. Las imágenes son ilustrativas (IA).",
  fr: "Transparence : En tant que Partenaire Amazon, ce site réalise un bénéfice sur les achats remplissant les conditions requises. Les résultats sont des estimations basées sur des paramètres standards (-20°C / -20% temps). Vérifiez toujours la cuisson. Images à but illustratif (IA)."
};

const footerLabels = {
  it: { about: "Chi Siamo", privacy: "Privacy", cookie: "Cookie", prefix: "" },
  en: { about: "About Us", privacy: "Privacy", cookie: "Cookies", prefix: "/en" },
  es: { about: "Quiénes Somos", privacy: "Privacidad", cookie: "Cookies", prefix: "/es" },
  fr: { about: "À Propos", privacy: "Confidentialité", cookie: "Cookies", prefix: "/fr" }
};

// Seleziona la lingua corretta (fallback all'italiano se non trovata)
const currentDisclaimer = disclaimers[lang as keyof typeof disclaimers] || disclaimers.it;
const currentLabels = footerLabels[lang as keyof typeof footerLabels] || footerLabels.it;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta name="google-site-verification" content="Tx2vsoQT33RAsPE5ydGss9ylFckhKM1DCAI59kyDlW8" />
    <meta name="p:domain_verify" content="0513c10094fa04708fce47d2922e822b"/>

    {alternateUrls?.it && <link rel="alternate" hreflang="it" href={alternateUrls.it} />}
    {alternateUrls?.en && <link rel="alternate" hreflang="en-US" href={alternateUrls.en} />}
    {alternateUrls?.es && <link rel="alternate" hreflang="es" href={alternateUrls.es} />}
    {alternateUrls?.fr && <link rel="alternate" hreflang="fr" href={alternateUrls.fr} />}
    {alternateUrls?.it && <link rel="alternate" hreflang="x-default" href={alternateUrls.it} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Convertitore Friggitrice ad Aria",
        "url": "https://www.convertitorefriggitrice.it",
        "description": "Strumento online per convertire automaticamente tempi e temperature da forno a friggitrice ad aria.",
        "applicationCategory": "KitchenTool",
        "operatingSystem": "All",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR"
        }
      }
    </script>

    {recipeData && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org/",
        "@type": "Recipe",
        "name": recipeData.title,
        "image": [`https://www.convertitorefriggitrice.it${recipeData.image}`],
        "description": recipeData.description || `Come cucinare ${recipeData.title} in friggitrice ad aria.`,
        "cookTime": `PT${recipeData.time}M`,
        "recipeIngredient": recipeData.ingredients,
        "prepTime": "PT5M",
        "author": {
          "@type": "Organization",
          "name": "Convertitore Friggitrice"
        }
      })} />
    )}
  </head>
  
  <body class="bg-[#0B1120] text-slate-300 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white">
    
    {alternateUrls && (
      <header class="w-full flex justify-center px-4 py-4 md:py-6">
        <div class="flex items-center gap-4 bg-slate-900/60 backdrop-blur-md border border-slate-700/50 rounded-full px-5 py-2.5 shadow-[0_4px_20px_rgba(0,0,0,0.4)]">
          {alternateUrls.it && <a href={alternateUrls.it} class={`text-2xl md:text-xl hover:scale-125 transition-all duration-300 ${lang === 'it' ? 'drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100'}`} title="Italiano">🇮🇹</a>}
          {alternateUrls.en && <a href={alternateUrls.en} class={`text-2xl md:text-xl hover:scale-125 transition-all duration-300 ${lang === 'en' ? 'drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100'}`} title="English">🇬🇧</a>}
          {alternateUrls.es && <a href={alternateUrls.es} class={`text-2xl md:text-xl hover:scale-125 transition-all duration-300 ${lang === 'es' ? 'drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100'}`} title="Español">🇪🇸</a>}
          {alternateUrls.fr && <a href={alternateUrls.fr} class={`text-2xl md:text-xl hover:scale-125 transition-all duration-300 ${lang === 'fr' ? 'drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100'}`} title="Français">🇫🇷</a>}
        </div>
      </header>
    )}

    <main class="flex-grow w-full px-4 pb-8 pt-2">
      <slot />
    </main>

    <footer class="bg-[#0F172A] border-t border-slate-800 mt-auto py-10 pb-28 text-center font-sans">
      <div class="max-w-[480px] mx-auto px-6 space-y-6">
        <div class="p-4 bg-slate-900/50 rounded-xl border border-slate-800 shadow-inner text-justify">
          <p class="text-[10px] text-slate-500 leading-relaxed italic">
            <strong>{currentDisclaimer}</strong>
          </p>
        </div>
        
        <nav class="flex justify-center gap-4 text-[11px] text-slate-400 font-medium tracking-wide">
          <a href={`${currentLabels.prefix}/info`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.about}</a>
          <span>•</span>
          <a href={`${currentLabels.prefix}/privacy`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.privacy}</a>
          <span>•</span>
          <a href={`${currentLabels.prefix}/cookies`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.cookie}</a>
        </nav>
        
        <p class="text-[10px] text-slate-600 font-mono italic">
          © {new Date().getFullYear()} convertitorefriggitrice.it
        </p>
      </div>
    </footer>

    <Analytics />
  </body>
</html>