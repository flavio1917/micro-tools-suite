---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';
import { ClientRouter } from 'astro:transitions';

export interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  recipeData?: any;
  alternateUrls?: { 
    it?: string; 
    en?: string; 
    es?: string; 
    fr?: string;
  };
}

const { 
  title = "Convertitore Friggitrice ad Aria: Tempi e Gradi Online", 
  lang = "it",
  description = "Il miglior convertitore friggitrice ad aria online. Trasforma tempi e temperature da forno a Air Fryer in un click. Oltre 220 ricette ottimizzate.",
  ogImage = "https://www.convertitorefriggitrice.it/og-image.jpg",
  recipeData,
  alternateUrls
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://www.convertitorefriggitrice.it").toString();

// Gestione dinamica dei Locale per i Social Network
const locales = {
  it: "it_IT",
  en: "en_US",
  es: "es_ES",
  fr: "fr_FR"
};
const currentLocale = locales[lang as keyof typeof locales] || "it_IT";

// --- INIZIO: EXTREME CTR HACKING (SEO Dinamica Semantica) ---
let finalTitle = title;
let finalDescription = description;

if (recipeData) {
  const seoPhrases = {
    it: { pro: "Proteine", fast: "Pronto in", light: "Solo", kcal: "Kcal", read: "Ricetta testata. Leggi la guida per la cottura perfetta." },
    en: { pro: "Protein", fast: "Ready in", light: "Only", kcal: "Kcal", read: "Tested recipe. Read the guide for perfect cooking." },
    es: { pro: "Proteínas", fast: "Listo en", light: "Solo", kcal: "Kcal", read: "Receta probada. Lee la guía para una cocción perfecta." },
    fr: { pro: "Protéines", fast: "Prêt en", light: "Seulement", kcal: "Kcal", read: "Recette testée. Lisez le guide pour une cuisson parfaite." }
  };
  const p = seoPhrases[lang as keyof typeof seoPhrases] || seoPhrases.it;

  const kw = Array.isArray(recipeData.keywords) ? recipeData.keywords.map((k:string) => k.toLowerCase()) : [];
  const isMeatOrFish = kw.some((k:string) => k.includes('carne') || k.includes('pollo') || k.includes('pesce') || k.includes('salmone') || k.includes('meat') || k.includes('fish'));
  const isVegOrSide = kw.some((k:string) => k.includes('veg') || k.includes('verdure') || k.includes('patate') || k.includes('contorno') || k.includes('side'));
  
  const timeStr = recipeData.time ? recipeData.time.toString() : "";
  const numMatch = timeStr.match(/\d+/);
  const cookTimeNum = numMatch ? parseInt(numMatch[0]) : 999;
  const isFast = cookTimeNum <= 15;

  const hasNutrition = recipeData.nutrition && recipeData.nutrition.kcal;
  const kcal = hasNutrition ? recipeData.nutrition.kcal : 0;
  const pro = hasNutrition ? recipeData.nutrition.proteins_g : 0;
  const isLowCal = kcal > 0 && kcal <= 350;

  if (isMeatOrFish && pro >= 15) {
    finalTitle = `${recipeData.title} - ${pro}g ${p.pro} | Air Fryer`;
  } else if (isVegOrSide && isLowCal) {
    finalTitle = `${recipeData.title} - ${p.light} ${kcal} ${p.kcal} | Air Fryer`;
  } else if (isFast) {
    finalTitle = `${recipeData.title} - ${p.fast} ${timeStr} | Air Fryer`;
  } else {
    finalTitle = `${recipeData.title} | Air Fryer`;
  }

  const baseDesc = recipeData.description || "";
  let statsString = "";
  if (hasNutrition && isFast) statsString = `✓ ${pro}g ${p.pro} · ✓ ${timeStr} · ✓ ${kcal} ${p.kcal} — `;
  else if (hasNutrition) statsString = `✓ ${pro}g ${p.pro} · ✓ ${kcal} ${p.kcal} — `;
  else if (isFast) statsString = `✓ ${p.fast} ${timeStr} — `;

  finalDescription = `${statsString}${baseDesc} ${p.read}`;
}
// --- FINE: EXTREME CTR HACKING ---

const disclaimers = {
  it: "Trasparenza: In qualità di Affiliato Amazon, questo sito riceve un guadagno dagli acquisti idonei. I risultati della conversione sono stime basate su parametri standard (-20°C / -20% tempo). Controlla sempre la cottura.",
  en: "Transparency: As an Amazon Associate, this site earns from qualifying purchases. Conversion results are estimates based on standard parameters (-40°F / -20% time). Always check your food.",
  es: "Transparencia: Como Afiliado de Amazon, este sitio recibe una comisión por compras elegibles. Los resultados son estimaciones basadas en parámetros estándar (-20°C / -20% tiempo). Comprueba siempre la cocción.",
  fr: "Transparence : En tant que Partenaire Amazon, ce site réalise un bénéfice sur les achats remplissant les conditions requises. Les résultats sont des estimations basées sur des paramètres standards (-20°C / -20% temps)."
};

const footerLabels = {
  it: { info: "Chi Siamo", mat: "Guida Materiali", ris: "Riscaldare Avanzi", prob: "Risoluzione Problemi", err: "Codici Errore", cal: "Calcolo Calorie", pul: "Pulizia Resistenza", cons: "Costi Bolletta", ice: "Surgelati", privacy: "Privacy", cookie: "Cookie" },
  en: { info: "About Us", mat: "Materials Guide", ris: "Reheating", prob: "Troubleshooting", err: "Error Codes", cal: "Calories", pul: "Cleaning Guide", cons: "Electricity Costs", ice: "Frozen Foods", privacy: "Privacy", cookie: "Cookies" },
  es: { info: "Quiénes Somos", mat: "Guía de Materiales", ris: "Recalentar", prob: "Problemas", err: "Códigos de Error", cal: "Calorías", pul: "Guía de Limpieza", cons: "Gasto Eléctrico", ice: "Congelados", privacy: "Privacidad", cookie: "Cookies" },
  fr: { info: "À Propos", mat: "Guide des Matériaux", ris: "Réchauffer", prob: "Dépannage", err: "Codes d'Erreur", cal: "Calories", pul: "Guide de Nettoyage", cons: "Coût Électrique", ice: "Surgelés", privacy: "Confidentialité", cookie: "Cookies" }
};

const currentDisclaimer = disclaimers[lang as keyof typeof disclaimers] || disclaimers.it;
const currentLabels = footerLabels[lang as keyof typeof footerLabels] || footerLabels.it;
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-[#0B1120]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0B1120" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <link rel="preconnect" href="https://flagcdn.com" crossorigin />
    
    <ClientRouter /> 
    
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <meta name="google-site-verification" content="Tx2vsoQT33RAsPE5ydGss9ylFckhKM1DCAI59kyDlW8" />
    <meta name="p:domain_verify" content="0513c10094fa04708fce47d2922e822b"/>

    {/* Architettura Internazionale (Hreflang) */}
    {alternateUrls?.it && <link rel="alternate" hreflang="it" href={alternateUrls.it} />}
    {alternateUrls?.en && <link rel="alternate" hreflang="en-US" href={alternateUrls.en} />}
    {alternateUrls?.es && <link rel="alternate" hreflang="es" href={alternateUrls.es} />}
    {alternateUrls?.fr && <link rel="alternate" hreflang="fr" href={alternateUrls.fr} />}
    {alternateUrls?.it && <link rel="alternate" hreflang="x-default" href={alternateUrls.it} />}

    {/* Open Graph / Facebook */}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLocale} />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  
  <body class="bg-[#0B1120] text-slate-300 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white transition-colors duration-300">
    
    {alternateUrls && (
      <header class="w-full flex justify-center px-4 pt-3 pb-1 md:pt-4 md:pb-2 relative z-20 hide-on-print">
        <div class="flex items-center gap-4 bg-slate-900/60 backdrop-blur-md border border-slate-700/50 rounded-full px-5 py-2 shadow-lg">
          {alternateUrls.it && (
            <a href={alternateUrls.it} aria-label="Italiano" class="flex items-center justify-center">
              <img src="https://flagcdn.com/it.svg" alt="IT" width="24" height="18" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'it' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.en && (
            <a href={alternateUrls.en} aria-label="English" class="flex items-center justify-center">
              <img src="https://flagcdn.com/gb.svg" alt="EN" width="24" height="18" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'en' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.es && (
            <a href={alternateUrls.es} aria-label="Español" class="flex items-center justify-center">
              <img src="https://flagcdn.com/es.svg" alt="ES" width="24" height="18" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'es' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.fr && (
            <a href={alternateUrls.fr} aria-label="Français" class="flex items-center justify-center">
              <img src="https://flagcdn.com/fr.svg" alt="FR" width="24" height="18" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'fr' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
        </div>
      </header>
    )}

    <main class="flex-grow w-full px-4 pb-4 pt-1">
      <slot />
    </main>

    <footer class="bg-[#0F172A] border-t border-slate-800 mt-auto py-8 pb-[100px] text-center font-sans relative z-10 hide-on-print">
      <div class="max-w-[500px] md:max-w-3xl mx-auto px-4 space-y-6">
        
        <div class="p-3 bg-slate-900/50 rounded-xl border border-slate-800 shadow-inner text-justify">
          <p class="text-[9px] text-slate-500 leading-relaxed italic">
            <strong>{currentDisclaimer}</strong>
          </p>
        </div>
        
        <nav class="flex flex-wrap justify-center gap-x-4 gap-y-3 text-[10px] md:text-xs text-slate-400 font-bold tracking-wide">
          <a href={`/${lang}/info`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.info}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/materiali`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.mat}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/riscaldare`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.ris}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/problemi`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.prob}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/errori`} class="text-red-400 hover:text-red-300 transition-colors">{currentLabels.err}</a>
        </nav>

        <nav class="flex flex-wrap justify-center gap-x-4 gap-y-3 text-[10px] md:text-xs text-slate-400 font-bold tracking-wide">
          <a href={`/${lang}/calorie`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.cal}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/pulizia`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.pul}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/consumi`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.cons}</a>
          <span class="hidden sm:inline text-slate-700">•</span>
          <a href={`/${lang}/surgelati`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.ice}</a>
        </nav>
        
        <nav class="flex justify-center gap-4 text-[10px] text-slate-500 font-medium tracking-wide pt-4 border-t border-slate-800/50 w-2/3 md:w-1/3 mx-auto">
          <a href="/privacy" class="hover:text-[#F59E0B] transition-colors">{currentLabels.privacy}</a>
          <span>•</span>
          <a href="/cookies" class="hover:text-[#F59E0B] transition-colors">{currentLabels.cookie}</a>
        </nav>
        
        <p class="text-[9px] text-slate-600 font-mono italic">
          © {new Date().getFullYear()} convertitorefriggitrice.it
        </p>
      </div>
    </footer>

    <Analytics />
  </body>
</html>