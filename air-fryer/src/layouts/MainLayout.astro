---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  recipeData?: any;
  alternateUrls?: { 
    it?: string; 
    en?: string; 
    es?: string; 
    fr?: string;
  };
}

const { 
  title = "Convertitore Friggitrice ad Aria: Tempi e Gradi Online", 
  lang = "it",
  description = "Il miglior convertitore friggitrice ad aria online. Trasforma tempi e temperature da forno a Air Fryer in un click. Oltre 220 ricette ottimizzate.",
  ogImage = "https://www.convertitorefriggitrice.it/og-image.jpg",
  recipeData,
  alternateUrls
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://www.convertitorefriggitrice.it").toString();

// FIX 1: Diamo sempre la priorità alla descrizione della ricetta, se esiste
const finalDescription = recipeData?.description || description;

// FIX 2: Generazione Dati Strutturati Intelligente
let schemaJson = null;
if (recipeData) {
  // Funzione per estrarre solo i numeri (es. "12-14" diventa 12, "2 ore" diventa 120)
  const getMinutes = (timeStr: any) => {
    if (!timeStr) return 0;
    const str = timeStr.toString().toLowerCase();
    const numMatch = str.match(/\d+/);
    if (!numMatch) return 0;
    let val = parseInt(numMatch[0]);
    if (str.includes('ore') || str.includes('ora') || str.includes('h')) {
      val = val * 60; // Converte le ore in minuti
    }
    return val;
  };

  const prepMin = getMinutes(recipeData.prep_time) || 10;
  const cookMin = getMinutes(recipeData.time) || 15;
  const totalMin = prepMin + cookMin;

  schemaJson = JSON.stringify({
    "@context": "https://schema.org/",
    "@type": "Recipe",
    "name": recipeData.title,
    "image": [`https://www.convertitorefriggitrice.it${recipeData.image || `/images/recipes/${recipeData.slug}.webp`}`],
    "description": finalDescription,
    "prepTime": `PT${prepMin}M`,
    "cookTime": `PT${cookMin}M`,
    "totalTime": `PT${totalMin}M`,
    "recipeYield": `${recipeData.portions || 2} servings`,
    "recipeCategory": "Main Course",
    "cookMethod": "Air Frying",
    // Inseriamo le keywords se esistono nel tuo JSON
"keywords": Array.isArray(recipeData.keywords) ? recipeData.keywords.join(", ") : (recipeData.keywords || "friggitrice ad aria, ricette"),    "recipeIngredient": recipeData.ingredients,
    // Arricchiamo gli step con Nomi e Immagini per far contento Google
    "recipeInstructions": recipeData.instructions ? recipeData.instructions.map((step: string, idx: number) => ({
      "@type": "HowToStep",
      "name": `Step ${idx + 1}`,
      "text": step,
      "url": `https://www.convertitorefriggitrice.it/recipes/${recipeData.slug}#step-${idx + 1}`,
      "image": `https://www.convertitorefriggitrice.it/images/recipes/${recipeData.slug}/step_${idx + 1}.jpg`
    })) : [],
    "author": { "@type": "Organization", "name": "Convertitore Friggitrice" }
  });
}

const disclaimers = {
  it: "Trasparenza: In qualità di Affiliato Amazon, questo sito riceve un guadagno dagli acquisti idonei. I risultati della conversione sono stime basate su parametri standard (-20°C / -20% tempo). Controlla sempre la cottura.",
  en: "Transparency: As an Amazon Associate, this site earns from qualifying purchases. Conversion results are estimates based on standard parameters (-40°F / -20% time). Always check your food.",
  es: "Transparencia: Como Afiliado de Amazon, este sitio recibe una comisión por compras elegibles. Los resultados son estimaciones basadas en parámetros estándar (-20°C / -20% tiempo). Comprueba siempre la cocción.",
  fr: "Transparence : En tant que Partenaire Amazon, ce site réalise un bénéfice sur les achats remplissant les conditions requises. Les résultats sont des estimations basées sur des paramètres standards (-20°C / -20% temps)."
};

const footerLabels = {
  it: { about: "Chi Siamo", privacy: "Privacy", cookie: "Cookie", prefix: "" },
  en: { about: "About Us", privacy: "Privacy", cookie: "Cookies", prefix: "/en" },
  es: { about: "Quiénes Somos", privacy: "Privacidad", cookie: "Cookies", prefix: "/es" },
  fr: { about: "À Propos", privacy: "Confidentialité", cookie: "Cookies", prefix: "/fr" }
};

const currentDisclaimer = disclaimers[lang as keyof typeof disclaimers] || disclaimers.it;
const currentLabels = footerLabels[lang as keyof typeof footerLabels] || footerLabels.it;
---

<!doctype html>
<html lang={lang} class="scroll-smooth bg-[#0B1120]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalURL} />
    
    <meta name="google-site-verification" content="Tx2vsoQT33RAsPE5ydGss9ylFckhKM1DCAI59kyDlW8" />
    <meta name="p:domain_verify" content="0513c10094fa04708fce47d2922e822b"/>

    {alternateUrls?.it && <link rel="alternate" hreflang="it" href={alternateUrls.it} />}
    {alternateUrls?.en && <link rel="alternate" hreflang="en-US" href={alternateUrls.en} />}
    {alternateUrls?.es && <link rel="alternate" hreflang="es" href={alternateUrls.es} />}
    {alternateUrls?.fr && <link rel="alternate" hreflang="fr" href={alternateUrls.fr} />}
    {alternateUrls?.it && <link rel="alternate" hreflang="x-default" href={alternateUrls.it} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImage} />

    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson} />
    )}
  </head>
  
  <body class="bg-[#0B1120] text-slate-300 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white">
    
    {alternateUrls && (
      <header class="w-full flex justify-center px-4 pt-3 pb-1 md:pt-4 md:pb-2">
        <div class="flex items-center gap-4 bg-slate-900/60 backdrop-blur-md border border-slate-700/50 rounded-full px-5 py-2 shadow-lg">
          {alternateUrls.it && (
            <a href={alternateUrls.it} title="Italiano" class="flex items-center justify-center">
              <img src="https://flagcdn.com/it.svg" alt="IT" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'it' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.en && (
            <a href={alternateUrls.en} title="English" class="flex items-center justify-center">
              <img src="https://flagcdn.com/gb.svg" alt="EN" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'en' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.es && (
            <a href={alternateUrls.es} title="Español" class="flex items-center justify-center">
              <img src="https://flagcdn.com/es.svg" alt="ES" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'es' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
          {alternateUrls.fr && (
            <a href={alternateUrls.fr} title="Français" class="flex items-center justify-center">
              <img src="https://flagcdn.com/fr.svg" alt="FR" class={`w-5 md:w-6 h-auto rounded-[2px] transition-all duration-300 ${lang === 'fr' ? 'scale-110 drop-shadow-[0_0_8px_rgba(255,255,255,0.4)]' : 'grayscale opacity-40 hover:grayscale-0 hover:opacity-100 hover:scale-110'}`} />
            </a>
          )}
        </div>
      </header>
    )}

    <main class="flex-grow w-full px-4 pb-4 pt-1">
      <slot />
    </main>

    <footer class="bg-[#0F172A] border-t border-slate-800 mt-auto py-8 pb-[100px] text-center font-sans relative z-10">
      <div class="max-w-[480px] mx-auto px-6 space-y-5">
        <div class="p-3 bg-slate-900/50 rounded-xl border border-slate-800 shadow-inner text-justify">
          <p class="text-[9px] text-slate-500 leading-relaxed italic">
            <strong>{currentDisclaimer}</strong>
          </p>
        </div>
        
        <nav class="flex justify-center gap-4 text-[10px] text-slate-400 font-medium tracking-wide">
          <a href={`${currentLabels.prefix}/info`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.about}</a>
          <span>•</span>
          <a href={`${currentLabels.prefix}/privacy`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.privacy}</a>
          <span>•</span>
          <a href={`${currentLabels.prefix}/cookies`} class="hover:text-[#F59E0B] transition-colors">{currentLabels.cookie}</a>
        </nav>
        
        <p class="text-[9px] text-slate-600 font-mono italic">
          © {new Date().getFullYear()} convertitorefriggitrice.it
        </p>
      </div>
    </footer>

    <Analytics />
  </body>
</html>