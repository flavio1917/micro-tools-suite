---
import "../styles/global.css";
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  recipeData?: any; 
}

const { 
  title = "Convertitore Friggitrice ad Aria: Tempi e Gradi Online", 
  lang = "it",
  description = "Il miglior convertitore friggitrice ad aria online. Trasforma tempi e temperature da forno a Air Fryer in un click. Oltre 220 ricette ottimizzate.",
  ogImage = "https://www.convertitorefriggitrice.it/og-image.jpg",
  recipeData
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="convertitore friggitrice ad aria, calcolo tempi friggitrice ad aria, conversione forno friggitrice aria, ricette air fryer" />
    <link rel="canonical" href="https://www.convertitorefriggitrice.it" />
    <meta name="google-site-verification" content="Tx2vsoQT33RAsPE5ydGss9ylFckhKM1DCAI59kyDlW8" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.convertitorefriggitrice.it" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Convertitore Friggitrice ad Aria",
        "url": "https://www.convertitorefriggitrice.it",
        "description": "Strumento online per convertire automaticamente tempi e temperature da forno a friggitrice ad aria.",
        "applicationCategory": "KitchenTool",
        "operatingSystem": "All",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR"
        }
      }
    </script>

    {recipeData && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org/",
        "@type": "Recipe",
        "name": recipeData.title,
        "image": [`https://www.convertitorefriggitrice.it${recipeData.image}`],
        "description": `Come cucinare ${recipeData.title} in friggitrice ad aria.`,
        "cookTime": `PT${recipeData.time}M`,
        "recipeIngredient": recipeData.ingredients,
        "prepTime": "PT5M",
        "author": {
          "@type": "Organization",
          "name": "Convertitore Friggitrice"
        }
      })} />
    )}
  </head>
  
  <body class="bg-[#0B1120] text-slate-300 min-h-screen flex flex-col font-sans antialiased selection:bg-blue-500 selection:text-white">
    <main class="flex-grow w-full px-4 py-8">
      <slot />
    </main>

    <footer class="bg-[#0F172A] border-t border-slate-800 mt-auto py-10 text-center font-sans">
      <div class="max-w-[480px] mx-auto px-6 space-y-6">
        <div class="p-4 bg-slate-900/50 rounded-xl border border-slate-800 shadow-inner text-justify">
          <p class="text-[10px] text-slate-500 leading-relaxed italic">
            <strong>Trasparenza:</strong> In qualità di Affiliato Amazon, questo sito riceve un guadagno dagli acquisti idonei. I risultati della conversione sono stime basate su parametri standard (-20°C / -20% tempo). Controlla sempre la cottura. Le immagini sono a scopo illustrativo (IA).
          </p>
        </div>
        
        <nav class="flex justify-center gap-4 text-[11px] text-slate-400 font-medium tracking-wide">
          <a href="/info" class="hover:text-[#F59E0B] transition-colors">Chi Siamo</a>
          <span>•</span>
          <a href="/privacy" class="hover:text-[#F59E0B] transition-colors">Privacy</a>
          <span>•</span>
          <a href="/cookies" class="hover:text-[#F59E0B] transition-colors">Cookie</a>
        </nav>
        
        <p class="text-[10px] text-slate-600 font-mono italic">
          © {new Date().getFullYear()} convertitorefriggitrice.it
        </p>
      </div>
    </footer>
    <Analytics />
  </body>
</html>