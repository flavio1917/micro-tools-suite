---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

export interface Props {
  title?: string;
  lang?: string;
  description?: string;
  ogImage?: string;
  recipeData?: any;
  alternateUrls?: {
    it?: string;
    en?: string;
    es?: string;
    fr?: string;
  };
}

const {
  title,
  lang = "it",
  description,
  ogImage = "https://www.crispissimo.com/og-image.jpg",
  recipeData,
  alternateUrls = {},
} = Astro.props;

const defaultTitles = {
  it: "Crispissimo | Ricette in Friggitrice ad Aria Facili e Croccanti",
  en: "Crispissimo | Easy & Crispy Air Fryer Recipes",
  es: "Crispissimo | Recetas en Freidora de Aire Fáciles y Crujientes",
  fr: "Crispissimo | Recettes à la Friteuse à Air Faciles et Croustillantes",
};

const defaultDescriptions = {
  it: "Scopri ricette facili, gustose e croccanti per la friggitrice ad aria, con consigli pratici, categorie e strumenti utili firmati Crispissimo.",
  en: "Discover easy, tasty, crispy air fryer recipes, practical tips, categories, and useful tools from Crispissimo.",
  es: "Descubre recetas fáciles, sabrosas y crujientes para freidora de aire, con consejos prácticos, categorías y herramientas útiles de Crispissimo.",
  fr: "Découvrez des recettes faciles, savoureuses et croustillantes pour friteuse à air, avec des conseils pratiques, des catégories et des outils utiles signés Crispissimo.",
};

const locales = {
  it: "it_IT",
  en: "en_US",
  es: "es_ES",
  fr: "fr_FR",
};

const routeMap = {
  it: { home: "/", categories: "/#ricettario-container", converter: "/convertitore" },
  en: { home: "/en/", categories: "/en/#ricettario-container", converter: "/en/converter" },
  es: { home: "/es/", categories: "/es/#ricettario-container", converter: "/es/convertidor" },
  fr: { home: "/fr/", categories: "/fr/#ricettario-container", converter: "/fr/convertisseur" },
};

const navLabels = {
  it: {
    brandTagline: "Ricette facili e super croccanti per la friggitrice ad aria.",
    recipes: "Ricette", categories: "Categorie", converter: "Convertitore", themeToggle: "Cambia tema", language: "Lingua",
    footerNote: "Crispissimo è il nuovo nome di Convertitore Friggitrice.",
    disclaimer: "Trasparenza: in qualità di Affiliato Amazon, questo sito può ricevere una commissione dagli acquisti idonei. I risultati del convertitore sono indicativi e vanno sempre verificati in cottura.",
    privacy: "Privacy", cookies: "Cookie",
  },
  en: {
    brandTagline: "Easy and crispy air fryer recipes for everyday cooking.",
    recipes: "Recipes", categories: "Categories", converter: "Converter", themeToggle: "Toggle theme", language: "Language",
    footerNote: "Crispissimo is the new name of Convertitore Friggitrice.",
    disclaimer: "Transparency: as an Amazon Associate, this site may earn from qualifying purchases. Converter results are estimates and should always be checked while cooking.",
    privacy: "Privacy", cookies: "Cookies",
  },
  es: {
    brandTagline: "Recetas fáciles y crujientes para freidora de aire cada día.",
    recipes: "Recetas", categories: "Categorías", converter: "Convertidor", themeToggle: "Cambiar tema", language: "Idioma",
    footerNote: "Crispissimo es el nuevo nombre de Convertitore Friggitrice.",
    disclaimer: "Transparencia: como Afiliado de Amazon, este sitio puede recibir una comisión por compras válidas. Los resultados del convertidor son estimaciones y deben comprobarse durante la cocción.",
    privacy: "Privacidad", cookies: "Cookies",
  },
  fr: {
    brandTagline: "Des recettes faciles et croustillantes pour la friteuse à air.",
    recipes: "Recettes", categories: "Catégories", converter: "Convertisseur", themeToggle: "Changer le thème", language: "Langue",
    footerNote: "Crispissimo est le nouveau nom de Convertitore Friggitrice.",
    disclaimer: "Transparence : en tant que Partenaire Amazon, ce site peut percevoir une commission sur les achats éligibles. Les résultats du convertisseur sont indicatifs et doivent toujours être vérifiés pendant la cuisson.",
    privacy: "Confidentialité", cookies: "Cookies",
  },
};

const currentLocale = locales[lang as keyof typeof locales] || locales.it;
const navRoutes = routeMap[lang as keyof typeof routeMap] || routeMap.it;
const currentLabels = navLabels[lang as keyof typeof navLabels] || navLabels.it;

const fallbackCanonical = new URL(Astro.url.pathname, Astro.site || "https://www.crispissimo.com").toString();
const canonicalURL = alternateUrls?.[lang as keyof typeof alternateUrls] || fallbackCanonical;

// --- INIZIO: EXTREME CTR HACKING (Ripristinato e adattato per Crispissimo) ---
const fallbackCanonical = new URL(Astro.url.pathname, Astro.site || "https://www.crispissimo.com").toString();
const canonicalURL = alternateUrls?.[lang as keyof typeof alternateUrls] || fallbackCanonical;

// --- FIX BANDIERINE: Fallback sicuro per Home e Convertitore ---
const finalAlternateUrls = Object.keys(alternateUrls).length > 0 ? alternateUrls : {
  it: "https://www.crispissimo.com/",
  en: "https://www.crispissimo.com/en/",
  es: "https://www.crispissimo.com/es/",
  fr: "https://www.crispissimo.com/fr/"
};

// --- INIZIO: EXTREME CTR HACKING ---
let finalTitle = title || defaultTitles[lang as keyof typeof defaultTitles] || defaultTitles.it;
let finalDescription = description || defaultDescriptions[lang as keyof typeof defaultDescriptions] || defaultDescriptions.it;

if (recipeData) {
  const seoPhrases = {
    it: { pro: "Proteine", fast: "Pronto in", light: "Solo", kcal: "Kcal", read: "Ricetta testata. Leggi la guida per la cottura perfetta." },
    en: { pro: "Protein", fast: "Ready in", light: "Only", kcal: "Kcal", read: "Tested recipe. Read the guide for perfect cooking." },
    es: { pro: "Proteínas", fast: "Listo en", light: "Solo", kcal: "Kcal", read: "Receta probada. Lee la guía para una cocción perfecta." },
    fr: { pro: "Protéines", fast: "Prêt en", light: "Seulement", kcal: "Kcal", read: "Recette testée. Lisez le guide pour une cuisson parfaite." }
  };
  const p = seoPhrases[lang as keyof typeof seoPhrases] || seoPhrases.it;

  const kw = Array.isArray(recipeData.keywords) ? recipeData.keywords.map((k:string) => k.toLowerCase()) : [];
  const isMeatOrFish = kw.some((k:string) => k.includes('carne') || k.includes('pollo') || k.includes('pesce') || k.includes('salmone') || k.includes('meat') || k.includes('fish'));
  const isVegOrSide = kw.some((k:string) => k.includes('veg') || k.includes('verdure') || k.includes('patate') || k.includes('contorno') || k.includes('side'));
  
  const timeStr = recipeData.time ? recipeData.time.toString() : "";
  const numMatch = timeStr.match(/\d+/);
  const cookTimeNum = numMatch ? parseInt(numMatch[0]) : 999;
  const isFast = cookTimeNum <= 15;

  const hasNutrition = recipeData.nutrition && recipeData.nutrition.kcal;
  const kcal = hasNutrition ? recipeData.nutrition.kcal : 0;
  const pro = hasNutrition ? recipeData.nutrition.proteins_g : 0;
  const isLowCal = kcal > 0 && kcal <= 350;

  if (isMeatOrFish && pro >= 15) {
    finalTitle = `${recipeData.title} (${pro}g ${p.pro}) | Crispissimo`;
  } else if (isVegOrSide && isLowCal) {
    finalTitle = `${recipeData.title} (${p.light} ${kcal} ${p.kcal}) | Crispissimo`;
  } else if (isFast && cookTimeNum > 0) {
    finalTitle = `${recipeData.title} (${p.fast} ${timeStr} min) | Crispissimo`;
  } else {
    finalTitle = `${recipeData.title} | Crispissimo`;
  }

  const baseDesc = recipeData.description || "";
  let statsString = "";
  if (hasNutrition && isFast) statsString = `✓ ${pro}g ${p.pro} · ✓ ${timeStr} min · ✓ ${kcal} ${p.kcal} — `;
  else if (hasNutrition) statsString = `✓ ${pro}g ${p.pro} · ✓ ${kcal} ${p.kcal} — `;
  else if (isFast) statsString = `✓ ${p.fast} ${timeStr} min — `;

  finalDescription = `${statsString}${baseDesc} ${p.read}`;
}
// --- FINE: EXTREME CTR HACKING ---

const ogType = recipeData ? "article" : "website";
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fff7ed" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://flagcdn.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800;900&family=Raleway:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <ClientRouter />

    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="Tx2vsoQT33RAsPE5ydGss9ylFckhKM1DCAI59kyDlW8" />
    <meta name="p:domain_verify" content="0513c10094fa04708fce47d2922e822b" />

    {Object.keys(finalAlternateUrls).length > 0 && (
      <>
        {finalAlternateUrls.it && <link rel="alternate" hreflang="it" href={finalAlternateUrls.it} />}
        {finalAlternateUrls.en && <link rel="alternate" hreflang="en" href={finalAlternateUrls.en} />}
        {finalAlternateUrls.es && <link rel="alternate" hreflang="es" href={finalAlternateUrls.es} />}
        {finalAlternateUrls.fr && <link rel="alternate" hreflang="fr" href={finalAlternateUrls.fr} />}
        {finalAlternateUrls.it && <link rel="alternate" hreflang="x-default" href={finalAlternateUrls.it} />}
      </>
    )}

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={currentLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={ogImage} />

    <style is:global>
      :root { color-scheme: light; }
      html.dark { color-scheme: dark; }
      body { font-family: "Raleway", system-ui, sans-serif; }
      h1, h2, h3, h4, h5, h6 { font-family: "Montserrat", system-ui, sans-serif; }
    </style>

    <script is:inline>
      (() => {
        const storageKey = "crispissimo-theme";
        const root = document.documentElement;
        let savedTheme = "light";
        try { savedTheme = localStorage.getItem(storageKey) || "light"; } catch {}
        if (savedTheme === "dark") {
          root.classList.add("dark");
          root.setAttribute("data-theme", "dark");
        } else {
          root.classList.remove("dark");
          root.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-orange-50 text-slate-800 antialiased selection:bg-orange-200 selection:text-slate-900 transition-colors duration-300 dark:bg-slate-950 dark:text-slate-200">
    <header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur dark:border-slate-800 dark:bg-slate-950/85">
      <div class="mx-auto max-w-7xl px-4">
        <div class="flex h-16 items-center justify-between gap-4">
          <a href={navRoutes.home} class="shrink-0 text-2xl font-black tracking-tight text-orange-600 transition-colors hover:text-orange-700 dark:text-orange-400 dark:hover:text-orange-300" style="font-family: 'Montserrat', system-ui, sans-serif;">
            Crispissimo
          </a>

          <nav class="hidden items-center gap-6 md:flex">
            <a href={navRoutes.home} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.recipes}</a>
            <a href={navRoutes.categories} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.categories}</a>
            <a href={navRoutes.converter} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.converter}</a>
          </nav>

          <div class="flex items-center gap-2 sm:gap-3">
            <div class="flex items-center gap-1.5 rounded-full border border-slate-200 bg-white/80 px-2 py-1 shadow-sm dark:border-slate-700 dark:bg-slate-900/80 sm:gap-2 sm:px-3 sm:py-1.5" aria-label={currentLabels.language}>
              {["it", "en", "es", "fr"].map((l) => {
                const url = finalAlternateUrls[l as keyof typeof finalAlternateUrls];
                if (!url) return null;
                return (
                  <a href={url} aria-label={l.toUpperCase()} class="flex items-center justify-center">
                    <img src={`https://flagcdn.com/${l === "en" ? "gb" : l}.svg`} alt={l.toUpperCase()} width="24" height="18" class={`h-auto w-5 rounded-[2px] transition-all duration-200 md:w-6 ${lang === l ? "scale-110 opacity-100 ring-2 ring-orange-400/70" : "opacity-50 grayscale hover:scale-110 hover:opacity-100 hover:grayscale-0"}`} />
                  </a>
                );
              })}
            </div>

            <button type="button" data-theme-toggle class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition-colors hover:border-orange-300 hover:text-orange-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-orange-400 dark:hover:text-orange-400" aria-label={currentLabels.themeToggle}>
              <span data-theme-icon aria-hidden="true">🌙</span>
              <span class="sr-only">{currentLabels.themeToggle}</span>
            </button>
          </div>
        </div>

        <nav class="flex items-center justify-center gap-6 pb-3 md:hidden">
          <a href={navRoutes.home} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.recipes}</a>
          <a href={navRoutes.categories} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.categories}</a>
          <a href={navRoutes.converter} class="text-sm font-semibold text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.converter}</a>
        </nav>
      </div>
    </header>

    <main class="flex-grow w-full px-4 py-6">
      <slot />
    </main>

    <footer class="mt-auto border-t border-slate-200 bg-white py-10 dark:border-slate-800 dark:bg-slate-950">
      <div class="mx-auto max-w-7xl px-4">
        <div class="grid gap-8 md:grid-cols-[1.3fr_auto] md:items-start">
          <div class="space-y-4">
            <a href={navRoutes.home} class="inline-block text-2xl font-black tracking-tight text-orange-600 dark:text-orange-400" style="font-family: 'Montserrat', system-ui, sans-serif;">Crispissimo</a>
            <p class="max-w-xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">{currentLabels.brandTagline}</p>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-500">{currentLabels.footerNote}</p>
          </div>

          <nav class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold">
            <a href={navRoutes.home} class="text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.recipes}</a>
            <a href={navRoutes.categories} class="text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.categories}</a>
            <a href={navRoutes.converter} class="text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.converter}</a>
            <a href="/privacy" class="text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.privacy}</a>
            <a href="/cookies" class="text-slate-700 transition-colors hover:text-orange-600 dark:text-slate-200 dark:hover:text-orange-400">{currentLabels.cookies}</a>
          </nav>
        </div>

        <div class="mt-8 border-t border-slate-200 pt-6 dark:border-slate-800">
          <p class="max-w-4xl text-xs leading-relaxed text-slate-500 dark:text-slate-500">{currentLabels.disclaimer}</p>
          <p class="mt-4 text-xs text-slate-400 dark:text-slate-600">© {currentYear} Crispissimo</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const storageKey = "crispissimo-theme";
        const applyTheme = (theme) => {
          const isDark = theme === "dark";
          const root = document.documentElement;
          root.classList.toggle("dark", isDark);
          root.setAttribute("data-theme", theme);
          const themeMeta = document.querySelector('meta[name="theme-color"]');
          if (themeMeta) themeMeta.setAttribute("content", isDark ? "#020617" : "#fff7ed");
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
            const icon = button.querySelector("[data-theme-icon]");
            if (icon) icon.textContent = isDark ? "☀️" : "🌙";
          });
        };
        const bindThemeToggle = () => {
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.onclick = () => {
              const nextTheme = document.documentElement.classList.contains("dark") ? "light" : "dark";
              try { localStorage.setItem(storageKey, nextTheme); } catch {}
              applyTheme(nextTheme);
            };
          });
          let savedTheme = "light";
          try { savedTheme = localStorage.getItem(storageKey) || "light"; } catch {}
          applyTheme(savedTheme);
        };
        document.addEventListener("DOMContentLoaded", bindThemeToggle);
        document.addEventListener("astro:page-load", bindThemeToggle);
      })();
    </script>
    <Analytics />
  </body>
</html>