---
import ProblemGuide from '../../../components/seo-tools/ProblemGuide.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr', slug: 'reset-friteuse-air' }, props: { id: 'reset', lang: 'fr' } },
    { params: { lang: 'fr', slug: 'fumee-odeur-friteuse-air' }, props: { id: 'smoke-smell', lang: 'fr' } },
    { params: { lang: 'fr', slug: 'friteuse-air-ne-sallume-pas' }, props: { id: 'wont-turn-on', lang: 'fr' } },
    { params: { lang: 'fr', slug: 'friteuse-air-ne-chauffe-pas' }, props: { id: 'not-heating', lang: 'fr' } },
    { params: { lang: 'fr', slug: 'friteuse-air-ventilateur-ne-marche-pas' }, props: { id: 'fan-not-working', lang: 'fr' } }
  ];
}

const { id, lang } = Astro.props;
---
<ProblemGuide id={id} lang={lang} />
