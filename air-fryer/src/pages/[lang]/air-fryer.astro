---
import MainLayout from '../../layouts/MainLayout.astro';
import AirFryer from '../../components/tools/AirFryer/AirFryer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}
const { lang } = Astro.params;
---

<MainLayout title="Air Fryer Converter" lang={lang as string}>
  <AirFryer lang={lang as string} />
</MainLayout>