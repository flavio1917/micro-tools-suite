      { id: "patate", name: "Frites (Fraîches)", absorb: 0.12, airOil: 10 },
      { id: "cotoletta", name: "Poulet Pané", absorb: 0.15, airOil: 5 },
      { id: "calamari", name: "Calamars", absorb: 0.11, airOil: 8 },
