const t = content[lang as keyof typeof content] || content.it;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.h1,
  "operatingSystem": "All",
  "applicationCategory": "HealthApplication",
  "description": t.desc,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};
---

<MainLayout title={t.title} lang={lang}>
  <section class="max-w-4xl mx-auto py-12 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-teal-400">{t.h1}</h1>
      <p class="text-slate-400 text-base md:text-xl max-w-2xl mx-auto leading-relaxed">{t.desc}</p>
    </header>

    <div class="bg-slate-800/60 border border-slate-700 rounded-3xl p-6 md:p-10 shadow-2xl mb-12 backdrop-blur-sm max-w-2xl mx-auto relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="space-y-6 relative z-10">
        <div>
          <label class="block text-sm font-bold text-slate-300 uppercase tracking-wider mb-2">{t.foodLabel}</label>
          <select id="food-select" class="w-full bg-slate-900 border border-slate-600 text-white rounded-xl px-4 py-3.5 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all shadow-inner font-medium text-lg appearance-none cursor-pointer">
            {t.foods.map((food) => (
              <option value={food.id} data-absorb={food.absorb} data-airoil={food.airOil}>{food.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-sm font-bold text-slate-300 uppercase tracking-wider mb-2">{t.weightLabel}</label>
          
          <div class="flex items-center justify-center bg-slate-900 border border-slate-600 rounded-xl overflow-hidden shadow-inner h-14">
            <button id="btn-minus-weight" class="w-16 h-full hover:bg-slate-800 text-white font-black text-2xl transition-colors select-none active:bg-slate-700">-</button>
            <div class="flex-1 flex items-center justify-center border-x border-slate-700/50 h-full">
              <input type="number" id="weight-input" value="250" class="w-16 bg-transparent text-right text-white font-mono font-bold text-3xl outline-none appearance-none p-0 m-0" style="-moz-appearance: textfield;" />
              <span class="text-slate-400 font-bold text-xl ml-1 mb-0.5 select-none">g</span>
            </div>
            <button id="btn-plus-weight" class="w-16 h-full hover:bg-slate-800 text-white font-black text-2xl transition-colors select-none active:bg-slate-700">+</button>
          </div>
        </div>

        <button id="calc-btn" class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 hover:from-emerald-400 hover:to-teal-400 text-slate-900 font-black text-lg py-4 rounded-xl shadow-[0_0_20px_rgba(16,185,129,0.3)] transition-all active:scale-95 uppercase tracking-wide mt-4">
          {t.btnCalc}
        </button>
      </div>

      <div id="results-dash" class="mt-8 pt-8 border-t border-slate-700 hidden opacity-0 transition-opacity duration-500">
        <div class="grid grid-cols-2 gap-4">
          <div class="bg-slate-900/80 border border-amber-500/30 rounded-2xl p-4 text-center shadow-inner">
            <span class="block text-[10px] md:text-xs uppercase font-bold text-amber-400 tracking-wider mb-1">{t.resFat}</span>
            <div class="flex items-baseline justify-center gap-1">
              <span id="res-fat" class="text-3xl md:text-4xl font-black font-mono text-white">0</span>
              <span class="text-amber-500 font-bold">g</span>
            </div>
          </div>
          <div class="bg-slate-900/80 border border-emerald-500/30 rounded-2xl p-4 text-center shadow-inner">
            <span class="block text-[10px] md:text-xs uppercase font-bold text-emerald-400 tracking-wider mb-1">{t.resKcal}</span>
            <div class="flex items-baseline justify-center gap-1">
              <span id="res-kcal" class="text-3xl md:text-4xl font-black font-mono text-white">0</span>
              <span class="text-emerald-500 font-bold">kcal</span>
            </div>
          </div>
        </div>
        
        <div class="mt-4 bg-blue-900/20 border border-blue-500/20 rounded-xl p-4 flex items-center justify-center gap-3">
          <span class="text-2xl animate-bounce">🏃‍♂️</span>
          <p class="text-blue-200 text-sm md:text-base font-medium">
            {t.resRun} <strong id="res-run" class="text-white text-lg font-black mx-1">0</strong> <span class="text-blue-300">{t.resRunUnit}</span>
          </p>
        </div>
      </div>
    </div>

    <Disclaimer type="nutrizionale" lang={lang} />

    <div class="mt-12 text-center pt-8 border-t border-slate-800">
      <a href={homeUrl} class="inline-flex items-center justify-center px-6 py-3 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

  </section>

  <style>
    input[type="number"]::-webkit-inner-spin-button,
    input[type="number"]::-webkit-outer-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Logica Pulsanti Peso
      const btnMinus = document.getElementById('btn-minus-weight');
      const btnPlus = document.getElementById('btn-plus-weight');
      const wInput = document.getElementById('weight-input');

      btnMinus.addEventListener('click', () => {
        let val = parseInt(wInput.value) || 0;
        if (val > 50) wInput.value = val - 50;
      });

      btnPlus.addEventListener('click', () => {
        let val = parseInt(wInput.value) || 0;
        if (val < 2000) wInput.value = val + 50;
      });

      // Logica Calcolatore
      const btn = document.getElementById('calc-btn');
      const select = document.getElementById('food-select');
      const dash = document.getElementById('results-dash');
      const elFat = document.getElementById('res-fat');
      const elKcal = document.getElementById('res-kcal');
      const elRun = document.getElementById('res-run');

      let animRefs = { fat: null, kcal: null, run: null };

      function animateValue(obj, start, end, duration, animKey) {
        if (animRefs[animKey]) cancelAnimationFrame(animRefs[animKey]);
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          obj.innerHTML = Math.floor(progress * (end - start) + start);
          if (progress < 1) animRefs[animKey] = window.requestAnimationFrame(step);
        };
        animRefs[animKey] = window.requestAnimationFrame(step);
      }

      btn.addEventListener('click', () => {
        const option = select.options[select.selectedIndex];
        const absorbRate = parseFloat(option.getAttribute('data-absorb'));
        // DATO FONDAMENTALE: calcoliamo l'olio ad aria proporzionalmente (valore base calcolato su 250g)
        const baseAirOil = parseFloat(option.getAttribute('data-airoil'));
        const weight = parseFloat(wInput.value);

        if (isNaN(weight) || weight <= 0) return;

        const airFryOilGram = (weight / 250) * baseAirOil;

        const deepFryFat = weight * absorbRate;
        let savedFat = Math.max(0, deepFryFat - airFryOilGram);
        const savedKcal = savedFat * 9;
        const runMinutes = savedKcal / 10;

        dash.classList.remove('hidden');
        requestAnimationFrame(() => dash.classList.remove('opacity-0'));

        animateValue(elFat, 0, Math.round(savedFat), 1000, 'fat');
        animateValue(elKcal, 0, Math.round(savedKcal), 1000, 'kcal');
        animateValue(elRun, 0, Math.round(runMinutes), 1000, 'run');
      });
    });
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
</MainLayout>