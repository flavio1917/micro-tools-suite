---
import MainLayout from '../../layouts/MainLayout.astro'; 

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const lang = Astro.params.lang || 'it';

// Dizionario Multilingua Completo
const content = {
  it: {
    pageTitle: "Chi Siamo e Contatti | Convertitore Friggitrice ad Aria",
    h1: "Informazioni sul Progetto",
    backBtn: "Vai alle ricette",
    p1: "<strong>Convertitore Friggitrice</strong> nasce dall'esigenza di rendere la cucina con la friggitrice ad aria semplice, veloce e accessibile a tutti.",
    p2: "Oltre al convertitore, mettiamo a disposizione un ricettario curato con oltre <strong>180 ricette</strong> testate.",
    authorTitle: "L'Autore & Creatore",
    authorText: "Ciao, sono Flavio Refrigeri. Nella vita sono un Ingegnere Informatico, ma la mia vera passione è la cucina fatta come si deve. Ho preso la precisione che uso nel mio lavoro e l'ho portata in cucina, creando un algoritmo che calcola come il calore si muove dentro una friggitrice ad aria.",
    techTitle: "Tecnologia e Immagini",
    techText: "Per offrirti la migliore esperienza visiva, utilizziamo l'intelligenza artificiale per generare rappresentazioni realistiche dei piatti.<br><br><strong>Nota bene:</strong> Mentre le immagini sono generate, tutte le istruzioni e temperature sono frutto di test reali.",
    transparencyTitle: "Trasparenza e Sostenibilità",
    transparencyText: "Per mantenere il sito gratuito e senza pubblicità invasiva, partecipiamo al programma di affiliazione Amazon. Selezioniamo solo accessori che riteniamo realmente utili.",
    contactTitle: "Contatti",
    contactText: "Hai suggerimenti o vuoi collaborare? Puoi scriverci a:"
  },
  en: {
    pageTitle: "About Us & Contact | Air Fryer Converter",
    h1: "About the Project",
    backBtn: "Go to Recipes",
    p1: "<strong>Air Fryer Converter</strong> was born from the need to make air frying simple, fast, and accessible.",
    p2: "Besides the converter, we offer a curated cookbook with over <strong>180 tested recipes</strong>.",
    authorTitle: "The Author & Creator",
    authorText: "Hi, I'm Flavio Refrigeri. By day, I'm a Software Engineer, but my true passion is proper cooking.",
    techTitle: "Technology and Images",
    techText: "We use AI to generate realistic representations of the dishes.<br><br><strong>Please note:</strong> While images are AI-generated, instructions are from real culinary tests.",
    transparencyTitle: "Transparency",
    transparencyText: "To keep the site free, we participate in the Amazon affiliate program.",
    contactTitle: "Contact Us",
    contactText: "Have suggestions or want to collaborate? Write to us at:"
  },
  es: {
    pageTitle: "Quiénes Somos y Contacto | Convertidor Freidora",
    h1: "Sobre el Proyecto",
    backBtn: "Ir a las recetas",
    p1: "<strong>Convertidor Freidora</strong> nace de la necesidad de hacer que cocinar con freidora de aire sea simple.",
    p2: "Ofrecemos un recetario con más de <strong>180 recetas probadas</strong>.",
    authorTitle: "El Autor y Creador",
    authorText: "Hola, soy Flavio Refrigeri. Soy Ingeniero Informático, pero mi verdadera pasión es la buena cocina.",
    techTitle: "Tecnología e Imágenes",
    techText: "Utilizamos inteligencia artificial para generar representaciones realistas.<br><br><strong>Nota:</strong> Aunque las imágenes son generadas, las instrucciones son reales.",
    transparencyTitle: "Transparencia",
    transparencyText: "Para mantener el sitio gratuito, participamos en el programa de afiliados de Amazon.",
    contactTitle: "Contacto",
    contactText: "¿Tienes sugerencias? Escríbenos a:"
  },
  fr: {
    pageTitle: "À Propos et Contact | Convertisseur Friteuse",
    h1: "À Propos du Projet",
    backBtn: "Voir les recettes",
    p1: "<strong>Convertisseur Friteuse</strong> est né du besoin de rendre la cuisine simple et rapide.",
    p2: "Nous proposons un livre de recettes de plus de <strong>180 recettes testées</strong>.",
    authorTitle: "L'Auteur & Créateur",
    authorText: "Bonjour, je suis Flavio Refrigeri. Dans la vie, je suis Ingénieur Informatique, mais ma véritable passion est la cuisine.",
    techTitle: "Technologie et Images",
    techText: "Nous utilisons l'IA pour générer des images réalistes.<br><br><strong>À noter :</strong> Bien que les images soient générées, les instructions sont réelles.",
    transparencyTitle: "Transparence",
    transparencyText: "Pour garder le site gratuit, nous participons au programme d'affiliation Amazon.",
    contactTitle: "Contactez-nous",
    contactText: "Vous avez des suggestions ? Écrivez-nous à :"
  }
};

const t = content[lang as keyof typeof content] || content.it;

// Generazione URL corretta e link al ricettario
const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;
const pageUrl = lang === 'it' ? 'https://www.convertitorefriggitrice.it/info' : `https://www.convertitorefriggitrice.it/${lang}/info`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Flavio Refrigeri",
    "jobTitle": "Ingegnere Informatico & Creatore di Ricette",
    "url": pageUrl,
    "knowsAbout": ["Cottura in Friggitrice ad Aria", "Sviluppo Ricette", "Ottimizzazione Tempi di Cottura", "Tecnologia in Cucina"]
  }
};
---

<MainLayout title={t.pageTitle} lang={lang}>
  <section class="max-w-3xl mx-auto py-12 md:py-20 px-4 text-slate-300">
    
    <div class="mb-10">
      <a href={homeUrl} class="inline-flex items-center gap-2 px-6 py-3 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl text-white font-bold transition-all shadow-lg group">
        <svg class="w-5 h-5 text-orange-400 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l-7-7m7 7V3"></path></svg>
        {t.backBtn}
      </a>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-8">{t.h1}</h1>
    
    <div class="space-y-8 text-base md:text-lg leading-relaxed">
      
      <div class="space-y-4">
        <p set:html={t.p1}></p>
        <p set:html={t.p2}></p>
      </div>

      <div class="bg-slate-800/40 border border-blue-500/30 p-6 md:p-8 rounded-2xl flex flex-col md:flex-row gap-6 md:gap-8 items-center md:items-start shadow-lg">
        <div class="w-24 h-24 flex-shrink-0 rounded-full overflow-hidden border-2 border-slate-600 bg-slate-900 flex items-center justify-center">
          <span class="text-5xl">👨‍🍳</span> 
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-white mb-3">{t.authorTitle}</h2>
          <p class="text-sm md:text-base leading-relaxed text-slate-300">{t.authorText}</p>
        </div>
      </div>

      <div class="bg-slate-800/30 border border-slate-700 p-6 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-3">{t.techTitle}</h2>
        <p class="text-sm leading-relaxed" set:html={t.techText}></p>
      </div>

      <div class="bg-slate-800/50 border border-slate-700 p-6 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">{t.transparencyTitle}</h2>
        <p class="text-sm leading-relaxed">{t.transparencyText}</p>
      </div>

      <div class="mt-8 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-white mb-4">{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <a href="mailto:postmaster@convertitorefriggitrice.it" class="text-blue-400 font-bold text-xl hover:underline block mt-3">
          postmaster@convertitorefriggitrice.it
        </a>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</MainLayout>