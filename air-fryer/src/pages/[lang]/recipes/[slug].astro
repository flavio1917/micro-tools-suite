---
import MainLayout from '../../../layouts/MainLayout.astro';
import AmazonProduct from '../../../components/ads/AmazonProduct.astro';

import recipesIt from '../../../data/recipes-it.json';
import recipesEn from '../../../data/recipes-en.json';
import recipesEs from '../../../data/recipes-es.json';
import recipesFr from '../../../data/recipes-fr.json';

export async function getStaticPaths() {
  const datasets = {
    it: recipesIt,
    en: recipesEn,
    es: recipesEs,
    fr: recipesFr
  };

  const paths = [];
  for (const [lang, recipes] of Object.entries(datasets)) {
    recipes.forEach((recipe) => {
      paths.push({
        params: { lang, slug: recipe.slug },
        props: { recipe, lang },
      });
    });
  }
  return paths;
}

const { recipe, lang } = Astro.props;

const translations = {
  it: {
    back: "Torna al Ricettario", backLink: "/#ricettario",
    temp: "Temperatura", time: "Cottura", prep: "Preparazione",
    portions: "Porzioni", pers: "pers.",
    ingTitle: "Ingredienti", noIng: "Vedi descrizione per i dettagli.",
    stepTitle: "Procedimento",
    step1: "Preparazione", step1Desc: "Prepara tutti gli ingredienti sul piano di lavoro. Se necessario, ungi leggermente il cibo con un filo d'olio spray.",
    step2: "Cottura", step2Desc: `Imposta la friggitrice a <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuoci per <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} minuti</strong>.`,
    tipTitle: "Il Segreto dello Chef",
    searchOther: "← Cerca un'altra ricetta",
    authBadge: "Ricetta Autentica", seoAuth: " | Ricetta Originale",
    unitTemp: "°C", unitTime: "min"
  },
  en: {
    back: "Back to Recipes", backLink: "/en/#ricettario",
    temp: "Temperature", time: "Cook Time", prep: "Prep Time",
    portions: "Servings", pers: "pers.",
    ingTitle: "Ingredients", noIng: "See description for details.",
    stepTitle: "Instructions",
    step1: "Preparation", step1Desc: "Prepare all ingredients on the counter. Lightly coat the food with cooking spray.",
    step2: "Cooking", step2Desc: `Set air fryer to <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°F</strong>. Cook for <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} minutes</strong>.`,
    tipTitle: "Chef's Tip",
    searchOther: "← Search another recipe",
    authBadge: "Authentic Italian", seoAuth: " | Authentic Italian Recipe",
    unitTemp: "°F", unitTime: "min"
  },
  es: {
    back: "Volver al Recetario", backLink: "/es/#ricettario",
    temp: "Temperatura", time: "Cocción", prep: "Preparación",
    portions: "Porciones", pers: "pers.",
    ingTitle: "Ingredientes", noIng: "Ver descripción para más detalles.",
    stepTitle: "Instrucciones",
    step1: "Preparación", step1Desc: "Prepara todos los ingredientes. Rocía ligeramente la comida con aceite en spray.",
    step2: "Cocción", step2Desc: `Ajusta la freidora a <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cocina por <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} minutos</strong>.`,
    tipTitle: "Consejo del Chef",
    searchOther: "← Buscar otra receta",
    authBadge: "Receta Auténtica", seoAuth: " | Auténtica Receta Italiana",
    unitTemp: "°C", unitTime: "min"
  },
  fr: {
    back: "Retour aux Recettes", backLink: "/fr/#ricettario",
    temp: "Température", time: "Cuisson", prep: "Préparation",
    portions: "Portions", pers: "pers.",
    ingTitle: "Ingrédients", noIng: "Voir la description pour les détails.",
    stepTitle: "Instructions",
    step1: "Préparation", step1Desc: "Préparez tous les ingrédients. Vaporisez légèrement les aliments d'huile.",
    step2: "Cuisson", step2Desc: `Réglez la friteuse sur <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuisez pendant <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} minutes</strong>.`,
    tipTitle: "Astuce du Chef",
    searchOther: "← Chercher une autre recette",
    authBadge: "Recette Authentique", seoAuth: " | Recette Italienne Authentique",
    unitTemp: "°C", unitTime: "min"
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;

const baseImageName = recipe.image || recipe.slug;
const imagePath = `/images/recipes/${baseImageName}.webp`;
const defaultPortions = parseInt(recipe.portions) || 2;

// PULIZIA DEL TEMPO: Rimuove "minutes", "min", "mins" dal numero per evitare sdoppiamenti
const cleanTime = recipe.time ? recipe.time.toString().replace(/\s*(minutes|mins|min)\s*/gi, '') : "--";

const isAuth = recipe.isItalian === true;
const pageTitle = `${recipe.title}${isAuth ? t.seoAuth : ''} - Air Fryer`;
const seoRecipeData = { ...recipe, image: imagePath, isItalian: isAuth };

const affiliateLinks = [
  { regex: /(carta forno\b(?: forata)?)/gi, link: "https://www.amazon.it/dp/B0D3VCV459?tag=convfriggit-21" },
  { regex: /(olio(?: in)? spray|nebulizzatore)/gi, link: "https://www.amazon.it/dp/B0F2DJV6SZ?tag=convfriggit-21" },
  { regex: /(teglia(?: in)? silicone|stampo(?: in)? silicone)/gi, link: "https://www.amazon.it/dp/B0D9CSGYYP?tag=convfriggit-21" },
  { regex: /(termometro\b(?: per carne)?)/gi, link: "https://www.amazon.it/dp/B07CB8JG21?tag=convfriggit-21" }
];

function enrichText(text: string, currentLang: string) {
  if (currentLang !== 'it' || !text) return text;
  let enriched = text;
  affiliateLinks.forEach(item => {
    enriched = enriched.replace(item.regex, `<a href="${item.link}" target="_blank" rel="nofollow noopener" class="text-orange-400 font-bold hover:underline decoration-orange-500 underline-offset-4 transition-colors">$1</a>`);
  });
  return enriched;
}
---

<MainLayout title={pageTitle} lang={lang} recipeData={seoRecipeData}>
  
  <div class="relative h-[40vh] min-h-[320px] md:h-[50vh] md:min-h-[400px] w-full overflow-hidden bg-slate-900">
    <img src={imagePath} alt={recipe.title} class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-1000 hover:scale-105" onerror="this.style.opacity='0'" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
    
    <div class="relative max-w-4xl mx-auto px-4 h-full flex flex-col justify-end pb-12 md:pb-16 items-center text-center z-10">
      
      <div class="w-full flex justify-between items-center mb-4 md:mb-6">
        <a href={t.backLink} class="inline-flex items-center gap-2 px-6 py-3 md:px-4 md:py-2 rounded-full bg-slate-800/80 hover:bg-slate-700/90 backdrop-blur-md text-white transition-all border border-slate-500/50 text-sm font-bold md:font-medium shadow-xl group">
          <svg class="w-5 h-5 md:w-4 md:h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          {t.back}
        </a>

        {/* SELETTORE UNITÀ DI MISURA (VISIBILE SOLO IN INGLESE) */}
        {lang === 'en' && (
          <div class="bg-slate-800/80 backdrop-blur-md p-1 rounded-full border border-slate-600 shadow-xl flex items-center">
            <button id="btn-imperial" class="px-3 py-1 text-xs font-bold rounded-full transition-colors bg-blue-600 text-white">Imperial</button>
            <button id="btn-metric" class="px-3 py-1 text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white">Metric</button>
          </div>
        )}
      </div>

      {isAuth && (
        <div class="mb-4 inline-flex items-center gap-2.5 px-4 py-1.5 bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-600 border border-yellow-200/80 text-black text-[10px] md:text-xs font-black uppercase tracking-widest rounded-full shadow-[0_0_20px_rgba(245,158,11,0.5)] transform transition-transform hover:scale-105 backdrop-blur-sm">
          <img src="https://flagcdn.com/it.svg" alt="Italia" class="w-5 h-auto rounded-sm shadow-md border border-black/10" />
          <span class="drop-shadow-sm">{t.authBadge}</span>
        </div>
      )}

      <h1 class="text-3xl md:text-6xl font-extrabold text-white mb-3 md:mb-4 leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
        {recipe.title}
      </h1>
      <p class="text-base md:text-xl text-slate-200 max-w-2xl font-medium drop-shadow-md border-t border-white/20 pt-3 md:pt-4 mt-1 md:mt-2">
        {recipe.description}
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 -mt-8 relative z-20 pb-10">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.temp}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-orange-400 mt-1 flex justify-center items-end gap-1">
            <span id="display-temp-val">{recipe.temp}</span>
            <span id="display-temp-unit" class="text-xl md:text-2xl pb-1">{t.unitTemp}</span>
        </div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.time}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-blue-400 mt-1">
            {cleanTime} <span class="text-lg md:text-xl">{t.unitTime}</span>
        </div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.prep}</span>
        <div class="text-xl md:text-2xl font-bold text-green-400 mt-2">{recipe.prep_time || '--'}</div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center items-center relative group">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-2">{t.portions}</span>
        <div class="flex items-center justify-center gap-3 mt-1">
          <button id="btn-minus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg">-</button>
          <div class="text-2xl md:text-3xl font-bold text-purple-400 w-8 text-center" id="portions-display">{defaultPortions}</div>
          <button id="btn-plus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg">+</button>
        </div>
        <span class="text-[10px] text-slate-500 mt-1">{t.pers}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-1">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sticky top-8 shadow-lg">
          <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3 border-b border-slate-800 pb-4">
            <span class="text-2xl">🛒</span> {t.ingTitle}
          </h3>
          <ul class="space-y-4">
            {recipe.ingredients && recipe.ingredients.length > 0 ? (
              recipe.ingredients.map((ing) => (
                <li class="flex items-start gap-3 text-slate-300 group">
                  <input type="checkbox" class="mt-1.5 w-5 h-5 flex-shrink-0 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 cursor-pointer accent-blue-500">
                  <span class="leading-relaxed group-hover:text-white transition-colors ingredient-text" data-original={ing}>{ing}</span>
                </li>
              ))
            ) : (
              <li class="text-slate-500 italic text-sm">{t.noIng}</li>
            )}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <AmazonProduct recipe={recipe} lang={lang} />

        <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-6 md:p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <span class="text-3xl">👨‍🍳</span> {t.stepTitle}
          </h3>
          
          <div class="space-y-8 relative before:absolute before:inset-0 before:ml-3.5 before:-z-10 before:h-full before:w-0.5 before:bg-slate-700">
            {recipe.instructions && Array.isArray(recipe.instructions) ? (
              recipe.instructions.map((step, index) => (
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">{index + 1}</div>
                  <div class="pt-1 pb-2">
                    <p class="text-slate-300 leading-relaxed text-lg instruction-text" set:html={enrichText(step, lang)}></p>
                  </div>
                </div>
              ))
            ) : (
              <>
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">1</div>
                  <div class="pt-1">
                    <h4 class="text-lg font-bold text-white mb-2">{t.step1}</h4>
                    <p class="text-slate-400 leading-relaxed" set:html={enrichText(t.step1Desc, lang)}></p>
                  </div>
                </div>
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">2</div>
                  <div class="pt-1">
                    <h4 class="text-lg font-bold text-white mb-2">{t.step2}</h4>
                    <p class="text-slate-400 leading-relaxed" set:html={t.step2Desc}></p>
                  </div>
                </div>
              </>
            )}

            {recipe.tip && (
              <div class="flex gap-6 relative">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center font-bold text-black shadow-lg shadow-amber-500/20 ring-4 ring-slate-900 z-10">💡</div>
                <div class="pt-1 w-full">
                  <h4 class="text-amber-400 font-bold mb-2">{t.tipTitle}</h4>
                  <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4">
                    <p class="text-amber-100 italic leading-relaxed">"{recipe.tip}"</p>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="text-center pt-8 border-t border-slate-800">
          <a href={t.backLink} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all font-medium">
            {t.searchOther}
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ basePortions: defaultPortions, baseTemp: recipe.temp, lang: lang }}>
    document.addEventListener('DOMContentLoaded', () => {
      // LOGICA PORZIONI
      let currentPortions = basePortions;
      const display = document.getElementById('portions-display');
      const btnMinus = document.getElementById('btn-minus');
      const btnPlus = document.getElementById('btn-plus');
      const ingredients = document.querySelectorAll('.ingredient-text');

      // STATO UNITÀ (solo EN)
      let isMetric = false; 
      const btnImperial = document.getElementById('btn-imperial');
      const btnMetric = document.getElementById('btn-metric');
      
      const tempValDisplay = document.getElementById('display-temp-val');
      const tempUnitDisplay = document.getElementById('display-temp-unit');
      const instTempVals = document.querySelectorAll('.recipe-temp-val');
      const instTempUnits = document.querySelectorAll('.recipe-temp-unit');

      if (!display || !btnMinus || !btnPlus) return;

      // FUNZIONI DI CONVERSIONE MATEMATICA
      function fToC(f) { return Math.round((f - 32) * 5/9); }
      function ozToG(oz) { return Math.round(oz * 28.3495); }
      function flOzToMl(floz) { return Math.round(floz * 29.5735); }
      function lbsToKg(lbs) { return (lbs * 0.453592).toFixed(2); }

      // REGEX PER TROVARE E SOSTITUIRE MISURE
      const regexOz = /([\d.,]+)\s*oz\b/gi;
      const regexFlOz = /([\d.,]+)\s*fl oz\b/gi;
      const regexLbs = /([\d.,]+)\s*lbs?\b/gi;

      function scaleAndConvertIngredient(originalStr, ratio, forceMetric) {
        let currentStr = originalStr;

        // 1. Applica conversione Metrica se richiesta
        if (forceMetric) {
            currentStr = currentStr.replace(regexFlOz, (match, p1) => `${flOzToMl(parseFloat(p1))} ml`);
            currentStr = currentStr.replace(regexOz, (match, p1) => `${ozToG(parseFloat(p1))} g`);
            currentStr = currentStr.replace(regexLbs, (match, p1) => `${lbsToKg(parseFloat(p1))} kg`);
        }

        // 2. Scala le porzioni
        const match = currentStr.trim().match(/^([\d.,]+(?:\/\d+)?)\s+(.*)/);
        if (!match) return currentStr; 

        let numStr = match[1].replace(',', '.');
        let num = 0;
        
        if (numStr.includes('/')) {
          const parts = numStr.split('/');
          num = parseFloat(parts[0]) / parseFloat(parts[1]);
        } else {
          num = parseFloat(numStr);
        }

        if (isNaN(num)) return currentStr;

        let newNum = num * ratio;
        newNum = Number.isInteger(newNum) ? newNum : parseFloat(newNum.toFixed(2));

        return newNum + " " + match[2];
      }

      function updateUI() {
        display.textContent = currentPortions;
        const ratio = currentPortions / basePortions;

        ingredients.forEach(el => {
          const originalText = el.getAttribute('data-original');
          el.textContent = scaleAndConvertIngredient(originalText, ratio, isMetric);
        });

        // Aggiorna Temperature se siamo in inglese
        if (lang === 'en' && tempValDisplay && baseTemp) {
            const currentTemp = isMetric ? fToC(baseTemp) : baseTemp;
            const currentUnit = isMetric ? "°C" : "°F";
            
            tempValDisplay.textContent = currentTemp;
            tempUnitDisplay.textContent = currentUnit;

            instTempVals.forEach(el => el.textContent = currentTemp);
            instTempUnits.forEach(el => el.textContent = currentUnit);
        }
      }

      btnMinus.addEventListener('click', () => {
        if (currentPortions > 1) { 
          currentPortions--;
          updateUI();
        }
      });

      btnPlus.addEventListener('click', () => {
        if (currentPortions < 20) { 
          currentPortions++;
          updateUI();
        }
      });

      // GESTIONE BOTTONI IMPERIAL/METRIC
      if (btnImperial && btnMetric) {
          btnImperial.addEventListener('click', () => {
              isMetric = false;
              btnImperial.classList.replace('text-slate-400', 'text-white');
              btnImperial.classList.replace('bg-transparent', 'bg-blue-600');
              
              btnMetric.classList.replace('text-white', 'text-slate-400');
              btnMetric.classList.replace('bg-blue-600', 'bg-transparent');
              updateUI();
          });

          btnMetric.addEventListener('click', () => {
              isMetric = true;
              btnMetric.classList.replace('text-slate-400', 'text-white');
              btnMetric.classList.replace('bg-transparent', 'bg-blue-600');
              
              btnImperial.classList.replace('text-white', 'text-slate-400');
              btnImperial.classList.replace('bg-blue-600', 'bg-transparent');
              updateUI();
          });
      }
    });
  </script>
</MainLayout>