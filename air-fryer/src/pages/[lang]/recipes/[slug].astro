---
import MainLayout from '../../../layouts/MainLayout.astro';
import AmazonProduct from '../../../components/ads/AmazonProduct.astro';
import StarRating from '../../../components/StarRating.astro';

import recipesIt from '../../../data/recipes-it.json';
import recipesEn from '../../../data/recipes-en.json';
import recipesEs from '../../../data/recipes-es.json';
import recipesFr from '../../../data/recipes-fr.json';

export async function getStaticPaths() {
  const datasets = { it: recipesIt, en: recipesEn, es: recipesEs, fr: recipesFr };
  const paths = [];
  for (const [lang, recipes] of Object.entries(datasets)) {
    recipes.forEach((recipe) => {
      if (recipe && recipe.slug) {
        paths.push({ params: { lang, slug: recipe.slug }, props: { recipe, lang } });
      }
    });
  }
  return paths;
}

const { recipe, lang } = Astro.props;

const translations = {
  it: {
    back: "Indietro", backLink: "/#ricettario", temp: "Temperatura", time: "Cottura", prep: "Preparazione",
    portions: "Porzioni", pers: "pers.", ingTitle: "Ingredienti", noIng: "Vedi descrizione per i dettagli.",
    stepTitle: "Procedimento", step1: "Preparazione", step1Desc: "Prepara tutti gli ingredienti sul piano di lavoro.",
    step2: "Cottura", step2Desc: `Imposta a <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuoci per <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,
    tipTitle: "Il Segreto dello Chef", searchOther: "← Cerca un'altra ricetta", authBadge: "Autentica", seoAuth: " | Ricetta Originale",
    unitTemp: "°C", unitTime: "min", bannerTop: "MIGLIORA LA FRIGGITRICE", bannerBot: "Scopri il Kit Accessori.", bannerBtn: "Offerte"
  },
  en: {
    back: "Back", backLink: "/en/#ricettario", temp: "Temperature", time: "Cook Time", prep: "Prep Time",
    portions: "Servings", pers: "pers.", ingTitle: "Ingredients", noIng: "See description for details.",
    stepTitle: "Instructions", step1: "Preparation", step1Desc: "Prepare all ingredients on the counter.",
    step2: "Cooking", step2Desc: `Set to <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°F</strong>. Cook for <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,
    tipTitle: "Chef's Tip", searchOther: "← Search another recipe", authBadge: "Authentic", seoAuth: " | Authentic Recipe",
    unitTemp: "°F", unitTime: "min", bannerTop: "UPGRADE AIR FRYER", bannerBot: "Discover the ultimate Kit.", bannerBtn: "Deals"
  },
  es: {
    back: "Volver", backLink: "/es/#ricettario", temp: "Temperatura", time: "Cocción", prep: "Preparación",
    portions: "Porciones", pers: "pers.", ingTitle: "Ingredientes", noIng: "Ver descripción.",
    stepTitle: "Instrucciones", step1: "Preparación", step1Desc: "Prepara todos los ingredientes.",
    step2: "Cocción", step2Desc: `Ajusta a <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cocina por <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,
    tipTitle: "Consejo del Chef", searchOther: "← Buscar otra receta", authBadge: "Auténtica", seoAuth: " | Auténtica",
    unitTemp: "°C", unitTime: "min", bannerTop: "MEJORA TU FREIDORA", bannerBot: "Descubre el Kit definitivo.", bannerBtn: "Ofertas"
  },
  fr: {
    back: "Retour", backLink: "/fr/#ricettario", temp: "Température", time: "Cuisson", prep: "Préparation",
    portions: "Portions", pers: "pers.", ingTitle: "Ingrédients", noIng: "Voir la description.",
    stepTitle: "Instructions", step1: "Préparation", step1Desc: "Préparez tous les ingrédients.",
    step2: "Cuisson", step2Desc: `Réglez sur <strong class="text-white bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-white bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuisez pendant <strong class="text-white bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,
    tipTitle: "Astuce du Chef", searchOther: "← Chercher autre", authBadge: "Authentique", seoAuth: " | Authentique",
    unitTemp: "°C", unitTime: "min", bannerTop: "AMÉLIOREZ LA FRITEUSE", bannerBot: "Découvrez le Kit ultime.", bannerBtn: "Offres"
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;

const baseImageName = recipe.image || recipe.slug;
const imagePath = `/images/recipes/${baseImageName}.webp`;
const defaultPortions = parseInt(recipe.portions) || 2;

const sharedStepImages = recipe.instructions.map((_, index) => `/images/recipes/${baseImageName}/step_${index + 1}.jpg`);

const cleanTime = recipe.time ? recipe.time.toString().replace(/\s*(minutes|mins|min)\s*/gi, '') : "--";
const isAuth = recipe.isItalian === true;
const pageTitle = `${recipe.title}${isAuth ? t.seoAuth : ''} - Air Fryer`;

const seoRecipeData = { ...recipe, image: imagePath, isItalian: isAuth };

const getLocalizedUrl = (targetLang: string) => {
  const datasets: Record<string, any[]> = { it: recipesIt, en: recipesEn, es: recipesEs, fr: recipesFr };
  const targetRecipe = datasets[targetLang].find(r => (r.image || r.slug) === baseImageName);
  return targetRecipe ? `/${targetLang}/recipes/${targetRecipe.slug}` : `/${targetLang}/#ricettario`;
};

const affiliateLinks = [
  { regex: /(carta(?:\s+da)?\s+forno(?:(?:\s+in)?\s+fogli)?(?:\s+forata)?|parchment paper|papel de horno|papel pergamino|papier cuisson|papier sulfurisé)/gi, link: "https://www.amazon.it/dp/B0D3VCV459?tag=convfriggit-21" },
  { regex: /(olio(?:\s+(?:extravergine|extra vergine)\s+d'oliva|\s+evo)?\s+spray|nebulizzare(?:\s+(?:con\s+)?olio)?|nebulizzatore(?:\s+d'olio)?|oil spray|cooking spray|aceite en spray|pulverizador(?: de aceite)?|huile en spray|vaporisateur(?: d'huile)?)/gi, link: "https://www.amazon.it/dp/B0F2DJV6SZ?tag=convfriggit-21" },
  { regex: /(teglia(?:\s+in)?\s+silicone|cestello(?:\s+in)?\s+silicone|stampo(?:\s+in)?\s+silicone|silicone(?: liner| mold| pan| basket)|molde de silicona|moule en silicone)/gi, link: "https://www.amazon.it/dp/B0D9CSGYYP?tag=convfriggit-21" },
  { regex: /(termometro\b(?:\s+per\s+carne|\s+alimentare)?|meat thermometer|termómetro(?: de carne)?|thermomètre(?: à viande)?)/gi, link: "https://www.amazon.it/dp/B07CB8JG21?tag=convfriggit-21" },
  { regex: /(pinze(?:\s+da\s+cucina|\s+in\s+silicone)?|kitchen tongs|pinzas(?: de cocina)?|pinces(?: de cuisine)?)/gi, link: "https://www.amazon.it/dp/B08P1QDFN6?tag=convfriggit-21" }
];

function enrichText(text: string) {
  if (!text) return text;
  let enriched = text;
  affiliateLinks.forEach(item => {
    enriched = enriched.replace(item.regex, `<a href="${item.link}" target="_blank" rel="nofollow noopener" title="Vedi su Amazon" class="text-orange-400 font-bold hover:text-orange-300 hover:underline decoration-orange-500/50 underline-offset-4 transition-colors">$1</a>`);
  });
  return enriched;
}
---

<MainLayout title={pageTitle} lang={lang} recipeData={seoRecipeData}>
  
  <div class="relative h-[40vh] min-h-[320px] md:h-[45vh] w-full overflow-hidden bg-slate-900">
    <img src={imagePath} alt={recipe.title} class="absolute inset-0 h-full w-full object-cover opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-slate-950/40"></div>
    
    <div class="absolute top-4 md:top-6 left-0 right-0 z-50 px-3 md:px-4 w-full">
      <div class="max-w-5xl mx-auto flex justify-between items-center relative h-10 md:h-11">
        
        <a href={t.backLink} class="flex items-center justify-center h-full w-10 md:w-auto md:px-4 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10">
          <svg class="w-4 h-4 md:mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span class="hidden md:inline font-bold text-xs">{t.back}</span>
        </a>

        <div class="absolute left-1/2 -translate-x-1/2 h-full z-20">
          <StarRating slug={baseImageName} title={recipe.title} />
        </div>

        <div class="flex items-center justify-center h-full px-2.5 md:px-3 bg-slate-800/90 backdrop-blur-md rounded-full border border-slate-600/50 shadow-xl z-10 gap-1.5 md:gap-2">
            {['it', 'en', 'es', 'fr'].map((l) => (
              <a href={getLocalizedUrl(l)} class={`transition-all flex items-center justify-center ${lang === l ? 'scale-110 opacity-100 ring-1 ring-blue-500 rounded-[2px]' : 'opacity-40 hover:opacity-100'}`}>
                <img src={`https://flagcdn.com/${l === 'en' ? 'gb' : l}.svg`} alt={l.toUpperCase()} class="w-4 h-[11px] md:w-[18px] md:h-[13px] rounded-[1px] object-cover" />
              </a>
            ))}
        </div>

      </div>
    </div>
    
    <div class="relative max-w-4xl mx-auto px-4 h-full flex flex-col justify-end pb-8 md:pb-12 z-10 text-center">
      <h1 class="text-xl md:text-3xl lg:text-4xl font-extrabold text-white mb-2 leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] px-2">
        {recipe.title}
      </h1>
      <p class="text-xs md:text-base text-slate-300 max-w-2xl mx-auto font-medium drop-shadow-md border-t border-white/20 pt-2 md:pt-3 mt-1 px-3 leading-relaxed">
        {recipe.description}
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 -mt-8 relative z-20 pb-28">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.temp}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-orange-400 mt-1 flex justify-center items-end gap-1">
            <span id="display-temp-val">{recipe.temp}</span>
            <span id="display-temp-unit" class="text-xl md:text-2xl pb-1">{t.unitTemp}</span>
        </div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.time}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-blue-400 mt-1">
            {cleanTime} <span class="text-lg md:text-xl">{t.unitTime}</span>
        </div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.prep}</span>
        <div class="text-xl md:text-2xl font-bold text-green-400 mt-2">{recipe.prep_time || '--'}</div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center items-center relative group">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-2">{t.portions}</span>
        <div class="flex items-center justify-center gap-3 mt-1">
          <button id="btn-minus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg">-</button>
          <div class="text-2xl md:text-3xl font-bold text-purple-400 w-8 text-center" id="portions-display">{defaultPortions}</div>
          <button id="btn-plus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg">+</button>
        </div>
        <span class="text-[10px] text-slate-500 mt-1">{t.pers}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-1">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sticky top-8 shadow-lg">
          <h3 class="text-xl font-bold text-white mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 pb-4">
            <div class="flex items-center gap-3"><span class="text-2xl">🛒</span> {t.ingTitle}</div>
            {lang === 'en' && (
              <div class="bg-slate-800/80 p-1 rounded-full border border-slate-600 flex items-center shrink-0 shadow-inner">
                <button id="btn-imperial" class="px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors bg-blue-600 text-white shadow-sm">Imperial</button>
                <button id="btn-metric" class="px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white">Metric</button>
              </div>
            )}
          </h3>
          <ul class="space-y-4">
            {recipe.ingredients && recipe.ingredients.length > 0 ? (
              recipe.ingredients.map((ing) => (
                <li class="flex items-start gap-3 text-slate-300 group">
                  <input type="checkbox" class="mt-1.5 w-5 h-5 flex-shrink-0 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 cursor-pointer accent-blue-500" />
                  <span class="leading-relaxed group-hover:text-white transition-colors ingredient-text" data-original={ing} set:html={enrichText(ing)}></span>
                </li>
              ))
            ) : (<li class="text-slate-500 italic text-sm">{t.noIng}</li>)}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        <AmazonProduct recipe={recipe} lang={lang} />
        <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-6 md:p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3"><span class="text-3xl">👨‍🍳</span> {t.stepTitle}</h3>
          <div class="space-y-8 relative before:absolute before:inset-0 before:ml-3.5 before:-z-10 before:h-full before:w-0.5 before:bg-slate-700">
            {recipe.instructions && Array.isArray(recipe.instructions) ? (
              recipe.instructions.map((step, index) => (
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">{index + 1}</div>
                  <div class="pt-1 pb-2 w-full">
                    <p class="text-slate-300 leading-relaxed text-lg instruction-text mb-4" set:html={enrichText(step)}></p>
                    {sharedStepImages && sharedStepImages[index] && sharedStepImages[index] !== "" && (
                      <div class="mb-4">
                        <img src={sharedStepImages[index]} alt={`Step ${index + 1}`} class="w-full md:max-w-md rounded-xl shadow-lg border border-slate-700 object-cover" loading="lazy" onerror="this.parentElement.style.display='none';" />
                      </div>
                    )}
                  </div>
                </div>
              ))
            ) : (
              <>
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg z-10">1</div>
                  <div class="pt-1"><h4 class="text-lg font-bold text-white mb-2">{t.step1}</h4><p class="text-slate-400" set:html={enrichText(t.step1Desc)}></p></div>
                </div>
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg z-10">2</div>
                  <div class="pt-1"><h4 class="text-lg font-bold text-white mb-2">{t.step2}</h4><p class="text-slate-400" set:html={t.step2Desc}></p></div>
                </div>
              </>
            )}
            {recipe.tip && (
              <div class="flex gap-6 relative">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center font-bold text-black shadow-lg shadow-amber-500/20 z-10">💡</div>
                <div class="pt-1 w-full"><h4 class="text-amber-400 font-bold mb-2">{t.tipTitle}</h4><div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4"><p class="text-amber-100 italic">"{recipe.tip}"</p></div></div>
              </div>
            )}
          </div>
        </div>

        <div class="text-center pt-8 border-t border-slate-800">
          <a href={t.backLink} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all font-medium">{t.searchOther}</a>
        </div>
      </div>
    </div>
  </div>
{/* BANNER AFFILIAZIONE (SOLO PER LINGUA ITALIANA) */}
{lang === 'it' && (
<div class="fixed bottom-0 left-0 right-0 z-[100] transition-transform duration-300">
  <div class="w-full bg-[#0B1120] border-t border-orange-500/30 shadow-[0_-15px_40px_rgba(0,0,0,0.6)]">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
      
      <div class="flex items-center gap-3 md:gap-4 flex-1 min-w-0">
         <div class="w-10 h-10 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 p-[1px] flex-shrink-0 shadow-[0_0_10px_rgba(245,158,11,0.5)] animate-pulse">
            <div class="w-full h-full bg-slate-900 rounded-full flex items-center justify-center text-lg">🎁</div>
         </div>
        <div class="flex-1 min-w-0">
          <span class="block text-[10px] uppercase tracking-widest font-extrabold text-orange-500 mb-0.5 drop-shadow-md truncate">{t.bannerTop}</span>
          <p class="text-sm md:text-base text-white leading-tight font-bold truncate">{t.bannerBot}</p>
        </div>
      </div>

      <a href="https://www.amazon.it/s?k=kit+accessori+friggitrice+ad+aria&tag=convertitoref-21" target="_blank" rel="nofollow noopener" class="flex-shrink-0 bg-orange-500 hover:bg-orange-400 text-black text-xs md:text-sm font-black py-2.5 px-5 rounded-full flex items-center gap-1.5 shadow-[0_0_15px_rgba(245,158,11,0.4)] transition-all hover:scale-105 active:scale-95">
        <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
        <span>{t.bannerBtn}</span>
      </a>
      
    </div>
  </div>
</div>
)}
  <script is:inline define:vars={{ basePortions: defaultPortions, baseTemp: recipe.temp, lang: lang }}>
    document.addEventListener('DOMContentLoaded', () => {
      let currentPortions = basePortions;
      const display = document.getElementById('portions-display');
      const btnMinus = document.getElementById('btn-minus');
      const btnPlus = document.getElementById('btn-plus');
      const ingredients = document.querySelectorAll('.ingredient-text');

      let isMetric = false; 
      const btnImperial = document.getElementById('btn-imperial');
      const btnMetric = document.getElementById('btn-metric');
      const tempValDisplay = document.getElementById('display-temp-val');
      const tempUnitDisplay = document.getElementById('display-temp-unit');

      if (!display || !btnMinus || !btnPlus) return;

      function fToC(f) { return Math.round(((f - 32) * 5/9) / 5) * 5; }
      function smartRound(val) { return val >= 100 ? Math.round(val / 10) * 10 : val >= 10 ? Math.round(val / 5) * 5 : Math.round(val); }
      function ozToG(oz) { return smartRound(oz * 28.3495); }
      function flOzToMl(floz) { return smartRound(floz * 29.5735); }
      function lbsToKg(lbs) { return (lbs * 0.453592).toFixed(2); }

      function scaleAndConvertIngredient(originalStr, ratio, forceMetric) {
        let str = originalStr;
        if (forceMetric) {
            str = str.replace(/([\d.,]+)\s*fl oz\b/gi, (m, p1) => `${flOzToMl(parseFloat(p1))} ml`);
            str = str.replace(/([\d.,]+)\s*oz\b/gi, (m, p1) => `${ozToG(parseFloat(p1))} g`);
            str = str.replace(/([\d.,]+)\s*lbs?\b/gi, (m, p1) => `${lbsToKg(parseFloat(p1))} kg`);
        }
        const match = str.trim().match(/^([\d.,]+(?:\/\d+)?)\s+(.*)/);
        if (!match) return str; 
        let numStr = match[1].replace(',', '.');
        let num = numStr.includes('/') ? parseFloat(numStr.split('/')[0]) / parseFloat(numStr.split('/')[1]) : parseFloat(numStr);
        if (isNaN(num)) return str;
        let newNum = num * ratio;
        newNum = Number.isInteger(newNum) ? newNum : parseFloat(newNum.toFixed(2));
        return newNum + " " + match[2];
      }

      function updateUI() {
        display.textContent = currentPortions;
        const ratio = currentPortions / basePortions;
        ingredients.forEach(el => {
          el.innerHTML = el.innerHTML.replace(el.innerText, scaleAndConvertIngredient(el.getAttribute('data-original'), ratio, isMetric));
        });
        if (lang === 'en' && tempValDisplay && baseTemp) {
            tempValDisplay.textContent = isMetric ? fToC(baseTemp) : baseTemp;
            tempUnitDisplay.textContent = isMetric ? "°C" : "°F";
            document.querySelectorAll('.recipe-temp-val').forEach(el => el.textContent = isMetric ? fToC(baseTemp) : baseTemp);
            document.querySelectorAll('.recipe-temp-unit').forEach(el => el.textContent = isMetric ? "°C" : "°F");
        }
      }

      btnMinus.addEventListener('click', () => { if (currentPortions > 1) { currentPortions--; updateUI(); }});
      btnPlus.addEventListener('click', () => { if (currentPortions < 20) { currentPortions++; updateUI(); }});

      if (btnImperial && btnMetric) {
          btnImperial.addEventListener('click', () => { isMetric = false; btnImperial.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors bg-blue-600 text-white shadow-sm"; btnMetric.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white"; updateUI(); });
          btnMetric.addEventListener('click', () => { isMetric = true; btnMetric.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors bg-blue-600 text-white shadow-sm"; btnImperial.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white"; updateUI(); });
      }
    });
  </script>
</MainLayout>