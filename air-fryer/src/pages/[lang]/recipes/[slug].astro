                  <div><label class="block text-[10px] text-slate-500 mb-1 transition-colors">{t.ecoWattOven}</label><input type="number" id="input-watt-oven" value="2200" step="100" class="w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono text-sm outline-none focus:border-emerald-500 transition-colors" /></div>
                  <div><label class="block text-[10px] text-slate-500 mb-1 transition-colors">{t.ecoWattAF}</label><input type="number" id="input-watt-af" value="1500" step="50" class="w-full bg-slate-950 border border-slate-700 rounded p-2 text-white font-mono text-sm outline-none focus:border-emerald-500 transition-colors" /></div>
              </div>
