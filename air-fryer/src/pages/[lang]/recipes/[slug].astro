      </div>

      <div class="text-center pt-8 border-t border-slate-800 hide-on-print transition-colors">
        <a href={t.backLink} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all font-medium focus:outline-none focus:ring-2 focus:ring-slate-500">{t.searchOther}</a>
      </div>
