---
import MainLayout from '../../../layouts/MainLayout.astro';
import AmazonProduct from '../../../components/ads/AmazonProduct.astro';
import StarRating from '../../../components/StarRating.astro';
import SchemaRecipe from '../../../components/SchemaRecipe.astro';

import recipesIt from '../../../data/recipes-it.json';
import recipesEn from '../../../data/recipes-en.json';
import recipesEs from '../../../data/recipes-es.json';
import recipesFr from '../../../data/recipes-fr.json';

export async function getStaticPaths() {
  const datasets = { it: recipesIt, en: recipesEn, es: recipesEs, fr: recipesFr };
  const paths = [];
  for (const [lang, recipes] of Object.entries(datasets)) {
    recipes.forEach((recipe) => {
      if (recipe && recipe.slug) {
        paths.push({ params: { lang, slug: recipe.slug }, props: { recipe, lang } });
      }
    });
  }
  return paths;
}

const { recipe, lang } = Astro.props;

const translations = {
  it: {
    back: "Indietro", backLink: "/#ricettario", temp: "Temperatura", time: "Cottura", prep: "Preparazione",
    portions: "Porzioni", pers: "pers.", ingTitle: "Ingredienti", noIng: "Vedi descrizione per i dettagli.",
    stepTitle: "Procedimento", step1: "Preparazione", step1Desc: "Prepara tutti gli ingredienti sul piano di lavoro.",
    step2: "Cottura", step2Desc: `Imposta a <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuoci per <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,    tipTitle: "Il Segreto dello Chef", searchOther: "← Cerca un'altra ricetta", authBadge: "Autentica", seoAuth: " | Ricetta Originale",
    unitTemp: "°C", unitTime: "min",
    nutriTitle: "Valori Nutrizionali", nutriSub: "Valori medi per 1 porzione", nutriVnr: "% VNR*",
    lblKcal: "Kcal", lblPro: "Pro", lblCarbs: "Carbo", lblFat: "Grassi",
    ecoTitle: "Risparmio Energetico", ecoDesc: "Scopri quanto risparmi cucinando ad aria invece che al forno.",
    ecoOven: "Forno Tradizionale", ecoAF: "Friggitrice ad Aria", ecoSave: "Risparmio Netto", ecoCustomize: "⚙️ Personalizza Consumi",
    ecoKwh: "Costo Energia (€/kWh)", ecoWattOven: "Watt Forno", ecoWattAF: "Watt Friggitrice",
    eeatTested: "Ricetta Testata", eeatReview: "Metodo Validato",
    startTimer: "⏱️ Avvia Timer", stopTimer: "⏹️ Ferma Timer",
    months: ["Gen", "Feb", "Mar", "Apr", "Mag", "Giu", "Lug", "Ago", "Set", "Ott", "Nov", "Dic"],
    verifiedText: "Ultima verifica:",
    print: "Stampa", jump: "Vai alla Ricetta", readMode: "Modalità Lettura", darkMode: "Modalità Scura", share: "Condividi",
    faqTitle: "Domande Frequenti",
    faq1Q: `Come conservare ${recipe.title}?`, faq1A: "Lascia raffreddare completamente, poi conserva in un contenitore ermetico in frigorifero per 2-3 giorni. Non congelare dopo la cottura per non perdere la croccantezza.",
    faq2Q: `Posso cuocere da surgelato?`, faq2A: "Sì, se usi ingredienti base surgelati, aggiungi circa il 20-30% di tempo in più rispetto alla ricetta standard e controlla la cottura a metà, separando eventuali pezzi attaccati.",
    faq3Q: `Come riscaldare gli avanzi?`, faq3A: "Usa la friggitrice ad aria a 160°C per 3-5 minuti. Evita il microonde, che renderebbe il cibo molliccio, mentre l'aria calda restituirà la texture originale."
  },
  en: {
    back: "Back", backLink: "/en/#ricettario", temp: "Temperature", time: "Cook Time", prep: "Prep Time",
    portions: "Servings", pers: "pers.", ingTitle: "Ingredients", noIng: "See description for details.",
    stepTitle: "Instructions", step1: "Preparation", step1Desc: "Prepare all ingredients on the counter.",
    step2: "Cooking", step2Desc: `Set to <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 pr-1 rounded recipe-temp-unit">°F</strong>. Cook for <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,    tipTitle: "Chef's Tip", searchOther: "← Search another recipe", authBadge: "Authentic", seoAuth: " | Authentic Recipe",
    unitTemp: "°F", unitTime: "min",
    nutriTitle: "Nutrition Facts", nutriSub: "Amount per 1 serving", nutriVnr: "% DV*",
    lblKcal: "Kcal", lblPro: "Pro", lblCarbs: "Carbs", lblFat: "Fat",
    ecoTitle: "Energy Savings", ecoDesc: "See how much you save by cooking with air instead of an oven.",
    ecoOven: "Traditional Oven", ecoAF: "Air Fryer", ecoSave: "Net Savings", ecoCustomize: "⚙️ Customize Parameters",
    ecoKwh: "Energy Cost ($/kWh)", ecoWattOven: "Oven Wattage", ecoWattAF: "Air Fryer Wattage",
    eeatTested: "Lab Tested", eeatReview: "Verified Method",
    startTimer: "⏱️ Start Timer", stopTimer: "⏹️ Stop Timer",
    months: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
    verifiedText: "Last check:",
    print: "Print", jump: "Jump to Recipe", readMode: "Reading Mode", darkMode: "Dark Mode", share: "Share",
    faqTitle: "Frequently Asked Questions",
    faq1Q: `How to store ${recipe.title}?`, faq1A: "Let it cool completely, then store in an airtight container in the fridge for 2-3 days.",
    faq2Q: `Can I cook this from frozen?`, faq2A: "Yes, add about 20-30% more time compared to the standard recipe and check halfway through.",
    faq3Q: `How to reheat leftovers?`, faq3A: "Use the air fryer at 320°F (160°C) for 3-5 minutes to restore crispiness. Avoid the microwave."
  },
  es: {
    back: "Volver", backLink: "/es/#ricettario", temp: "Temperatura", time: "Cocción", prep: "Preparación",
    portions: "Porciones", pers: "pers.", ingTitle: "Ingredientes", noIng: "Ver descripción.",
    stepTitle: "Instrucciones", step1: "Preparación", step1Desc: "Prepara todos los ingredientes.",
    step2: "Cocción", step2Desc: `Ajusta a <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cocina por <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,    tipTitle: "Consejo del Chef", searchOther: "← Buscar otra receta", authBadge: "Auténtica", seoAuth: " | Auténtica",
    unitTemp: "°C", unitTime: "min",
    nutriTitle: "Info Nutricional", nutriSub: "Por 1 porción", nutriVnr: "% VD*",
    lblKcal: "Kcal", lblPro: "Pro", lblCarbs: "Carbo", lblFat: "Grasas",
    ecoTitle: "Ahorro de Energía", ecoDesc: "Descubre cuánto ahorras cocinando con aire en lugar de horno.",
    ecoOven: "Horno Tradicional", ecoAF: "Freidora de Aire", ecoSave: "Ahorro Neto", ecoCustomize: "⚙️ Personalizar",
    ecoKwh: "Costo Energía (€/kWh)", ecoWattOven: "Vatios Horno", ecoWattAF: "Vatios Freidora",
    eeatTested: "Receta Probada", eeatReview: "Método Validado",
    startTimer: "⏱️ Iniciar Timer", stopTimer: "⏹️ Parar Timer",
    months: ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"],
    verifiedText: "Última verificación:",
    print: "Imprimir", jump: "Ir a la Receta", readMode: "Modo Lectura", darkMode: "Modo Oscuro", share: "Compartir",
    faqTitle: "Preguntas Frecuentes",
    faq1Q: `¿Cómo conservar ${recipe.title}?`, faq1A: "Deja enfriar por completo, luego guarda en un recipiente hermético en el refrigerador por 2-3 días.",
    faq2Q: `¿Se puede cocinar congelado?`, faq2A: "Sí, añade aproximadamente un 20% più di tempo rispetto alla ricetta standard e controlla la cottura a metà.",
    faq3Q: `¿Cómo recalentar las sobras?`, faq3A: "Usa la freidora de aire a 160°C durante 3-5 minutos para devolver la textura crujiente."
  },
  fr: {
    back: "Retour", backLink: "/fr/#ricettario", temp: "Température", time: "Cuisson", prep: "Préparation",
    portions: "Portions", pers: "pers.", ingTitle: "Ingrédients", noIng: "Voir la description.",
    stepTitle: "Instructions", step1: "Préparation", step1Desc: "Préparez tous les ingrédients.",
    step2: "Cuisson", step2Desc: `Réglez sur <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded recipe-temp-val">${recipe.temp}</strong><strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 pr-1 rounded recipe-temp-unit">°C</strong>. Cuisez pendant <strong class="text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-700 px-1 rounded">${recipe.time} min</strong>.`,    tipTitle: "Astuce du Chef", searchOther: "← Chercher autre", authBadge: "Authentique", seoAuth: " | Authentique",
    unitTemp: "°C", unitTime: "min",
    nutriTitle: "Valeurs Nutritives", nutriSub: "Pour 1 portion", nutriVnr: "% VQ*",
    lblKcal: "Kcal", lblPro: "Pro", lblCarbs: "Glucides", lblFat: "Lipides",
    ecoTitle: "Économie d'Énergie", ecoDesc: "Découvrez combien vous économisez en cuisinant à l'air.",
    ecoOven: "Four Traditionnel", ecoAF: "Friteuse à Air", ecoSave: "Économie Nette", ecoCustomize: "⚙️ Personnaliser",
    ecoKwh: "Coût Énergie (€/kWh)", ecoWattOven: "Watts Four", ecoWattAF: "Watts Friteuse",
    eeatTested: "Recette Testée", eeatReview: "Méthode Validée",
    startTimer: "⏱️ Démarrer Timer", stopTimer: "⏹️ Arrêter Timer",
    months: ["Jan", "Fév", "Mar", "Avr", "Mai", "Juin", "Juil", "Aoû", "Sep", "Oct", "Nov", "Déc"],
    verifiedText: "Dernière vérif. :",
    print: "Imprimer", jump: "Aller à la Recette", readMode: "Mode Lecture", darkMode: "Mode Sombre", share: "Partager",
    faqTitle: "Foire Aux Questions",
    faq1Q: `Comment conserver ${recipe.title}?`, faq1A: "Laissez refroidir complètement, puis conservez dans une boîte hermétique au réfrigérateur pendant 2-3 jours.",
    faq2Q: `Peut-on le cuire congelé ?`, faq2A: "Oui, ajoutez environ 20% di tempo in più rispetto alla ricetta standard e controlla la cottura a metà.",
    faq3Q: `How to reheat leftovers?`, faq3A: "Utilisez la friteuse à air à 160°C pendant 3-5 minutes per ridare croccantezza."
  }
};

const t = translations[lang as keyof typeof translations] || translations.it;

const baseImageName = recipe.image || recipe.slug;
const imagePath = `/images/recipes/${baseImageName}.webp`;
const defaultPortions = parseInt(recipe.portions) || 2;

const sharedStepImages = recipe.instructions.map((_, index) => `/images/recipes/${baseImageName}/step_${index + 1}.jpg`);
const cleanTime = recipe.time ? recipe.time.toString().replace(/\s*(minutes|mins|min)\s*/gi, '') : "--";

// FIX PREP TIME ASSENTE
const rawPrep = recipe.prep_time ? recipe.prep_time.toString().toLowerCase() : "";
const isPrepMissing = !rawPrep || rawPrep.includes("non") || rawPrep === "0" || rawPrep === "--";
const displayPrepTime = isPrepMissing ? "--" : recipe.prep_time;

const isAuth = recipe.isItalian === true;
const pageTitle = `${recipe.title}${isAuth ? t.seoAuth : ''} - Air Fryer`;

const seoRecipeData = { ...recipe, image: imagePath, isItalian: isAuth };

const getLocalizedUrl = (targetLang: string) => {
  const datasets: Record<string, any[]> = { it: recipesIt, en: recipesEn, es: recipesEs, fr: recipesFr };
  const targetRecipe = datasets[targetLang].find(r => (r.image || r.slug) === baseImageName);
  
  if (targetRecipe) {
    // Manteniamo "recipes" invece di "ricette" finché non applicheremo la Fase 2 della Roadmap
    return targetLang === "it" 
      ? `/it/recipes/${targetRecipe.slug}` 
      : `/${targetLang}/recipes/${targetRecipe.slug}`;
  }
  
  // Fallback alla Home Page corretta
  return targetLang === "it" ? "/" : `/${targetLang}/`;
};

function enrichText(text: string) { return text; }

let baseNutrition = recipe.nutrition || null;

if (!baseNutrition && lang !== 'it') {
  const fallbackRecipe = recipesIt.find((r: any) => (r.image || r.slug) === baseImageName);
  if (fallbackRecipe && fallbackRecipe.nutrition) {
    baseNutrition = fallbackRecipe.nutrition;
  }
}

const hasNutrition = !!baseNutrition;
const VNR = { kcal: 2000, proteins: 50, carbs: 260, sugars: 50, fats: 70, saturated_fats: 20, salt: 6 };

const d = new Date();
const currentMonthStr = t.months[d.getMonth()];
const currentYear = d.getFullYear();
const freshnessString = `${t.verifiedText} ${currentMonthStr} ${currentYear}`;

const alternateUrls = {
  it: `https://www.convertitorefriggitrice.it${getLocalizedUrl('it')}`,
  en: `https://www.convertitorefriggitrice.it${getLocalizedUrl('en')}`,
  es: `https://www.convertitorefriggitrice.it${getLocalizedUrl('es')}`,
  fr: `https://www.convertitorefriggitrice.it${getLocalizedUrl('fr')}`
};
---

<MainLayout title={pageTitle} lang={lang} recipeData={seoRecipeData} alternateUrls={alternateUrls}>
  
  <style is:global>
    body > header { display: none !important; }
  </style>

  <SchemaRecipe recipe={recipe} lang={lang} />

  <div class="relative h-[45vh] min-h-[380px] md:h-[50vh] w-full overflow-hidden bg-slate-900 hero-bg-print-hide">
    <img src={imagePath} alt={recipe.title} class="absolute inset-0 h-full w-full object-cover opacity-80" />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-slate-950/40 pointer-events-none"></div>
    
    <div class="absolute top-4 md:top-6 left-0 right-0 z-[60] px-3 md:px-4 w-full">
      <div class="max-w-5xl mx-auto flex justify-between items-center relative h-10 md:h-11">
        
        <a href={t.backLink} aria-label={t.back} class="flex items-center justify-center h-full w-10 md:w-auto md:px-4 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
          <svg class="w-4 h-4 md:mr-1.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          <span class="hidden md:inline font-bold text-xs">{t.back}</span>
        </a>

        <div class="flex items-center justify-center h-full px-2.5 md:px-3 bg-slate-800/90 backdrop-blur-md rounded-full border border-slate-600/50 shadow-xl gap-1.5 md:gap-2">
            {['it', 'en', 'es', 'fr'].map((l) => (
              <a href={getLocalizedUrl(l)} aria-label={l.toUpperCase()} class={`transition-all flex items-center justify-center cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500 rounded-[2px] ${lang === l ? 'scale-110 opacity-100 ring-1 ring-blue-500' : 'opacity-40 hover:opacity-100'}`}>
                <img src={`https://flagcdn.com/${l === 'en' ? 'gb' : l}.svg`} alt={l.toUpperCase()} width="24" height="18" class="w-4 h-[11px] md:w-[18px] md:h-[13px] rounded-[1px] object-cover" />
              </a>
            ))}
        </div>
      </div>
    </div>
    
    <div class="relative max-w-5xl mx-auto px-4 h-full flex flex-col justify-end pb-10 md:pb-14 z-20 text-center pointer-events-none">
      <div class="hidden md:flex justify-center mb-3 opacity-90">
         <span class="px-3 py-1 bg-slate-900/60 backdrop-blur-md border border-slate-500/30 rounded-full text-[10px] text-slate-300 font-bold uppercase tracking-widest flex items-center gap-1.5 shadow-lg"><span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span> {freshnessString}</span>
      </div>

      <h1 class="text-2xl md:text-4xl lg:text-5xl font-extrabold text-white mb-2 leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)] px-2">
        {recipe.title}
      </h1>
      
      <p class="text-sm md:text-lg text-slate-300 max-w-4xl mx-auto font-medium drop-shadow-md border-t border-white/20 pt-2 md:pt-3 mt-1 px-3 leading-relaxed mb-4">
        {recipe.description}
      </p>
      
      <div class="flex justify-center items-center relative z-[9999] pointer-events-auto cursor-pointer hover:scale-105 transition-transform mb-3">
         <StarRating slug={baseImageName} title={recipe.title} />
      </div>
    </div>
  </div>

  <div id="recipe-content-wrapper" class="max-w-5xl mx-auto px-4 -mt-8 print:mt-0 print:pt-4 relative z-30 pb-28 reading-transition rounded-t-3xl pt-2">
    
    <div class="hidden print:block print:mb-8 text-center print-section">
       <h1 class="text-3xl font-black text-black mb-3">{recipe.title}</h1>
       <p class="text-sm text-gray-800 max-w-3xl mx-auto">{recipe.description}</p>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-2.5 md:gap-4 mb-8 relative z-30 hide-on-print">
      <button id="btn-jump" aria-label={t.jump} class="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-full text-[10px] md:text-xs font-bold text-white transition-all shadow-lg active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
        ⬇️ <span class="hidden sm:inline">{t.jump}</span>
      </button>
      <button id="btn-print" aria-label={t.print} class="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-full text-[10px] md:text-xs font-bold text-white transition-all shadow-lg active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
        🖨️ <span class="hidden sm:inline">{t.print}</span>
      </button>
      <button id="btn-read-mode" aria-label={t.readMode} class="flex items-center gap-1.5 px-3.5 py-2 bg-slate-800 hover:bg-slate-700 border border-slate-600 rounded-full text-[10px] md:text-xs font-bold text-white transition-all shadow-lg active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500">
        ☀️ <span id="text-read-mode" class="hidden sm:inline">{t.readMode}</span>
      </button>
      <button id="btn-share" aria-label={t.share} class="flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-500 border border-blue-500 rounded-full text-[10px] md:text-xs font-bold text-white transition-all shadow-lg shadow-blue-500/20 active:scale-95 cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-400">
        🔗 {t.share}
      </button>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8 hide-on-print">
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl flex flex-col justify-center transition-colors">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.temp}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-orange-400 mt-1 flex justify-center items-end gap-1">
            <span id="display-temp-val">{recipe.temp}</span><span id="display-temp-unit" class="text-xl md:text-2xl pb-1">{t.unitTemp}</span>
        </div>
      </div>
      
      {/* BOX COTTURA CON FIX WRAPPING MOBILE */}
      <div class="bg-slate-900/95 backdrop-blur-md border border-blue-500/30 rounded-xl p-4 md:p-6 text-center shadow-[0_0_15px_rgba(59,130,246,0.15)] flex flex-col justify-center relative overflow-hidden transition-colors">
        <div id="timer-progress" class="absolute bottom-0 left-0 h-1.5 bg-blue-500 w-0 transition-all duration-1000 ease-linear shadow-[0_0_15px_rgba(59,130,246,1)]"></div>
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.time}</span>
        <div class="flex items-center justify-center gap-1.5 mt-1 mb-3">
            <span id="timer-display" class="text-2xl sm:text-3xl md:text-4xl font-mono font-black text-blue-400 whitespace-nowrap leading-none">{cleanTime}</span>
            <span id="timer-unit" class="text-base md:text-xl font-sans font-bold text-blue-500 lowercase">{t.unitTime}</span>
        </div>
        <button id="btn-timer" aria-label={t.startTimer} class="mx-auto w-full max-w-[140px] px-3 py-2 bg-blue-600/20 border border-blue-500/50 hover:bg-blue-600/40 text-blue-300 rounded-full text-[10px] md:text-xs uppercase font-bold tracking-wider transition-all active:scale-95 flex justify-center items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400">
          {t.startTimer}
        </button>
      </div>

      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl flex flex-col justify-center transition-colors">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">{t.prep}</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-green-400 mt-1">
            {displayPrepTime} {!isPrepMissing && <span class="text-lg md:text-xl">{t.unitTime}</span>}
        </div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl flex flex-col justify-center items-center relative group transition-colors">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-2">{t.portions}</span>
        <div class="flex items-center justify-center gap-3 mt-1">
          <button id="btn-minus" aria-label="Decrease portions" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg select-none focus:outline-none focus:ring-2 focus:ring-purple-400">-</button>
          <div class="text-2xl md:text-3xl font-bold text-purple-400 w-8 text-center select-none" id="portions-display">{defaultPortions}</div>
          <button id="btn-plus" aria-label="Increase portions" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg select-none focus:outline-none focus:ring-2 focus:ring-purple-400">+</button>
        </div>
        <span class="text-[10px] text-slate-500 mt-1">{t.pers}</span>
      </div>
    </div>

    <div id="recipe-core" class="scroll-mt-24"></div>

