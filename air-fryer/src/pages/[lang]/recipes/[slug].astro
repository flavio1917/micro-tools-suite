  </div>

  <script is:inline define:vars={{ basePortions: defaultPortions, baseTemp: recipe.temp, lang: lang, recipeTime: cleanTime, txtStart: t.startTimer, txtStop: t.stopTimer, txtReadMode: t.readMode, txtDarkMode: t.darkMode }}>
    document.addEventListener('astro:page-load', () => {
      
      const triggerHaptic = () => { if (navigator.vibrate) navigator.vibrate(40); };

      const btnPrint = document.getElementById('btn-print');
      if (btnPrint) btnPrint.addEventListener('click', () => { triggerHaptic(); window.print(); });

      const btnJump = document.getElementById('btn-jump');
      if (btnJump) {
        btnJump.addEventListener('click', () => {
          triggerHaptic();
          const core = document.getElementById('recipe-core');
          if (core) core.scrollIntoView({ behavior: 'smooth' });
        });
      }

      const btnShare = document.getElementById('btn-share');
      if (btnShare) {
        btnShare.addEventListener('click', async () => {
          triggerHaptic();
          try {
            if (navigator.share) {
              await navigator.share({ title: document.title, url: window.location.href });
            } else {
              await navigator.clipboard.writeText(window.location.href);
              const originalHTML = btnShare.innerHTML;
              btnShare.innerHTML = '✅ Copiato!';
              setTimeout(() => { btnShare.innerHTML = originalHTML; }, 2000);
            }
          } catch (err) { console.log('Share error or canceled', err); }
        });
      }

      const btnReadMode = document.getElementById('btn-read-mode');
      const textReadMode = document.getElementById('text-read-mode');
      const contentWrapper = document.getElementById('recipe-content-wrapper');
      let isReadMode = false;
      
      if (btnReadMode && contentWrapper) {
        btnReadMode.addEventListener('click', () => {
          triggerHaptic();
          isReadMode = !isReadMode;
          if (isReadMode) {
            contentWrapper.classList.add('reading-mode');
            if (textReadMode) textReadMode.innerText = txtDarkMode;
            btnReadMode.innerHTML = `🌙 <span id="text-read-mode" class="hidden sm:inline">${txtDarkMode}</span>`;
          } else {
            contentWrapper.classList.remove('reading-mode');
            if (textReadMode) textReadMode.innerText = txtReadMode;
            btnReadMode.innerHTML = `☀️ <span id="text-read-mode" class="hidden sm:inline">${txtReadMode}</span>`;
          }
        });
      }

      const btnTimer = document.getElementById('btn-timer');
      const timerDisplay = document.getElementById('timer-display');
      const timerUnit = document.getElementById('timer-unit');
      const progressBar = document.getElementById('timer-progress');
      
      let timerInterval = null;
      let totalSeconds = 0;
      
      let parsedTime = 0;
      let timeStr = recipeTime.toString().trim();
      if (timeStr.includes('-')) {
          let parts = timeStr.split('-');
          parsedTime = Math.round((parseFloat(parts[0]) + parseFloat(parts[1])) / 2);
      } else {
          parsedTime = parseFloat(timeStr) || 0;
      }
      
      let isTimerRunning = false;

      if (btnTimer && timerDisplay && parsedTime > 0) {
        btnTimer.addEventListener('click', () => {
          triggerHaptic();
          if (isTimerRunning) {
            clearInterval(timerInterval);
            isTimerRunning = false;
            btnTimer.innerHTML = txtStart;
            btnTimer.className = "mx-auto w-full max-w-[140px] px-3 py-2 bg-blue-600/20 border border-blue-500/50 hover:bg-blue-600/40 text-blue-300 rounded-full text-[10px] md:text-xs uppercase font-bold tracking-wider transition-all active:scale-95 flex justify-center items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400";
            timerDisplay.innerText = recipeTime; 
            timerUnit.innerText = lang === 'en' ? 'min' : 'min';
            progressBar.style.width = '0%';
          } else {
            totalSeconds = parsedTime * 60;
            const fullTime = totalSeconds;
            isTimerRunning = true;
            btnTimer.innerHTML = txtStop;
            btnTimer.className = "mx-auto w-full max-w-[140px] px-3 py-2 bg-red-600/20 border border-red-500/50 hover:bg-red-600/40 text-red-300 rounded-full text-[10px] md:text-xs uppercase font-bold tracking-wider transition-all active:scale-95 flex justify-center items-center gap-1.5 focus:outline-none focus:ring-2 focus:ring-red-400";
            
            timerInterval = setInterval(() => {
              totalSeconds--;
              if (totalSeconds < 0) {
                clearInterval(timerInterval);
                timerDisplay.innerText = "00:00";
                btnTimer.innerHTML = txtStart;
                isTimerRunning = false;
                progressBar.style.width = '100%';
                try { new Audio("data:audio/wav;base64,UklGRl9vT19XQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YU").play(); } catch(e) {}
                return;
              }
              const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
              const s = (totalSeconds % 60).toString().padStart(2, '0');
              timerDisplay.innerText = `${m}:${s}`;
              timerUnit.innerText = '';
              progressBar.style.width = `${((fullTime - totalSeconds) / fullTime) * 100}%`;
            }, 1000);
            
            const m = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
            const s = (totalSeconds % 60).toString().padStart(2, '0');
            timerDisplay.innerText = `${m}:${s}`;
            timerUnit.innerText = '';
          }
        });
      }

      let currentPortions = basePortions;
      const display = document.getElementById('portions-display');
      const btnMinus = document.getElementById('btn-minus');
      const btnPlus = document.getElementById('btn-plus');
      const ingredients = document.querySelectorAll('.ingredient-text');

      let isMetric = lang !== 'en'; 

      const btnImperial = document.getElementById('btn-imperial');
      const btnMetric = document.getElementById('btn-metric');
      const tempValDisplay = document.getElementById('display-temp-val');
      const tempUnitDisplay = document.getElementById('display-temp-unit');

      if (!display || !btnMinus || !btnPlus) return;

      function fToC(f) { return Math.round(((f - 32) * 5/9) / 5) * 5; }

      function scaleAndConvertIngredient(originalStr, ratio, forceMetric, forceImperial) {
        let str = originalStr;

        if (forceMetric) {
            str = str.replace(/([\d.,]+)\s*fl oz\b/gi, (m, p1) => {
                let ml = parseFloat(p1.replace(',', '.')) * 29.5735;
                if (ml > 100) return `${Math.round(ml / 10) * 10} ml`;
                return `${Math.round(ml / 5) * 5} ml`;
            });
            str = str.replace(/([\d.,]+)\s*oz\b/gi, (m, p1) => {
                let g = parseFloat(p1.replace(',', '.')) * 28.3495;
                if (g >= 200) return `${Math.round(g / 10) * 10} g`;
                if (g >= 50) return `${Math.round(g / 5) * 5} g`;
                return `${Math.round(g)} g`;
            });
            str = str.replace(/([\d.,]+)\s*lbs?\b/gi, (m, p1) => {
                let g = parseFloat(p1.replace(',', '.')) * 453.592;
                return `${Math.round(g / 10) * 10} g`;
            });
        } else if (forceImperial) {
            str = str.replace(/([\d.,]+)\s*ml\b/gi, (m, p1) => {
                let floz = parseFloat(p1.replace(',', '.')) / 29.5735;
                return `${(Math.round(floz * 2) / 2)} fl oz`;
            });
            str = str.replace(/([\d.,]+)\s*k?g\b/gi, (m, p1) => {
                let val = parseFloat(p1.replace(',', '.'));
                if (m.toLowerCase().includes('kg')) val = val * 1000;
                let oz = val / 28.3495;
                return `${(Math.round(oz * 2) / 2)} oz`;
            });
        }

        if (!/\d/.test(str)) return str;
        const regex = /(^|[:,]\s*|\b)(\d+(?:[.,]\d+)?(?:\s*-\s*\d+(?:[.,]\d+)?)?(?:\/\d+)?)\s*([a-zA-Z]*)/g;
        let match;
        const tempRegex = new RegExp(regex);

        while ((match = tempRegex.exec(str)) !== null) {
            const pre = match[1];
            const numStr = match[2];
            const unitStr = match[3] ? match[3].toLowerCase() : '';
            if (numStr === '00' || numStr === '0') continue; 
            
            const roundSmart = (val) => {
                if (['g', 'gr', 'ml'].includes(unitStr)) {
                    if (val >= 200) return Math.round(val / 10) * 10;
                    if (val >= 50) return Math.round(val / 5) * 5;
                    return Math.round(val);
                }
                if (val >= 10) return Math.round(val);
                let step = Math.round(val * 4) / 4; 
                return step > 0 ? step : 0.25;
            };

            let newNumStr;
            if (numStr.includes('-')) {
                const parts = numStr.split('-');
                newNumStr = roundSmart(parseFloat(parts[0].replace(',', '.')) * ratio) + "-" + roundSmart(parseFloat(parts[1].replace(',', '.')) * ratio);
            } else if (numStr.includes('/')) {
                const parts = numStr.split('/');
                let val = (parseFloat(parts[0]) / parseFloat(parts[1])) * ratio;
                newNumStr = (ratio === 1 && !forceMetric && !forceImperial) ? numStr : roundSmart(val); 
            } else {
                newNumStr = roundSmart(parseFloat(numStr.replace(',', '.')) * ratio);
            }
            str = str.substring(0, match.index + pre.length) + newNumStr + str.substring(match.index + pre.length + numStr.length);
            break; 
        }
        return str;
      }

      function updateUI() {
        display.textContent = currentPortions;
        const ratio = currentPortions / basePortions;
        
        ingredients.forEach(el => {
          const original = el.getAttribute('data-original');
          if(original) {
              el.innerHTML = scaleAndConvertIngredient(original, ratio, isMetric, !isMetric);
          }
        });

        if (lang === 'en' && tempValDisplay && baseTemp) {
            tempValDisplay.textContent = isMetric ? fToC(baseTemp) : baseTemp;
            tempUnitDisplay.textContent = isMetric ? "°C" : "°F";
            document.querySelectorAll('.recipe-temp-val').forEach(el => el.textContent = isMetric ? fToC(baseTemp) : baseTemp);
            document.querySelectorAll('.recipe-temp-unit').forEach(el => el.textContent = isMetric ? "°C" : "°F");
        }

        const schemaScript = document.getElementById('recipe-schema');
        if (schemaScript) {
          try {
            const schemaData = JSON.parse(schemaScript.textContent);
            schemaData.recipeYield = `${currentPortions} servings`;
            schemaData.recipeIngredient = Array.from(ingredients).map(el => el.textContent.trim());
            schemaScript.textContent = JSON.stringify(schemaData);
          } catch(e) { console.error("Schema sync failed:", e); }
        }
      }
      
      btnMinus.addEventListener('click', () => { triggerHaptic(); if (currentPortions > 1) { currentPortions--; updateUI(); }});
      btnPlus.addEventListener('click', () => { triggerHaptic(); if (currentPortions < 20) { currentPortions++; updateUI(); }});

      if (btnImperial && btnMetric) {
          btnImperial.addEventListener('click', () => { 
            triggerHaptic();
            isMetric = false; 
            btnImperial.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors bg-blue-600 text-white shadow-sm focus:outline-none"; 
            btnMetric.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white focus:outline-none"; 
            updateUI(); 
          });
          btnMetric.addEventListener('click', () => { 
            triggerHaptic();
            isMetric = true; 
            btnMetric.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors bg-blue-600 text-white shadow-sm focus:outline-none"; 
            btnImperial.className = "px-2.5 py-1 text-[10px] md:text-xs font-bold rounded-full transition-colors text-slate-400 hover:text-white focus:outline-none"; 
            updateUI(); 
          });
      }

      const timeValue = parsedTime || 0; 
      const kwhInput = document.getElementById('input-kwh');
      const wattOvenInput = document.getElementById('input-watt-oven');
      const wattAFInput = document.getElementById('input-watt-af');
      const costOvenEl = document.getElementById('eco-cost-oven');
      const costAFEl = document.getElementById('eco-cost-af');
      const savedEl = document.getElementById('eco-saved-total');
      const currSymbolEco = lang === 'en' ? '$' : '€';

      function updateEco() {
          if(!kwhInput || timeValue === 0) return;
          const costPerKwh = parseFloat(kwhInput.value) || 0.28;
          const wattOven = parseFloat(wattOvenInput.value) || 2200;
          const wattAF = parseFloat(wattAFInput.value) || 1500;
          
          const hoursAF = timeValue / 60;
          const hoursOven = (timeValue * 1.2) / 60;

          const costOven = (wattOven / 1000) * hoursOven * costPerKwh;
          const costAF = (wattAF / 1000) * hoursAF * costPerKwh;
          const saved = costOven - costAF;

          costOvenEl.innerText = currSymbolEco + costOven.toFixed(2);
          costAFEl.innerText = currSymbolEco + costAF.toFixed(2);
          savedEl.innerText = currSymbolEco + saved.toFixed(2);
      }

      if(kwhInput) {
          kwhInput.addEventListener('input', updateEco);
          wattOvenInput.addEventListener('input', updateEco);
          wattAFInput.addEventListener('input', updateEco);
          updateEco(); 
      }
    });
  </script>
</MainLayout>