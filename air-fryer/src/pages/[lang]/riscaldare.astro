---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const lang = Astro.params.lang || 'it';
const homeUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;

const backBtnLabel = {
  it: "Vai alle ricette",
  en: "Go to Recipes",
  es: "Ir a las recetas",
  fr: "Voir les recettes"
}[lang] || "Vai alle ricette";

const content = {
  it: {
    title: "Come Riscaldare gli Avanzi nella Friggitrice ad Aria",
    h1: "Rianimatore di Avanzi",
    desc: "Il microonde li rende gommosi, il forno ci mette troppo. Ecco i tempi e i gradi perfetti per far tornare croccante la pizza, le patatine e i fritti di ieri.",
    items: [
      { name: "Pizza (Fette)", temp: "170°C", time: "3-4 min", tip: "Aggiungi qualche goccia d'acqua sulla crosta prima di infornare per evitare che si secchi troppo." },
      { name: "Patatine Fritte", temp: "180°C", time: "4-5 min", tip: "Scuoti il cestello a metà cottura e aggiungi un piccolo puff di olio spray." },
      { name: "Carne / Bistecca", temp: "150°C", time: "3-4 min", tip: "Temperatura più bassa per non stracuocere l'interno. Se era al sangue, fermati a 3 minuti." },
      { name: "Pasta al Forno / Lasagne", temp: "160°C", time: "6-8 min", tip: "Mettila in una teglietta di silicone o alluminio per non far scivolare il condimento sul fondo." },
      { name: "Pollo Arrosto (Pezzi)", temp: "170°C", time: "5-6 min", tip: "Se la pelle è diventata molliccia in frigo, tornerà super croccante." },
      { name: "Frittura Mista (Calamari)", temp: "190°C", time: "3-5 min", tip: "Usa una temperatura alta per ridare lo shock termico alla panatura senza asciugare l'interno." },
      { name: "Verdure Grigliate / Arrosto", temp: "160°C", time: "4-5 min", tip: "Aggiungi un cucchiaino d'acqua sul fondo del cestello per creare vapore e non seccarle." },
      { name: "Hamburger (Solo carne)", temp: "160°C", time: "4-5 min", tip: "Se ha il formaggio sopra, mettilo solo nell'ultimo minuto per farlo fondere senza bruciarlo." },
      { name: "Cornetti e Brioche", temp: "150°C", time: "2-3 min", tip: "Attenzione ai ripieni (crema/cioccolato) che diventano incandescenti in fretta!" },
      { name: "Polpette al Sugo", temp: "160°C", time: "5-7 min", tip: "Tagliale a metà se sono molto grandi, per farle scaldare bene al cuore." },
      { name: "Cotoletta Milanese", temp: "170°C", time: "3-4 min", tip: "Spruzza un velo d'olio se la panatura sembra troppo secca dal giorno prima." },
      { name: "Pesce (Forno o Fritto)", temp: "160°C", time: "4-5 min", tip: "Metti un foglio di alluminio forato sotto se c'è della salsa per non sporcare il cestello." },
      { name: "Arrosticini / Spiedini", temp: "180°C", time: "3-4 min", tip: "Tieni d'occhio il tempo per evitare di prosciugare i preziosi succhi della carne." },
      { name: "Pancake e Muffin", temp: "150°C", time: "2-3 min", tip: "Se non vuoi far scurire la superficie, coprili leggermente con carta stagnola." },
      { name: "Torta Salata / Quiche", temp: "160°C", time: "5-7 min", tip: "La bassa temperatura assicura che il cuore si scaldi prima che la crosta bruci." },
      { name: "Rustici di Sfoglia", temp: "170°C", time: "4-5 min", tip: "La pasta sfoglia rinasce letteralmente, non serve aggiungere olio." },
      { name: "Pane Raffermo", temp: "180°C", time: "3-4 min", tip: "Passalo sotto il rubinetto dell'acqua per 1 secondo prima di infornarlo: tornerà fragrante come appena sfornato." },
      { name: "Kebab / Piadina", temp: "170°C", time: "4-5 min", tip: "Avvolgilo in carta stagnola se lo vuoi morbido, lascialo libero se lo vuoi croccante." },
      { name: "Salsiccia Cotta", temp: "160°C", time: "3-4 min", tip: "Essendo già cotta, NON bucarla, altrimenti perderà tutti i succhi interni diventando stopposa." },
      { name: "Frittata / Omelette", temp: "150°C", time: "4-5 min", tip: "Scalda delicatamente a bassa temperatura per non far diventare l'uovo gommoso." }
    ]
  },
  en: {
    title: "How to Reheat Leftovers in the Air Fryer",
    h1: "The Leftover Reviver",
    desc: "The microwave makes them chewy. Here are the perfect times and temperatures to bring back the crispiness to yesterday's pizza and fries.",
    items: [
      { name: "Pizza Slices", temp: "340°F", time: "3-4 min", tip: "Add a few drops of water to the crust before air frying to prevent it from drying out." },
      { name: "French Fries", temp: "360°F", time: "4-5 min", tip: "Shake the basket halfway through and add a quick spray of oil." },
      { name: "Steak / Meat", temp: "300°F", time: "3-4 min", tip: "Keep the temp lower to avoid overcooking. If it was rare, stop at 3 minutes." },
      { name: "Baked Pasta / Lasagna", temp: "320°F", time: "6-8 min", tip: "Place it in a silicone or aluminum pan to keep the sauce from dripping." },
      { name: "Roast Chicken", temp: "340°F", time: "5-6 min", tip: "If the skin got soggy in the fridge, this will make it super crispy again." },
      { name: "Mixed Fried Seafood", temp: "375°F", time: "3-5 min", tip: "Use a high temp to shock the breading back to crispy without drying the inside." },
      { name: "Roasted Vegetables", temp: "320°F", time: "4-5 min", tip: "Add a teaspoon of water to the bottom of the basket to create steam and prevent drying." },
      { name: "Hamburger Patties", temp: "320°F", time: "4-5 min", tip: "If it has cheese on top, add it only in the last minute to melt without burning." },
      { name: "Croissants & Pastries", temp: "300°F", time: "2-3 min", tip: "Be careful with fillings (cream/chocolate) as they get molten hot very quickly!" },
      { name: "Meatballs", temp: "320°F", time: "5-7 min", tip: "Cut them in half if they are very large to ensure they heat through to the center." },
      { name: "Breaded Cutlet / Schnitzel", temp: "340°F", time: "3-4 min", tip: "Lightly spray with oil if the breading looks too dry from yesterday." },
      { name: "Fish (Baked or Fried)", temp: "320°F", time: "4-5 min", tip: "Use perforated foil underneath if it has a sauce, to prevent sticking." },
      { name: "Meat Skewers", temp: "360°F", time: "3-4 min", tip: "Keep a close eye on them to avoid drying out the meat juices." },
      { name: "Pancakes & Muffins", temp: "300°F", time: "2-3 min", tip: "If you don't want the top to brown, cover lightly with foil." },
      { name: "Quiche / Savory Pie", temp: "320°F", time: "5-7 min", tip: "Low temp ensures the center warms up before the crust burns." },
      { name: "Puff Pastry Snacks", temp: "340°F", time: "4-5 min", tip: "Puff pastry revives beautifully, no extra oil needed." },
      { name: "Stale Bread", temp: "360°F", time: "3-4 min", tip: "Run it under the tap for 1 second before cooking: it will steam and revive perfectly." },
      { name: "Kebab / Wraps", temp: "340°F", time: "4-5 min", tip: "Wrap in foil for a soft wrap, leave exposed for a crunchy wrap." },
      { name: "Cooked Sausages", temp: "320°F", time: "3-4 min", tip: "Since they are cooked, DO NOT pierce them, or they will dry out completely." },
      { name: "Omelette / Frittata", temp: "300°F", time: "4-5 min", tip: "Reheat gently so the egg doesn't turn rubbery." }
    ]
  },
  es: {
    title: "Cómo Recalentar Sobras en la Freidora de Aire",
    h1: "Revividor de Sobras",
    desc: "El microondas las deja blandas. Aquí tienes los tiempos y grados perfectos para devolverle el crujiente a la pizza y las patatas de ayer.",
    items: [
      { name: "Pizza (Porciones)", temp: "170°C", time: "3-4 min", tip: "Pon unas gotas de agua en la corteza antes de calentar para que no se seque." },
      { name: "Patatas Fritas", temp: "180°C", time: "4-5 min", tip: "Agita la cesta a la mitad y añade un toque de aceite en spray." },
      { name: "Carne / Filete", temp: "150°C", time: "3-4 min", tip: "Baja temperatura para no cocinarla de más por dentro. Si estaba poco hecha, no pases de 3 min." },
      { name: "Pasta al Horno / Lasaña", temp: "160°C", time: "6-8 min", tip: "Usa un molde de silicona para que la salsa no se caiga al fondo." },
      { name: "Pollo Asado (Piezas)", temp: "170°C", time: "5-6 min", tip: "Si la piel se ablandó en la nevera, volverá a estar súper crujiente." },
      { name: "Fritura Mixta (Calamares)", temp: "190°C", time: "3-5 min", tip: "Usa temperatura alta para reactivar el rebozado sin secar el interior." },
      { name: "Verduras Asadas", temp: "160°C", time: "4-5 min", tip: "Añade una cucharadita de agua en el fondo para crear vapor y no resecarlas." },
      { name: "Hamburguesas (Solo carne)", temp: "160°C", time: "4-5 min", tip: "Si lleva queso, ponlo solo en el último minuto para que se funda sin quemarse." },
      { name: "Cruasanes y Bollería", temp: "150°C", time: "2-3 min", tip: "¡Cuidado con los rellenos (crema/chocolate) que se calientan muchísimo!" },
      { name: "Albóndigas", temp: "160°C", time: "5-7 min", tip: "Córtalas por la mitad si son muy grandes para que se calienten bien por dentro." },
      { name: "Milanesa / Empanado", temp: "170°C", time: "3-4 min", tip: "Rocía un poco de aceite si el rebozado parece muy seco del día anterior." },
      { name: "Pescado (Asado/Frito)", temp: "160°C", time: "4-5 min", tip: "Pon papel de aluminio perforado debajo si tiene salsa para no manchar." },
      { name: "Pinchos Morunos", temp: "180°C", time: "3-4 min", tip: "Vigila el tiempo para evitar resecar la carne." },
      { name: "Tortitas y Muffins", temp: "150°C", time: "2-3 min", tip: "Si no quieres que se doren más, cúbrelos ligeramente con aluminio." },
      { name: "Quiche / Tarta Salada", temp: "160°C", time: "5-7 min", tip: "Baja temperatura para que el centro se caliente antes de que la masa se queme." },
      { name: "Hojaldres", temp: "170°C", time: "4-5 min", tip: "El hojaldre revive perfectamente, no hace falta aceite extra." },
      { name: "Pan Duro", temp: "180°C", time: "3-4 min", tip: "Pásalo por el grifo de agua 1 segundo antes de meterlo: volverá a estar crujiente." },
      { name: "Kebab / Wraps", temp: "170°C", time: "4-5 min", tip: "Envuélvelo en aluminio para que quede suave, o déjalo libre para que cruja." },
      { name: "Salchichas (Ya cocidas)", temp: "160°C", time: "3-4 min", tip: "Como ya están cocidas, NO las pinches o perderán sus jugos." },
      { name: "Tortilla / Omelette", temp: "150°C", time: "4-5 min", tip: "Calienta suavemente para que el huevo no se vuelva gomoso." }
    ]
  },
  fr: {
    title: "Comment Réchauffer les Restes à la Friteuse à Air",
    h1: "Le Réanimateur de Restes",
    desc: "Le micro-ondes les rend caoutchouteux. Voici les temps et températures parfaits pour redonner du croustillant à la pizza d'hier.",
    items: [
      { name: "Pizza (Parts)", temp: "170°C", time: "3-4 min", tip: "Ajoutez quelques gouttes d'eau sur la croûte avant de chauffer." },
      { name: "Frites", temp: "180°C", time: "4-5 min", tip: "Secouez le panier à mi-cuisson et ajoutez un pschitt d'huile." },
      { name: "Viande / Steak", temp: "150°C", time: "3-4 min", tip: "Baissez la température. S'il était saignant, ne dépassez pas 3 minutes." },
      { name: "Pâtes au Four / Lasagnes", temp: "160°C", time: "6-8 min", tip: "Mettez-les dans un moule en silicone pour retenir la sauce." },
      { name: "Poulet Rôti (Morceaux)", temp: "170°C", time: "5-6 min", tip: "Si la peau a ramolli au frigo, elle redeviendra super croustillante." },
      { name: "Friture Mixte", temp: "190°C", time: "3-5 min", tip: "Température élevée pour redonner un choc thermique à la panure sans assécher." },
      { name: "Légumes Rôtis", temp: "160°C", time: "4-5 min", tip: "Ajoutez une cuillère à café d'eau au fond du panier pour créer de la vapeur." },
      { name: "Steak Haché", temp: "160°C", time: "4-5 min", tip: "Si vous ajoutez du fromage, mettez-le à la dernière minute pour le faire fondre." },
      { name: "Croissants et Viennoiseries", temp: "150°C", time: "2-3 min", tip: "Attention aux fourrages (crème/chocolat) qui deviennent brûlants très vite !" },
      { name: "Boulettes de viande", temp: "160°C", time: "5-7 min", tip: "Coupez-les en deux si elles sont grosses pour bien les chauffer à cœur." },
      { name: "Escalope Pannée", temp: "170°C", time: "3-4 min", tip: "Vaporisez un peu d'huile si la panure semble trop sèche." },
      { name: "Poisson", temp: "160°C", time: "4-5 min", tip: "Mettez du papier d'aluminium en dessous s'il y a de la sauce." },
      { name: "Brochettes", temp: "180°C", time: "3-4 min", tip: "Surveillez le temps pour éviter de dessécher la viande." },
      { name: "Pancakes & Muffins", temp: "150°C", time: "2-3 min", tip: "Pour ne pas faire brunir le dessus, couvrez légèrement d'aluminium." },
      { name: "Quiche / Tarte Salée", temp: "160°C", time: "5-7 min", tip: "La basse température assure que le cœur chauffe avant que la croûte ne brûle." },
      { name: "Feuilletés / Apéritif", temp: "170°C", time: "4-5 min", tip: "La pâte feuilletée renaît littéralement, pas besoin d'huile supplémentaire." },
      { name: "Pain Rassis", temp: "180°C", time: "3-4 min", tip: "Passez-le sous le robinet 1 seconde avant de le cuire : il redeviendra croustillant." },
      { name: "Kebab / Wraps", temp: "170°C", time: "4-5 min", tip: "Enveloppez d'aluminium pour le rendre moelleux, laissez libre pour le croustillant." },
      { name: "Saucisses (Déjà cuites)", temp: "160°C", time: "3-4 min", tip: "Ne les piquez SURTOUT PAS, sinon elles perdront tout leur jus." },
      { name: "Omelette", temp: "150°C", time: "4-5 min", tip: "Chauffez doucement pour que l'œuf ne devienne pas caoutchouteux." }
    ]
  }
};

const t = content[lang as keyof typeof content] || content.it;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": t.items.map(item => ({
    "@type": "Question",
    "name": `Come riscaldare ${item.name.toLowerCase()} nella friggitrice ad aria?`, 
    "acceptedAnswer": {
      "@type": "Answer",
      "text": `Imposta a ${item.temp} per ${item.time}. Consiglio: ${item.tip}`
    }
  }))
};
---

<MainLayout title={t.title} lang={lang}>
  <section class="max-w-4xl mx-auto py-12 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-amber-400">{t.h1}</h1>
      <p class="text-slate-400 text-base md:text-xl max-w-2xl mx-auto leading-relaxed">{t.desc}</p>
    </header>

    <div class="grid md:grid-cols-2 gap-6 mb-12">
      {t.items.map((item) => (
        <div class="bg-slate-800/40 border border-slate-700/50 p-6 rounded-2xl shadow-xl hover:border-orange-500/50 transition-all">
          <h2 class="text-xl font-bold text-white mb-4 border-b border-slate-700 pb-3">{item.name}</h2>
          <div class="flex gap-4 mb-4">
            <div class="bg-slate-900/80 px-4 py-2 rounded-lg border border-slate-700 text-center flex-1">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Temp</span>
              <span class="text-lg font-mono font-bold text-orange-400">{item.temp}</span>
            </div>
            <div class="bg-slate-900/80 px-4 py-2 rounded-lg border border-slate-700 text-center flex-1">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Time</span>
              <span class="text-lg font-mono font-bold text-blue-400">{item.time}</span>
            </div>
          </div>
          <p class="text-sm text-slate-300 bg-amber-500/10 border border-amber-500/20 p-3 rounded-lg"><span class="text-amber-400 font-bold">💡 Tip:</span> {item.tip}</p>
        </div>
      ))}
    </div>

    <Disclaimer type="generale" lang={lang} />

    <div class="mt-12 text-center pt-8 border-t border-slate-800">
      <a href={homeUrl} class="inline-flex items-center justify-center px-6 py-3 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</MainLayout>