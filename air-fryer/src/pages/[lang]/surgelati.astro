---
import MainLayout from '../../layouts/MainLayout.astro';
import Disclaimer from '../../components/Disclaimer.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const lang = Astro.params.lang || 'it';
const homeUrl = `/${lang}/#ricettario`;

const backBtnLabel = {
  it: "Vai alle ricette",
  en: "Go to Recipes",
  es: "Ir a las recetas",
  fr: "Voir les recettes"
}[lang] || "Vai alle ricette";

const content = {
  it: {
    title: "Convertitore Friggitrice ad Aria per Surgelati: Tempi a 2 Fasi",
    h1: "Calibratore Surgelati",
    desc: "Basta cibi bruciati fuori e ghiacciati dentro. Inserisci i dati della scatola e ottieni la cottura termodinamica perfetta in 2 Fasi.",
    catLabel: "Categoria Prodotto",
    tLabel: "Gradi sulla Scatola",
    mLabel: "Minuti sulla Scatola",
    phase1: "Fase 1: Scongelamento & Asciugatura",
    phase2: "Fase 2: Crisping ad Alta Temp.",
    cats: [
      { id: "patate", name: "🍟 Patatine & Snack Fritti" },
      { id: "carne", name: "🍗 Carne Panata (Cordon Bleu, Nuggets)" },
      { id: "pesce", name: "🐟 Pesce (Bastoncini, Anelli)" },
      { id: "lievitati", name: "🥐 Lievitati (Cornetti, Rustici)" }
    ],
    shakeTip: "🔔 Ricorda di scuotere il cestello a metà cottura!"
  },
  en: {
    title: "Air Fryer Frozen Food Converter: 2-Phase Cooking",
    h1: "Frozen Food Calibrator",
    desc: "Stop burning the outside while the inside is frozen. Enter the box instructions to get the perfect 2-Phase thermodynamic cooking method.",
    catLabel: "Product Category",
    tLabel: "Box Temperature",
    mLabel: "Box Minutes",
    phase1: "Phase 1: Defrost & Dry",
    phase2: "Phase 2: High-Heat Crisping",
    cats: [
      { id: "patate", name: "🍟 French Fries & Snacks" },
      { id: "carne", name: "🍗 Breaded Meat (Nuggets, Schnitzel)" },
      { id: "pesce", name: "🐟 Fish (Fishsticks, Calamari)" },
      { id: "lievitati", name: "🥐 Pastries & Doughs" }
    ],
    shakeTip: "🔔 Remember to shake the basket halfway through!"
  },
  es: {
    title: "Calculadora Freidora de Aire para Congelados: 2 Fases",
    h1: "Calibrador de Congelados",
    desc: "Evita comida quemada por fuera y helada por dentro. Introduce los datos del envase y obtén la cocción termodinámica perfecta en 2 Fases.",
    catLabel: "Categoría del Producto",
    tLabel: "Grados en el Envase",
    mLabel: "Minutos en el Envase",
    phase1: "Fase 1: Descongelación y Secado",
    phase2: "Fase 2: Crujiente a Alta Temp.",
    cats: [
      { id: "patate", name: "🍟 Patatas Fritas y Snacks" },
      { id: "carne", name: "🍗 Carne Empanada (Nuggets, San Jacobos)" },
      { id: "pesce", name: "🐟 Pescado (Varitas, Anillas)" },
      { id: "lievitati", name: "🥐 Masas y Bollería" }
    ],
    shakeTip: "🔔 ¡Recuerda agitar la cesta a la mitad del tiempo!"
  },
  fr: {
    title: "Convertisseur Friteuse à Air pour Surgelés : Cuisson en 2 Phases",
    h1: "Calculateur pour Surgelés",
    desc: "Évitez les aliments brûlés dehors et congelés dedans. Entrez les données de la boîte pour obtenir la cuisson thermodynamique parfaite.",
    catLabel: "Catégorie de Produit",
    tLabel: "Temp. sur la Boîte",
    mLabel: "Minutes sur la Boîte",
    phase1: "Phase 1 : Décongélation",
    phase2: "Phase 2 : Croustillant Haute Temp.",
    cats: [
      { id: "patate", name: "🍟 Frites et Snacks" },
      { id: "carne", name: "🍗 Viande Panée (Nuggets, Cordon Bleu)" },
      { id: "pesce", name: "🐟 Poisson (Bâtonnets, Calamars)" },
      { id: "lievitati", name: "🥐 Pâtisseries et Pâtes" }
    ],
    shakeTip: "🔔 N'oubliez pas de secouer le panier à mi-cuisson !"
  }
};

const t = content[lang as keyof typeof content] || content.it;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": t.h1,
  "operatingSystem": "All",
  "applicationCategory": "UtilitiesApplication",
  "description": t.desc,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" }
};
---

<MainLayout title={t.title} lang={lang}>
  <section class="max-w-5xl mx-auto py-12 md:py-16 px-4">
    
    <div class="mb-8 flex justify-start">
      <a href={homeUrl} class="inline-flex items-center justify-center px-5 py-2.5 bg-slate-800/90 backdrop-blur-md text-white border border-slate-600/50 shadow-xl rounded-full hover:bg-slate-700 transition-all z-10 group">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span class="font-bold text-sm">{backBtnLabel}</span>
      </a>
    </div>

    <header class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-black text-white mb-4 tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
        <span class="text-4xl md:text-5xl">❄️</span> {t.h1}
      </h1>
      <p class="text-slate-400 text-base md:text-xl max-w-2xl mx-auto leading-relaxed">{t.desc}</p>
    </header>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-12 max-w-4xl mx-auto">
      
      <div class="flex-1 bg-slate-800/60 border border-slate-700 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden h-fit">
        <div class="absolute -top-24 -left-24 w-48 h-48 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="space-y-8 relative z-10">
          <div>
            <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">{t.catLabel}</label>
            <select id="cat-select" class="w-full bg-slate-900 border border-slate-600 text-white rounded-xl px-4 py-3.5 focus:ring-2 focus:ring-cyan-500 outline-none transition-all shadow-inner font-medium text-base appearance-none cursor-pointer">
              {t.cats.map((cat) => (
                <option value={cat.id}>{cat.name}</option>
              ))}
            </select>
          </div>

          <div class="bg-slate-900/50 p-5 rounded-2xl border border-slate-700/50">
            <div class="flex justify-between items-end mb-4">
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">{t.tLabel}</label>
              <div class="text-2xl font-black font-mono text-orange-400"><span id="val-temp">{lang === 'en' ? '400' : '200'}</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <input type="range" id="slider-temp" min={lang === 'en' ? '300' : '150'} max={lang === 'en' ? '450' : '230'} step="5" value={lang === 'en' ? '400' : '200'} class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-orange-500" />
            <div class="flex justify-between text-[10px] text-slate-500 mt-2 font-mono font-bold">
              <span>{lang === 'en' ? '300°F' : '150°C'}</span>
              <span>{lang === 'en' ? '450°F' : '230°C'}</span>
            </div>
          </div>

          <div class="bg-slate-900/50 p-5 rounded-2xl border border-slate-700/50">
            <div class="flex justify-between items-end mb-4">
              <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">{t.mLabel}</label>
              <div class="text-2xl font-black font-mono text-blue-400"><span id="val-mins">20</span> <span class="text-sm">min</span></div>
            </div>
            <input type="range" id="slider-mins" min="5" max="60" step="1" value="20" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500" />
            <div class="flex justify-between text-[10px] text-slate-500 mt-2 font-mono font-bold">
              <span>5 min</span>
              <span>60 min</span>
            </div>
          </div>

        </div>
      </div>

      <div class="flex-1 space-y-0 flex flex-col justify-center relative">
    
        <div class="relative bg-gradient-to-r from-cyan-900/30 to-slate-900/50 border border-cyan-500/30 p-6 rounded-2xl mb-6 ml-0 md:ml-4 shadow-lg hover:border-cyan-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-cyan-500 rounded-full flex items-center justify-center font-black text-slate-900 shadow-[0_0_15px_rgba(6,182,212,0.5)] text-lg ring-4 ring-[#0B1120]">1</div>
          
          <h3 class="text-cyan-400 font-bold uppercase tracking-wider text-xs mb-4">{t.phase1}</h3>
          
          <div class="flex gap-4">
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-300"><span id="res-t1">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-cyan-300"><span id="res-m1">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

        <div class="relative bg-amber-500/10 border border-amber-500/20 rounded-xl p-4 flex items-center gap-3 ml-0 md:ml-8 mb-6 z-10 backdrop-blur-md">
          <span class="text-2xl animate-bounce">🔀</span>
          <p class="text-amber-200 text-xs md:text-sm font-bold tracking-wide uppercase">{t.shakeTip}</p>
        </div>

        <div class="relative bg-gradient-to-r from-orange-900/30 to-slate-900/50 border border-orange-500/30 p-6 rounded-2xl ml-0 md:ml-4 shadow-lg hover:border-orange-400/60 transition-colors">
          <div class="absolute -top-4 -left-4 md:-left-8 w-10 h-10 bg-orange-500 rounded-full flex items-center justify-center font-black text-slate-900 shadow-[0_0_15px_rgba(249,115,22,0.5)] text-lg ring-4 ring-[#0B1120]">2</div>
          
          <h3 class="text-orange-400 font-bold uppercase tracking-wider text-xs mb-4">{t.phase2}</h3>
          
          <div class="flex gap-4">
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Temp</span>
              <div class="text-2xl font-mono font-black text-orange-500"><span id="res-t2">--</span> <span class="text-sm">{lang === 'en' ? '°F' : '°C'}</span></div>
            </div>
            <div class="bg-slate-950/80 px-4 py-3 rounded-xl border border-slate-700 text-center flex-1 shadow-inner">
              <span class="block text-[10px] text-slate-500 uppercase font-bold mb-1">Time</span>
              <div class="text-2xl font-mono font-black text-blue-400"><span id="res-m2">--</span> <span class="text-sm">min</span></div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="mt-16 text-center pt-8 border-t border-slate-800">
      <Disclaimer type="generale" lang={lang} />
    </div>

  </section>

  <script is:inline define:vars={{ isEn: lang === 'en' }}>
    document.addEventListener('DOMContentLoaded', () => {
      const selectCat = document.getElementById('cat-select');
      const sliderTemp = document.getElementById('slider-temp');
      const sliderMins = document.getElementById('slider-mins');
      const valTemp = document.getElementById('val-temp');
      const valMins = document.getElementById('val-mins');

      const resT1 = document.getElementById('res-t1');
      const resM1 = document.getElementById('res-m1');
      const resT2 = document.getElementById('res-t2');
      const resM2 = document.getElementById('res-m2');

      // Helper per animare i numeri al volo
      let animRefs = {};
      function animateValue(obj, start, end, duration, key) {
        if (animRefs[key]) cancelAnimationFrame(animRefs[key]);
        let startTimestamp = null;
        const step = (timestamp) => {
          if (!startTimestamp) startTimestamp = timestamp;
          const progress = Math.min((timestamp - startTimestamp) / duration, 1);
          obj.innerHTML = Math.floor(progress * (end - start) + start);
          if (progress < 1) animRefs[key] = window.requestAnimationFrame(step);
        };
        animRefs[key] = window.requestAnimationFrame(step);
      }

      function round5(val) { return Math.round(val / 5) * 5; }

      function calculateLive() {
        const cat = selectCat.value;
        const boxTemp = parseFloat(sliderTemp.value);
        const boxMins = parseFloat(sliderMins.value);

        valTemp.textContent = boxTemp;
        valMins.textContent = boxMins;

        let dropT1, dropT2, percM1, percM2;

        // MATEMATICA BASE IN CELSIUS (Drop termico)
        if (cat === 'patate') {
          dropT1 = 40; dropT2 = 0; percM1 = 0.45; percM2 = 0.35;
        } else if (cat === 'carne') {
          dropT1 = 30; dropT2 = 10; percM1 = 0.50; percM2 = 0.30;
        } else if (cat === 'pesce') {
          dropT1 = 40; dropT2 = 15; percM1 = 0.50; percM2 = 0.25;
        } else if (cat === 'lievitati') {
          dropT1 = 50; dropT2 = 20; percM1 = 0.60; percM2 = 0.20;
        }

        // Se lingua inglese, moltiplichiamo i "drop" termici per 1.8 (Conversione C -> F dei Delta)
        if (isEn) {
          dropT1 = Math.round(dropT1 * 1.8);
          dropT2 = Math.round(dropT2 * 1.8);
        }

        const finalT1 = round5(boxTemp - dropT1);
        const finalT2 = round5(boxTemp - dropT2);
        const finalM1 = Math.max(1, Math.round(boxMins * percM1));
        const finalM2 = Math.max(1, Math.round(boxMins * percM2));

        // Anima i numeri per effetto gamification (molto veloce, 400ms)
        const currT1 = parseInt(resT1.textContent) || finalT1;
        const currM1 = parseInt(resM1.textContent) || finalM1;
        const currT2 = parseInt(resT2.textContent) || finalT2;
        const currM2 = parseInt(resM2.textContent) || finalM2;

        animateValue(resT1, currT1, finalT1, 400, 't1');
        animateValue(resM1, currM1, finalM1, 400, 'm1');
        animateValue(resT2, currT2, finalT2, 400, 't2');
        animateValue(resM2, currM2, finalM2, 400, 'm2');
      }

      // Event Listeners
      selectCat.addEventListener('change', calculateLive);
      sliderTemp.addEventListener('input', calculateLive);
      sliderMins.addEventListener('input', calculateLive);

      // Inizializza
      calculateLive();
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
</MainLayout>