---
import MainLayout from '../layouts/MainLayout.astro'; 

export function getStaticPaths() {
  return [
    { params: { lang: 'it' } },
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } }
  ];
}

const { lang } = Astro.params;

// Dizionario Multilingua Completo
const content = {
  it: {
    pageTitle: "Chi Siamo e Contatti | Convertitore Friggitrice ad Aria",
    h1: "Informazioni sul Progetto",
    p1: "<strong>Convertitore Friggitrice</strong> nasce dall'esigenza di rendere la cucina con la friggitrice ad aria semplice, veloce e accessibile a tutti. Abbiamo sviluppato uno strumento di conversione preciso per adattare le tue ricette tradizionali da forno a questo fantastico elettrodomestico.",
    p2: "Oltre al convertitore, mettiamo a disposizione un ricettario curato con oltre <strong>180 ricette</strong> testate, complete di tempi e temperature ottimali per garantire risultati sempre croccanti.",
    authorTitle: "L'Autore & Creatore",
    authorText: "Ciao, sono Flavio Refrigeri. Nella vita sono un Ingegnere Informatico, ma la mia vera passione è la cucina fatta come si deve. Ho creato questo sito perché ero stanco di vedere ricette rovinate da tempi e temperature tirati a indovinare. Così ho deciso di risolvere il problema: ho preso la precisione che uso nel mio lavoro e l'ho portata in cucina, creando un algoritmo che calcola come il calore si muove dentro una friggitrice ad aria. Ma i numeri da soli non sfamano nessuno: ogni singola ricetta che vedi qui l'ho preparata, assaggiata e aggiustata nella mia cucina. Non sono solo conversioni, sono piatti che porto in tavola per la mia famiglia e che ora condivido con te.",
    techTitle: "Tecnologia e Immagini",
    techText: "Per offrirti la migliore esperienza visiva, utilizziamo l'intelligenza artificiale per generare rappresentazioni realistiche dei piatti. Questo ci permette di mostrarti il risultato ideale di ogni ricetta, mantenendo il sito leggero e moderno.<br><br><strong>Nota bene:</strong> Mentre le immagini sono generate, tutte le istruzioni, le temperature e i tempi di cottura sono frutto di analisi rigorose su manuali d'uso e test culinari reali.",
    transparencyTitle: "Trasparenza e Sostenibilità",
    transparencyText: "Per mantenere il sito gratuito e senza pubblicità invasiva, partecipiamo al programma di affiliazione Amazon. Questo significa che per alcuni prodotti consigliati potremmo ricevere una piccola commissione, senza alcun costo aggiuntivo per te. Selezioniamo solo accessori che riteniamo realmente utili per migliorare l'esperienza in cucina.",
    contactTitle: "Contatti",
    contactText: "Hai suggerimenti, hai trovato un errore o vuoi collaborare? Saremo felici di leggerti. Puoi scriverci a:"
  },
  en: {
    pageTitle: "About Us & Contact | Air Fryer Converter",
    h1: "About the Project",
    p1: "<strong>Air Fryer Converter</strong> was born from the need to make air frying simple, fast, and accessible to everyone. We developed a precise conversion tool to adapt your traditional oven recipes to this fantastic appliance.",
    p2: "Besides the converter, we offer a curated cookbook with over <strong>180 tested recipes</strong>, complete with optimal times and temperatures to ensure crispy results every time.",
    authorTitle: "The Author & Creator",
    authorText: "Hi, I'm Flavio Refrigeri. By day, I'm a Software Engineer, but my true passion is proper cooking. I created this site because I was tired of ruined recipes caused by guessed times and temperatures. I brought the precision of my daily job into the kitchen, creating an algorithm that truly understands how heat moves inside an air fryer. But numbers alone don't feed anyone: every single recipe you see here has been prepared, tasted, and tweaked in my own kitchen. They aren't just conversions; they are meals I serve my family and now share with you.",
    techTitle: "Technology and Images",
    techText: "To offer you the best visual experience, we use artificial intelligence to generate realistic representations of the dishes. This allows us to show you the ideal result of each recipe while keeping the site light and modern.<br><br><strong>Please note:</strong> While the images are AI-generated, all instructions, temperatures, and cooking times are the result of rigorous analysis of user manuals and real culinary tests.",
    transparencyTitle: "Transparency and Sustainability",
    transparencyText: "To keep the site free and without invasive advertising, we participate in the Amazon affiliate program. This means we may earn a small commission on some recommended products, at no extra cost to you. We only select accessories that we believe are truly useful for improving your cooking experience.",
    contactTitle: "Contact Us",
    contactText: "Have suggestions, found an error, or want to collaborate? We'd love to hear from you. You can write to us at:"
  },
  es: {
    pageTitle: "Quiénes Somos y Contacto | Convertidor Freidora de Aire",
    h1: "Sobre el Proyecto",
    p1: "<strong>Convertidor Freidora</strong> nace de la necesidad de hacer que cocinar con la freidora de aire sea simple, rápido y accesible para todos. Hemos desarrollado una herramienta de conversión precisa para adaptar tus recetas tradicionales de horno a este fantástico electrodoméstico.",
    p2: "Además del convertidor, ofrecemos un recetario con más de <strong>180 recetas probadas</strong>, con tiempos y temperaturas óptimas para garantizar resultados siempre crujientes.",
    authorTitle: "El Autor y Creador",
    authorText: "Hola, soy Flavio Refrigeri. Soy Ingeniero Informático, pero mi verdadera pasión es la buena cocina. Creé este sitio porque estaba cansado de recetas arruinadas por tiempos y temperaturas al azar. Llevé la precisión de mi trabajo a la cocina, creando un cálculo que entiende cómo se mueve el calor. Pero los números no alimentan a nadie: cada receta que ves aquí la he preparado, probado y ajustado en mi propia cocina hasta que quedó perfecta. Son platos que llevo a mi mesa y que ahora comparto contigo.",
    techTitle: "Tecnología e Imágenes",
    techText: "Para ofrecerte la mejor experiencia visual, utilizamos inteligencia artificial para generar representaciones realistas de los platos. Esto nos permite mostrarte el resultado ideal manteniendo el sitio ligero y moderno.<br><br><strong>Nota:</strong> Aunque las imágenes son generadas, todas las instrucciones, temperaturas y tiempos de cocción son el resultado de análisis rigurosos y pruebas culinarias reales.",
    transparencyTitle: "Transparencia y Sostenibilidad",
    transparencyText: "Para mantener el sitio gratuito y sin publicidad invasiva, participamos en el programa de afiliados de Amazon. Esto significa que podemos recibir una pequeña comisión por algunos productos recomendados, sin costo adicional para ti. Solo seleccionamos accesorios que consideramos realmente útiles.",
    contactTitle: "Contacto",
    contactText: "¿Tienes sugerencias, encontraste un error o quieres colaborar? Estaremos encantados de leerte. Puedes escribirnos a:"
  },
  fr: {
    pageTitle: "À Propos et Contact | Convertisseur Friteuse à Air",
    h1: "À Propos du Projet",
    p1: "<strong>Convertisseur Friteuse</strong> est né du besoin de rendre la cuisine à la friteuse à air simple, rapide et accessible à tous. Nous avons développé un outil de conversion précis pour adapter vos recettes traditionnelles au four à ce fantastique appareil.",
    p2: "En plus du convertisseur, nous proposons un livre de recettes de plus de <strong>180 recettes testées</strong>, avec des temps et des températures optimaux pour garantir des résultats toujours croustillants.",
    authorTitle: "L'Auteur & Créateur",
    authorText: "Bonjour, je suis Flavio Refrigeri. Dans la vie, je suis Ingénieur Informatique, mais ma véritable passion est la bonne cuisine. J'ai créé ce site parce que j'en avais assez des recettes gâchées par des temps de cuisson approximatifs. J'ai apporté la précision de mon métier dans la cuisine, en créant un calcul qui comprend vraiment la répartition de la chaleur. Mais les chiffres seuls ne nourrissent personne : chaque recette a été préparée, goûtée et ajustée dans ma propre cuisine. Ce sont des plats que je sers à ma famille et que je partage maintenant avec vous.",
    techTitle: "Technologie et Images",
    techText: "Pour vous offrir la meilleure expérience visuelle, nous utilisons l'intelligence artificielle pour générer des représentations réalistes des plats. Cela nous permet de vous montrer le résultat idéal tout en gardant le site léger et moderne.<br><br><strong>À noter :</strong> Bien que les images soient générées, toutes les instructions, températures et temps de cuisson sont le résultat d'analyses rigoureuses et de véritables tests culinaires.",
    transparencyTitle: "Transparence et Durabilité",
    transparencyText: "Pour garder le site gratuit et sans publicité envahissante, nous participons au programme d'affiliation Amazon. Cela signifie que nous pouvons recevoir une petite commission pour certains produits recommandés, sans frais supplémentaires pour vous. Nous ne sélectionnons que des accessoires que nous jugeons vraiment utiles.",
    contactTitle: "Contactez-nous",
    contactText: "Vous avez des suggestions, trouvé une erreur ou souhaitez collaborer ? Nous serions ravis de vous lire. Vous pouvez nous écrire à :"
  }
};

const t = content[lang as keyof typeof content] || content.it;

const pageUrl = lang === 'it' ? 'https://www.convertitorefriggitrice.it/info' : `https://www.convertitorefriggitrice.it/${lang}/info`;

// Dati Strutturati E-E-A-T (ProfilePage & Person)
const personSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": {
    "@type": "Person",
    "name": "Flavio Refrigeri",
    "jobTitle": "Ingegnere Informatico & Creatore di Ricette",
    "url": pageUrl,
    "description": "Ingegnere informatico appassionato di cucina, dedicato a perfezionare la cottura in friggitrice ad aria attraverso test reali e calcoli precisi.",
    "knowsAbout": [
        "Cottura in Friggitrice ad Aria", 
        "Sviluppo Ricette", 
        "Ottimizzazione Tempi di Cottura", 
        "Tecnologia in Cucina"
    ]
  }
};
---

<MainLayout title={t.pageTitle} lang={lang}>
  <section class="max-w-3xl mx-auto py-20 px-4 text-slate-300">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-8">{t.h1}</h1>
    
    <div class="space-y-8 text-base md:text-lg leading-relaxed">
      
      <div class="space-y-4">
        <p set:html={t.p1}></p>
        <p set:html={t.p2}></p>
      </div>

      <div class="bg-slate-800/40 border border-blue-500/30 p-6 md:p-8 rounded-2xl flex flex-col md:flex-row gap-6 md:gap-8 items-center md:items-start shadow-lg">
        <div class="w-24 h-24 flex-shrink-0 rounded-full overflow-hidden border-2 border-slate-600 bg-slate-900 flex items-center justify-center">
          <span class="text-5xl">👨‍🍳</span> 
        </div>
        <div>
          <h2 class="text-xl md:text-2xl font-bold text-white mb-3">{t.authorTitle}</h2>
          <p class="text-sm md:text-base leading-relaxed text-slate-300">{t.authorText}</p>
        </div>
      </div>

      <div class="bg-slate-800/30 border border-slate-700 p-6 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-3">{t.techTitle}</h2>
        <p class="text-sm leading-relaxed" set:html={t.techText}></p>
      </div>

      <div class="bg-slate-800/50 border border-slate-700 p-6 rounded-2xl">
        <h2 class="text-xl font-bold text-white mb-4">{t.transparencyTitle}</h2>
        <p class="text-sm leading-relaxed">{t.transparencyText}</p>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-800">
        <h2 class="text-2xl font-bold text-white mb-4">{t.contactTitle}</h2>
        <p>{t.contactText}</p>
        <a href="mailto:postmaster@convertitorefriggitrice.it" class="text-blue-400 font-bold text-xl hover:underline block mt-3">
          postmaster@convertitorefriggitrice.it
        </a>
      </div>

    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</MainLayout>