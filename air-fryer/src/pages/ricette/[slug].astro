---
import MainLayout from '../../layouts/MainLayout.astro';
import recipes from '../../data/recipes-it.json';
import AmazonProduct from '../../components/ads/AmazonProduct.astro';

export async function getStaticPaths() {
  return recipes.map((recipe) => {
    return {
      params: { slug: recipe.slug },
      props: { recipe },
    };
  });
}

const { recipe } = Astro.props;

// --- AGGIUNTE PER LINGUA E BOTTONE ---
const lang = 'it'; // ATTENZIONE: cambia questo in 'en', 'es', 'fr' quando duplichi questo file per le altre lingue!
const backUrl = lang === 'it' ? '/#ricettario' : `/${lang}/#ricettario`;
// -------------------------------------

// Gestione immagine
const imagePath = `/images/recipes/${recipe.slug}.webp`;

// Calcoliamo il numero base di porzioni estraendolo dalla stringa (es: "4" o "4-6")
// Se non c'è, il default è 2
const defaultPortions = parseInt(recipe.portions) || 2;
---

<MainLayout title={`${recipe.title} - Ricetta Friggitrice ad Aria`} lang={lang}>
  
  <div class="relative h-[40vh] min-h-[320px] md:h-[50vh] md:min-h-[400px] w-full overflow-hidden bg-slate-900">
    <img 
      src={imagePath} 
      alt={recipe.title} 
      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-1000 hover:scale-105"
      onerror="this.style.opacity='0'" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
    
    <div class="relative max-w-4xl mx-auto px-4 h-full flex flex-col justify-end pb-12 md:pb-16 items-center text-center z-10">
      
      <a href={backUrl} class="inline-flex items-center gap-2 px-6 py-3 md:px-4 md:py-2 mb-4 md:mb-6 rounded-full bg-slate-800/80 hover:bg-slate-700/90 backdrop-blur-md text-white transition-all border border-slate-500/50 text-sm font-bold md:font-medium shadow-xl group">
        <svg class="w-5 h-5 md:w-4 md:h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Torna al Ricettario
      </a>

      <h1 class="text-3xl md:text-6xl font-extrabold text-white mb-3 md:mb-4 leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
        {recipe.title}
      </h1>
      <p class="text-base md:text-xl text-slate-200 max-w-2xl font-medium drop-shadow-md border-t border-white/20 pt-3 md:pt-4 mt-1 md:mt-2">
        {recipe.description}
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 -mt-8 relative z-20 pb-20">
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">Temperatura</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-orange-400 mt-1">{recipe.temp}°C</div>
      </div>
      
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">Cottura</span>
        <div class="text-3xl md:text-4xl font-mono font-bold text-blue-400 mt-1">{recipe.time} <span class="text-lg md:text-xl">min</span></div>
      </div>
      
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-1">Preparazione</span>
        <div class="text-xl md:text-2xl font-bold text-green-400 mt-2">{recipe.prep_time || 'N/D'}</div>
      </div>

      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-4 md:p-6 text-center shadow-2xl hover:border-blue-500 transition-colors flex flex-col justify-center items-center relative group">
        <span class="block text-slate-400 text-[10px] md:text-xs uppercase tracking-wider font-bold mb-2">Porzioni</span>
        <div class="flex items-center justify-center gap-3 mt-1">
          <button id="btn-minus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg" aria-label="Riduci">-</button>
          <div class="text-2xl md:text-3xl font-bold text-purple-400 w-8 text-center" id="portions-display">
            {defaultPortions}
          </div>
          <button id="btn-plus" class="w-8 h-8 rounded-full bg-slate-700 hover:bg-purple-600 text-white flex items-center justify-center font-bold text-lg transition-colors cursor-pointer active:scale-95 z-10 shadow-lg" aria-label="Aumenta">+</button>
        </div>
        <span class="text-[10px] text-slate-500 mt-1">pers.</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <div class="lg:col-span-1">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sticky top-8 shadow-lg">
          <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3 border-b border-slate-800 pb-4">
            <span class="text-2xl">🛒</span> Ingredienti
          </h3>
          <ul class="space-y-4">
            {recipe.ingredients && recipe.ingredients.length > 0 ? (
              recipe.ingredients.map((ing) => (
                <li class="flex items-start gap-3 text-slate-300 group">
                  <input type="checkbox" class="mt-1.5 w-5 h-5 flex-shrink-0 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 cursor-pointer accent-blue-500" />
                  <span class="leading-relaxed group-hover:text-white transition-colors ingredient-text" data-original={ing}>{ing}</span>
                </li>
              ))
            ) : (
              <li class="text-slate-500 italic text-sm">Vedi descrizione per i dettagli.</li>
            )}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        
        {lang === 'it' && <AmazonProduct recipe={recipe} />}

        <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-6 md:p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <span class="text-3xl">👨‍🍳</span> Procedimento
          </h3>
          
          <div class="space-y-8 relative before:absolute before:inset-0 before:ml-3.5 before:-z-10 before:h-full before:w-0.5 before:bg-slate-700">
            
            {recipe.instructions && Array.isArray(recipe.instructions) ? (
              {recipe.instructions.map((step, index) => {
  // Calcolo dinamico del percorso
  const stepImagePath = `/images/recipes/${recipe.slug}/step_${index + 1}.jpg`;

  return (
    <div class="flex gap-6 relative">
      <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">{index + 1}</div>
      <div class="pt-1 pb-2 w-full">
        
        <p class="text-slate-300 leading-relaxed text-lg mb-4">{step}</p>
        
        {/* LA FOTO DEVE ESSERE QUI */}
        <div class="mb-4">
          <img 
            src={stepImagePath} 
            alt={`Step ${index + 1} - ${recipe.title}`} 
            class="w-full md:max-w-md rounded-xl shadow-lg border border-slate-700 object-cover bg-slate-800 min-h-[200px]" 
            loading="lazy"
            onerror="this.style.display='none'"
          />
        </div>

      </div>
    </div>
  );
})}
            ) : (
              <>
                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">1</div>
                  <div class="pt-1">
                    <h4 class="text-lg font-bold text-white mb-2">Preparazione</h4>
                    <p class="text-slate-400 leading-relaxed">
                      Prepara tutti gli ingredienti sul piano di lavoro. Se necessario, ungi leggermente il cibo con un filo d'olio spray o condiscilo in una ciotola per distribuire uniformemente le spezie.
                    </p>
                  </div>
                </div>

                <div class="flex gap-6 relative">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">2</div>
                  <div class="pt-1">
                    <h4 class="text-lg font-bold text-white mb-2">Cottura</h4>
                    <p class="text-slate-400 leading-relaxed">
                      Imposta la friggitrice a <strong class="text-white bg-slate-700 px-1 rounded">{recipe.temp}°C</strong>. 
                      Inserisci il cibo nel cestello e cuoci per <strong class="text-white bg-slate-700 px-1 rounded">{recipe.time} minuti</strong>.
                    </p>
                  </div>
                </div>
              </>
            )}

            {recipe.tip && (
              <div class="flex gap-6 relative">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center font-bold text-black shadow-lg shadow-amber-500/20 ring-4 ring-slate-900 z-10">💡</div>
                <div class="pt-1 w-full">
                  <h4 class="text-amber-400 font-bold mb-2">Il Segreto dello Chef</h4>
                  <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4">
                    <p class="text-amber-100 italic leading-relaxed">"{recipe.tip}"</p>
                  </div>
                </div>
              </div>
            )}

          </div>
        </div>

        <div class="text-center pt-8 border-t border-slate-800">
          <a href={backUrl} class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all font-medium">
            ← Cerca un'altra ricetta
          </a>
        </div>

      </div>
    </div>
  </div>

  <script is:inline define:vars={{ basePortions: defaultPortions }}>
    document.addEventListener('DOMContentLoaded', () => {
      let currentPortions = basePortions;
      const display = document.getElementById('portions-display');
      const btnMinus = document.getElementById('btn-minus');
      const btnPlus = document.getElementById('btn-plus');
      const ingredients = document.querySelectorAll('.ingredient-text');

      if (!display || !btnMinus || !btnPlus) return;

      function scaleIngredient(originalStr, ratio) {
        const match = originalStr.trim().match(/^([\d.,]+(?:\/\d+)?)\s+(.*)/);
        if (!match) return originalStr; 

        let numStr = match[1].replace(',', '.');
        let num = 0;
        
        if (numStr.includes('/')) {
          const parts = numStr.split('/');
          num = parseFloat(parts[0]) / parseFloat(parts[1]);
        } else {
          num = parseFloat(numStr);
        }

        if (isNaN(num)) return originalStr;

        let newNum = num * ratio;
        newNum = Number.isInteger(newNum) ? newNum : parseFloat(newNum.toFixed(2));

        return newNum + " " + match[2];
      }

      function updateUI() {
        display.textContent = currentPortions;
        const ratio = currentPortions / basePortions;

        ingredients.forEach(el => {
          const originalText = el.getAttribute('data-original');
          el.textContent = scaleIngredient(originalText, ratio);
        });
      }

      btnMinus.addEventListener('click', () => {
        if (currentPortions > 1) { 
          currentPortions--;
          updateUI();
        }
      });

      btnPlus.addEventListener('click', () => {
        if (currentPortions < 20) { 
          currentPortions++;
          updateUI();
        }
      });
    });
  </script>
</MainLayout>