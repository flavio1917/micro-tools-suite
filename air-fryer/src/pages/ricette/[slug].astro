---
import MainLayout from '../../layouts/MainLayout.astro';
import recipes from '../../data/recipes.json';

// QUESTA È LA FUNZIONE FONDAMENTALE CHE MANCAVA O ERA ERRATA
export async function getStaticPaths() {
  // Astro cicla su tutte le ricette del JSON e crea una pagina per ognuna
  return recipes.map((recipe) => {
    return {
      params: { slug: recipe.slug }, // Dice ad Astro che URL generare (es. /ricette/pollo)
      props: { recipe }, // Passa i dati della ricetta alla pagina
    };
  });
}

// Recupera i dati passati dalla funzione sopra
const { recipe } = Astro.props;

// Gestione immagine
const imagePath = `/images/recipes/${recipe.slug}.webp`;
---

<MainLayout title={`${recipe.title} - Ricetta Friggitrice ad Aria`}>
  
  <div class="relative h-[40vh] min-h-[300px] w-full overflow-hidden">
    <img 
      src={imagePath} 
      alt={recipe.title} 
      class="absolute inset-0 h-full w-full object-cover blur-sm opacity-50"
      onerror="this.style.opacity='0'" 
    />
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/60 via-slate-900/80 to-slate-900"></div>
    
    <div class="relative max-w-4xl mx-auto px-4 h-full flex flex-col justify-center items-center text-center">
      <span class="text-6xl md:text-8xl mb-4 animate-bounce-slow">{recipe.emoji}</span>
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-4 leading-tight">{recipe.title}</h1>
      <p class="text-lg text-slate-300 max-w-2xl">{recipe.description}</p>
      
      <div class="mt-6 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/30 text-blue-300 text-sm">
        <span>Fonte Ufficiale: <strong>{recipe.source}</strong></span>
      </div>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 -mt-10 relative z-10 pb-20">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 text-center shadow-lg">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Temperatura</span>
        <div class="text-4xl font-mono font-bold text-orange-400">{recipe.temp}°C</div>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 text-center shadow-lg">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Tempo</span>
        <div class="text-4xl font-mono font-bold text-blue-400">{recipe.time} <span class="text-xl">min</span></div>
      </div>
      <div class="bg-slate-800 border border-slate-700 rounded-xl p-6 text-center shadow-lg">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Difficoltà</span>
        <div class="text-4xl font-bold text-green-400">
          {recipe.ingredients && recipe.ingredients.length <= 5 ? 'Facile' : 'Media'}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="lg:col-span-1">
        <div class="bg-slate-800/50 border border-slate-700 rounded-2xl p-6 sticky top-8">
          <h3 class="text-xl font-bold text-white mb-4 flex items-center gap-2">
            🛒 Ingredienti
          </h3>
          <ul class="space-y-3">
            {recipe.ingredients && recipe.ingredients.length > 0 ? (
              recipe.ingredients.map((ing) => (
                <li class="flex items-start gap-3 text-slate-300 text-sm">
                  <input type="checkbox" class="mt-1 w-4 h-4 rounded border-slate-600 bg-slate-700 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 cursor-pointer">
                  <span class="leading-snug">{ing}</span>
                </li>
              ))
            ) : (
              <li class="text-slate-500 italic text-sm">Nessun ingrediente specifico elencato.</li>
            )}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-6">
        
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8">
          <h3 class="text-2xl font-bold text-white mb-6">👨‍🍳 Procedimento Rapido</h3>
          
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white">1</div>
              <div>
                <h4 class="text-white font-bold mb-1">Preparazione</h4>
                <p class="text-slate-400">Unisci gli ingredienti elencati. Se previsto dalla ricetta, impana o condisci il cibo in una ciotola prima di inserirlo nel cestello.</p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white">2</div>
              <div>
                <h4 class="text-white font-bold mb-1">Cottura Air Fryer</h4>
                <p class="text-slate-400">
                  Imposta la friggitrice a <strong class="text-white">{recipe.temp}°C</strong>. 
                  Inserisci il cibo nel cestello (non sovrapporre troppo) e cuoci per <strong class="text-white">{recipe.time} minuti</strong>.
                </p>
              </div>
            </div>

             <div class="flex gap-4">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center font-bold text-black">💡</div>
              <div>
                <h4 class="text-amber-400 font-bold mb-1">Il Consiglio dell'Esperto</h4>
                <p class="text-slate-300 italic">"{recipe.tip}"</p>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center pt-8">
          <a href="/#ricettario" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors">
            ← Cerca un'altra ricetta
          </a>
        </div>

      </div>
    </div>
  </div>
</MainLayout>

<style>
  .animate-bounce-slow {
    animation: bounce 3s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(-5%); }
    50% { transform: translateY(0); }
  }
</style>