---
import MainLayout from '../../layouts/MainLayout.astro';
import recipes from '../../data/recipes.json';
import AmazonProduct from '../../components/ads/AmazonProduct.astro'; // <--- 1. MANCAVA QUESTO IMPORT

export async function getStaticPaths() {
  return recipes.map((recipe) => {
    return {
      params: { slug: recipe.slug },
      props: { recipe },
    };
  });
}

const { recipe } = Astro.props;

// Gestione immagine
const imagePath = `/images/recipes/${recipe.slug}.webp`;
---

<MainLayout title={`${recipe.title} - Ricetta Friggitrice ad Aria`}>
  
  <div class="relative h-[50vh] min-h-[400px] w-full overflow-hidden bg-slate-900">
    <img 
      src={imagePath} 
      alt={recipe.title} 
      class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-1000 hover:scale-105"
      onerror="this.style.opacity='0'" 
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/60 to-transparent"></div>
    <div class="relative max-w-4xl mx-auto px-4 h-full flex flex-col justify-end pb-16 items-center text-center z-10">
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4 leading-tight drop-shadow-[0_4px_4px_rgba(0,0,0,0.8)]">
        {recipe.title}
      </h1>
      <p class="text-lg md:text-xl text-slate-200 max-w-2xl font-medium drop-shadow-md border-t border-white/20 pt-4 mt-2">
        {recipe.description}
      </p>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-4 -mt-8 relative z-20 pb-20">
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-6 text-center shadow-2xl hover:border-blue-500 transition-colors">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Temperatura</span>
        <div class="text-5xl font-mono font-bold text-orange-400">{recipe.temp}°C</div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-6 text-center shadow-2xl hover:border-blue-500 transition-colors">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Tempo</span>
        <div class="text-5xl font-mono font-bold text-blue-400">{recipe.time} <span class="text-2xl">min</span></div>
      </div>
      <div class="bg-slate-800/90 backdrop-blur-md border border-slate-700 rounded-xl p-6 text-center shadow-2xl hover:border-blue-500 transition-colors">
        <span class="block text-slate-400 text-xs uppercase tracking-wider font-bold mb-1">Difficoltà</span>
        <div class="text-5xl font-bold text-green-400">
          {recipe.ingredients && recipe.ingredients.length <= 5 ? 'Facile' : 'Media'}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      
      <div class="lg:col-span-1">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 sticky top-8 shadow-lg">
          <h3 class="text-xl font-bold text-white mb-6 flex items-center gap-3 border-b border-slate-800 pb-4">
            <span class="text-2xl">🛒</span> Ingredienti
          </h3>
          <ul class="space-y-4">
            {recipe.ingredients && recipe.ingredients.length > 0 ? (
              recipe.ingredients.map((ing) => (
                <li class="flex items-start gap-3 text-slate-300 group">
                  <input type="checkbox" class="mt-1.5 w-5 h-5 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-blue-500 focus:ring-offset-slate-900 cursor-pointer accent-blue-500">
                  <span class="leading-relaxed group-hover:text-white transition-colors">{ing}</span>
                </li>
              ))
            ) : (
              <li class="text-slate-500 italic text-sm">Vedi descrizione per i dettagli.</li>
            )}
          </ul>
        </div>
      </div>

      <div class="lg:col-span-2 space-y-8">
        
        <AmazonProduct recipe={recipe} />

        <div class="bg-slate-800/50 border border-slate-700/50 rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-white mb-8 flex items-center gap-3">
            <span class="text-3xl">👨‍🍳</span> Procedimento
          </h3>
          
          <div class="space-y-8 relative before:absolute before:inset-0 before:ml-3.5 before:-z-10 before:h-full before:w-0.5 before:bg-slate-700">
            <div class="flex gap-6 relative">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">1</div>
              <div class="pt-1">
                <h4 class="text-lg font-bold text-white mb-2">Preparazione</h4>
                <p class="text-slate-400 leading-relaxed">
                  Prepara tutti gli ingredienti sul piano di lavoro. Se necessario, ungi leggermente il cibo con un filo d'olio spray o condiscilo in una ciotola per distribuire uniformemente le spezie.
                </p>
              </div>
            </div>

            <div class="flex gap-6 relative">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center font-bold text-white shadow-lg ring-4 ring-slate-900 z-10">2</div>
              <div class="pt-1">
                <h4 class="text-lg font-bold text-white mb-2">Cottura</h4>
                <p class="text-slate-400 leading-relaxed">
                  Imposta la friggitrice a <strong class="text-white bg-slate-700 px-1 rounded">{recipe.temp}°C</strong>. 
                  Inserisci il cibo nel cestello cercando di non sovrapporlo troppo per far circolare l'aria. Cuoci per <strong class="text-white bg-slate-700 px-1 rounded">{recipe.time} minuti</strong>.
                </p>
              </div>
            </div>

             <div class="flex gap-6 relative">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-500 flex items-center justify-center font-bold text-black shadow-lg shadow-amber-500/20 ring-4 ring-slate-900 z-10">💡</div>
              <div class="pt-1">
                <h4 class="text-amber-400 font-bold mb-2">Il Segreto dello Chef</h4>
                <div class="bg-amber-500/10 border border-amber-500/20 rounded-lg p-4">
                  <p class="text-amber-100 italic">"{recipe.tip}"</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center pt-8 border-t border-slate-800">
          <a href="/#ricettario" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-all font-medium">
            ← Cerca un'altra ricetta
          </a>
        </div>

      </div>
    </div>
  </div>
</MainLayout>