---
// 1. IMPORTA IL CSS QUI SOTTO
import '../styles/global.css';

const { title, lang = 'it' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 min-h-screen">
    <slot />
  </body>
</html>